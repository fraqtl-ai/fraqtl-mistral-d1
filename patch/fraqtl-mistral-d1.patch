new file mode 100644
index 000000000..d5073a425
--- /dev/null
+++ b/src/llama-fraqtl.h
@@ -0,0 +1,102 @@
+// fraQtl V cache compression — sidecar loader.
+// Reads a .fraqtl-eigenbasis.bin file into GPU memory at llama_context init.
+// Validates magic + version + (n_kv_heads, head_dim) against the model's
+// hparams; refuses to run on mismatch (prevents silent garbage on wrong basis).
+// Sidecar v1 wire format (little-endian, no padding):
+//     int32 magic = 0x46524151 // "FRAQ"
+//     int32 version = 1
+//     int32 n_layers
+//     int32 n_kv_heads // NKV — must equal model's n_head_kv
+//     int32 head_dim // must equal model's n_embd_head_v
+//     int32 k_protect // top-k protected dims
+//     int32 reserved[2] = {0, 0}
+//     fp16 U[n_layers * n_kv_heads * head_dim * head_dim] row-major
+// Owned by llama_context; freed at llama_free.
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+struct llama_model;
+
+namespace fraqtl {
+
+struct kv_bundle {
+    // GPU device pointer (cudaMalloc'd, fp16). Lifetime tied to bundle.
+    void *  d_eigenbasis = nullptr;
+
+    int32_t n_layers     = 0;
+    int32_t n_kv_heads   = 0;
+    int32_t head_dim     = 0;
+    int32_t k_protect    = 0;
+
+    // Bytes allocated on device — for accounting / sanity.
+    size_t  bytes        = 0;
+
+    bool    loaded       = false;
+};
+
+// separate K-side bundle (orthogonal to V's kv_bundle above).
+// Parallel structure but carries:
+//   - U_K device arena (analogous to V's d_eigenbasis but K-specific)
+//   - per-(layer, kv_head) ranks from the calibration sidecar
+// Lifetime tied to llama_context: loaded at init from
+// --fraqtl-k-eigenbasis <path>, freed at llama_free.
+// Sidecar v1 wire format (matches docs/fraqtl-kv-step5-7b-scope.md):
+//     int32 magic = 0x4B514152 // 'RAQK' little-endian
+//     int32 version = 1
+//     int32 n_layers
+//     int32 n_kv_heads
+//     int32 head_dim
+//     int32 reserved[3] = {0, 0, 0} // header = 32 bytes
+//     int32 ranks[n_layers * n_kv_heads] // each in [24, head_dim]
+//     fp16 U_K[n_layers * n_kv_heads * head_dim * head_dim] // row-major (d, c)
+// `ranks_per_layer_kvh` is laid out [layer][kvh] (n_layers * n_kv_heads
+// int32s) — matches fraqtl_kv_options.k_ranks_per_layer addressing.
+struct k_bundle {
+    void *               d_uk_arena         = nullptr;  // GPU fp16 arena
+    int32_t              n_layers           = 0;
+    int32_t              n_kv_heads         = 0;
+    int32_t              head_dim           = 0;
+    std::vector<int32_t> ranks_per_layer_kvh;           // size = n_layers*n_kv_heads
+    size_t               uk_arena_bytes     = 0;
+    bool                 loaded             = false;
+};
+
+// Load + validate sidecar. Throws std::runtime_error on:
+//   - file open failure
+//   - bad magic / unsupported version
+//   - n_kv_heads or head_dim mismatch with model hparams
+//   - short read / corrupt data
+//   - cudaMalloc / cudaMemcpy failure
+// On success, populates `out` with a GPU-resident U bundle.
+void load_eigenbasis_sidecar(
+    const std::string & path,
+    const llama_model * model,
+    int32_t             requested_k_protect,
+    kv_bundle &         out
+);
+
+// Free GPU resources. Safe to call on a default-constructed (unloaded) bundle.
+void free_kv_bundle(kv_bundle & bundle);
+
+// load + validate K sidecar binary into a k_bundle.
+// Throws std::runtime_error on:
+//   - file open failure
+//   - bad magic / unsupported version
+//   - n_layers / n_kv_heads / head_dim mismatch with model hparams
+//   - any rank outside [24, head_dim]
+//   - short read / corrupt data
+//   - cudaMalloc / cudaMemcpy failure
+// On success populates `out` with a GPU-resident U_K arena + ranks vector.
+void load_k_eigenbasis_sidecar(
+    const std::string & path,
+    const llama_model * model,
+    k_bundle &          out
+);
+
+void free_k_bundle(k_bundle & bundle);
+
+}  // namespace fraqtl
