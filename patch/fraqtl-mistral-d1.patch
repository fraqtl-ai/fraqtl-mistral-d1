+extern "C" int fraqtl_runtime_is_active(void) {
+    // deferred-pack: "active" requires both initialization AND
+    // ONLINE mode. During prefill (mode=DEFERRED) the set-rows hook and
+    // fattn dispatcher both see false, so V writes go to the standard
+    // fp16 cache_v_l<L> via the normal llama.cpp path and attention
+    // reads from it via standard fattn — zero fraQtl overhead in the
+    // prefill hot path. llama_fraqtl_compress_cache(ctx) flips to ONLINE.
+    return (g_fraqtl.active && g_fraqtl.mode == fraqtl_runtime_state::MODE_ONLINE) ? 1 : 0;
+}
