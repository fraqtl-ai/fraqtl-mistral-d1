+extern "C" int fraqtl_runtime_get_mode(void) {
+    return (int) g_fraqtl.mode;   // 0 = DEFERRED, 1 = ONLINE
+}
+
+extern "C" void fraqtl_runtime_set_mode_online(void) {
+    g_fraqtl.mode = fraqtl_runtime_state::MODE_ONLINE;
+}
+
+extern "C" void fraqtl_runtime_set_mode_deferred(void) {
+    g_fraqtl.mode = fraqtl_runtime_state::MODE_DEFERRED;
+}
+// ROW_AUDIT for compress_cache. Reads alive cache_v_l[layer]
+// at slot 0 / kvh 0 + slabs at the same address, computes V_recon =
+// prot @ U.T (+ INT3 SAC dequant for K<HD), and prints rel_l2 vs the
+// live cache row. Must be called BEFORE the v_fp16 buffer is freed.
+// One-shot per process per layer_idx; no-op on repeat calls.
+extern "C" int fraqtl_runtime_audit_compressed_layer(int32_t layer_idx) {
+    if (!g_fraqtl.active) return 0;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 0;
+
+    // Memoize verdict so subsequent calls are O(1). State lives in g_fraqtl
+    // (NOT a function-static) so fraqtl_runtime_setup() / teardown() can reset
+    // it for multi-context safety. Encoded: 0 = not yet run, 1 = passed,
+    // 2 = skipped/failed.
+    if (g_fraqtl.audit_done[layer_idx] != 0) {
+        return (g_fraqtl.audit_done[layer_idx] == 1) ? 1 : 0;
+    }
+
+    const int HD = g_fraqtl.hd;
+    const int K  = g_fraqtl.k_protect;
+    const int sac_dims     = HD - K;
+    const int n_groups     = (sac_dims + 7) / 8;
+    const int packed_bytes_local = n_groups * 3;
+
+    void *       lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void *       lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void *       lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    const void * v_cache   = g_fraqtl.layer_v_cache_data[layer_idx];
+    if (!lay_prot || !lay_scale || !v_cache) {
+        fprintf(stderr, "fraqtl: ROW_AUDIT layer %d skipped — slabs/v_cache not registered\n",
+                layer_idx);
+        fflush(stderr);
+        g_fraqtl.audit_done[layer_idx] = 2;   // skipped/failed
+        return 0;
+    }
+
+    // Sync any in-flight compress kernels.
+    cudaDeviceSynchronize();
+
+    // Read live V row at slot 0, kvh 0 (first HD halves of cache_v_l<L>).
+    std::vector<half> live_v_h(HD);
+    cudaMemcpy(live_v_h.data(), v_cache, HD * sizeof(half), cudaMemcpyDeviceToHost);
+
+    // Read slab[layer, kvh=0, slot=0] prot row (K halves).
+    std::vector<half> prot_row_h(K);
+    cudaMemcpy(prot_row_h.data(), lay_prot, K * sizeof(half), cudaMemcpyDeviceToHost);
+
+    // Read U[layer, kvh=0] (HD x HD halves).
+    std::vector<half> U_h(HD * HD);
+    cudaMemcpy(U_h.data(),
+               (const half *) g_fraqtl.d_U
+                 + (size_t) layer_idx * g_fraqtl.n_kv * HD * HD,
+               HD * HD * sizeof(half), cudaMemcpyDeviceToHost);
+
+    // Reconstruct C[0:HD]: prot[0:K] for protected dims, INT3 dequant for SAC.
+    std::vector<float> C(HD, 0.0f);
+    for (int i = 0; i < K; ++i) C[i] = __half2float(prot_row_h[i]);
+
+    if (K < HD) {
+        float scale_h_val = 0.0f;
+        cudaMemcpy(&scale_h_val, lay_scale, sizeof(float), cudaMemcpyDeviceToHost);
+        std::vector<uint8_t> pack_bytes(packed_bytes_local, 0);
+        if (lay_pack) {
+            cudaMemcpy(pack_bytes.data(), lay_pack, packed_bytes_local, cudaMemcpyDeviceToHost);
+        }
+        for (int g = 0; g < n_groups; ++g) {
+            const uint32_t b0 = pack_bytes[g*3 + 0];
+            const uint32_t b1 = pack_bytes[g*3 + 1];
+            const uint32_t b2 = pack_bytes[g*3 + 2];
+            int idx[8];
+            idx[0] = ((b0 >> 5) & 7) - 4;
+            idx[1] = ((b0 >> 2) & 7) - 4;
+            idx[2] = (((b0 & 0x3) << 1) | ((b1 >> 7) & 0x1)) - 4;
+            idx[3] = ((b1 >> 4) & 7) - 4;
+            idx[4] = ((b1 >> 1) & 7) - 4;
+            idx[5] = (((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3)) - 4;
+            idx[6] = ((b2 >> 3) & 7) - 4;
+            idx[7] = ( b2       & 7) - 4;
+            for (int e = 0; e < 8; ++e) {
+                const int hd_dim_idx = K + g*8 + e;
+                if (hd_dim_idx < HD) {
+                    C[hd_dim_idx] = (float) idx[e] * scale_h_val;
+                }
+            }
+        }
+    }
+
+    // V_recon[d] = sum_r C[r] * U[d, r] = (C @ U.T)[d]
+    std::vector<float> V_recon(HD, 0.0f);
+    for (int d = 0; d < HD; ++d) {
+        float acc = 0.0f;
+        for (int r = 0; r < HD; ++r) {
+            acc += C[r] * __half2float(U_h[d * HD + r]);
+        }
+        V_recon[d] = acc;
+    }
+
+    // rel_l2 = ||live_v - V_recon|| / ||live_v||
+    float num = 0.0f, den = 0.0f;
+    for (int d = 0; d < HD; ++d) {
+        const float lv = __half2float(live_v_h[d]);
+        const float diff = lv - V_recon[d];
+        num += diff * diff;
+        den += lv * lv;
+    }
+    const float rel_l2 = (den > 0.0f) ? sqrtf(num / den) : 0.0f;
+
+    fprintf(stderr, "fraqtl: ROW_AUDIT layer=%d kvh=0 slot=0 K=%d HD=%d\n", layer_idx, K, HD);
+    fprintf(stderr, "  live_v[0:8]   :");
+    for (int i = 0; i < 8 && i < HD; ++i) fprintf(stderr, " %+.4f", __half2float(live_v_h[i]));
+    fprintf(stderr, "\n  prot[0:%d]   :", (K < 8 ? K : 8));
+    for (int i = 0; i < 8 && i < K; ++i) fprintf(stderr, " %+.4f", __half2float(prot_row_h[i]));
+    fprintf(stderr, "\n  V_recon[0:8]  :");
+    for (int i = 0; i < 8 && i < HD; ++i) fprintf(stderr, " %+.4f", V_recon[i]);
+    fprintf(stderr, "\n  rel_l2(live_v vs V_recon over HD dims) = %.6f\n", rel_l2);
+    fflush(stderr);
+
+    // re-land: rel_l2 tolerance for "pass". Empirically, descriptor
+    // adapter at K_PROTECT=64 / HD=128 produces rel_l2 in the 1e-3..1e-2 band
+    // (matches the offline pack/unpack roundtrip). Anything > 0.05 indicates
+    // pack corruption; anything > 0.5 means the slabs hold garbage. Conservative
+    // threshold: 0.10 (well above expected, well below garbage).
+    const float rel_l2_pass_threshold = 0.10f;
+    const int passed = (rel_l2 <= rel_l2_pass_threshold) ? 1 : 0;
+    g_fraqtl.audit_done[layer_idx] = passed ? 1 : 2;
+    if (!passed) {
+        fprintf(stderr,
+            "fraqtl: ROW_AUDIT layer=%d FAILED — rel_l2=%.6f > %.4f tolerance; "
+            "release-ready guard will refuse for this layer\n",
+            layer_idx, rel_l2, rel_l2_pass_threshold);
+        fflush(stderr);
+    }
+    return passed;
+}
+
+// re-land (): engine-side release-ready guard.
+// Returns 1 iff every layer in [0, n_layers):
+//   (a) g_fraqtl.set_rows_hook_calls[L] > 0
+//       (bypass has fired at least once for this layer)
+//   (b) fraqtl_runtime_audit_compressed_layer(L) == 1
+//       (V_recon ≈ V at slot 0 / kvh 0 — proves slabs hold real data)
+// Returns 0 otherwise. Idempotent + cheap on subsequent calls (audit
+// memoization). Used by llama_context::decode() to gate the live VRAM
+// release one-shot.
+extern "C" int fraqtl_runtime_release_ready(int32_t n_layers) {
+    if (!g_fraqtl.active) return 0;
+    if (n_layers <= 0 || n_layers > FRAQTL_MAX_LAYERS) return 0;
+
+    for (int L = 0; L < n_layers; ++L) {
+        if (g_fraqtl.set_rows_hook_calls[L] == 0) return 0;
+    }
+    for (int L = 0; L < n_layers; ++L) {
+        if (fraqtl_runtime_audit_compressed_layer(L) != 1) return 0;
+    }
+    return 1;
+}
+
+// stream sync helper so callers in CUDA-free TUs (llama-context.cpp)
+// can wait on compress completion without including <cuda_runtime.h>.
+// stream == nullptr → device-wide sync (default stream).
+extern "C" int fraqtl_runtime_compress_sync(void * stream) {
+    cudaError_t e;
+    if (stream) {
+        e = cudaStreamSynchronize((cudaStream_t) stream);
+    } else {
+        e = cudaDeviceSynchronize();
+    }
+    return (e == cudaSuccess) ? 0 : 1;
+}
+
+// per-layer fp16 V cache registrar. Called once after
+// llama-kv-cache.cpp's backend allocation completes, alongside the slab
+// registration. The cache constructor knows the layer's cache_v_l<L>
+// tensor data pointer + ne[0] + nb[1]; we just stash the values.
+extern "C" void fraqtl_runtime_register_layer_v_cache(
+    int32_t      layer_idx,
+    const void * v_cache_data,
+    int64_t      v_cache_ne0,    // = NKV*HD
+    size_t       v_cache_nb1     // row stride bytes
+) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    g_fraqtl.layer_v_cache_data[layer_idx] = v_cache_data;
+    g_fraqtl.layer_v_cache_ne0 [layer_idx] = v_cache_ne0;
+    g_fraqtl.layer_v_cache_nb1 [layer_idx] = v_cache_nb1;
+}
+
+// bulk-compress one layer's fp16 V rows [0, n_rows) into
+// the descriptor slabs. Idempotent on the [0, last_compressed_rows) prefix
+// re-call with a larger n_rows to compress only the delta.
+// Return codes:
+//   0 success
+//  10 fraqtl runtime not initialized
+//  11 layer_idx out of range
+//  12 slabs not registered for this layer (no fp16 V or no slab data)
+//  13 v_cache shape mismatch (ne0 != NKV*HD or nb1 != NKV*HD*sizeof(half))
+//  14 n_rows > kv_size
+//  15 n_rows < last_compressed_rows (would shrink — refused)
+//  30 CUDA error during bulk pack
+extern "C" int fraqtl_runtime_compress_layer(
+    int32_t  layer_idx,
+    int32_t  n_rows,
+    void *   stream
+) {
+    if (!g_fraqtl.active) return 10;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 11;
+    if (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers) return 11;
+
+    void *       lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void *       lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void *       lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    int          kv_size   = g_fraqtl.layer_kv_size    [layer_idx];
+    const void * v_cache   = g_fraqtl.layer_v_cache_data[layer_idx];
+    int64_t      vc_ne0    = g_fraqtl.layer_v_cache_ne0[layer_idx];
+    size_t       vc_nb1    = g_fraqtl.layer_v_cache_nb1[layer_idx];
+
+    if (!lay_prot || !lay_scale || kv_size <= 0 || !v_cache) return 12;
+
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    const int K   = g_fraqtl.k_protect;
+
+    if (vc_ne0 != (int64_t) NKV * (int64_t) HD)                   return 13;
+    if (vc_nb1 != (size_t) NKV * (size_t) HD * sizeof(half))      return 13;
+    if (n_rows < 0 || n_rows > kv_size)                           return 14;
+
+    const int already = g_fraqtl.last_compressed_rows[layer_idx];
+    if (n_rows < already) return 15;
+    if (n_rows == already) return 0;        // nothing to do
+
+    const int row_start = already;
+    const int delta     = n_rows - already;
+
+    const int sac_dims          = HD - K;
+    const int padded_groups     = (sac_dims + 7) / 8;
+    const int packed_bytes_row  = padded_groups * 3;
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+
+    // Per-kvh sub-launch (mirrors per-row hook). For typical Qwen2.5-0.5B
+    // shapes (NKV=2) this is 2 launches per layer; cheap. Cross-layer
+    // batching can be a follow-up.
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        half *    prot_kvh  = (half *) ((char *) lay_prot
+            + (size_t) kvh * (size_t) kv_size * (size_t) K * sizeof(half));
+        uint8_t * pack_kvh  = lay_pack
+            ? (uint8_t *) ((char *) lay_pack
+              + (size_t) kvh * (size_t) kv_size * (size_t) packed_bytes_row)
+            : nullptr;
+        float *   scale_kvh = (float *) ((char *) lay_scale
+            + (size_t) kvh * (size_t) kv_size * sizeof(float));
+        const half * U_kvh = ((half *) g_fraqtl.d_U)
+            + (size_t) layer_idx * NKV * HD * HD
+            + (size_t) kvh        * HD * HD;
+
+        fraqtl_kv_pack_v_bulk(
+            (const half *) v_cache,
+            prot_kvh, pack_kvh, scale_kvh, U_kvh,
+            row_start, delta, kvh, kv_size, HD, K,
+            vc_nb1, cu_stream
+        );
+
+        cudaError_t e = cudaGetLastError();
+        if (e != cudaSuccess) {
+            fprintf(stderr,
+                "fraqtl: compress_layer L%d kvh=%d bulk pack CUDA error: %s\n",
+                layer_idx, kvh, cudaGetErrorString(e));
+            fflush(stderr);
+            return 30;
+        }
+    }
+
+    {
+        const int sync_rc = fraqtl_sync_if_not_capturing(cu_stream, "compress_layer", layer_idx);
+        if (sync_rc != 0) return sync_rc;
+    }
+    fraqtl_runtime_note_v_pack_ok(layer_idx);
+    g_fraqtl.last_compressed_rows[layer_idx] = n_rows;
+    return 0;
+}
+
+// In-place lossy roundtrip on a V tensor.
+// Validates layout via ne[]/nb[] before launching kernels:
+//   - ne[0] (head_dim) must match sidecar's head_dim
+//   - ne[2] (n_kv_heads) must match sidecar's n_kv_heads
+//   - byte strides must match contiguous packed layout
+//     (nb[0]=2, nb[1]=2*HD, nb[2]=2*HD*S, nb[3]=2*HD*S*NKV)
+// On layout mismatch: returns non-zero, V untouched. On CUDA error from
+// pack/unpack: returns 30/31 and prints diagnostics to stderr.
+// stream is cudaStream_t passed as void* to keep the header CUDA-free.
+extern "C" int fraqtl_runtime_roundtrip_v(
+    void * v_data,
+    const int64_t * ne,
+    const size_t  * nb,
+    int32_t layer_idx,
+    void *  stream
+) {
+    if (!g_fraqtl.active) return 0;
+
+    const int HD  = (int) ne[0];
+    const int S   = (int) ne[1];
+    const int NKV = (int) ne[2];
+    const int B   = (int) ne[3];
+
+    if (NKV != g_fraqtl.n_kv)                              return 10;
+    if (HD  != g_fraqtl.hd)                                return 11;
+    if (layer_idx < 0 || layer_idx >= g_fraqtl.n_layers)   return 13;
+    if ((int64_t) B * NKV * S > g_fraqtl.scratch_rows)     return 12;
+
+    // stride-aware path. Uses byte strides (nb[]) for V addressing,
+    // works on contiguous AND non-contiguous V (KV cache layouts vary).
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+    half *    prot    = (half *)    g_fraqtl.d_protected;
+    uint8_t * pkd     = (uint8_t *) g_fraqtl.d_packed;
+    float *   scale   = (float *)   g_fraqtl.d_scale;
+    half *    U_layer = ((half *)   g_fraqtl.d_U) + (size_t) layer_idx * NKV * g_fraqtl.hd * g_fraqtl.hd;
+
+    fraqtl_kv_pack_v_strided(v_data, prot, pkd, scale, U_layer,
+                             B, NKV, S, g_fraqtl.hd, g_fraqtl.k_protect,
+                             nb[0], nb[1], nb[2], nb[3], cu_stream);
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: pack kernel CUDA error: %s\n", cudaGetErrorString(e));
+        return 30;
+    }
+    fraqtl_kv_unpack_v_strided(prot, pkd, scale, U_layer, v_data,
+                               B, NKV, S, g_fraqtl.hd, g_fraqtl.k_protect,
+                               nb[0], nb[1], nb[2], nb[3], cu_stream);
+    e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: unpack kernel CUDA error: %s\n", cudaGetErrorString(e));
+        return 31;
+    }
+    return 0;
+}
+
+// ===========================================================================
+// incremental pack at fattn entry.
+// Replaces the lite "pack S rows + unpack S rows" per fattn call
+// with "pack new_rows since last call + unpack S rows from per-layer
+// persistent slabs". Saves O(S - new_rows) pack work per call.
+// Per step at S=32K, n_layers=32, single token:
+//   lite : 32 layers × (S pack + S unpack) = 64 × 32K = 2M ops
+//   32 layers × (1 pack + S unpack) = 32 × 32K + 32 = 1M+32
+//   Saves ~50% of pack/unpack work at long context.
+// V tensor's strided byte layout passed via ne[]/nb[]; slab writes at
+// row offset = packed_until * row_bytes (slabs are contiguous, we own them).
+// Multi-token prefill: pack the whole [packed_until, current_S) range. No
+// "one token" assumption.
+// ===========================================================================
+
+extern "C" int fraqtl_runtime_decode_v_incremental(
+    void *          v_data,
+    const int64_t * v_ne,
+    const size_t  * v_nb,
+    int32_t         layer_idx,
+    void *          stream
+) {
+    if (!g_fraqtl.active) return 0;
+
+    // Architectural rule (locked):
+    //   V.ne[1] is the CURRENT VIEW LENGTH (active slot count).
+    //   kv_size is the SLAB STORAGE CAPACITY (registered at cache ctor).
+    //   Slab addressing is bounded by kv_size, never inferred from V.ne[1].
+    // Host fail-fast: every violation below logs to stdout (harness captures
+    // stdout last 3000 chars; stderr is dropped) and returns non-zero. On
+    // return!=0 the caller must fail-open: leave V untouched; attention
+    // proceeds with whatever V currently holds.
+
+    // ---- Layer index bounds (array safety + semantic validity) -------------
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) {
+        fprintf(stderr,
+            "fraqtl: layer_idx=%d out of [0, FRAQTL_MAX_LAYERS=%d) — refusing\n",
+            layer_idx, FRAQTL_MAX_LAYERS);
+        fflush(stderr);
+        return 13;
+    }
+    if (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers) {
+        fprintf(stderr,
+            "fraqtl: layer_idx=%d >= n_layers=%d — refusing\n",
+            layer_idx, g_fraqtl.n_layers);
+        fflush(stderr);
+        return 13;
+    }
+
+    // ---- Registry lookup: slab pointers + slab capacity --------------------
+    void * lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void * lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void * lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    int    kv_size   = g_fraqtl.layer_kv_size    [layer_idx];
+    if (!lay_prot || !lay_scale || kv_size <= 0) {
+        fprintf(stderr,
+            "fraqtl: layer %d unregistered (lay_prot=%p lay_scale=%p kv_size=%d) "
+            "— refusing\n",
+            layer_idx, lay_prot, lay_scale, kv_size);
+        fflush(stderr);
+        return 14;
+    }
+
+    // ---- V tensor view shape (current call only — no capacity inference) --
+    const int HD  = (int) v_ne[0];
+    const int S   = (int) v_ne[1];   // current view length, NOT capacity
+    const int NKV = (int) v_ne[2];
+    const int B   = (int) v_ne[3];
+    if (NKV != g_fraqtl.n_kv) {
+        fprintf(stderr,
+            "fraqtl: layer %d: V.ne[2]=%d != registered n_kv=%d — refusing\n",
+            layer_idx, NKV, g_fraqtl.n_kv);
+        fflush(stderr);
+        return 10;
+    }
+    if (HD != g_fraqtl.hd) {
+        fprintf(stderr,
+            "fraqtl: layer %d: V.ne[0]=%d != registered head_dim=%d — refusing\n",
+            layer_idx, HD, g_fraqtl.hd);
+        fflush(stderr);
+        return 11;
+    }
+    if (B != 1) {
+        fprintf(stderr,
+            "fraqtl: layer %d: V.ne[3]=%d != 1 (batched cache unsupported) "
+            "— refusing\n",
+            layer_idx, B);
+        fflush(stderr);
+        return 15;
+    }
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+    const int K = g_fraqtl.k_protect;
+    const int sac_dims = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes_per_row = padded_groups * 3;
+
+    // ---- Bounds (catch bad math BEFORE kernel launch) ----------------------
+    // pack moved to cpy time (fraqtl_runtime_pack_v_cpy_hook fired
+    // from ggml_cuda_cpy when the destination is cache_v_l<L>). This entry
+    // point now ONLY unpacks the active V slice from the per-layer slab
+    // back into V at fattn read time. The slab rows for slots that were
+    // written by a cpy hook hold real packed values; rows that were never
+    // written are zero (slabs are zeroed at construction by
+    // ggml_backend_buffer_clear and the kvh-major × kv_size layout never
+    // overwrites those zeros). Empty slots unpack to zero V values, which
+    // attention masks out via cells.is_empty(idx).
+    // g_fraqtl.packed_until[layer_idx] is now a high-water mark advanced
+    // by the cpy hook (max slot index written so far) — used for
+    // diagnostics only, not for control flow here.
+    if (S > kv_size) {
+        fprintf(stderr,
+            "fraqtl: layer %d: V.ne[1]=%d > kv_size=%d — refusing\n",
+            layer_idx, S, kv_size);
+        fflush(stderr);
+        return 17;
+    }
+
+    // First-call-per-layer diagnostic (logs once per layer per process).
+    // The two write-time hook counters are reported separately so the
+    // receipt can prove which path is firing:
+    //   cpy_hook_calls — legacy cpy-side hook (cache_v_l<L> via
+    //                          ggml_cuda_cpy). Typically 0 in modern
+    //                          llama.cpp where V writes go through
+    //                          ggml_set_rows.
+    //   set_rows_hook_calls — (A1) primary hook, fired from
+    //                          ggml_cuda_op_set_rows. THIS is what
+    //                          must be > 0 for the smoke to be valid.
+    static unsigned char layer_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!layer_logged[layer_idx]) {
+        fprintf(stderr,
+            "fraqtl: layer %d FIRST CALL — "
+            "B=%d NKV=%d S=%d HD=%d K=%d kv_size=%d "
+            "packed_until_hwm=%d cpy_hook_calls=%d set_rows_hook_calls=%d "
+            "fused_attn_calls=%d "
+            "hook_skips_shape=%d hook_errors=%d needs_fallback=%d "
+            "v_nb=[%zu,%zu,%zu,%zu]\n",
+            layer_idx, B, NKV, S, HD, K, kv_size,
+            g_fraqtl.packed_until[layer_idx],
+            g_fraqtl.cpy_hook_calls[layer_idx],
+            g_fraqtl.set_rows_hook_calls[layer_idx],
+            g_fraqtl.fused_attn_calls[layer_idx],
+            g_fraqtl.hook_skips_shape[layer_idx],
+            g_fraqtl.hook_errors[layer_idx],
+            g_fraqtl.needs_fallback_pack[layer_idx],
+            v_nb[0], v_nb[1], v_nb[2], v_nb[3]);
+        fflush(stderr);
+        layer_logged[layer_idx] = 1;
+    }
+
+    // Slab layout (populated by write-time hooks on the same stream, read here):
+    //   prot[kvh, s, k] at byte ((kvh * kv_size + s) * K) * sizeof(half)
+    //   pack[kvh, s, byte] at byte (kvh * kv_size + s) * packed_bytes_per_row
+    //   scale[kvh, s] at byte (kvh * kv_size + s) * sizeof(float)
+    const int unpack_S_clamped = (S < kv_size) ? S : kv_size;
+
+    // Mandatory safety trigger (internal review direction): if NEITHER hook has
+    // fired for this layer at all and S > 0, the slab cannot possibly be
+    // populated for ANY active slot. Force a Phase-1 fallback pack before
+    // unpack so attention reads valid V values for every non-empty cell,
+    // not zeros. This catches the case where the smoke harness or future
+    // llama.cpp change routes V cache writes through an op we don't yet
+    // hook (the exact failure mode we hit at fork commit 391ae370f).
+    if (S > 0 &&
+        g_fraqtl.cpy_hook_calls     [layer_idx] == 0 &&
+        g_fraqtl.set_rows_hook_calls[layer_idx] == 0)
+    {
+        if (!g_fraqtl.needs_fallback_pack[layer_idx]) {
+            // Quiet first time per layer — print once so the receipt
+            // shows that the trigger fired.
+            fprintf(stderr,
+                "fraqtl: layer %d HOOK MISS — cpy_hook_calls=0 "
+                "set_rows_hook_calls=0 S=%d, forcing Phase-1 fallback\n",
+                layer_idx, S);
+            fflush(stderr);
+        }
+        g_fraqtl.needs_fallback_pack[layer_idx] = 1;
+    }
+
+    // Phase-1 fallback (): when neither write-time hook covered
+    // this layer for this step (shape/stride gate failed, hook body
+    // errored, or the cache write went through an unrecognized op), we
+    // cannot trust the slab. Regenerate it from the live V cache here,
+    // then proceed with unpack as normal. Same kvh-major ×
+    // kv_size slab layout, same kernel, same per-kvh sub-launch shape
+    // as the Option 1 packer. Reads V via the strided ne[]/nb[]
+    // passed in (V at fattn entry has shape [HD, S, NKV, B]).
+    if (g_fraqtl.needs_fallback_pack[layer_idx]) {
+        fprintf(stderr,
+            "fraqtl: layer %d FALLBACK PACK — cpy_hook missed; "
+            "doing full Phase-1 repack S=%d from live V before unpack\n",
+            layer_idx, S);
+        fflush(stderr);
+        const int fb_S = (S < kv_size) ? S : kv_size;
+        if (fb_S > 0) {
+            for (int kvh = 0; kvh < NKV; ++kvh) {
+                char * v_off = (char *) v_data + (size_t) kvh * v_nb[2];
+                char * prot_off = (char *) lay_prot
+                    + ((size_t) kvh * (size_t) kv_size)
+                      * (size_t) K * sizeof(half);
+                char * pack_off = lay_pack
+                    ? (char *) lay_pack
+                      + ((size_t) kvh * (size_t) kv_size)
+                        * (size_t) packed_bytes_per_row
+                    : nullptr;
+                char * scale_off = (char *) lay_scale
+                    + ((size_t) kvh * (size_t) kv_size) * sizeof(float);
+                const half * U_kvh = ((half *) g_fraqtl.d_U)
+                    + (size_t) layer_idx * NKV * HD * HD
+                    + (size_t) kvh        * HD * HD;
+                fraqtl_kv_pack_v_strided(
+                    v_off,
+                    (half *)    prot_off,
+                    (uint8_t *) pack_off,
+                    (float *)   scale_off,
+                    U_kvh,
+                    /*B=*/1, /*NKV=*/1, /*S=*/fb_S, HD, K,
+                    v_nb[0], v_nb[1], v_nb[2], v_nb[3],
+                    cu_stream);
+            }
+            if (fb_S > g_fraqtl.packed_until[layer_idx]) {
+                g_fraqtl.packed_until[layer_idx] = fb_S;
+            }
+        }
+        g_fraqtl.needs_fallback_pack[layer_idx] = 0;
+    }
+
+    // ---- Identity-mode roundtrip diagnostic (env-gated, debug only) --------
+    // When FRAQTL_IDENTITY_CHECK=1, AND layer_idx==0, AND K==HD (so the
+    // pack/unpack round-trip with identity-U is a mathematical no-op):
+    //   1. Snapshot HD halves of V at (b=0, s=0, kvh=0) BEFORE pack
+    //   2. Run pack/unpack
+    //   3. Snapshot the same HD halves AFTER unpack
+    //   4. Print max_abs_diff
+    // Inserts cudaStreamSynchronize calls — breaks CUDA graph capture, so
+    // ONLY enable for one diagnostic Modal fire. Off by default; static
+    // initializer reads env once at first call.
+    static const bool dbg_identity_check = []() {
+        const char * v = getenv("FRAQTL_IDENTITY_CHECK");
+        return v && atoi(v) > 0;
+    }();
+    const bool do_identity_check = dbg_identity_check && layer_idx == 0 && K == HD;
+
+    constexpr int IDENTITY_SAMPLE_MAX = 128;
+    half v_pre[IDENTITY_SAMPLE_MAX];
+    const int identity_sample = (HD < IDENTITY_SAMPLE_MAX) ? HD : IDENTITY_SAMPLE_MAX;
+    if (do_identity_check) {
+        cudaStreamSynchronize(cu_stream);
+        cudaError_t e = cudaMemcpy(v_pre, v_data,
+                                   identity_sample * sizeof(half),
+                                   cudaMemcpyDeviceToHost);
+        if (e != cudaSuccess) {
+            fprintf(stderr,
+                "fraqtl: identity check pre-copy failed: %s — skipping\n",
+                cudaGetErrorString(e));
+            fflush(stderr);
+        }
+    }
+
+    // (pack moved to fraqtl_runtime_pack_v_cpy_hook, fired from
+    // ggml_cuda_cpy at V cache write time — see ggml/src/ggml-cuda/cpy.cu.)
+
+    // per-kvh unpack reads first unpack_S_clamped rows of each
+    // kvh's slab section into V's active slice. Bounded by kv_size on
+    // the slab side and by V's view on the output side.
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        char * v_out_off = (char *) v_data + (size_t) kvh * v_nb[2];
+
+        char * prot_off  = (char *) lay_prot
+            + (size_t) kvh * (size_t) kv_size * (size_t) K * sizeof(half);
+        char * pack_off  = lay_pack
+            ? (char *) lay_pack
+              + (size_t) kvh * (size_t) kv_size * (size_t) packed_bytes_per_row
+            : nullptr;
+        char * scale_off = (char *) lay_scale
+            + (size_t) kvh * (size_t) kv_size * sizeof(float);
+
+        const half * U_kvh = ((half *) g_fraqtl.d_U)
+            + (size_t) layer_idx * NKV * HD * HD
+            + (size_t) kvh        * HD * HD;
+
+        fraqtl_kv_unpack_v_strided(
+            (const half *)    prot_off,
+            (const uint8_t *) pack_off,
+            (const float *)   scale_off,
+            U_kvh,
+            v_out_off,
+            /*B=*/1, /*NKV=*/1, /*S=*/unpack_S_clamped, HD, K,
+            v_nb[0], v_nb[1], v_nb[2], v_nb[3],
+            cu_stream
+        );
+    }
+
+    // ---- Identity check post-unpack (paired with snapshot above) -----------
+    if (do_identity_check) {
+        cudaStreamSynchronize(cu_stream);
+        half v_post[IDENTITY_SAMPLE_MAX];
+        cudaError_t e = cudaMemcpy(v_post, v_data,
+                                   identity_sample * sizeof(half),
+                                   cudaMemcpyDeviceToHost);
+        if (e != cudaSuccess) {
+            fprintf(stderr,
+                "fraqtl: identity check post-copy failed: %s\n",
+                cudaGetErrorString(e));
+            fflush(stderr);
+        } else {
+            float max_diff = 0.0f;
+            int   worst    = -1;
+            for (int i = 0; i < identity_sample; ++i) {
+                const float a = __half2float(v_pre[i]);
+                const float b = __half2float(v_post[i]);
+                const float d = fabsf(a - b);
+                if (d > max_diff) { max_diff = d; worst = i; }
+            }
+            const float pre_v  = (worst >= 0) ? __half2float(v_pre[worst])  : 0.0f;
+            const float post_v = (worst >= 0) ? __half2float(v_post[worst]) : 0.0f;
+            fprintf(stderr,
+                "fraqtl: IDENTITY CHECK layer 0 — sample=%d/%d "
+                "max_abs_diff=%.6e @i=%d (pre=%.6f post=%.6f) "
+                "S=%d packed_until_after=%d\n",
+                identity_sample, HD, max_diff, worst, pre_v, post_v,
+                S, g_fraqtl.packed_until[layer_idx]);
+            fflush(stderr);
+        }
+    }
+
+    return 0;
+}
+
+// ===========================================================================
+// per-layer slab pack/unpack wrappers.
+// pack_v_to_slabs: V is potentially strided (from ggml's KV cache); slabs
+// are contiguous (we own their layout in kv_layer). Calls the strided pack
+// kernel directly with the externally-owned slab pointers.
+// unpack_slabs_to_scratch: slabs and scratch are both contiguous. Calls
+// the original (non-strided) unpack kernel.
+// ===========================================================================
+
+extern "C" int fraqtl_runtime_pack_v_to_slabs(
+    void *      v_data,
+    void *      v_protected,
+    void *      v_packed,
+    void *      v_scale,
+    int32_t     B, int32_t NKV, int32_t S, int32_t HD,
+    const int64_t * v_ne,
+    const size_t  * v_nb,
+    int32_t     layer_idx,
+    void *      stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (NKV != g_fraqtl.n_kv)  return 10;
+    if (HD  != g_fraqtl.hd)    return 11;
+    if (layer_idx < 0 || layer_idx >= g_fraqtl.n_layers) return 13;
+
+    const half * U_layer = ((half *) g_fraqtl.d_U)
+                         + (size_t) layer_idx * NKV * HD * HD;
+
+    fraqtl_kv_pack_v_strided(
+        v_data,
+        (half *)    v_protected,
+        (uint8_t *) v_packed,
+        (float *)   v_scale,
+        U_layer,
+        B, NKV, S, HD, g_fraqtl.k_protect,
+        v_nb[0], v_nb[1], v_nb[2], v_nb[3],
+        (cudaStream_t) stream
+    );
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: pack_v_to_slabs CUDA error: %s\n",
+                cudaGetErrorString(e));
+        return 30;
+    }
+    return 0;
+}
+
+extern "C" int fraqtl_runtime_unpack_slabs_to_scratch(
+    const void * v_protected,
+    const void * v_packed,
+    const void * v_scale,
+    void *       scratch_v,
+    int32_t      B, int32_t NKV, int32_t S, int32_t HD,
+    int32_t      layer_idx,
+    void *       stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (NKV != g_fraqtl.n_kv)  return 10;
+    if (HD  != g_fraqtl.hd)    return 11;
+    if (layer_idx < 0 || layer_idx >= g_fraqtl.n_layers) return 13;
+
+    const half * U_layer = ((half *) g_fraqtl.d_U)
+                         + (size_t) layer_idx * NKV * HD * HD;
+
+    // Use the original (non-strided) unpack kernel — both inputs and output
+    // are contiguous in this path.
+    fraqtl_kv_unpack_v(
+        (const half *)    v_protected,
+        (const uint8_t *) v_packed,
+        (const float *)   v_scale,
+        U_layer,
+        (half *) scratch_v,
+        B, NKV, S, HD, g_fraqtl.k_protect,
+        (cudaStream_t) stream
+    );
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: unpack_slabs_to_scratch CUDA error: %s\n",
+                cudaGetErrorString(e));
+        return 31;
+    }
+    return 0;
+}
+
+// ---- Sentinel-layout probe ------------------------------------------------
+extern "C" int fraqtl_runtime_sentinel_test(int B, int NKV, int S, int HD) {
+    if (B <= 0 || NKV <= 0 || S <= 0 || HD <= 0) return 1;
+    const size_t n_elements = (size_t) B * NKV * S * HD;
+    const size_t bytes      = n_elements * sizeof(half);
+
+    // Coordinate-encoded fp16 values:
+    //   value = b*1e6 + nkv*1e4 + s*100 + hd (clamped to fp16 dynamic range)
+    // Build on host, transfer, run pack/unpack with identity-U + k=HD,
+    // transfer back, compare.
+    half * h_in  = (half *) malloc(bytes);
+    half * h_out = (half *) malloc(bytes);
+    if (!h_in || !h_out) { free(h_in); free(h_out); return 2; }
+    for (int b = 0; b < B; ++b) {
+        for (int kvh = 0; kvh < NKV; ++kvh) {
+            for (int s = 0; s < S; ++s) {
+                for (int d = 0; d < HD; ++d) {
+                    const int idx = ((b * NKV + kvh) * S + s) * HD + d;
+                    const float v = (float) (b * 1000000 + kvh * 10000 + s * 100 + d);
+                    h_in[idx] = __float2half(v);
+                }
+            }
+        }
+    }
+
+    half * d_in = nullptr;
+    half * d_U  = nullptr;
+    cudaMalloc(&d_in, bytes);
+    cudaMalloc(&d_U,  (size_t) NKV * HD * HD * sizeof(half));
+    cudaMemcpy(d_in, h_in, bytes, cudaMemcpyHostToDevice);
+
+    // Identity U per kv_head.
+    std::vector<half> h_U((size_t) NKV * HD * HD, __float2half(0.0f));
+    for (int h = 0; h < NKV; ++h) {
+        for (int d = 0; d < HD; ++d) {
+            h_U[((size_t) h * HD + d) * HD + d] = __float2half(1.0f);
+        }
+    }
+    cudaMemcpy(d_U, h_U.data(), h_U.size() * sizeof(half), cudaMemcpyHostToDevice);
+
+    // Use sidecar-independent scratch slabs sized for this test.
+    const int sac     = 0;                          // k_protect = HD → no sacrifice
+    const int p_grps  = (sac + 7) / 8;              // = 0
+    const int p_bytes = p_grps * 3;                 // = 0
+    half *    d_prot   = nullptr;
+    uint8_t * d_packed = nullptr;
+    float *   d_scale  = nullptr;
+    cudaMalloc(&d_prot,   (size_t) B * NKV * S * HD * sizeof(half));
+    if (p_bytes > 0) cudaMalloc(&d_packed, (size_t) B * NKV * S * p_bytes);
+    cudaMalloc(&d_scale,  (size_t) B * NKV * S * sizeof(float));
+
+    fraqtl_kv_pack_v  (d_in, d_prot, d_packed, d_scale, d_U,
+                       B, NKV, S, HD, /*k_protect=*/HD, /*stream=*/0);
+    fraqtl_kv_unpack_v(d_prot, d_packed, d_scale, d_U, d_in,
+                       B, NKV, S, HD, /*k_protect=*/HD, /*stream=*/0);
+    cudaDeviceSynchronize();
+
+    cudaMemcpy(h_out, d_in, bytes, cudaMemcpyDeviceToHost);
+
+    int rc = 0;
+    int n_diff = 0, first_b=-1, first_kvh=-1, first_s=-1, first_d=-1;
+    float worst_diff = 0.0f;
+    for (int b = 0; b < B && rc == 0; ++b) {
+        for (int kvh = 0; kvh < NKV && rc == 0; ++kvh) {
+            for (int s = 0; s < S && rc == 0; ++s) {
+                for (int d = 0; d < HD; ++d) {
+                    const int idx = ((b * NKV + kvh) * S + s) * HD + d;
+                    const float in_v  = __half2float(h_in[idx]);
+                    const float out_v = __half2float(h_out[idx]);
+                    const float diff  = fabsf(in_v - out_v);
+                    if (diff > worst_diff) worst_diff = diff;
+                    if (diff > 1.0f) {
+                        if (n_diff == 0) {
+                            first_b = b; first_kvh = kvh; first_s = s; first_d = d;
+                        }
+                        ++n_diff;
+                    }
+                }
+            }
+        }
+    }
+    if (n_diff > 0) {
+        fprintf(stderr,
+            "fraqtl_sentinel: FAIL %d/%zu mismatches; first at "
+            "(b=%d kvh=%d s=%d d=%d); worst_diff=%.3f\n",
+            n_diff, n_elements, first_b, first_kvh, first_s, first_d, worst_diff);
+        rc = 100;
+    } else {
+        fprintf(stderr,
+            "fraqtl_sentinel: PASS %zu values bit-exact (worst_diff=%.3f)\n",
+            n_elements, worst_diff);
+    }
+
+    cudaFree(d_in); cudaFree(d_U); cudaFree(d_prot);
+    if (d_packed) cudaFree(d_packed);
+    cudaFree(d_scale);
+    free(h_in); free(h_out);
+    return rc;
+}
