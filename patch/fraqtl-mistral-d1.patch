+// FraqtlArena — one persistent cudaMalloc, sub-allocated regions.
+// internal review-committed . of FraQtl Runtime v0.
+
+#include "fraqtl_runtime_v0.h"
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+// Internal struct definition (opaque to public API).
+struct fraqtl_arena_s {
+    void * base;                 // device pointer to the single cudaMalloc
+    fraqtl_arena_config_t cfg;
+    fraqtl_arena_layout_t layout;
+    bool skip_compressed_kv;     // true when ggml owns compressed K/V
+                                 // (production); false in standalone tests.
+
+    // Per-region byte offsets from base.
+    size_t off_compressed_k;     // [n_layers, kv_size, n_kv, packed]
+    size_t off_compressed_v;
+    size_t off_uk;               // [n_layers, n_kv, head_dim, head_dim] fp16
+    size_t off_uv;
+    size_t off_scales_k;
+    size_t off_scales_v;
+    size_t off_ranks_k;
+    size_t off_ranks_v;
+    size_t off_offsets;
+    size_t off_sink_k;
+    size_t off_sink_v;
+    size_t off_residual_k;
+    size_t off_residual_v;
+    size_t off_qprime_scratch;
+    size_t off_tile_scratch;
+    size_t off_k_desc;
+    size_t off_v_desc;
+    //  global staging buffers.
+    size_t off_staging_packed;
+    size_t off_staging_scale;
+    size_t off_staging_protected;
+};
+
+// 64-byte alignment padding helper.
+static inline size_t align64(size_t x) {
+    return (x + 63) & ~((size_t)63);
+}
+
+extern "C" int fraqtl_arena_compute_layout(
+    const fraqtl_arena_config_t * cfg,
+    fraqtl_arena_layout_t       * layout
+) {
+    if (!cfg || !layout) return -1;
+
+    const size_t N_LAYERS  = cfg->n_layers;
+    const size_t N_KV      = cfg->n_kv_heads;
+    const size_t HD        = cfg->head_dim;
+    const size_t KV_SIZE   = cfg->kv_size;
+    const size_t MAX_UB    = cfg->max_n_tokens;
+    const size_t K_PROTECT = cfg->k_protect;
+    const size_t V_PROTECT = cfg->v_protect;
+    const size_t SINK_N    = cfg->sink_n;
+    const size_t RES_N     = cfg->residual_n;
+
+    // Compressed K slab per layer: per-row = (k_protect * 2 bytes) +
+    //   (padded_groups * 3 bytes for INT4 tail) + (4 bytes for fp32 scale)
+    const size_t k_tail_dims      = HD - K_PROTECT;
+    const size_t k_padded_groups  = (k_tail_dims + 7) / 8;
+    const size_t k_per_row_bytes  = K_PROTECT * 2 + k_padded_groups * 3 + 4;
+    const size_t k_slab_per_layer = k_per_row_bytes * KV_SIZE * N_KV;
+
+    const size_t v_tail_dims      = HD - V_PROTECT;
+    const size_t v_padded_groups  = (v_tail_dims + 7) / 8;
+    const size_t v_per_row_bytes  = V_PROTECT * 2 + v_padded_groups * 3 + 4;
+    const size_t v_slab_per_layer = v_per_row_bytes * KV_SIZE * N_KV;
+
+    // Sink + residual fp16 buffers per layer per modality.
+    const size_t sink_bytes_per_layer = HD * SINK_N * N_KV * sizeof(__half);
+    const size_t res_bytes_per_layer  = HD * RES_N  * N_KV * sizeof(__half);
+
+    // U_K / U_V eigenbasis arena: [n_layers, n_kv, hd, hd] fp16
+    const size_t u_arena = N_LAYERS * N_KV * HD * HD * sizeof(__half);
+
+    // K descriptor (post ): per-(layer, kvh), 64 bytes
+    const size_t k_desc = N_LAYERS * N_KV * 64;
+
+    // V descriptor: 48 bytes each.
+    //   legacy : one per (layer, kvh, slot) → kv_size × n_kv × layers
+    //   compact : one per (layer, kvh) → n_kv × layers (FRAQTL_V_DESC_COMPACT)
+    // Both fraqtl_v_row_desc and fraqtl_v_kvh_desc are 48 bytes
+    // (static_assert in fraqtl-kv.cuh). When the env flag is set, the compact
+    // table fits comfortably inside the legacy-sized region, so an over-sized
+    // arena is harmless — but sizing it correctly recovers the arena bytes too.
+    const bool v_desc_compact_arena = []() {
+        const char * e = std::getenv("FRAQTL_V_DESC_COMPACT");
+        return (e != nullptr) && (*e != '\0') && (*e != '0');
+    }();
+    const size_t v_desc = v_desc_compact_arena
+        ? (N_LAYERS * N_KV * 48)
+        : (N_LAYERS * KV_SIZE * N_KV * 48);
+
+    // Scales / ranks / offsets
+    const size_t k_ranks  = N_LAYERS * N_KV * sizeof(int32_t);
+    const size_t v_ranks  = N_LAYERS         * sizeof(int32_t);
+    const size_t offsets  = N_LAYERS * 8     * sizeof(int32_t);
+    const size_t scales_k = N_LAYERS * N_KV  * sizeof(float);  // per-(layer,kvh) global scale
+    const size_t scales_v = N_LAYERS * N_KV  * sizeof(float);
+
+    //  fix — qprime is sized per-TOTAL-HEAD (Q-side), not
+    // per-kvh, because the K dispatcher allocates `n_q × n_heads × n_seqs ×
+    // HD × float` for Q'. For Qwen 7B at MAX_UB=2048: 2048 × 28 × 128 × 4 =
+    // 28 MiB. Earlier v0 used n_kv_heads which gave only 4 MiB and would
+    // crash on first attention call.
+    const size_t N_HEADS_Q = (size_t) cfg->n_heads_q;
+    const size_t qprime    = MAX_UB * N_HEADS_Q * HD * sizeof(float);
+    const size_t tile_sc   = qprime;  // conservative symmetric estimate
+
+    layout->compressed_k_bytes  = N_LAYERS * k_slab_per_layer;
+    layout->compressed_v_bytes  = N_LAYERS * v_slab_per_layer;
+    layout->protected_k_bytes   = 0;   // protected dims are inside the slab
+    layout->protected_v_bytes   = 0;
+    layout->uk_arena_bytes      = u_arena;
+    layout->uv_arena_bytes      = u_arena;
+    layout->scales_k_bytes      = scales_k;
+    layout->scales_v_bytes      = scales_v;
+    layout->ranks_bytes         = k_ranks + v_ranks;
+    layout->offsets_bytes       = offsets;
+    layout->sink_k_bytes        = N_LAYERS * sink_bytes_per_layer;
+    layout->sink_v_bytes        = N_LAYERS * sink_bytes_per_layer;
+    layout->residual_k_bytes    = N_LAYERS * res_bytes_per_layer;
+    layout->residual_v_bytes    = N_LAYERS * res_bytes_per_layer;
+    layout->qprime_scratch_bytes = qprime;
+    layout->tile_scratch_bytes   = tile_sc;
+
+    //  global staging buffers sized to match the
+    // existing cudaMalloc formulas in fraqtl_runtime_setup (fraqtl-kv.cu).
+    // scratch_rows = kv_size * n_kv_heads.
+    const size_t scratch_rows         = KV_SIZE * N_KV;
+    const size_t staging_packed       = scratch_rows * k_padded_groups * 3;
+    const size_t staging_scale        = scratch_rows * sizeof(float);
+    const size_t staging_protected    = scratch_rows * K_PROTECT * sizeof(__half);
+    layout->staging_packed_bytes      = staging_packed;
+    layout->staging_scale_bytes       = staging_scale;
+    layout->staging_protected_bytes   = staging_protected;
+
+    //  — arena-side dead-region squeeze.
+    // L4 (tile_scratch): the arena reserves a tile_scratch region the same
+    // size as qprime_scratch (~32 MiB at Mistral ub=2048) but NO accessor
+    // function reads it. Confirmed dead by exhaustive grep. Always zero.
+    // L3-in-arena (staging): when FRAQTL_SKIP_DEAD_STAGING=1 is set,
+    // fraqtl-kv.cu skips the non-arena cudaMallocs of d_packed/d_scale/
+    // d_protected (since those slabs are read only by the Day-11
+    // roundtrip_v path, which is std::abort-fenced in ONLINE mode at
+    // fattn.cu:1487). The same logic applies to the arena reservation
+    // but until now the arena was still reserving these bytes. Skip the
+    // arena reservation too when L3 is set.
+    // Sizing at Mistral 128K: ~104 MiB staging + ~32 MiB tile_scratch
+    // = ~136 MiB squeezed.
+    // Sizing at Mistral 256K: ~208 MiB staging + ~32 MiB = ~240 MiB.
+    // Sizing at Mistral 512K: ~416 MiB staging + ~32 MiB = ~448 MiB.
+    // Scales with context — the longer we go, the more bytes recovered.
+    layout->tile_scratch_bytes = 0;
+    {
+        const char * skip_staging_env = std::getenv("FRAQTL_SKIP_DEAD_STAGING");
+        const bool skip_staging = skip_staging_env
+                                  && skip_staging_env[0] != '\0'
+                                  && skip_staging_env[0] != '0';
+        if (skip_staging) {
+            layout->staging_packed_bytes    = 0;
+            layout->staging_scale_bytes     = 0;
+            layout->staging_protected_bytes = 0;
+        }
+    }
+
+    //  ABI expose the descriptor regions that are
+    // already summed into total_bytes (k_desc + v_desc) so the accounting
+    // ledger is complete (was short by ~768 MiB v_desc at Mistral 7B/64K).
+    layout->k_desc_bytes              = k_desc;
+    layout->v_desc_bytes              = v_desc;
+
+    // Per-region 64-byte alignment padding (20 regions max: 17 original + 3 staging).
+    const size_t alignment_padding = 20 * 64;
+
+    size_t total = 0;
+    total += align64(layout->compressed_k_bytes);
+    total += align64(layout->compressed_v_bytes);
+    total += align64(layout->uk_arena_bytes);
+    total += align64(layout->uv_arena_bytes);
+    total += align64(layout->sink_k_bytes);
+    total += align64(layout->sink_v_bytes);
+    total += align64(layout->residual_k_bytes);
+    total += align64(layout->residual_v_bytes);
+    total += align64(layout->scales_k_bytes);
+    total += align64(layout->scales_v_bytes);
+    total += align64(layout->ranks_bytes);
+    total += align64(layout->offsets_bytes);
+    total += align64(k_desc);
+    total += align64(v_desc);
+    total += align64(layout->qprime_scratch_bytes);
+    total += align64(layout->tile_scratch_bytes);
+    total += align64(layout->staging_packed_bytes);
+    total += align64(layout->staging_scale_bytes);
+    total += align64(layout->staging_protected_bytes);
+    total += alignment_padding;
+    layout->total_bytes = total;
+    return 0;
+}
+
+extern "C" int fraqtl_arena_create(
+    const fraqtl_arena_config_t * cfg,
+    fraqtl_arena_t             ** out_arena
+) {
+    // Backward-compat: full layout, used by standalone tests.
+    fraqtl_arena_opts_t opts = {};
+    opts.skip_compressed_kv = 0;
+    return fraqtl_arena_create_with_opts(cfg, &opts, out_arena);
+}
+
+extern "C" int fraqtl_arena_create_with_opts(
+    const fraqtl_arena_config_t * cfg,
+    const fraqtl_arena_opts_t   * opts,
+    fraqtl_arena_t             ** out_arena
+) {
+    if (!cfg || !opts || !out_arena) return -1;
+
+    fraqtl_arena_t * arena = (fraqtl_arena_t *) calloc(1, sizeof(fraqtl_arena_t));
+    if (!arena) return -2;
+
+    arena->cfg = *cfg;
+    arena->skip_compressed_kv = (opts->skip_compressed_kv != 0);
+    int rc = fraqtl_arena_compute_layout(cfg, &arena->layout);
+    if (rc != 0) { free(arena); return rc; }
+
+    //  when ggml owns the compressed K/V cache
+    // (production path), drop the arena's reservation for those regions
+    // BEFORE computing offsets. Saves ~1456 MiB on Qwen 7B / 64K. Pre-flight
+    // grep audit () confirmed ZERO production callers of
+    // fraqtl_arena_compressed_k/v — they're standalone-test only.
+    if (arena->skip_compressed_kv) {
+        const size_t shrink = align64(arena->layout.compressed_k_bytes)
+                            + align64(arena->layout.compressed_v_bytes);
+        arena->layout.total_bytes -= shrink;
+        arena->layout.compressed_k_bytes = 0;
+        arena->layout.compressed_v_bytes = 0;
+    }
+
+    // ONE cudaMalloc for the entire arena.
+    cudaError_t e = cudaMalloc(&arena->base, arena->layout.total_bytes);
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl_arena_create: cudaMalloc %zu bytes failed: %s\n",
+                arena->layout.total_bytes, cudaGetErrorString(e));
+        free(arena);
+        return (int) e;
+    }
+
+    // Zero-init (safety; small one-time cost vs lifetime).
+    cudaMemset(arena->base, 0, arena->layout.total_bytes);
+
+    // Lay out offsets in order, 64-byte aligned.
+    size_t off = 0;
+    arena->off_compressed_k = off; off = align64(off + arena->layout.compressed_k_bytes);
+    arena->off_compressed_v = off; off = align64(off + arena->layout.compressed_v_bytes);
+    arena->off_uk           = off; off = align64(off + arena->layout.uk_arena_bytes);
+    arena->off_uv           = off; off = align64(off + arena->layout.uv_arena_bytes);
+    arena->off_sink_k       = off; off = align64(off + arena->layout.sink_k_bytes);
+    arena->off_sink_v       = off; off = align64(off + arena->layout.sink_v_bytes);
+    arena->off_residual_k   = off; off = align64(off + arena->layout.residual_k_bytes);
+    arena->off_residual_v   = off; off = align64(off + arena->layout.residual_v_bytes);
+    arena->off_scales_k     = off; off = align64(off + arena->layout.scales_k_bytes);
+    arena->off_scales_v     = off; off = align64(off + arena->layout.scales_v_bytes);
+    arena->off_ranks_k      = off; off = align64(off + (cfg->n_layers * cfg->n_kv_heads * sizeof(int32_t)));
+    arena->off_ranks_v      = off; off = align64(off + (cfg->n_layers * sizeof(int32_t)));
+    arena->off_offsets      = off; off = align64(off + arena->layout.offsets_bytes);
+    arena->off_k_desc       = off; off = align64(off + (size_t)(cfg->n_layers * cfg->n_kv_heads * 64));
+    //  advance by layout.v_desc_bytes (compact-aware,
+    // computed in fraqtl_arena_compute_layout). Hardcoding the legacy
+    // kv_size*n_kv*48 here while compute_layout sized the region smaller would
+    // place every later region past total_bytes.
+    arena->off_v_desc       = off; off = align64(off + arena->layout.v_desc_bytes);
+    arena->off_qprime_scratch = off; off = align64(off + arena->layout.qprime_scratch_bytes);
+    arena->off_tile_scratch   = off; off = align64(off + arena->layout.tile_scratch_bytes);
+    //  global staging buffers.
+    arena->off_staging_packed     = off; off = align64(off + arena->layout.staging_packed_bytes);
+    arena->off_staging_scale      = off; off = align64(off + arena->layout.staging_scale_bytes);
+    arena->off_staging_protected  = off; off = align64(off + arena->layout.staging_protected_bytes);
+
+    if (off > arena->layout.total_bytes) {
+        fprintf(stderr, "fraqtl_arena_create: layout overflow off=%zu total=%zu\n",
+                off, arena->layout.total_bytes);
+        cudaFree(arena->base);
+        free(arena);
+        return -3;
+    }
+
+    fprintf(stderr,
+        "fraqtl: ARENA_CREATED total_bytes=%zu (%.2f MiB) ptr=%p "
+        "n_layers=%d n_kv=%d hd=%d kv_size=%d residual_n=%d sink_n=%d\n",
+        arena->layout.total_bytes,
+        arena->layout.total_bytes / (1024.0 * 1024.0),
+        arena->base,
+        cfg->n_layers, cfg->n_kv_heads, cfg->head_dim, cfg->kv_size,
+        cfg->residual_n, cfg->sink_n);
+    fflush(stderr);
+
+    *out_arena = arena;
+    return 0;
+}
+
+// Per-region accessors.
+static inline void * arena_ptr(const fraqtl_arena_t * a, size_t off) {
+    return (void *)((char *)a->base + off);
+}
+
+extern "C" void * fraqtl_arena_compressed_k(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    //  when ggml owns compressed K/V, this region
+    // is NOT in the arena. Returning a non-null pointer here would aim into
+    // off_uk's slot (offset 0), silently corrupting the U_K matrix on read.
+    // Fail loudly instead.
+    if (a->skip_compressed_kv) return nullptr;
+    const size_t k_tail_dims = a->cfg.head_dim - a->cfg.k_protect;
+    const size_t k_padded_groups = (k_tail_dims + 7) / 8;
+    const size_t k_per_row_bytes = a->cfg.k_protect * 2 + k_padded_groups * 3 + 4;
+    const size_t per_layer = k_per_row_bytes * a->cfg.kv_size * a->cfg.n_kv_heads;
+    return (void *)((char *)a->base + a->off_compressed_k + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_compressed_v(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    if (a->skip_compressed_kv) return nullptr;  // see compressed_k note
+    const size_t v_tail_dims = a->cfg.head_dim - a->cfg.v_protect;
+    const size_t v_padded_groups = (v_tail_dims + 7) / 8;
+    const size_t v_per_row_bytes = a->cfg.v_protect * 2 + v_padded_groups * 3 + 4;
+    const size_t per_layer = v_per_row_bytes * a->cfg.kv_size * a->cfg.n_kv_heads;
+    return (void *)((char *)a->base + a->off_compressed_v + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_residual_k(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    const size_t per_layer = a->cfg.head_dim * a->cfg.residual_n * a->cfg.n_kv_heads * sizeof(__half);
+    return (void *)((char *)a->base + a->off_residual_k + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_residual_v(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    const size_t per_layer = a->cfg.head_dim * a->cfg.residual_n * a->cfg.n_kv_heads * sizeof(__half);
+    return (void *)((char *)a->base + a->off_residual_v + layer * per_layer);
+}
+
+//  sink accessors (per-layer, mirror of residual).
+extern "C" void * fraqtl_arena_sink_k(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    const size_t per_layer = a->cfg.head_dim * a->cfg.sink_n * a->cfg.n_kv_heads * sizeof(__half);
+    return (void *)((char *)a->base + a->off_sink_k + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_sink_v(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    const size_t per_layer = a->cfg.head_dim * a->cfg.sink_n * a->cfg.n_kv_heads * sizeof(__half);
+    return (void *)((char *)a->base + a->off_sink_v + layer * per_layer);
+}
+
+//  descriptor + ranks accessors.
+// Arena reserved these in layout (off_v_desc, off_k_desc, off_ranks_k).
+// Per-layer sizes match the cudaMalloc formulas in fraqtl-kv.cu register_layer_*_slabs.
+extern "C" void * fraqtl_arena_v_desc(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    //  per-layer stride must match the v_desc region sizing
+    // in fraqtl_arena_compute_layout: compact = n_kv * 48, legacy = kv_size *
+    // n_kv * 48. Both descriptor structs are 48 bytes. Mismatching the stride
+    // here would walk layer 1+ past the reserved region.
+    const bool v_desc_compact_arena = []() {
+        const char * e = std::getenv("FRAQTL_V_DESC_COMPACT");
+        return (e != nullptr) && (*e != '\0') && (*e != '0');
+    }();
+    const size_t per_layer = v_desc_compact_arena
+        ? ((size_t) a->cfg.n_kv_heads * 48)
+        : ((size_t) a->cfg.kv_size * a->cfg.n_kv_heads * 48);
+    return (void *)((char *)a->base + a->off_v_desc + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_k_desc(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    // collapsed: n_descs = n_kv per layer. sizeof(fraqtl_k_kvh_desc) = 64.
+    const size_t per_layer = (size_t) a->cfg.n_kv_heads * 64;
+    return (void *)((char *)a->base + a->off_k_desc + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_k_ranks(fraqtl_arena_t * a, int32_t layer) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers) return nullptr;
+    const size_t per_layer = (size_t) a->cfg.n_kv_heads * sizeof(int32_t);
+    return (void *)((char *)a->base + a->off_ranks_k + layer * per_layer);
+}
+
+extern "C" void * fraqtl_arena_uk(fraqtl_arena_t * a, int32_t layer, int32_t kvh) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers ||
+        kvh < 0 || kvh >= a->cfg.n_kv_heads) return nullptr;
+    const size_t per_head = a->cfg.head_dim * a->cfg.head_dim * sizeof(__half);
+    const size_t per_layer = a->cfg.n_kv_heads * per_head;
+    return (void *)((char *)a->base + a->off_uk + layer * per_layer + kvh * per_head);
+}
+
+extern "C" void * fraqtl_arena_uv(fraqtl_arena_t * a, int32_t layer, int32_t kvh) {
+    if (!a || layer < 0 || layer >= a->cfg.n_layers ||
+        kvh < 0 || kvh >= a->cfg.n_kv_heads) return nullptr;
+    const size_t per_head = a->cfg.head_dim * a->cfg.head_dim * sizeof(__half);
+    const size_t per_layer = a->cfg.n_kv_heads * per_head;
+    return (void *)((char *)a->base + a->off_uv + layer * per_layer + kvh * per_head);
+}
+
+extern "C" void * fraqtl_arena_qprime(fraqtl_arena_t * a) {
+    if (!a) return nullptr;
+    return (void *)((char *)a->base + a->off_qprime_scratch);
+}
+
+//  global staging-buffer accessors.
+//  — return nullptr when the region is zero-sized (L3-in-arena
+// active). Callers (fraqtl-kv.cu binding path) treat nullptr as "L3
+// sentinel" and skip without failing.
+extern "C" void * fraqtl_arena_staging_packed(fraqtl_arena_t * a) {
+    if (!a) return nullptr;
+    if (a->layout.staging_packed_bytes == 0) return nullptr;
+    return (void *)((char *)a->base + a->off_staging_packed);
+}
+
+extern "C" void * fraqtl_arena_staging_scale(fraqtl_arena_t * a) {
+    if (!a) return nullptr;
+    if (a->layout.staging_scale_bytes == 0) return nullptr;
+    return (void *)((char *)a->base + a->off_staging_scale);
+}
+
+extern "C" void * fraqtl_arena_staging_protected(fraqtl_arena_t * a) {
+    if (!a) return nullptr;
