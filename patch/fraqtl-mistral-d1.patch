+            if (d < stride) {
+                const float other = red_buf[d + stride];
+                if (other > red_buf[d]) red_buf[d] = other;
+            }
+            __syncthreads();
+        }
+        const float tile_max = red_buf[0];
+        const float m_new    = (tile_max > m) ? tile_max : m;
+
+        // ---- Per-tile softmax exp + sum -----------------------------------
+        if (d < tile_n) {
+            P_tile[d] = expf(KQ_tile[d] - m_new);
+        } else if (d < BLOCK_S) {
+            P_tile[d] = 0.0f;
+        }
+        __syncthreads();
+
+        if (d < BLOCK_S) red_buf[d] = P_tile[d];
+        else if (d < HD) red_buf[d] = 0.0f;
+        __syncthreads();
+        for (int stride = HD/2; stride > 0; stride >>= 1) {
+            if (d < stride) red_buf[d] += red_buf[d + stride];
+            __syncthreads();
