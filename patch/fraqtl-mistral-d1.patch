+// ---- + stub -----------------------------------------------------------
+
+extern "C" void fraqtl_attn_v_fused(
+    const half*    /*attn_weights*/,
+    const half*    /*v_protected*/,
+    const uint8_t* /*v_packed*/,
+    const float*   /*v_scale*/,
+    const half*    /*eigenbasis*/,
+    half*          /*output*/,
+    int /*B*/, int /*NKV*/, int /*q_len*/, int /*k_len*/, int /*HD*/, int /*K*/,
+    cudaStream_t /*stream*/
+) {
+    // +.
+}
+
+// ===========================================================================
+// K-side set_rows bypass hook
+// Mirrors V's Phase-8A from-src hook (fraqtl_runtime_pack_v_set_rows_from_src_hook)
+// but for K writes.
+// Per the locked v0 design:
+//   - For each (token t, kv_head h) pair:
+//       C_K = K_row[h, :] @ U_K[layer, h] (HD-dim projection)
+//       prot[h, idx, 0..R) = fp16(C_K[0..R)) (protected slab)
+//       scale[h, idx] = absmax(C_K[R..HD)) / 7 (per-row INT4 scale)
+//       pack[h, idx, *] = INT4 quantized C_K[R..HD) (canonical Gate 0b)
+//   - When R == HD (uncompressible head): skip INT4 tail entirely.
+//     scale gets a placeholder 1.0 so any later dequant has a defined value.
+// Each block handles one (t, kvh) pair via descriptor arena lookup.
+// ===========================================================================
+template <typename TIdx>
+__global__ void fraqtl_kv_pack_kernel_set_rows_k_from_src(
+    const float * __restrict__ src0,                  // F32, [n_tokens, NKV*HD] flattened
+    const TIdx *  __restrict__ k_idxs,                // [n_tokens]
+    const fraqtl_k_kvh_desc * __restrict__ descs,     // [NKV] per layer
+    int n_tokens, int NKV, int kv_size, int HD,
+    size_t src0_row_stride_bytes
+) {
+    extern __shared__ float smem[];
+    float * C_shared    = smem;
+    float * scale_bcast = smem + HD;
+    float * reduce_buf  = smem + HD + 1;
+
+    const int t   = blockIdx.x;
+    const int kvh = blockIdx.y;
+    if (t >= n_tokens || kvh >= NKV) return;
+    const int tid = threadIdx.x;
+
+    const TIdx idx_val = k_idxs[t];
+    const int  idx     = (int) idx_val;
+    if (idx < 0 || idx >= kv_size) return;
+
+    // descriptor is per-(layer, kvh), not per-(layer, slot, kvh).
+    fraqtl_k_kvh_desc d = descs[kvh];
+    const int rank_h   = d.rank;
+    const int sac_dims = HD - rank_h;
+
+    // Source K row for this kvh: [t]-th row, then offset to head kvh.
+    const char *  src_row = (const char *) src0 + (size_t) t * src0_row_stride_bytes;
+    const float * src_kvh = (const float *)(src_row + (size_t) kvh * HD * sizeof(float));
+
+    // C_K[c] = sum_d K[d] * U_K_head[d, c]
+    // U_K layout: row-major [HD (input axis d), HD (output axis c)] — same
+    // as 's apply_U_K_to_Q kernel.
+    for (int c = tid; c < HD; c += blockDim.x) {
+        float acc = 0.0f;
+        for (int dd = 0; dd < HD; ++dd) {
+            acc += src_kvh[dd] * __half2float(d.U_K_head[(size_t) dd * HD + c]);
+        }
+        C_shared[c] = acc;
+    }
+    __syncthreads();
+
+    // protected slab — write top rank_h coefficients in fp16.
+    // per-slot row pointer derived from base + slot * slab_stride.
+    // Descriptor pointers are typed `const *` for the read-side dequant
+    // contract; the pack kernel owns the layout and casts to writable.
+    // Runtime invariant: pack-kernel and read-side never run concurrently
+    // on the same row.
+    half * prot_row_w = const_cast<half *>(d.prot_base)
+                      + (size_t) idx * (size_t) d.slab_row_stride_halves;
+    for (int c = tid; c < rank_h; c += blockDim.x) {
+        prot_row_w[c] = __float2half(C_shared[c]);
+    }
+
+    if (sac_dims > 0) {
+        // per-row absmax over tail C_K[rank_h..HD).
+        float local_max = 0.0f;
+        for (int c = rank_h + tid; c < HD; c += blockDim.x) {
+            const float a = fabsf(C_shared[c]);
+            if (a > local_max) local_max = a;
+        }
+        reduce_buf[tid] = local_max;
+        __syncthreads();
+        for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+            if (tid < stride) {
+                const float other = reduce_buf[tid + stride];
+                if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+            }
+            __syncthreads();
+        }
+        if (tid == 0) {
+            //  S2 port: scale divisor depends on tail bit width.
+            //   INT4: |q|max = 7 (q in [-8, 7])
+            //   INT3: |q|max = 3 (q in [-4, 3])
+            const float scale_div = (d.tail_bits == 3) ? 3.0f : 7.0f;
+            float scale = reduce_buf[0] / scale_div;
+            if (scale < 1e-10f) scale = 1e-10f;
+            scale_bcast[0]   = scale;
+            float * scale_row_w = const_cast<float *>(d.scale_base) + (size_t) idx;
+            scale_row_w[0]      = scale;
+        }
+        __syncthreads();
+        const float scale = scale_bcast[0];
+
+        // pack — dispatch on tail_bits.
+        //   INT3 (S2 exp16 path): 8 indices per 3 bytes, MSB-first, matches V INT3 layout
+        //                         (fraqtl-kv.cu:1044-1064). q ∈ [-4, 3] stored as u = q + 4.
+        //   INT4 (legacy path): 2 indices per byte. HIGH nibble = first (lower coefficient index),
+        //                         LOW nibble = second. q ∈ [-8, 7] stored as u = q + 8.
+        if (d.pack_base != nullptr) {
+            uint8_t * packed_row = const_cast<uint8_t *>(d.pack_base)
+                                 + (size_t) idx * (size_t) d.slab_pack_stride_bytes;
+            if (d.tail_bits == 3) {
+                // INT3 pack — mirror of V's INT3 pack pattern (8-into-3, MSB-first).
+                // d.pack_stride is now in BYTES = ceil(sac_dims/8) * 3.
+                const int n_groups = (sac_dims + 7) / 8;
+                for (int g = tid; g < n_groups; g += blockDim.x) {
+                    int idx8[8] = {4, 4, 4, 4, 4, 4, 4, 4};  // q=0 default (u = q+4 = 4)
+                    #pragma unroll
+                    for (int j = 0; j < 8; ++j) {
+                        const int e = g * 8 + j;
+                        if (e < sac_dims) {
+                            int q = (int) rintf(C_shared[rank_h + e] / scale);
+                            if (q < -4) q = -4;
+                            if (q >  3) q =  3;
+                            idx8[j] = q + 4;
+                        }
+                    }
+                    const uint8_t b0 = (idx8[0] << 5) | (idx8[1] << 2) | (idx8[2] >> 1);
+                    const uint8_t b1 = ((idx8[2] & 1) << 7) | (idx8[3] << 4) |
+                                       (idx8[4] << 1) | (idx8[5] >> 2);
+                    const uint8_t b2 = ((idx8[5] & 0x3) << 6) | (idx8[6] << 3) | idx8[7];
+                    packed_row[g * 3 + 0] = b0;
+                    packed_row[g * 3 + 1] = b1;
+                    packed_row[g * 3 + 2] = b2;
+                }
+            } else {
+                // INT4 pack — legacy 2-nibble path.
+                const int n_bytes = d.pack_stride;
+                for (int g = tid; g < n_bytes; g += blockDim.x) {
+                    const int e0 = 2 * g;
+                    const int e1 = 2 * g + 1;
+                    int u0 = 8;  // q=0 default for odd-tail padding
+                    int u1 = 8;
+                    if (e0 < sac_dims) {
+                        int q = (int) rintf(C_shared[rank_h + e0] / scale);
+                        if (q < -8) q = -8;
+                        if (q >  7) q =  7;
+                        u0 = q + 8;
+                    }
+                    if (e1 < sac_dims) {
+                        int q = (int) rintf(C_shared[rank_h + e1] / scale);
+                        if (q < -8) q = -8;
+                        if (q >  7) q =  7;
+                        u1 = q + 8;
+                    }
+                    packed_row[g] = (uint8_t) ((u0 << 4) | (u1 & 0x0F));
+                }
+            }
+        }
+    } else {
+        // Uncompressible head (R == HD): no INT4 tail. Write a placeholder
+        // scale of 1.0 so any read of scale_base[idx] returns a defined value.
+        if (tid == 0) {
+            float * scale_row_w_rhd = const_cast<float *>(d.scale_base) + (size_t) idx;
+            scale_row_w_rhd[0]      = 1.0f;
+        }
+    }
+}
+
+extern "C" void fraqtl_kv_pack_k_set_rows_from_src_i64(
+    const float *   src0,
+    const int64_t * k_idxs,
+    const fraqtl_k_kvh_desc * descs,
+    int n_tokens, int NKV, int kv_size, int HD,
+    size_t src0_row_stride_bytes,
+    cudaStream_t stream
+) {
+    if (n_tokens <= 0 || NKV <= 0) return;
+    const size_t shmem = (size_t)(HD + 1 + BLOCK_THREADS) * sizeof(float);
+    const dim3 grid((unsigned) n_tokens, (unsigned) NKV, 1);
+    fraqtl_kv_pack_kernel_set_rows_k_from_src<int64_t><<<grid, BLOCK_THREADS, shmem, stream>>>(
+        src0, k_idxs, descs, n_tokens, NKV, kv_size, HD, src0_row_stride_bytes);
+}
+
+extern "C" void fraqtl_kv_pack_k_set_rows_from_src_i32(
+    const float *   src0,
+    const int32_t * k_idxs,
+    const fraqtl_k_kvh_desc * descs,
+    int n_tokens, int NKV, int kv_size, int HD,
+    size_t src0_row_stride_bytes,
+    cudaStream_t stream
+) {
+    if (n_tokens <= 0 || NKV <= 0) return;
+    const size_t shmem = (size_t)(HD + 1 + BLOCK_THREADS) * sizeof(float);
+    const dim3 grid((unsigned) n_tokens, (unsigned) NKV, 1);
+    fraqtl_kv_pack_kernel_set_rows_k_from_src<int32_t><<<grid, BLOCK_THREADS, shmem, stream>>>(
+        src0, k_idxs, descs, n_tokens, NKV, kv_size, HD, src0_row_stride_bytes);
+}
+
+// Return codes (mirroring V's from-src hook for parser consistency):
+//   0 handled — set-rows.cu skips the standard kernel write
+//   13 cache shape / layer index out of range
+//   14 K slabs (descriptors) not registered for this layer
+//   15 d_U_K not yet set — descriptors carry null U_K_head
+//   17 n_tokens > kv_size
+//   99 kernel launch CUDA error
+extern "C" int fraqtl_runtime_pack_k_set_rows_from_src_hook(
+    const void *    src0_data,
+    const int64_t * src0_ne,
+    const size_t  * src0_nb,
+    const void *    k_idxs_data,
+    int32_t         k_idxs_dtype,
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (n_tokens <= 0)    return 0;
+    if (g_fraqtl.mode != fraqtl_runtime_state::MODE_ONLINE) return 0;
+
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS ||
+        (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers))
+    {
+        fprintf(stderr,
+            "fraqtl: K_set_rows_from_src_hook layer_idx=%d out of range — ABORT\n",
+            layer_idx);
+        fflush(stderr);
+        return 13;
+    }
+
+    const fraqtl_k_kvh_desc * descs = g_fraqtl.layer_k_descs[layer_idx];
+    int kv_size = g_fraqtl.layer_kv_size[layer_idx];
+    if (descs == nullptr || kv_size <= 0) {
+        // K slabs not yet registered for this layer (e.g. hasn't
+        // wired first-class K storage yet, or this layer is fp16-only).
+        // Return non-zero so set-rows.cu falls through to the standard kernel.
+        return 14;
+    }
+    if (g_fraqtl.d_U_K == nullptr) {
+        fprintf(stderr,
+            "fraqtl: K_set_rows_from_src_hook layer %d: d_U_K not set — "
+            "descriptors carry null U_K_head, cannot project. Falling back.\n",
+            layer_idx);
+        fflush(stderr);
+        return 15;
+    }
+
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+
+    if (src0_ne[0] != (int64_t) NKV * (int64_t) HD) {
+        fprintf(stderr,
+            "fraqtl: K_set_rows_from_src_hook layer %d: src0 ne[0]=%lld != NKV*HD=%d\n",
+            layer_idx, (long long) src0_ne[0], NKV * HD);
+        fflush(stderr);
+        return 13;
+    }
+    if (n_tokens > kv_size) {
+        fprintf(stderr,
+            "fraqtl: K_set_rows_from_src_hook layer %d: n_tokens=%d > kv_size=%d\n",
+            layer_idx, n_tokens, kv_size);
+        fflush(stderr);
+        return 17;
+    }
+
+    // Hoisted: cu_stream is needed by the first-call diagnostic block below
+    // (cudaStreamSynchronize before reading post-RoPE K) AND by the pack
+    // kernel launch. Declared once here.
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+
+    // First-call-per-layer diagnostic carrying rank summary so a receipt
+    // parser can confirm:
+    //   - the hook fired
+    //   - per-head ranks landed (incl. R==HD uncompressible heads)
+    static unsigned char fr_k_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!fr_k_logged[layer_idx]) {
+        int min_r = HD, max_r = 0, n_uncompressible = 0;
+        long sum_r = 0;
+        for (int h = 0; h < NKV; ++h) {
+            const int r = g_fraqtl.layer_k_ranks[layer_idx][h];
+            if (r < min_r) min_r = r;
+            if (r > max_r) max_r = r;
+            if (r == HD)   n_uncompressible++;
+            sum_r += r;
+        }
+        fprintf(stderr,
+            "fraqtl: K_PACK_FIRST_CALL layer=%d n_tokens=%d kv_size=%d "
+            "NKV=%d HD=%d k_idxs_dtype=%d "
+            "ranks=[min=%d,max=%d,avg=%.2f,uncompressible=%d/%d] "
+            "src0_ne=[%lld,%lld,%lld,%lld] src0_nb=[%zu,%zu,%zu,%zu]\n",
+            layer_idx, n_tokens, kv_size, NKV, HD, k_idxs_dtype,
+            min_r, max_r, NKV > 0 ? (double) sum_r / NKV : 0.0,
+            n_uncompressible, NKV,
+            (long long) src0_ne[0], (long long) src0_ne[1],
+            (long long) src0_ne[2], (long long) src0_ne[3],
+            src0_nb[0], src0_nb[1], src0_nb[2], src0_nb[3]);
+        fflush(stderr);
+
+        // ===========================================================
+        // Diagnostic C (internal).
+        // Dump first 8 floats of src0 (token 0, kvh 0) on this first
+        // call. The K_src0 buffer holds the post-RoPE K floats fed
+        // into the pack kernel.
+        // CRITICAL: cudaStreamSynchronize(cu_stream) FIRST. The RoPE
+        // kernel that wrote src0_data ran on cu_stream (the dispatcher
+        // stream); cudaMemcpy on the DEFAULT stream races and reads
+        // stale memory for early layers (visible in the first round of
+        // Diag C: layers 1, 2, 3 all returned identical src0_first8
+        // because ggml's allocator gave them the same address that
+        // hadn't been overwritten yet by the time the memcpy ran).
+        // Sync ensures we see the ACTUAL post-RoPE K values that the
+        // pack kernel will read.
+        {
+            cudaStreamSynchronize(cu_stream);
+
+            const float * src0_f = (const float *) src0_data;
+            float K_dump[8] = {0,0,0,0,0,0,0,0};
+            cudaMemcpy(K_dump, src0_f, sizeof(K_dump), cudaMemcpyDeviceToHost);
+
+            // Norm estimate: read first NKV*HD floats from token 0.
+            const int n_norm = NKV * HD;  // 512 for Qwen 7B
+            std::vector<float> row_buf(n_norm);
+            cudaMemcpy(row_buf.data(), src0_f, n_norm * sizeof(float),
+                       cudaMemcpyDeviceToHost);
+            float l2 = 0.0f, abs_max = 0.0f;
+            for (int i = 0; i < n_norm; ++i) {
+                l2      += row_buf[i] * row_buf[i];
+                if (fabsf(row_buf[i]) > abs_max) abs_max = fabsf(row_buf[i]);
+            }
+            l2 = sqrtf(l2);
+
+            fprintf(stderr,
+                "fraqtl: K_SRC0_DUMP layer=%d token=0 "
+                "src0_first8= %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f "
+                "row0_L2=%.4f row0_abs_max=%.4f n_norm=%d "
+                "(expect L2~sqrt(NKV*HD)*|K|; abs_max should be O(1)-O(10) for fp16 K; "
+                "stream-synced)\n",
+                layer_idx,
+                (double) K_dump[0], (double) K_dump[1], (double) K_dump[2], (double) K_dump[3],
+                (double) K_dump[4], (double) K_dump[5], (double) K_dump[6], (double) K_dump[7],
+                (double) l2, (double) abs_max, n_norm);
+            fflush(stderr);
+        }
+
+        fr_k_logged[layer_idx] = 1;
+    }
+
+    // cu_stream hoisted above the diagnostic block.
+    const size_t src0_row_stride_bytes = src0_nb[1];
+
+    if (k_idxs_dtype == 0) {
+        fraqtl_kv_pack_k_set_rows_from_src_i64(
+            (const float *)   src0_data,
+            (const int64_t *) k_idxs_data,
+            descs, n_tokens, NKV, kv_size, HD,
+            src0_row_stride_bytes, cu_stream);
+    } else {
+        fraqtl_kv_pack_k_set_rows_from_src_i32(
+            (const float *)   src0_data,
+            (const int32_t *) k_idxs_data,
+            descs, n_tokens, NKV, kv_size, HD,
+            src0_row_stride_bytes, cu_stream);
+    }
+
+    // K-side double-write into fp16 sink + residual buffers.
+    // Same stream as the pack kernel above (cu_stream); kernel-ordered so
+    // the compressed slab is written first and any modular residual
+    // overwrite displaces a previously-compressed entry.
+    {
+        const bool step59_active =
+            (g_fraqtl.sink_n > 0 || g_fraqtl.residual_n > 0)
+            && (g_fraqtl.sink_K_buf[layer_idx] != nullptr
+                || g_fraqtl.residual_K_buf[layer_idx] != nullptr);
+        if (step59_active) {
+            if (k_idxs_dtype == 0) {
+                fraqtl_step59_double_write_dispatch_i64(
+                    (const float *)   src0_data,
+                    (const int64_t *) k_idxs_data,
+                    g_fraqtl.sink_K_buf[layer_idx],
+                    g_fraqtl.residual_K_buf[layer_idx],
+                    n_tokens, NKV, HD,
+                    g_fraqtl.sink_n, g_fraqtl.residual_n,
+                    src0_row_stride_bytes, cu_stream);
+            } else {
+                fraqtl_step59_double_write_dispatch_i32(
+                    (const float *)   src0_data,
+                    (const int32_t *) k_idxs_data,
+                    g_fraqtl.sink_K_buf[layer_idx],
+                    g_fraqtl.residual_K_buf[layer_idx],
+                    n_tokens, NKV, HD,
+                    g_fraqtl.sink_n, g_fraqtl.residual_n,
+                    src0_row_stride_bytes, cu_stream);
+            }
+            const int64_t cum = g_fraqtl.step59_residual_writes_K[layer_idx];
+            if (g_fraqtl.sink_n > 0 && g_fraqtl.sink_K_buf[layer_idx]) {
+                const int64_t sink_room = (int64_t) g_fraqtl.sink_n - cum;
+                const int64_t sink_inc  = (sink_room > 0)
+                    ? (int64_t) (n_tokens < (int) sink_room ? n_tokens : (int) sink_room)
+                    : 0;
+                g_fraqtl.step59_sink_writes_K[layer_idx] += sink_inc;
+            }
+            if (g_fraqtl.residual_n > 0 && g_fraqtl.residual_K_buf[layer_idx]) {
+                g_fraqtl.step59_residual_writes_K[layer_idx] += n_tokens;
+                const int64_t res_n    = g_fraqtl.residual_n;
+                const int64_t pre_room = (cum < res_n) ? (res_n - cum) : 0;
+                const int64_t ow_inc   = (pre_room >= n_tokens) ? 0 : ((int64_t) n_tokens - pre_room);
+                g_fraqtl.step59_overwrite_K[layer_idx] += ow_inc;
+            }
+        }
+    }
+
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: K_set_rows_from_src_hook layer %d kernel launch error: %s\n",
+            layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        return 99;
+    }
+
+    // ===========================================================
+    // Diagnostic C (post-pack half).
+    // After the pack kernel completes (sync the stream first), read
+    // the FIRST 8 C_K coefficients from the prot slab + estimate
+    // C_K row L2/abs_max. Compare against expected C_K = K @ U_K
+    // to localize whether the pack/projection math is the issue.
+    // Slot layout: per register_layer_k_slabs, descriptor
+    // row_id = kvh*kv_size + slot. For first call with prefill, the
+    // first written row is (kvh=0, slot=k_idxs[0]). We just read
+    // descs[0] which corresponds to (kvh=0, slot=0). For prefill
+    // with k_idxs=[0..n_tokens-1], slot 0 = token 0's K row.
+    // ranks=[min=24,max=24,...] for Qwen 7B early layers means c=0..7
+    // falls entirely in the protected fp16 portion — no INT4 dequant
+    // needed for this dump.
+    static unsigned char fr_k_postpack_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!fr_k_postpack_logged[layer_idx]) {
+        cudaStreamSynchronize(cu_stream);
+
+        // Pull descriptor[kvh=0] to host (per-(layer,kvh) desc).
+        // Slot=0 row pointer derived as prot_base + 0 * slab_row_stride_halves
+        // = prot_base.
+        fraqtl_k_kvh_desc desc_h{};
+        cudaMemcpy(&desc_h, descs, sizeof(fraqtl_k_kvh_desc),
+                   cudaMemcpyDeviceToHost);
+        // For slot=0, the row pointer IS the base.
+        const half * prot_row_slot0 = desc_h.prot_base;
+
+        // Read first min(rank, 8) fp16 prot values (all c=0..7 fit
+        // in protected fp16 for typical Qwen 7B ranks ≥ 8). If rank
+        // < 8 we'd need to dequant INT4 too; for now we cap at rank
+        // and read 8 if available.
+        const int n_prot_dump = (desc_h.rank < 8) ? desc_h.rank : 8;
+        std::vector<uint16_t> prot_h(n_prot_dump);
+        if (prot_row_slot0 != nullptr && n_prot_dump > 0) {
+            cudaMemcpy(prot_h.data(), prot_row_slot0,
+                       n_prot_dump * sizeof(uint16_t),
+                       cudaMemcpyDeviceToHost);
+        }
+        float ck_first8[8] = {0,0,0,0,0,0,0,0};
+        for (int i = 0; i < n_prot_dump; ++i) {
+            half hf;
+            std::memcpy(&hf, &prot_h[i], sizeof(uint16_t));
+            ck_first8[i] = __half2float(hf);
+        }
+
+        // C_K row L2/abs_max over the full protected portion (rank halves).
+        std::vector<uint16_t> prot_full(desc_h.rank);
+        if (prot_row_slot0 != nullptr && desc_h.rank > 0) {
+            cudaMemcpy(prot_full.data(), prot_row_slot0,
+                       desc_h.rank * sizeof(uint16_t),
+                       cudaMemcpyDeviceToHost);
+        }
+        float ck_l2 = 0.0f, ck_abs_max = 0.0f;
+        for (int i = 0; i < desc_h.rank; ++i) {
+            half hf;
+            std::memcpy(&hf, &prot_full[i], sizeof(uint16_t));
+            const float v = __half2float(hf);
+            ck_l2 += v * v;
+            if (fabsf(v) > ck_abs_max) ck_abs_max = fabsf(v);
+        }
+        ck_l2 = sqrtf(ck_l2);
+
+        fprintf(stderr,
+            "fraqtl: C_K_POSTPACK_DUMP layer=%d kvh=0 slot=0 "
+            "rank=%d ck_first8= %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f %+.6f "
+            "ck_prot_L2=%.4f ck_prot_abs_max=%.4f "
+            "(C_K read directly from prot slab post-pack-kernel-sync; "
+            "compare to host-computed K @ U_K to localize pack math)\n",
+            layer_idx, desc_h.rank,
+            (double) ck_first8[0], (double) ck_first8[1],
+            (double) ck_first8[2], (double) ck_first8[3],
+            (double) ck_first8[4], (double) ck_first8[5],
+            (double) ck_first8[6], (double) ck_first8[7],
+            (double) ck_l2, (double) ck_abs_max);
+        fflush(stderr);
+
+        fr_k_postpack_logged[layer_idx] = 1;
+    }
+
+    // ===========================================================
+    // micro-score parity on real K_src row
+    // (internal, layer-targeted to layer 27 = smoking gun
+    // from dump: R=24 vs K_L2=923 / K_max=416).
+    // Standalone host-side parity. Uses real runtime data:
+    //   - K_src[d] from src0_data (token 0, kvh 0, d in [0, HD))
+    //   - U_K[d, c] from desc.U_K_head (loaded from sidecar)
+    //   - C_prot[c] from desc.prot_base + 0 * slab_stride (post-pack, slot=0)
+    //   - C_tail[c] dequant via Gate 0b: q = (uint4 - 8); val = q * scale
+    // Q chosen as Q = K_src so:
+    //   score_ref = Q . K_src = ||K_src||²
+    //   score_prot = sum_{c<R} Q'[c] * C_prot[c]
+    //   score_tail = sum_{c>=R} Q'[c] * C_tail[c-R]
+    //   score_total = score_prot + score_tail
+    // For orthonormal U_K, score_total should ≈ score_ref up to
+    // fp16/INT4 quantization error.
+    // internal review's decision matrix:
+    //   tail nonzero AND |total-ref| huge → recipe/rank failure
+    //   tail tiny / total ≈ prot only → fattn read path bug
+    //   parity passes here but fattn fails → tile/MMA tail integration bug
+    static unsigned char fr_k_score_parity_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (layer_idx == 27 && !fr_k_score_parity_logged[layer_idx]) {
+        cudaStreamSynchronize(cu_stream);
+
+        // Loop kvh = 0..NKV-1 to confirm the outlier head reconstructs too
+        // (first round only checked kvh=0; layer 27 K_SRC0_DUMP showed
+        // abs_max=416 across 512 floats, but kvh=0 alone had abs_max=5.3
+        // the outlier lives in some other kvh; need per-kvh confirmation).
+        for (int kvh = 0; kvh < NKV; ++kvh) {
+            // descriptor is per-(layer, kvh), not per-(layer, slot, kvh).
+            // Slot=0 row pointer = base + 0 * slab_stride = base.
+            fraqtl_k_kvh_desc desc_h{};
+            cudaMemcpy(&desc_h, descs + (size_t) kvh,
+                       sizeof(fraqtl_k_kvh_desc), cudaMemcpyDeviceToHost);
+            const int R      = desc_h.rank;
+            const int Hd     = desc_h.hd;
+            const int tail_n = Hd - R;
+            const int pack_bytes = desc_h.pack_stride;
+
+            if (R <= 0 || Hd <= 0 || R > Hd || desc_h.U_K_head == nullptr) {
+                fprintf(stderr,
+                    "fraqtl: K_SCORE_PARITY layer=%d kvh=%d SKIP bad desc "
+                    "R=%d HD=%d U_K_head=%p\n",
+                    layer_idx, kvh, R, Hd, (const void *) desc_h.U_K_head);
+                fflush(stderr);
+                continue;
+            }
+
+            // K_src token 0, kvh, dims 0..HD-1 → offset = kvh * HD floats
+            std::vector<float> Ksrc(Hd);
+            const float * src0_kvh = ((const float *) src0_data)
+                                     + (size_t) kvh * Hd;
+            cudaMemcpy(Ksrc.data(), src0_kvh, Hd * sizeof(float),
+                       cudaMemcpyDeviceToHost);
+            float ksrc_l2sq = 0.0f, ksrc_abs_max = 0.0f;
+            int ksrc_nan = 0, ksrc_inf = 0, ksrc_first_bad = -1;
+            for (int d = 0; d < Hd; ++d) {
+                const float v = Ksrc[d];
+                if (std::isnan(v)) {
+                    ksrc_nan++;
+                    if (ksrc_first_bad < 0) ksrc_first_bad = d;
+                    continue;
+                }
+                if (std::isinf(v)) {
+                    ksrc_inf++;
+                    if (ksrc_first_bad < 0) ksrc_first_bad = d;
+                    continue;
+                }
+                ksrc_l2sq += v * v;
+                if (fabsf(v) > ksrc_abs_max) ksrc_abs_max = fabsf(v);
+            }
+
+            // U_K[d, c] = U_K_head[d*HD + c] — per kvh
+            std::vector<uint16_t> UK_h((size_t) Hd * Hd);
+            cudaMemcpy(UK_h.data(), desc_h.U_K_head,
+                       (size_t) Hd * Hd * sizeof(uint16_t),
+                       cudaMemcpyDeviceToHost);
+            std::vector<float> UK((size_t) Hd * Hd);
+            int uk_nan = 0, uk_inf = 0, uk_first_bad = -1;
+            float uk_abs_max = 0.0f;
+            for (int i = 0; i < Hd * Hd; ++i) {
+                half hf;
+                std::memcpy(&hf, &UK_h[i], sizeof(uint16_t));
+                const float v = __half2float(hf);
+                UK[i] = v;
+                if (std::isnan(v)) {
+                    uk_nan++;
+                    if (uk_first_bad < 0) uk_first_bad = i;
+                    continue;
+                }
+                if (std::isinf(v)) {
+                    uk_inf++;
+                    if (uk_first_bad < 0) uk_first_bad = i;
+                    continue;
+                }
+                if (fabsf(v) > uk_abs_max) uk_abs_max = fabsf(v);
+            }
+
+            // C_prot — slot=0 row = prot_base (derivation: base + 0 * stride).
+            std::vector<uint16_t> prot_h(R);
+            cudaMemcpy(prot_h.data(), desc_h.prot_base,
+                       R * sizeof(uint16_t), cudaMemcpyDeviceToHost);
+            std::vector<float> Cprot(R);
+            int cprot_nan = 0, cprot_inf = 0, cprot_first_bad = -1;
+            float cprot_abs_max = 0.0f;
+            for (int c = 0; c < R; ++c) {
+                half hf;
+                std::memcpy(&hf, &prot_h[c], sizeof(uint16_t));
+                const float v = __half2float(hf);
+                Cprot[c] = v;
+                if (std::isnan(v)) {
+                    cprot_nan++;
+                    if (cprot_first_bad < 0) cprot_first_bad = c;
+                    continue;
+                }
+                if (std::isinf(v)) {
+                    cprot_inf++;
+                    if (cprot_first_bad < 0) cprot_first_bad = c;
+                    continue;
+                }
+                if (fabsf(v) > cprot_abs_max) cprot_abs_max = fabsf(v);
+            }
+
+            // One-shot per-(layer,kvh) finite-count receipt — emitted BEFORE
+            // the dot product so we can attribute downstream NaN to inputs.
+            fprintf(stderr,
+                "fraqtl: K_PARITY_INPUTS layer=%d kvh=%d R=%d "
+                "ksrc[nan=%d inf=%d first_bad=%d max_abs=%.4f] "
+                "U_K[nan=%d inf=%d first_bad=%d max_abs=%.6f n=%d] "
+                "Cprot[nan=%d inf=%d first_bad=%d max_abs=%.4f n=%d]\n",
+                layer_idx, kvh, R,
+                ksrc_nan, ksrc_inf, ksrc_first_bad, (double) ksrc_abs_max,
+                uk_nan, uk_inf, uk_first_bad, (double) uk_abs_max, Hd * Hd,
+                cprot_nan, cprot_inf, cprot_first_bad, (double) cprot_abs_max, R);
+            fflush(stderr);
+
+            // C_tail dequant (Gate 0b convention)
+            std::vector<float> Ctail(tail_n, 0.0f);
+            float tail_scale  = 0.0f;
+            float tail_abs_max = 0.0f;
+            int   n_saturated = 0;
+            bool  tail_ok = true;
+            if (tail_n > 0) {
+                if (desc_h.pack_base == nullptr || desc_h.scale_base == nullptr) {
+                    tail_ok = false;
+                } else {
+                    // slot=0 row = base + 0 * slab_stride = base.
+                    std::vector<uint8_t> pack_h(pack_bytes);
+                    cudaMemcpy(pack_h.data(), desc_h.pack_base,
+                               (size_t) pack_bytes, cudaMemcpyDeviceToHost);
+                    cudaMemcpy(&tail_scale, desc_h.scale_base, sizeof(float),
+                               cudaMemcpyDeviceToHost);
+                    for (int rel = 0; rel < tail_n; ++rel) {
+                        const int g = rel >> 1;
+                        const int e = rel & 1;
+                        const uint8_t b = pack_h[g];
+                        const uint8_t u = (e == 0) ? ((b >> 4) & 0x0F)
+                                                   : (b & 0x0F);
+                        const int q = (int) u - 8;
+                        if (q == -8 || q == 7) n_saturated++;
+                        const float v = (float) q * tail_scale;
+                        Ctail[rel] = v;
+                        if (fabsf(v) > tail_abs_max) tail_abs_max = fabsf(v);
+                    }
+                }
+            }
+
+            if (!tail_ok) {
+                fprintf(stderr,
+                    "fraqtl: K_SCORE_PARITY layer=%d kvh=%d SKIP null "
+                    "pack/scale with tail_n=%d\n",
+                    layer_idx, kvh, tail_n);
+                fflush(stderr);
+                continue;
+            }
+
+            // Q = K_src; Q'[c] = sum_d Q[d] * U_K[d, c]
+            std::vector<float> Qproj(Hd, 0.0f);
+            for (int c = 0; c < Hd; ++c) {
+                float acc = 0.0f;
+                for (int d = 0; d < Hd; ++d) {
+                    acc += Ksrc[d] * UK[(size_t) d * Hd + c];
+                }
+                Qproj[c] = acc;
+            }
+
+            const float score_ref = ksrc_l2sq;
+            float score_prot = 0.0f;
+            for (int c = 0; c < R; ++c) score_prot += Qproj[c] * Cprot[c];
+            float score_tail = 0.0f;
+            for (int c = R; c < Hd; ++c) score_tail += Qproj[c] * Ctail[c - R];
+            const float score_total = score_prot + score_tail;
+            const float abs_diff = fabsf(score_total - score_ref);
+            const float rel_diff = (fabsf(score_ref) > 1e-6f)
+                ? abs_diff / fabsf(score_ref) : 0.0f;
+
+            fprintf(stderr,
+                "fraqtl: K_SCORE_PARITY layer=%d kvh=%d slot=0 R=%d HD=%d "
+                "tail_n=%d ksrc_l2sq=%.4f ksrc_abs_max=%.4f "
+                "score_ref=%.4f score_prot=%.4f score_tail=%.4f "
+                "score_total=%.4f abs_diff=%.4f rel_diff=%.4e "
+                "tail_scale=%.6f tail_abs_max=%.4f n_saturated=%d/%d\n",
+                layer_idx, kvh, R, Hd, tail_n,
+                (double) ksrc_l2sq, (double) ksrc_abs_max,
+                (double) score_ref, (double) score_prot,
+                (double) score_tail, (double) score_total,
+                (double) abs_diff, (double) rel_diff,
+                (double) tail_scale, (double) tail_abs_max,
+                n_saturated, tail_n);
+            fflush(stderr);
+        }
+        fr_k_score_parity_logged[layer_idx] = 1;
+    }
+
+    // ===========================================================
+    // K_LONGSLOT_PARITY (internal ).
+    // 64K Gate 2 PPL drift = +0.8645 (17.84σ) decision gate:
+    //   - parity FAILS at high slots → runtime slot/stride/overflow bug
+    //   - parity PASSES at high slots → recipe/calibration limit
+    // For each sampled (layer ∈ {0, 14, 27}, kvh ∈ all, slot ∈ samples):
+    //   1. Read desc[kvh] and derive prot/pack/scale row pointers via
+    //      base + slot * slab_stride (arithmetic).
+    //   2. Read fp16 prot row + INT4 pack row + fp32 scale to host.
+    //   3. Count NaN/Inf in each.
+    //   4. Reconstruct C_K = prot ⊕ dequant(pack, scale).
+    //   5. Reconstruct K_src = C_K @ U_K.T (orthonormal U_K → bit-exact).
+    //   6. Compute Q' = K_src @ U_K = C_K (math identity).
+    //   7. score_total = sum_c Q'[c] * C_K_stored[c]; score_ref = ||C_K_stored||².
+    //   8. Emit per-(L, kvh, slot) line with rel_diff + offsets.
+    // Gating: fires ONCE per (layer, K_pack call_count) when call_count
+    // crosses 25 (so slots up to ~50K are populated for 64K context with
+    // ub=2048 batches). Layer set is hardcoded {0, 14, 27}.
+    {
+        static unsigned char fr_longslot_logged[FRAQTL_MAX_LAYERS] = {0};
+        const int call_idx = g_fraqtl.k_set_rows_hook_calls[layer_idx];
+        const bool layer_in_sample = (layer_idx == 0 || layer_idx == 14 || layer_idx == 27);
+        // Trigger when this layer has packed >=25 batches AND we haven't fired yet.
+        // For 16K (call_idx maxes at ~8 batches of 2048), we trigger lower.
+        const int trigger_count = (kv_size >= 32768) ? 25 : (kv_size / 2048 - 1);
+        if (layer_in_sample && !fr_longslot_logged[layer_idx]
+            && call_idx >= trigger_count && call_idx < trigger_count + 4)
+        {
+            cudaStreamSynchronize(cu_stream);
+
+            const int sample_slots[] = {0, 1024, 4096, 16384, 32768, 50000};
+            const int n_samples = sizeof(sample_slots) / sizeof(sample_slots[0]);
+
+            for (int kvh = 0; kvh < NKV; ++kvh) {
+                fraqtl_k_kvh_desc desc_h{};
+                cudaMemcpy(&desc_h, descs + (size_t) kvh,
+                           sizeof(fraqtl_k_kvh_desc), cudaMemcpyDeviceToHost);
+                const int R      = desc_h.rank;
+                const int Hd     = desc_h.hd;
+                const int tail_n = Hd - R;
+                if (R <= 0 || Hd <= 0 || R > Hd || desc_h.U_K_head == nullptr) {
+                    continue;
+                }
+
+                // Pull U_K once per kvh (HD*HD halves).
+                std::vector<uint16_t> UK_h((size_t) Hd * Hd);
+                cudaMemcpy(UK_h.data(), desc_h.U_K_head,
+                           (size_t) Hd * Hd * sizeof(uint16_t),
+                           cudaMemcpyDeviceToHost);
+                std::vector<float> UK((size_t) Hd * Hd);
+                int uk_nan = 0, uk_inf = 0;
+                for (int i = 0; i < Hd * Hd; ++i) {
+                    half hf;
+                    std::memcpy(&hf, &UK_h[i], sizeof(uint16_t));
+                    const float v = __half2float(hf);
+                    UK[i] = v;
+                    if (std::isnan(v)) uk_nan++;
+                    else if (std::isinf(v)) uk_inf++;
+                }
+
+                for (int s = 0; s < n_samples; ++s) {
+                    const int slot = sample_slots[s];
+                    if (slot >= kv_size) continue;
+
+                    // slot pointer derivation.
+                    const size_t prot_off_halves =
+                        (size_t) slot * (size_t) desc_h.slab_row_stride_halves;
+                    const size_t pack_off_bytes  =
+                        (size_t) slot * (size_t) desc_h.slab_pack_stride_bytes;
+                    const size_t scale_off_floats = (size_t) slot;
+
+                    // --- prot read ---
+                    std::vector<uint16_t> prot_h(R);
+                    cudaMemcpy(prot_h.data(), desc_h.prot_base + prot_off_halves,
+                               R * sizeof(uint16_t), cudaMemcpyDeviceToHost);
+                    std::vector<float> Cprot(R);
+                    int cprot_nan = 0, cprot_inf = 0;
+                    float cprot_abs_max = 0.0f;
+                    for (int c = 0; c < R; ++c) {
+                        half hf;
+                        std::memcpy(&hf, &prot_h[c], sizeof(uint16_t));
+                        const float v = __half2float(hf);
+                        Cprot[c] = v;
+                        if (std::isnan(v)) cprot_nan++;
+                        else if (std::isinf(v)) cprot_inf++;
+                        else if (fabsf(v) > cprot_abs_max) cprot_abs_max = fabsf(v);
+                    }
+
+                    // --- scale read ---
+                    float tail_scale = 0.0f;
+                    int   scale_nonfinite = 0;
+                    if (desc_h.scale_base != nullptr) {
+                        cudaMemcpy(&tail_scale, desc_h.scale_base + scale_off_floats,
+                                   sizeof(float), cudaMemcpyDeviceToHost);
+                        if (std::isnan(tail_scale) || std::isinf(tail_scale)) {
+                            scale_nonfinite = 1;
+                        }
+                    }
+
+                    // --- tail dequant ---
+                    std::vector<float> Ctail(tail_n, 0.0f);
+                    int   tail_nonfinite = 0;
+                    int   pack_byte_nonzero = 0;
+                    float tail_abs_max = 0.0f;
+                    if (tail_n > 0 && desc_h.pack_base != nullptr) {
+                        const int pack_bytes = desc_h.pack_stride;
+                        std::vector<uint8_t> pack_h(pack_bytes);
+                        cudaMemcpy(pack_h.data(), desc_h.pack_base + pack_off_bytes,
+                                   (size_t) pack_bytes, cudaMemcpyDeviceToHost);
+                        for (int i = 0; i < pack_bytes; ++i) if (pack_h[i] != 0) pack_byte_nonzero++;
+                        for (int rel = 0; rel < tail_n; ++rel) {
+                            const int g = rel >> 1;
+                            const int e = rel & 1;
+                            const uint8_t b = pack_h[g];
+                            const uint8_t u = (e == 0) ? ((b >> 4) & 0x0F) : (b & 0x0F);
+                            const int q = (int) u - 8;
+                            const float v = (float) q * tail_scale;
+                            Ctail[rel] = v;
+                            if (std::isnan(v) || std::isinf(v)) tail_nonfinite++;
+                            else if (fabsf(v) > tail_abs_max) tail_abs_max = fabsf(v);
+                        }
+                    }
+
+                    // --- assemble C_K ---
+                    std::vector<float> CK(Hd);
+                    for (int c = 0; c < Hd; ++c) {
+                        CK[c] = (c < R) ? Cprot[c] : Ctail[c - R];
+                    }
+                    float ck_l2sq = 0.0f;
+                    for (int c = 0; c < Hd; ++c) ck_l2sq += CK[c] * CK[c];
+
+                    // --- reconstruct K_src = CK @ U_K.T (orthonormal U_K) ---
+                    // K_src[d] = sum_c CK[c] * U_K[d, c] (since U_K.T[c, d] = U_K[d, c])
+                    std::vector<float> K_src_recon(Hd, 0.0f);
+                    for (int d = 0; d < Hd; ++d) {
+                        float acc = 0.0f;
+                        for (int c = 0; c < Hd; ++c) {
+                            acc += CK[c] * UK[(size_t) d * Hd + c];
+                        }
+                        K_src_recon[d] = acc;
+                    }
+                    float ksrc_l2sq = 0.0f;
+                    for (int d = 0; d < Hd; ++d) ksrc_l2sq += K_src_recon[d] * K_src_recon[d];
+
+                    // --- compute Q' = K_src_recon @ U_K (should equal CK for orthonormal) ---
+                    std::vector<float> Qproj(Hd, 0.0f);
+                    for (int c = 0; c < Hd; ++c) {
+                        float acc = 0.0f;
+                        for (int d = 0; d < Hd; ++d) {
+                            acc += K_src_recon[d] * UK[(size_t) d * Hd + c];
+                        }
+                        Qproj[c] = acc;
+                    }
+
+                    // --- score parity ---
+                    float score_prot = 0.0f;
+                    for (int c = 0; c < R; ++c) score_prot += Qproj[c] * Cprot[c];
+                    float score_tail = 0.0f;
+                    for (int c = R; c < Hd; ++c) score_tail += Qproj[c] * Ctail[c - R];
+                    const float score_total = score_prot + score_tail;
+                    const float score_ref   = ksrc_l2sq;
+                    const float abs_diff = fabsf(score_total - score_ref);
+                    const float rel_diff = (fabsf(score_ref) > 1e-6f)
+                        ? abs_diff / fabsf(score_ref) : 0.0f;
+
+                    fprintf(stderr,
+                        "fraqtl: K_LONGSLOT_PARITY layer=%d kvh=%d slot=%d R=%d HD=%d "
+                        "prot[nan=%d inf=%d max=%.4f] tail[nonfinite=%d nonzero_bytes=%d max=%.4f] "
+                        "scale=%.6e scale_nonfinite=%d "
+                        "ck_l2sq=%.4f ksrc_l2sq=%.4f score_total=%.4f rel_diff=%.4e "
+                        "uk_nan=%d uk_inf=%d "
+                        "prot_off_bytes=%zu pack_off_bytes=%zu scale_off_bytes=%zu\n",
+                        layer_idx, kvh, slot, R, Hd,
+                        cprot_nan, cprot_inf, (double) cprot_abs_max,
+                        tail_nonfinite, pack_byte_nonzero, (double) tail_abs_max,
+                        (double) tail_scale, scale_nonfinite,
+                        (double) ck_l2sq, (double) ksrc_l2sq,
+                        (double) score_total, (double) rel_diff,
+                        uk_nan, uk_inf,
+                        prot_off_halves * sizeof(uint16_t),
+                        pack_off_bytes,
+                        scale_off_floats * sizeof(float));
+                    fflush(stderr);
+                }
+            }
+            fr_longslot_logged[layer_idx] = 1;
+        }
+    }
+
+    g_fraqtl.k_set_rows_hook_calls[layer_idx]++;
+    return 0;
+}
+
+// ===========================================================================
+// K-pack SELF-TEST
+// Validates fraqtl_kv_pack_kernel_set_rows_k_from_src end-to-end on a tiny
+// synthetic case (HD=8, NKV=2, kv_size=4, n_tokens=2) covering BOTH branches:
+//   - kvh=0: rank=3 (compressible) — protected slab + INT4 tail + scale
+//   - kvh=1: rank=8 (R==HD, uncompressible) — protected slab only, scale=1.0
+// U_K = identity per head, so C_K = K_src (no rotation). Expected values for
+// each row are computable on host, then compared after dequant.
+// Output line:
+//   fraqtl: K_PACK_SELFTEST_PASS HD=8 NKV=2 ranks=[3,8] max_abs_diff=...
+// or _FAIL / _CUDA_ERROR variants.
+// Returns 0 on PASS, 1 on FAIL, 2 on CUDA error. Allocates its own buffers
+// and does NOT touch g_fraqtl state.
+// ===========================================================================
+extern "C" int fraqtl_runtime_k_pack_selftest(void) {
+    constexpr int HD       = 8;
+    constexpr int NKV      = 2;
+    constexpr int KV_SIZE  = 4;
+    constexpr int N_TOKENS = 2;
+
+    const int ranks_h[NKV] = {3, 8};  // h=0 compressible, h=1 R==HD
+
+    // Per-head pack stride: ceil((HD - R) / 2) bytes.
+    int pack_stride_h[NKV];
+    int max_pack_stride = 0;
+    int max_rank        = 0;
+    for (int h = 0; h < NKV; ++h) {
+        const int sac = HD - ranks_h[h];
+        pack_stride_h[h] = (sac + 1) / 2;
+        if (pack_stride_h[h] > max_pack_stride) max_pack_stride = pack_stride_h[h];
+        if (ranks_h[h] > max_rank) max_rank = ranks_h[h];
+    }
+
+    // Build src0: [N_TOKENS, NKV * HD] F32. Deterministic pattern.
+    float src0_h[N_TOKENS * NKV * HD];
+    for (int i = 0; i < (int)(sizeof(src0_h) / sizeof(float)); ++i) {
+        src0_h[i] = 0.05f * (float)((i * 13 + 7) % 41) - 1.0f;
+    }
+    const int64_t k_idxs_h[N_TOKENS] = {1, 3};  // write rows into slots 1 and 3
+
+    // U_K identity per head.
+    half U_K_h[NKV * HD * HD];
+    for (int h = 0; h < NKV; ++h) {
+        for (int d = 0; d < HD; ++d) {
+            for (int c = 0; c < HD; ++c) {
+                const float v = (d == c) ? 1.0f : 0.0f;
+                U_K_h[((h * HD) + d) * HD + c] = __float2half(v);
+            }
+        }
+    }
+
+    // Slab sizes (per-(layer) layout: rows are (h-major, slot-minor)).
+    constexpr int n_rows = NKV * KV_SIZE;
+    const size_t prot_n  = (size_t) n_rows * (size_t) max_rank;
+    const size_t pack_n  = (size_t) n_rows * (size_t) max_pack_stride;
+    const size_t scale_n = (size_t) n_rows;
+
+    // Device buffers.
+    float *   d_src0  = nullptr;
+    int64_t * d_idxs  = nullptr;
+    half  *   d_U_K   = nullptr;
+    half  *   d_prot  = nullptr;
+    uint8_t * d_pack  = nullptr;
+    float *   d_scale = nullptr;
+    fraqtl_k_kvh_desc * d_descs = nullptr;
+
+    cudaError_t e;
+    e = cudaMalloc(&d_src0,  sizeof(src0_h));                            if (e) goto fail;
+    e = cudaMalloc(&d_idxs,  sizeof(k_idxs_h));                          if (e) goto fail;
+    e = cudaMalloc(&d_U_K,   sizeof(U_K_h));                             if (e) goto fail;
+    e = cudaMalloc(&d_prot,  prot_n  * sizeof(half));                    if (e) goto fail;
+    e = cudaMalloc(&d_pack,  pack_n  > 0 ? pack_n : 1);                  if (e) goto fail;
+    e = cudaMalloc(&d_scale, scale_n * sizeof(float));                   if (e) goto fail;
+    // allocate NKV descriptors per layer (was NKV * KV_SIZE).
+    e = cudaMalloc(&d_descs, NKV     * sizeof(fraqtl_k_kvh_desc));       if (e) goto fail;
+    e = cudaMemcpy(d_src0, src0_h,   sizeof(src0_h),   cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_idxs, k_idxs_h, sizeof(k_idxs_h), cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_U_K,  U_K_h,    sizeof(U_K_h),    cudaMemcpyHostToDevice); if (e) goto fail;
+    // Zero slabs so untouched rows / nibbles are observable.
+    e = cudaMemset(d_prot,  0, prot_n  * sizeof(half));                  if (e) goto fail;
+    if (pack_n > 0) { e = cudaMemset(d_pack, 0xCD, pack_n);              if (e) goto fail; }
+    e = cudaMemset(d_scale, 0, scale_n * sizeof(float));                 if (e) goto fail;
+
+    {
+        // build per-kvh descriptors. Slab layout unchanged
+        // (rectangular [NKV, KV_SIZE, max_rank] for prot, etc.) — only
+        // the descriptor representation collapsed.
+        fraqtl_k_kvh_desc descs_h[NKV];
+        for (int h = 0; h < NKV; ++h) {
+            fraqtl_k_kvh_desc d;
+            d.prot_base   = d_prot  + (size_t) h * (size_t) KV_SIZE * (size_t) max_rank;
+            d.pack_base   = (pack_stride_h[h] > 0)
+                              ? d_pack + (size_t) h * (size_t) KV_SIZE * (size_t) max_pack_stride
+                              : nullptr;
+            d.scale_base  = d_scale + (size_t) h * (size_t) KV_SIZE;
+            d.U_K_head    = d_U_K   + (size_t) h * HD * HD;
+            d.rank        = ranks_h[h];
+            d.hd          = HD;
+            d.pack_stride = pack_stride_h[h];
+            d.slab_row_stride_halves = max_rank;
+            d.slab_pack_stride_bytes = max_pack_stride;
+            d.tail_bits   = 4;       // K_PACK_SELFTEST uses INT4 path
+            d._pad        = 0;
+            descs_h[h]    = d;
+        }
+        e = cudaMemcpy(d_descs, descs_h, NKV * sizeof(fraqtl_k_kvh_desc),
+                       cudaMemcpyHostToDevice);
+        if (e) goto fail;
+    }
+
+    // Launch the kernel. src0 row stride = NKV * HD * sizeof(float).
+    {
+        const dim3 grid(N_TOKENS, NKV, 1);
+        const size_t shmem = (size_t)(HD + 1 + BLOCK_THREADS) * sizeof(float);
+        fraqtl_kv_pack_kernel_set_rows_k_from_src<int64_t>
+            <<<grid, BLOCK_THREADS, shmem>>>(
+                d_src0, d_idxs, d_descs,
+                N_TOKENS, NKV, KV_SIZE, HD,
+                /*src0_row_stride_bytes=*/(size_t) NKV * HD * sizeof(float));
+        e = cudaGetLastError();
+        if (e) goto fail;
+        e = cudaDeviceSynchronize();
+        if (e) goto fail;
+    }
+
+    // Read back + verify.
+    {
+        std::vector<half>    prot_h_out(prot_n);
+        std::vector<uint8_t> pack_h_out(pack_n > 0 ? pack_n : 1);
+        std::vector<float>   scale_h_out(scale_n);
+        e = cudaMemcpy(prot_h_out.data(),  d_prot,  prot_n  * sizeof(half),
+                       cudaMemcpyDeviceToHost); if (e) goto fail;
+        if (pack_n > 0) {
+            e = cudaMemcpy(pack_h_out.data(), d_pack, pack_n,
+                           cudaMemcpyDeviceToHost); if (e) goto fail;
+        }
+        e = cudaMemcpy(scale_h_out.data(), d_scale, scale_n * sizeof(float),
+                       cudaMemcpyDeviceToHost); if (e) goto fail;
+
+        int   n_mismatch    = 0;
+        float max_abs_diff  = 0.0f;
+        int   n_uncompressed_pack_bytes_touched = 0;
+
+        for (int t = 0; t < N_TOKENS; ++t) {
+            const int idx = (int) k_idxs_h[t];
+            for (int h = 0; h < NKV; ++h) {
+                const int  R    = ranks_h[h];
+                const int  sac  = HD - R;
+                const int  row  = h * KV_SIZE + idx;
+                const float * src_kvh = src0_h + (size_t) t * NKV * HD + (size_t) h * HD;
+
+                // Expected protected: src_kvh[c] for c in [0, R) (identity U_K).
+                for (int c = 0; c < R; ++c) {
+                    const float got = __half2float(prot_h_out[(size_t) row * max_rank + c]);
+                    const float exp = src_kvh[c];
+                    const float diff = fabsf(got - exp);
+                    if (diff > max_abs_diff) max_abs_diff = diff;
+                    if (diff > 1e-3f) {
+                        if (n_mismatch < 5) {
+                            fprintf(stderr,
+                                "fraqtl: K_PACK_SELFTEST mismatch (prot) "
+                                "h=%d slot=%d c=%d exp=%.6f got=%.6f\n",
+                                h, idx, c, exp, got);
+                        }
+                        n_mismatch++;
+                    }
+                }
+
+                if (sac > 0) {
+                    // Expected scale = absmax(tail) / 7
+                    float absmax = 0.0f;
+                    for (int c = R; c < HD; ++c) {
+                        const float a = fabsf(src_kvh[c]);
+                        if (a > absmax) absmax = a;
+                    }
+                    const float exp_scale = (absmax / 7.0f) > 1e-10f ? (absmax / 7.0f) : 1e-10f;
+                    const float got_scale = scale_h_out[row];
+                    const float dscale = fabsf(got_scale - exp_scale);
+                    if (dscale > 1e-6f) {
+                        fprintf(stderr,
+                            "fraqtl: K_PACK_SELFTEST scale mismatch h=%d slot=%d "
+                            "exp=%.8f got=%.8f\n",
+                            h, idx, exp_scale, got_scale);
+                        n_mismatch++;
+                    }
+
+                    // Dequant tail and compare to original within scale tolerance.
+                    const uint8_t * row_pack = pack_h_out.data() + (size_t) row * max_pack_stride;
+                    for (int c = 0; c < sac; ++c) {
+                        const int g = c / 2;
+                        const int e_inrow = c & 1;
+                        const uint8_t b = row_pack[g];
+                        const uint8_t u = (e_inrow == 0) ? ((b >> 4) & 0x0F) : (b & 0x0F);
+                        const int q = (int) u - 8;
+                        const float deq = (float) q * got_scale;
+                        const float exp = src_kvh[R + c];
+                        // Dequant is INT4 with absmax/7 scale: max abs error ≈ scale/2.
+                        // Use an absolute tolerance of (got_scale * 0.55) to account
+                        // for rintf rounding, plus a small fp slack.
+                        const float tol = got_scale * 0.55f + 1e-5f;
+                        const float diff = fabsf(deq - exp);
+                        if (diff > max_abs_diff) max_abs_diff = diff;
+                        if (diff > tol) {
+                            if (n_mismatch < 5) {
+                                fprintf(stderr,
+                                    "fraqtl: K_PACK_SELFTEST mismatch (tail) "
+                                    "h=%d slot=%d c=%d exp=%.6f deq=%.6f scale=%.6e "
+                                    "tol=%.6e\n",
+                                    h, idx, c, exp, deq, got_scale, tol);
+                            }
+                            n_mismatch++;
+                        }
+                    }
+                } else {
+                    // R == HD: scale should be the placeholder 1.0 and the
+                    // pack_row_k should NOT have been touched (still 0xCD
+                    // sentinel from cudaMemset above).
+                    if (fabsf(scale_h_out[row] - 1.0f) > 1e-6f) {
+                        fprintf(stderr,
+                            "fraqtl: K_PACK_SELFTEST R==HD scale not 1.0 "
+                            "h=%d slot=%d got=%.6f\n",
+                            h, idx, scale_h_out[row]);
+                        n_mismatch++;
+                    }
+                    // pack_stride_h[h] = 0 means no pack row exists for this
+                    // head, so nothing to check on the pack side here.
+                }
+            }
+        }
+
+        cudaFree(d_src0);  cudaFree(d_idxs); cudaFree(d_U_K);
+        cudaFree(d_prot);  cudaFree(d_pack); cudaFree(d_scale);
+        cudaFree(d_descs);
+
+        if (n_mismatch > 0) {
+            fprintf(stderr,
+                "fraqtl: K_PACK_SELFTEST_FAIL n_mismatch=%d max_abs_diff=%.6e "
+                "HD=%d NKV=%d ranks=[%d,%d] uncompressed_pack_touched=%d\n",
+                n_mismatch, max_abs_diff, HD, NKV, ranks_h[0], ranks_h[1],
+                n_uncompressed_pack_bytes_touched);
+            fflush(stderr);
+            return 1;
+        }
+        fprintf(stderr,
+            "fraqtl: K_PACK_SELFTEST_PASS HD=%d NKV=%d ranks=[%d,%d] "
+            "kv_size=%d n_tokens=%d max_abs_diff=%.6e (R==HD branch verified)\n",
+            HD, NKV, ranks_h[0], ranks_h[1], KV_SIZE, N_TOKENS, max_abs_diff);
+        fflush(stderr);
+        return 0;
+    }
+
+fail:
+    fprintf(stderr,
+        "fraqtl: K_PACK_SELFTEST_CUDA_ERROR err=%d (%s)\n",
+        (int) e, cudaGetErrorString(e));
+    fflush(stderr);
+    if (d_src0)  cudaFree(d_src0);
+    if (d_idxs)  cudaFree(d_idxs);
+    if (d_U_K)   cudaFree(d_U_K);
+    if (d_prot)  cudaFree(d_prot);
+    if (d_pack)  cudaFree(d_pack);
+    if (d_scale) cudaFree(d_scale);
+    if (d_descs) cudaFree(d_descs);
+    return 2;
+}
+
+// ============================================================================
+// Score-parity selftest (internal K math debug harness, ).
+// internal review direction:
+//   "Goal: Find first divergence between fp16 K attention and fraqtl K
+//    attention. Pick one layer, one kv head, one short row range. Dump/
+//    compare Q, U_K, Q'. Dump/compare C_K coefficients. Compute reference
+//    score = Q @ K_fp16.T. Compute fraqtl score = Q' @ C_K.T. Compare
+//    before softmax. Repeat for natural R==HD head."
+// Strategy: drive the full +5.3+5.4 pipeline end-to-end on a tiny
+// synthetic case, then compute attention scores via fraqtl_k_get_coeff
+// (the SAME helper iter K-write branch uses for tile_K). If
+// this score computation matches the reference Q @ K.T within INT4
+// quant noise, the kernel composition is correct and the bug is
+// elsewhere (e.g., fattn-mma integration). If it doesn't, this harness
+// reports the FIRST failing component:
+//   - Q' projection mismatch → fraqtl_apply_U_K_to_Q
+//   - descriptor U_K_head mismatch → register_layer_k_slabs
+//   - INT4 dequant mismatch → fraqtl_k_get_coeff
+//   - C_K storage layout mismatch → pack kernel
+//   - score accumulation mismatch → harness math vs runtime math
+// Configuration:
+//   HD=8 (small for human-readable dumps + logs)
+//   NKV=2 kv heads
+//   gqa_ratio=2 → n_heads=4 q heads
+//   ranks=[3, 8] ← head 0 compressible (R<HD), head 1 R==HD natural
+//   n_q=2, n_tokens=4
+//   U_K = orthonormal pseudo-random (perm + sign), known invertible
+// ============================================================================
+
+namespace {
+
+// Device kernel: compute fraqtl score = Q' · C_K.T using fraqtl_k_get_coeff.
+// One block per (q_idx, head_idx, kv_idx). HD threads per block performing
+// a parallel reduction. Output is written to score_dst at the same index
+// as score_ref so we can diff element-by-element on host.
+template <int HD>
+__global__ void fraqtl_k_score_parity_kernel(
+    const float * __restrict__ Q_proj,                    // [n_q, n_heads, HD] f32
+    const fraqtl_k_kvh_desc * __restrict__ descs,         // [NKV] per layer
+    float * __restrict__ score_out,                       // [n_q, n_heads, n_tokens] f32
+    int n_q, int n_heads, int n_tokens, int kv_size,
+    int gqa_ratio)
+{
+    const int q_idx  = blockIdx.x;
+    const int h_idx  = blockIdx.y;
+    const int k_idx  = blockIdx.z;
+    const int tid    = threadIdx.x;
+
+    const int kvh    = h_idx / gqa_ratio;
+    // descriptor is per-(layer, kvh); slot = k_idx is passed
+    // to fraqtl_k_get_coeff for row-pointer derivation.
+    const fraqtl_k_kvh_desc d = descs[kvh];
+
+    // Each thread accumulates partial dot over a strided slice of c.
+    __shared__ float reduce_buf[HD];
+    float acc = 0.0f;
+    for (int c = tid; c < HD; c += blockDim.x) {
+        const float qprime_c = Q_proj[((q_idx * n_heads) + h_idx) * HD + c];
+        const float c_k_val  = fraqtl_k_get_coeff(d, /*slot=*/k_idx, c);
+        acc += qprime_c * c_k_val;
+    }
+    reduce_buf[tid] = acc;
+    __syncthreads();
+
+    for (int stride = HD / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) reduce_buf[tid] += reduce_buf[tid + stride];
+        __syncthreads();
+    }
+    if (tid == 0) {
+        score_out[((q_idx * n_heads) + h_idx) * n_tokens + k_idx] = reduce_buf[0];
+    }
+}
+
+}  // anonymous namespace
+
+extern "C" int fraqtl_runtime_k_score_parity_selftest(void) {
+    constexpr int HD          = 8;
+    constexpr int NKV         = 2;
+    constexpr int GQA_RATIO   = 2;
+    constexpr int N_HEADS     = NKV * GQA_RATIO;   // 4
+    constexpr int N_TOKENS    = 4;
+    constexpr int KV_SIZE     = N_TOKENS;          // tight; no padding for simplicity
+    constexpr int N_Q         = 2;
+
+    const int ranks_h[NKV] = {3, 8};   // head 0 compressible (R<HD), head 1 R==HD
+    int       max_rank = 0;
+    int       max_pack_stride = 0;
+    int       pack_stride_h[NKV];
+    for (int h = 0; h < NKV; ++h) {
+        const int sac = HD - ranks_h[h];
+        pack_stride_h[h] = (sac + 1) / 2;
+        if (ranks_h[h] > max_rank)              max_rank        = ranks_h[h];
+        if (pack_stride_h[h] > max_pack_stride) max_pack_stride = pack_stride_h[h];
+    }
+
+    // -------- Build host data --------
+    // Q[q, h, d] random
+    float Q_h[N_Q * N_HEADS * HD];
+    for (int i = 0; i < (int)(sizeof(Q_h)/sizeof(float)); ++i) {
+        Q_h[i] = 0.10f * (float)((i * 7 + 3) % 23) - 1.0f;
+    }
+    // K[k, kvh, d] random — this is the POST-RoPE K (in eigenbasis input form)
+    float K_h[N_TOKENS * NKV * HD];
+    for (int i = 0; i < (int)(sizeof(K_h)/sizeof(float)); ++i) {
+        K_h[i] = 0.05f * (float)((i * 11 + 5) % 41) - 1.0f;
+    }
+    // U_K[kvh, d, c] orthonormal (perm + sign) — same trick as Q' selftest.
+    int  perm[HD]  = {3, 1, 7, 0, 5, 2, 6, 4};
+    int  signs[HD] = {+1, -1, +1, +1, -1, +1, +1, -1};
+    half U_K_h[NKV * HD * HD];
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        for (int d = 0; d < HD; ++d) {
+            for (int c = 0; c < HD; ++c) {
+                const float v = (perm[d] == c) ? (float)signs[d] : 0.0f;
+                U_K_h[(((kvh * HD) + d) * HD) + c] = __float2half(v);
+            }
+        }
+    }
+
+    // -------- Reference: score_ref[q, h, k] = Q[q,h,:] · K[k, h/gqa, :] --------
+    float score_ref[N_Q * N_HEADS * N_TOKENS];
+    for (int q = 0; q < N_Q; ++q) {
+      for (int h = 0; h < N_HEADS; ++h) {
+        const int kvh = h / GQA_RATIO;
+        for (int k = 0; k < N_TOKENS; ++k) {
+            float acc = 0.0f;
+            for (int d = 0; d < HD; ++d) {
+                const float qv = Q_h[((q * N_HEADS) + h) * HD + d];
+                const float kv = K_h[((k * NKV)     + kvh) * HD + d];
+                acc += qv * kv;
+            }
+            score_ref[(q * N_HEADS + h) * N_TOKENS + k] = acc;
+        }
+      }
+    }
+
+    // -------- Allocate device buffers --------
+    float   * d_Q       = nullptr;
+    float   * d_K_src0  = nullptr;
+    int64_t * d_k_idxs  = nullptr;
+    half    * d_U_K     = nullptr;
+    half    * d_prot    = nullptr;
+    uint8_t * d_pack    = nullptr;
+    float   * d_scale   = nullptr;
+    fraqtl_k_kvh_desc * d_descs = nullptr;
+    float   * d_Qproj   = nullptr;
+    float   * d_score   = nullptr;
+
+    const int n_rows = NKV * KV_SIZE;
+    const size_t prot_n  = (size_t)n_rows * (size_t)max_rank;
+    const size_t pack_n  = (size_t)n_rows * (size_t)max_pack_stride;
+    const size_t scale_n = (size_t)n_rows;
+
+    cudaError_t e;
+    e = cudaMalloc(&d_Q,      sizeof(Q_h));                          if (e) goto fail;
+    e = cudaMalloc(&d_K_src0, sizeof(K_h));                          if (e) goto fail;
+    e = cudaMalloc(&d_k_idxs, N_TOKENS * sizeof(int64_t));           if (e) goto fail;
+    e = cudaMalloc(&d_U_K,    sizeof(U_K_h));                        if (e) goto fail;
+    e = cudaMalloc(&d_prot,   prot_n  * sizeof(half));               if (e) goto fail;
+    e = cudaMalloc(&d_pack,   pack_n  > 0 ? pack_n : 1);             if (e) goto fail;
+    e = cudaMalloc(&d_scale,  scale_n * sizeof(float));              if (e) goto fail;
+    // NKV descriptors per layer (was NKV * KV_SIZE).
+    e = cudaMalloc(&d_descs,  (size_t)NKV * sizeof(fraqtl_k_kvh_desc)); if (e) goto fail;
+    e = cudaMalloc(&d_Qproj,  sizeof(Q_h));                          if (e) goto fail;
+    e = cudaMalloc(&d_score,  N_Q * N_HEADS * N_TOKENS * sizeof(float)); if (e) goto fail;
+
+    // -------- Copy host inputs --------
+    e = cudaMemcpy(d_Q,      Q_h,    sizeof(Q_h),    cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_K_src0, K_h,    sizeof(K_h),    cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_U_K,    U_K_h,  sizeof(U_K_h),  cudaMemcpyHostToDevice); if (e) goto fail;
+    {
+        int64_t k_idxs_h[N_TOKENS];
+        for (int t = 0; t < N_TOKENS; ++t) k_idxs_h[t] = t;  // identity — slot t = token t
+        e = cudaMemcpy(d_k_idxs, k_idxs_h, sizeof(k_idxs_h), cudaMemcpyHostToDevice); if (e) goto fail;
+    }
+    e = cudaMemset(d_prot,  0, prot_n  * sizeof(half));  if (e) goto fail;
+    if (pack_n > 0) { e = cudaMemset(d_pack, 0xCD, pack_n);  if (e) goto fail; }
+    e = cudaMemset(d_scale, 0, scale_n * sizeof(float)); if (e) goto fail;
+
+    // -------- Build descriptors (per-(layer, kvh) only) --------
+    {
+        fraqtl_k_kvh_desc descs_h[NKV];
+        for (int kvh = 0; kvh < NKV; ++kvh) {
+            fraqtl_k_kvh_desc d;
+            d.prot_base   = d_prot  + (size_t)kvh * (size_t)KV_SIZE * (size_t)max_rank;
+            d.pack_base   = (pack_stride_h[kvh] > 0)
+                              ? d_pack + (size_t)kvh * (size_t)KV_SIZE * (size_t)max_pack_stride
+                              : nullptr;
+            d.scale_base  = d_scale + (size_t)kvh * (size_t)KV_SIZE;
+            d.U_K_head    = d_U_K   + (size_t)kvh * HD * HD;
+            d.rank        = ranks_h[kvh];
+            d.hd          = HD;
+            d.pack_stride = pack_stride_h[kvh];
+            d.slab_row_stride_halves = max_rank;
+            d.slab_pack_stride_bytes = max_pack_stride;
+            d.tail_bits   = 4;       // selftest uses INT4 path
+            d._pad        = 0;
+            descs_h[kvh]  = d;
+        }
+        e = cudaMemcpy(d_descs, descs_h, sizeof(descs_h), cudaMemcpyHostToDevice); if (e) goto fail;
+    }
+
+    // -------- K pack: writes C_K coeffs into slabs --------
+    {
+        const dim3 grid(N_TOKENS, NKV, 1);
+        const size_t shmem = (size_t)(HD + 1 + BLOCK_THREADS) * sizeof(float);
+        fraqtl_kv_pack_kernel_set_rows_k_from_src<int64_t>
+            <<<grid, BLOCK_THREADS, shmem>>>(
+                d_K_src0, d_k_idxs, d_descs,
+                N_TOKENS, NKV, KV_SIZE, HD,
+                /*src0_row_stride_bytes=*/(size_t)NKV * HD * sizeof(float));
+        e = cudaGetLastError();        if (e) goto fail;
+        e = cudaDeviceSynchronize();   if (e) goto fail;
+    }
+
+    // -------- Q' projection: Q'[q, h, c] = Q[q, h, :] · U_K[h/gqa, :, c] --------
+    {
+        const dim3 grid(N_Q, N_HEADS, 1);
+        const dim3 block(HD);
+        // The kernel uses U_K_layer pointer with [n_kv_heads, HD, HD]
+        // layout (one layer slice). We pass our U_K arena directly.
+        fraqtl_apply_U_K_to_Q_kernel<HD><<<grid, block>>>(
+            d_Q, d_Qproj, d_U_K,
+            /*n_q=*/N_Q, /*n_heads=*/N_HEADS, /*gqa_ratio=*/GQA_RATIO);
+        e = cudaGetLastError();        if (e) goto fail;
+        e = cudaDeviceSynchronize();   if (e) goto fail;
+    }
+
+    // -------- score via fraqtl_k_get_coeff: score = Q' · C_K.T --------
+    {
+        const dim3 grid(N_Q, N_HEADS, N_TOKENS);
+        fraqtl_k_score_parity_kernel<HD><<<grid, HD>>>(
+            d_Qproj, d_descs, d_score,
+            N_Q, N_HEADS, N_TOKENS, KV_SIZE, GQA_RATIO);
+        e = cudaGetLastError();        if (e) goto fail;
+        e = cudaDeviceSynchronize();   if (e) goto fail;
+    }
+
+    // -------- Read back fraqtl score + Q' for diagnostic --------
+    {
+        float score_fraqtl[N_Q * N_HEADS * N_TOKENS];
+        e = cudaMemcpy(score_fraqtl, d_score, sizeof(score_fraqtl), cudaMemcpyDeviceToHost);
+        if (e) goto fail;
+
+        float Q_proj_h[N_Q * N_HEADS * HD];
+        e = cudaMemcpy(Q_proj_h, d_Qproj, sizeof(Q_proj_h), cudaMemcpyDeviceToHost);
+        if (e) goto fail;
+
+        // Tolerance per internal review ():
+        //   R==HD path (fp16-only): max_abs_diff ≤ 1e-3 strictly
+        //   R<HD path (fp16 + INT4): max_abs_diff ≤ 1e-3 target;
+        //                              if exceeded, report measured diff
+        //                              for internal review interpretation (real
+        //                              INT4 noise at HD=8 small ranges may
+        //                              push above 1e-3 for some inputs).
+        // PASS / FAIL gate is the strict R==HD tolerance only. The R<HD
+        // observed diff is informational. This way the harness flags
+        // structural bugs (which would blow 1e-3 hard) without false-
+        // failing on legitimate INT4 quant noise.
+        constexpr float TOL_R_EQ_HD = 1e-3f;  // pure fp16 round-off path
+        constexpr float TOL_R_LT_HD = 1e-3f;  // target; informational if exceeded
+
+        int   n_mismatch_r_eq_hd = 0;
+        int   n_mismatch_r_lt_hd = 0;
+        float max_abs_diff           = 0.0f;
+        float max_abs_diff_r_eq_hd   = 0.0f;
+        float max_abs_diff_r_lt_hd   = 0.0f;
+        float max_rel_diff_r_eq_hd   = 0.0f;
+        float max_rel_diff_r_lt_hd   = 0.0f;
+        int   first_fail_q = -1, first_fail_h = -1, first_fail_k = -1;
+        float first_fail_ref = 0.0f, first_fail_got = 0.0f, first_fail_diff = 0.0f;
+        int   first_fail_R = 0;
+
+        for (int q = 0; q < N_Q; ++q) {
+          for (int h = 0; h < N_HEADS; ++h) {
+            const int   kvh = h / GQA_RATIO;
+            const int   R   = ranks_h[kvh];
+            const float tol = (R == HD) ? TOL_R_EQ_HD : TOL_R_LT_HD;
+            for (int k = 0; k < N_TOKENS; ++k) {
+                const int idx = (q * N_HEADS + h) * N_TOKENS + k;
+                const float ref = score_ref[idx];
+                const float got = score_fraqtl[idx];
+                const float diff = fabsf(got - ref);
+                const float rel  = (fabsf(ref) > 1e-6f) ? diff / fabsf(ref) : diff;
+                if (diff > max_abs_diff) max_abs_diff = diff;
+                if (R == HD) {
+                    if (diff > max_abs_diff_r_eq_hd) max_abs_diff_r_eq_hd = diff;
+                    if (rel  > max_rel_diff_r_eq_hd) max_rel_diff_r_eq_hd = rel;
+                    if (diff > tol) {
+                        if (first_fail_q < 0) {
+                            first_fail_q = q; first_fail_h = h; first_fail_k = k;
+                            first_fail_R = R; first_fail_ref = ref;
+                            first_fail_got = got; first_fail_diff = diff;
+                        }
+                        n_mismatch_r_eq_hd++;
+                    }
+                } else {
+                    if (diff > max_abs_diff_r_lt_hd) max_abs_diff_r_lt_hd = diff;
+                    if (rel  > max_rel_diff_r_lt_hd) max_rel_diff_r_lt_hd = rel;
+                    if (diff > tol) {
+                        n_mismatch_r_lt_hd++;
+                    }
+                }
+            }
+          }
+        }
+        const int n_mismatch = n_mismatch_r_eq_hd;  // gate ONLY on R==HD
+
+        // Always dump the comparison matrix for human inspection.
+        fprintf(stderr,
+            "fraqtl: K_SCORE_PARITY_DUMP HD=%d NKV=%d N_HEADS=%d N_Q=%d N_TOKENS=%d "
+            "ranks=[%d,%d] gqa_ratio=%d\n",
+            HD, NKV, N_HEADS, N_Q, N_TOKENS, ranks_h[0], ranks_h[1], GQA_RATIO);
+
+        for (int q = 0; q < N_Q; ++q) {
+          for (int h = 0; h < N_HEADS; ++h) {
+            const int kvh = h / GQA_RATIO;
+            const int R   = ranks_h[kvh];
+            for (int k = 0; k < N_TOKENS; ++k) {
+                const int idx = (q * N_HEADS + h) * N_TOKENS + k;
+                fprintf(stderr,
+                    "  q=%d h=%d kvh=%d R=%d k=%d  ref=%+.6f  got=%+.6f  diff=%+.6e\n",
+                    q, h, kvh, R, k, score_ref[idx], score_fraqtl[idx],
+                    score_fraqtl[idx] - score_ref[idx]);
+            }
+          }
+        }
+
+        cudaFree(d_Q);     cudaFree(d_K_src0); cudaFree(d_k_idxs); cudaFree(d_U_K);
+        cudaFree(d_prot);  cudaFree(d_pack);   cudaFree(d_scale);  cudaFree(d_descs);
+        cudaFree(d_Qproj); cudaFree(d_score);
+
+        if (n_mismatch > 0) {
+            fprintf(stderr,
+                "fraqtl: K_SCORE_PARITY_FAIL "
+                "max_abs_diff=%.6e "
+                "max_abs_diff_R_eq_HD=%.6e tol_R_eq_HD=%.6e n_mismatch_R_eq_HD=%d "
+                "max_abs_diff_R_lt_HD=%.6e tol_R_lt_HD=%.6e n_mismatch_R_lt_HD=%d "
+                "max_rel_diff_R_eq_HD=%.6e max_rel_diff_R_lt_HD=%.6e "
+                "first_fail q=%d h=%d k=%d R=%d ref=%+.6f got=%+.6f diff=%+.6e\n",
+                max_abs_diff,
+                max_abs_diff_r_eq_hd, TOL_R_EQ_HD, n_mismatch_r_eq_hd,
+                max_abs_diff_r_lt_hd, TOL_R_LT_HD, n_mismatch_r_lt_hd,
+                max_rel_diff_r_eq_hd, max_rel_diff_r_lt_hd,
+                first_fail_q, first_fail_h, first_fail_k, first_fail_R,
+                first_fail_ref, first_fail_got, first_fail_diff);
+            fflush(stderr);
+            return 1;
+        }
+        fprintf(stderr,
+            "fraqtl: K_SCORE_PARITY_PASS HD=%d NKV=%d ranks=[%d,%d] "
+            "max_abs_diff=%.6e "
+            "max_abs_diff_R_eq_HD=%.6e tol_R_eq_HD=%.6e "
+            "max_abs_diff_R_lt_HD=%.6e tol_R_lt_HD=%.6e n_mismatch_R_lt_HD_informational=%d "
+            "max_rel_diff_R_eq_HD=%.6e max_rel_diff_R_lt_HD=%.6e "
+            "(gate=R==HD strict; R<HD informational)\n",
+            HD, NKV, ranks_h[0], ranks_h[1], max_abs_diff,
+            max_abs_diff_r_eq_hd, TOL_R_EQ_HD,
+            max_abs_diff_r_lt_hd, TOL_R_LT_HD, n_mismatch_r_lt_hd,
+            max_rel_diff_r_eq_hd, max_rel_diff_r_lt_hd);
+        fflush(stderr);
+        return 0;
+    }
+
+fail:
+    fprintf(stderr,
+        "fraqtl: K_SCORE_PARITY_CUDA_ERROR err=%d (%s)\n",
+        (int)e, cudaGetErrorString(e));
+    fflush(stderr);
+    if (d_Q)      cudaFree(d_Q);
+    if (d_K_src0) cudaFree(d_K_src0);
+    if (d_k_idxs) cudaFree(d_k_idxs);
+    if (d_U_K)    cudaFree(d_U_K);
+    if (d_prot)   cudaFree(d_prot);
+    if (d_pack)   cudaFree(d_pack);
+    if (d_scale)  cudaFree(d_scale);
+    if (d_descs)  cudaFree(d_descs);
+    if (d_Qproj)  cudaFree(d_Qproj);
+    if (d_score)  cudaFree(d_score);
+    return 2;
+}
diff --git a/ggml/src/ggml-cuda/fraqtl-kv.cuh b/ggml/src/ggml-cuda/fraqtl-kv.cuh
