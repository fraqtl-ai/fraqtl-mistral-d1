+        // ---- KQ for this tile (one thread per s, BLOCK_S == HD == 64) -----
+        if (d < tile_n) {
+            const int s = s_start + d;
+            const half * K_row = (const half *) (K_base
+                               + (size_t) batch * K_nb3
+                               + (size_t) kvh   * K_nb2
+                               + (size_t) s     * K_nb1);
+            float qk = 0.0f;
+            #pragma unroll
+            for (int i = 0; i < HD; ++i) {
+                qk += Q_smem[i] * __half2float(K_row[i]);
+            }
+            qk *= scale;
+
+            if (mask_base) {
+                // mask layout: ne[0] = n_kv (s axis), ne[1] = n_tokens.
+                // mask_row points to s=0 of this token; mask_row[s] is the
+                // value we need. nb[0] = sizeof(half) by convention.
+                const int t_clamped = (token < mask_n_tokens) ? token : 0;
+                const half * mask_row = (const half *) (mask_base
