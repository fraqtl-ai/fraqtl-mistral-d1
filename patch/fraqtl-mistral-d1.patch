+extern "C" int fraqtl_runtime_setup(
+    void * d_eigenbasis,
+    int32_t n_layers, int32_t n_kv, int32_t head_dim, int32_t k_protect,
+    int32_t scratch_n_ctx,
+    int32_t n_heads_q, int32_t max_n_tokens
+) {
+    g_fraqtl.d_U          = d_eigenbasis;
+    g_fraqtl.n_layers     = n_layers;
+    g_fraqtl.n_kv         = n_kv;
+    g_fraqtl.hd           = head_dim;
+    g_fraqtl.k_protect    = k_protect;
+    //  staging compaction. When FRAQTL_STAGING_COMPACT is
+    // set, size the d_packed/d_scale/d_protected staging for one ubatch
+    // (max_n_tokens rows) rather than the full context. The per-ubatch pack
+    // hook stages only one ubatch at a time; full-context staging was for the
+    // Day-11 roundtrip, dead in ONLINE mode. Falls back to full context if
+    // max_n_tokens was not plumbed (0). Flag OFF = unchanged.
+    {
+        const int32_t staging_n_ctx =
+            (fraqtl_staging_compact_enabled() && max_n_tokens > 0)
+            ? max_n_tokens
+            : scratch_n_ctx;
+        g_fraqtl.scratch_rows = staging_n_ctx * n_kv;
+    }
+
+    //  dynamic-harness audit: log the model dims that came in.
+    // n_heads_q + max_n_tokens are no longer hardcoded; they're plumbed
+    // from llama-context.cpp via model.hparams.n_head + cparams.n_ubatch.
+    // Any future receipt MUST capture these values so multi-model receipts
+    // can be distinguished from each other.
+    fprintf(stderr,
+        "fraqtl: runtime_setup — k_protect=%d n_layers=%d n_kv=%d head_dim=%d "
+        "scratch_n_ctx=%d n_heads_q=%d max_n_tokens=%d (DYNAMIC)\n",
+        k_protect, n_layers, n_kv, head_dim, scratch_n_ctx,
+        n_heads_q, max_n_tokens);
+    fflush(stderr);
+
+    // Sanity bounds — catch obviously-wrong dynamic values before they
+    // poison the arena layout or per-layer kernel launch dims.
+    if (n_heads_q <= 0 || n_heads_q > 256) {
+        fprintf(stderr,
+            "fraqtl: SETUP_FAIL n_heads_q=%d out of expected range (1..256). "
+            "Caller must pass model.hparams.n_head, not a hardcoded constant.\n",
+            n_heads_q);
+        fflush(stderr);
+        return 100;
+    }
+    if (max_n_tokens <= 0 || max_n_tokens > 16384) {
+        fprintf(stderr,
+            "fraqtl: SETUP_FAIL max_n_tokens=%d out of expected range (1..16384). "
+            "Caller must pass cparams.n_ubatch, not a hardcoded constant.\n",
+            max_n_tokens);
+        fflush(stderr);
+        return 101;
+    }
+
+    const int sac_dims      = head_dim - k_protect;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+    const size_t packed_sz  = (size_t) g_fraqtl.scratch_rows * packed_bytes;
+    const size_t scale_sz   = (size_t) g_fraqtl.scratch_rows * sizeof(float);
+    const size_t prot_sz    = (size_t) g_fraqtl.scratch_rows * k_protect * sizeof(half);
+
+    //  FraqtlArena create (env-gated FRAQTL_USE_ARENA=1).
+    // Moved BEFORE the d_packed/d_scale/d_protected cudaMallocs so
+    // can route those 3 pointers through arena suballocations when active.
+    // sink_n/residual_n aren't known yet (set later by
+    // fraqtl_runtime_set_step59_config). Use the internal product
+    // config defaults (sink=8, residual=2048). Non-default user configs
+    // are out of scope for v0 — the arena would over-size for smaller
+    // values (harmless waste) or potentially under-size for larger values
+    // (would crash; documented limitation).
+    {
+        const char * env = std::getenv("FRAQTL_USE_ARENA");
+        const bool use_arena = (env && env[0] == '1');
+        if (use_arena) {
+            //  dynamic-harness: n_heads_q + max_n_tokens come from
+            // the caller (llama-context.cpp passes hparams.n_head + cparams.n_ubatch).
+            // No more Qwen 7B hardcoding — same code path now serves Mistral 7B
+            // (n_heads_q=32), Llama 3.1 8B (n_heads_q=32), Qwen 14B (n_heads_q=40), etc.
+            fraqtl_arena_config_t cfg = {};
+            cfg.n_layers     = n_layers;
+            cfg.n_kv_heads   = n_kv;
+            cfg.n_heads_q    = n_heads_q;        // dynamic, was hardcoded 28
+            cfg.head_dim     = head_dim;
+            cfg.kv_size      = scratch_n_ctx;
+            cfg.max_n_tokens = max_n_tokens;     // dynamic, was hardcoded 2048
+            cfg.k_protect    = k_protect;
+            cfg.v_protect    = k_protect;
+            cfg.k_rank_max   = head_dim;
+            cfg.v_rank_max   = head_dim;
+            cfg.sink_n       = 8;           // internal product default
+            cfg.residual_n   = 2048;        // internal product default
+
+            //  production opts: skip_compressed_kv=1.
+            // ggml's KV cache buffer owns the compressed K/V storage (set_rows
+            // hooks write into it directly). Arena reserving those regions was
+            // double-counting at smi peak (~1456 MiB on Qwen 7B / 64K).
+            // Pre-flight grep audit () confirmed ZERO production
+            // callers of fraqtl_arena_compressed_k/v. Defensive accessor
+            // guards return nullptr if anything ever calls them under skip=1.
+            fraqtl_arena_opts_t opts = {};
+            opts.skip_compressed_kv = 1;
+
+            int rc = fraqtl_arena_create_with_opts(&cfg, &opts, &g_fraqtl.arena);
+            if (rc != 0) {
+                fprintf(stderr,
+                    "fraqtl: ARENA_CREATE_FAIL rc=%d (Phase 2 — falling back "
+                    "to scattered cudaMalloc path for this context)\n", rc);
+                fflush(stderr);
+                g_fraqtl.arena = nullptr;
+                g_fraqtl.arena_active = false;
+            } else {
+                g_fraqtl.arena_active = true;
+                fraqtl_arena_layout_t layout = {};
+                fraqtl_arena_get_layout(g_fraqtl.arena, &layout);
+                //  cache arena's qprime capacity
+                // so get_qprime_workspace can validate request size without
+                // querying the layout on every call.
+                g_fraqtl.arena_qprime_capacity_bytes = layout.qprime_scratch_bytes;
+                fprintf(stderr,
+                    "fraqtl: ARENA_INTEGRATED stage=6 active=1 skip_compressed_kv=%d "
+                    "total_bytes=%zu (%.2f MiB) "
+                    "n_layers=%d n_kv=%d n_heads_q=%d head_dim=%d kv_size=%d max_n_tokens=%d "
+                    "(DYNAMIC dims) — production: ggml owns compressed K/V; "
+                    "arena holds staging + sink/residual + descriptors + Q'\n",
+                    opts.skip_compressed_kv,
+                    layout.total_bytes, layout.total_bytes / (1024.0*1024.0),
+                    n_layers, n_kv, n_heads_q, head_dim, scratch_n_ctx, max_n_tokens);
+                fflush(stderr);
+                //  internal review memory ledger: probe immediately after
+                // arena allocation so internal review's ledger table can
+                // attribute the arena's contribution to live VRAM.
+            }
+        }
+    }
+
+    //  route d_packed/d_scale/d_protected through
+    // arena when active; fall back to scattered cudaMalloc otherwise.
+    if (g_fraqtl.arena_active) {
+        g_fraqtl.d_packed    = fraqtl_arena_staging_packed(g_fraqtl.arena);
+        g_fraqtl.d_scale     = (float *) fraqtl_arena_staging_scale(g_fraqtl.arena);
+        g_fraqtl.d_protected = (half  *) fraqtl_arena_staging_protected(g_fraqtl.arena);
+        //  — accessors return nullptr when FRAQTL_SKIP_DEAD_STAGING=1
+        // (arena zero-sized the region). Treat as L3 sentinel: leave pointers
+        // null, skip the bind log, do NOT return failure.
+        const bool l3_active = (g_fraqtl.d_packed == nullptr
+                                && g_fraqtl.d_scale == nullptr
+                                && g_fraqtl.d_protected == nullptr);
+        if (l3_active) {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE2_L3_SKIP — staging slabs zero-sized in "
+                "arena (FRAQTL_SKIP_DEAD_STAGING=1). Saved %.1f MiB. Readers "
+                "guarded by ONLINE-mode fatal fence in fattn.cu.\n",
+                (packed_sz + scale_sz + prot_sz) / (1024.0 * 1024.0));
+            fflush(stderr);
+        } else if (!g_fraqtl.d_packed || !g_fraqtl.d_scale || !g_fraqtl.d_protected) {
+            // partial bind — one nullptr but not all three. That's a real
+            // failure (the arena had a sizing bug, not an intentional skip).
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE2_BIND_FAIL packed=%p scale=%p prot=%p\n",
+                g_fraqtl.d_packed, (void*)g_fraqtl.d_scale, (void*)g_fraqtl.d_protected);
+            fflush(stderr);
+            return 1;
+        } else {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE2_SWAP cudaMallocs_eliminated=3 "
+                "packed=%zu scale=%zu protected=%zu (bytes)\n",
+                packed_sz, scale_sz, prot_sz);
+            fflush(stderr);
+        }
+    } else {
+        //  LEVER 3 — skip the d_packed/d_scale/d_protected staging
+        // slabs entirely when FRAQTL_SKIP_DEAD_STAGING=1.
+        // Readers: ONLY fraqtl_runtime_roundtrip_v (ggml-cuda/fraqtl-kv.cu
+        // ~5150) and its caller fraqtl_runtime_decode_v_incremental (~5215).
+        // Both are the Day-11 fallback path. fattn.cu (~1487-1502) calls
+        // std::abort() before reaching decode_v_incremental in ONLINE mode
+        // so in production these slabs are read by no one.
+        // Sizing: scratch_rows × (V_PROTECT*2 + packed_bytes + 4). At Mistral
+        // 7B 128K (kv_size=131072, n_kv=8, HD=128, V_PROTECT=32, SAC=8):
+        // scratch_rows = 131072 × 8 = 1,048,576. Per-row bytes ≈ 32*2 + (15
+        // groups × 3) + 4 = 113. Total ≈ 113 MiB. (50-70 MiB at smaller
+        // contexts.) Free path (lines ~2253-2257) is already null-safe.
+        // SAFE: if any non-product path (test, dev, FRAQTL_DISABLE_DESC_FUSED)
+        // ever actually reaches roundtrip_v with these nullptrs, the kernel
+        // would deref null and abort cleanly — a louder failure than today's
+        // silent waste. That's why this is opt-in via env, not default.
+        const char * skip_dead = std::getenv("FRAQTL_SKIP_DEAD_STAGING");
+        if (skip_dead && std::atoi(skip_dead) != 0) {
+            g_fraqtl.d_packed    = nullptr;
+            g_fraqtl.d_scale     = nullptr;
+            g_fraqtl.d_protected = nullptr;
+            fprintf(stderr,
+                "fraqtl: LEVER3_SKIP_DEAD_STAGING engaged — saved %.1f MiB "
+                "(packed=%zu scale=%zu protected=%zu bytes). Readers are "
+                "guarded in fattn.cu (ONLINE-mode fatal fence; dead-path "
+                "only).\n",
+                (packed_sz + scale_sz + prot_sz) / (1024.0 * 1024.0),
+                packed_sz, scale_sz, prot_sz);
+            fflush(stderr);
+        } else {
+            cudaError_t e;
+            e = cudaMalloc(&g_fraqtl.d_packed,    packed_sz); if (e != cudaSuccess) return 1;
+            e = cudaMalloc(&g_fraqtl.d_scale,     scale_sz);  if (e != cudaSuccess) return 2;
+            e = cudaMalloc(&g_fraqtl.d_protected, prot_sz);   if (e != cudaSuccess) return 3;
+        }
+    }
+
+    g_fraqtl.active = true;
+    // ONLINE_FROM_START: default mode is ONLINE so PPL/eval flows
+    // (which don't call llama_fraqtl_compress_cache) still engage the
+    // fraqtl bypass + descriptor adapter from the very first set_rows.
+    // Without this, PPL silently runs fp16 because nothing flips DEFERRED→ONLINE.
+    // 's set-rows.cu bypass is mandatory in ONLINE; see set-rows.cu.
+    g_fraqtl.mode   = fraqtl_runtime_state::MODE_ONLINE;
+    for (int i = 0; i < FRAQTL_MAX_LAYERS; ++i) {
+        g_fraqtl.last_compressed_rows[i] = 0;
+        // re-land: clear audit verdict cache so a second context
+        // in the same process starts fresh (multi-context safety).
+        g_fraqtl.audit_done[i] = 0;
+        g_fraqtl.set_rows_hook_calls[i] = 0;
+    }
+    // Path A: reset the early-release callback state too so a fresh
+    // setup gives a clean slate (multi-context safety).
+    g_fraqtl.release_callback       = nullptr;
+    g_fraqtl.release_callback_user  = nullptr;
+    g_fraqtl.release_callback_fired = false;
+
+    fprintf(stderr, "fraqtl: runtime mode=ONLINE_FROM_START — set-rows bypass + descriptor "
+                    "engaged from the first batch. compress_cache() is now an audit-only no-op.\n");
+    fflush(stderr);
+
+    return 0;
+}
+
+// free per-layer sink+residual fp16 buffers.
+// Per solutions_fraqtl_runtime_patterns.md Pattern 2: free ONLY the device
+// allocation, do NOT touch any external tensor metadata. These buffers have
+// no external metadata clients (they're owned end-to-end by g_fraqtl), but
+// follow the pattern anyway. Zero pointers + byte counts so a subsequent
+// teardown / re-setup gets a clean slate.
+// Safe to call when buffers are nullptr (no-op per layer).
+//  when arena is active, the per-layer pointers
+// are arena suballocations (NOT individually cudaMalloc'd). The single
+// fraqtl_arena_destroy() at teardown frees the whole region. Skip the
+// 112 individual cudaFrees here to avoid double-free on arena memory.
+// Pointers are still set to nullptr for state hygiene (lets the next
+// step59_alloc_buffers cycle re-bind cleanly).
+static void step59_free_buffers() {
+    const bool arena_owns = g_fraqtl.arena_active;
+    for (int L = 0; L < FRAQTL_MAX_LAYERS; ++L) {
+        if (g_fraqtl.sink_K_buf[L])     { if (!arena_owns) cudaFree(g_fraqtl.sink_K_buf[L]);     g_fraqtl.sink_K_buf[L]     = nullptr; }
+        if (g_fraqtl.sink_V_buf[L])     { if (!arena_owns) cudaFree(g_fraqtl.sink_V_buf[L]);     g_fraqtl.sink_V_buf[L]     = nullptr; }
+        if (g_fraqtl.residual_K_buf[L]) { if (!arena_owns) cudaFree(g_fraqtl.residual_K_buf[L]); g_fraqtl.residual_K_buf[L] = nullptr; }
+        if (g_fraqtl.residual_V_buf[L]) { if (!arena_owns) cudaFree(g_fraqtl.residual_V_buf[L]); g_fraqtl.residual_V_buf[L] = nullptr; }
+    }
+    g_fraqtl.sink_K_bytes_per_layer     = 0;
+    g_fraqtl.sink_V_bytes_per_layer     = 0;
+    g_fraqtl.residual_K_bytes_per_layer = 0;
+    g_fraqtl.residual_V_bytes_per_layer = 0;
+    g_fraqtl.step59_total_bytes         = 0;
+}
+
+// allocate per-layer sink+residual fp16 buffers.
+// Preconditions (caller-checked):
+//   - sink_n > 0 OR residual_n > 0
+//   - g_fraqtl.n_kv > 0, g_fraqtl.hd > 0, g_fraqtl.n_layers > 0 (i.e. setup ran)
+//   - g_fraqtl.n_layers <= FRAQTL_MAX_LAYERS
+// Allocates 4 buffers per layer (sink K, sink V, residual K, residual V) when
+// the corresponding window size > 0. Skipped when its size = 0 (e.g. sink_n=0
+// + residual_n=128 only allocates residual buffers — sink pointers stay null).
+// Each buffer is cudaMemset(0)-initialized so a fattn read on an unwritten
+// slot returns zeroed fp16 (defined behavior; the read-side branch in 5.9.4
+// will only happen for slots that were actually written via the K_pack hook
+// in 5.9.3, but zero-init guards against any window-edge race during the
+// first prefill batch).
+// Caches per-layer byte counts in g_fraqtl for receipt accounting.
+// Returns 0 on success, non-zero (the cudaError_t cast to int) on failure.
+// On failure, partially-allocated buffers are freed via step59_free_buffers
+// so the runtime never holds a half-allocated state.
+static int step59_alloc_buffers() {
+    const int L_count = g_fraqtl.n_layers;
+    const int NKV     = g_fraqtl.n_kv;
+    const int HD      = g_fraqtl.hd;
+    const int sink_n     = g_fraqtl.sink_n;
+    const int residual_n = g_fraqtl.residual_n;
+
+    const size_t sink_bytes_per_layer     = (sink_n     > 0)
+        ? (size_t) HD * (size_t) sink_n     * (size_t) NKV * sizeof(half) : 0;
+    const size_t residual_bytes_per_layer = (residual_n > 0)
+        ? (size_t) HD * (size_t) residual_n * (size_t) NKV * sizeof(half) : 0;
+
+    //  when arena is active, route per-layer
+    // sink/residual K+V buffers through arena suballocations instead of
+    // cudaMalloc. Memory is the same (arena pre-reserved these regions in
+    // layout); only the allocator changes. Math unchanged.
+    cudaError_t e = cudaSuccess;
+    int stage3_eliminated = 0;
+    for (int L = 0; L < L_count; ++L) {
+        if (sink_n > 0) {
+            if (g_fraqtl.arena_active) {
+                g_fraqtl.sink_K_buf[L] = (half *) fraqtl_arena_sink_k(g_fraqtl.arena, L);
+                g_fraqtl.sink_V_buf[L] = (half *) fraqtl_arena_sink_v(g_fraqtl.arena, L);
+                if (!g_fraqtl.sink_K_buf[L] || !g_fraqtl.sink_V_buf[L]) {
+                    fprintf(stderr,
+                        "fraqtl: ARENA_STAGE3_BIND_FAIL L=%d sink_K=%p sink_V=%p\n",
+                        L, (void*)g_fraqtl.sink_K_buf[L], (void*)g_fraqtl.sink_V_buf[L]);
+                    fflush(stderr);
+                    e = cudaErrorInvalidValue;
+                    goto fail;
+                }
+                stage3_eliminated += 2;
+            } else {
+                e = cudaMalloc((void**) &g_fraqtl.sink_K_buf[L], sink_bytes_per_layer);
+                if (e != cudaSuccess) goto fail;
+                e = cudaMalloc((void**) &g_fraqtl.sink_V_buf[L], sink_bytes_per_layer);
+                if (e != cudaSuccess) goto fail;
+            }
+            cudaMemset(g_fraqtl.sink_K_buf[L], 0, sink_bytes_per_layer);
+            cudaMemset(g_fraqtl.sink_V_buf[L], 0, sink_bytes_per_layer);
+        }
+        if (residual_n > 0) {
+            if (g_fraqtl.arena_active) {
+                g_fraqtl.residual_K_buf[L] = (half *) fraqtl_arena_residual_k(g_fraqtl.arena, L);
+                g_fraqtl.residual_V_buf[L] = (half *) fraqtl_arena_residual_v(g_fraqtl.arena, L);
+                if (!g_fraqtl.residual_K_buf[L] || !g_fraqtl.residual_V_buf[L]) {
+                    fprintf(stderr,
+                        "fraqtl: ARENA_STAGE3_BIND_FAIL L=%d residual_K=%p residual_V=%p\n",
+                        L, (void*)g_fraqtl.residual_K_buf[L], (void*)g_fraqtl.residual_V_buf[L]);
+                    fflush(stderr);
+                    e = cudaErrorInvalidValue;
+                    goto fail;
+                }
+                stage3_eliminated += 2;
+            } else {
+                e = cudaMalloc((void**) &g_fraqtl.residual_K_buf[L], residual_bytes_per_layer);
+                if (e != cudaSuccess) goto fail;
+                e = cudaMalloc((void**) &g_fraqtl.residual_V_buf[L], residual_bytes_per_layer);
+                if (e != cudaSuccess) goto fail;
+            }
+            cudaMemset(g_fraqtl.residual_K_buf[L], 0, residual_bytes_per_layer);
+            cudaMemset(g_fraqtl.residual_V_buf[L], 0, residual_bytes_per_layer);
+        }
+    }
+
+    g_fraqtl.sink_K_bytes_per_layer     = sink_bytes_per_layer;
+    g_fraqtl.sink_V_bytes_per_layer     = sink_bytes_per_layer;
+    g_fraqtl.residual_K_bytes_per_layer = residual_bytes_per_layer;
+    g_fraqtl.residual_V_bytes_per_layer = residual_bytes_per_layer;
+    g_fraqtl.step59_total_bytes =
+        (size_t) L_count * (2 * sink_bytes_per_layer + 2 * residual_bytes_per_layer);
+
+    //  emit swap log line in EXACT format that
+    // the harness regex matches (modal_fraqtl_step517_arena_stage3.py).
+    // Per-layer bytes; harness multiplies by L_count internally if needed.
+    if (g_fraqtl.arena_active && stage3_eliminated > 0) {
+        fprintf(stderr,
+            "fraqtl: ARENA_STAGE3_SWAP cudaMallocs_eliminated=%d "
+            "sink_k=%zu sink_v=%zu residual_k=%zu residual_v=%zu\n",
+            stage3_eliminated,
+            sink_bytes_per_layer, sink_bytes_per_layer,
+            residual_bytes_per_layer, residual_bytes_per_layer);
+        fflush(stderr);
+    }
+    return 0;
+
+fail:
+    fprintf(stderr,
+        "fraqtl: STEP59_ALLOC_FAIL cuda=%s sink_n=%d residual_n=%d L=%d HD=%d NKV=%d\n",
+        cudaGetErrorString(e), sink_n, residual_n, L_count, HD, NKV);
+    fflush(stderr);
+    step59_free_buffers();
+    return (int) e;
+}
+
+extern "C" void fraqtl_runtime_teardown(void) {
+    // emit STEP59_WRITE_STATS BEFORE we free anything so the
+    // counters reflect the full lifetime of the context. No-op when
+    // was disabled (all counters zero).
+    fraqtl_runtime_log_step59_write_stats();
+
+    //  emit QPRIME_WORKSPACE_STATS before freeing so the
+    // receipt has the singleton's full lifetime stats. Acceptance criterion
+    // is alloc_count == 1 after warmup; if > 1, the grow path was hit more
+    // than once which means the heuristic missed (max-ubatch chunk arriving
+    // later than expected, e.g. variable-length sequences).
+    fprintf(stderr,
+        "fraqtl: QPRIME_WORKSPACE_STATS alloc_count=%lld get_calls=%lld "
+        "final_bytes=%zu peak_bytes=%zu\n",
+        (long long) g_fraqtl.qprime_alloc_count,
+        (long long) g_fraqtl.qprime_get_calls,
+        g_fraqtl.qprime_workspace_bytes,
+        g_fraqtl.qprime_workspace_peak_bytes);
+    fflush(stderr);
+
+    //  FRAQTL_RUNTIME_BYTES_SUMMARY: single receipt line
+    // aggregating every byte the runtime owns. Harness parses this to build
+    // the memory ledger. Sum check vs nvidia-smi peak + common_memory_breakdown
+    // proves where the bytes went.
+    size_t step59_total = g_fraqtl.step59_total_bytes;
+    fprintf(stderr,
+        "fraqtl: RUNTIME_BYTES_SUMMARY "
+        "qprime_bytes=%zu qprime_peak_bytes=%zu "
+        "step59_total_bytes=%zu "
+        "sink_K_per_layer=%zu sink_V_per_layer=%zu "
+        "residual_K_per_layer=%zu residual_V_per_layer=%zu "
+        "n_layers=%d n_kv=%d hd=%d k_protect=%d\n",
+        g_fraqtl.qprime_workspace_bytes,
+        g_fraqtl.qprime_workspace_peak_bytes,
+        step59_total,
+        g_fraqtl.sink_K_bytes_per_layer, g_fraqtl.sink_V_bytes_per_layer,
+        g_fraqtl.residual_K_bytes_per_layer, g_fraqtl.residual_V_bytes_per_layer,
+        g_fraqtl.n_layers, g_fraqtl.n_kv, g_fraqtl.hd, g_fraqtl.k_protect);
+    fflush(stderr);
+
+    //  when arena is active, d_packed/d_scale/
+    // d_protected are arena suballocations (NOT individually cudaMalloc'd).
+    // The single fraqtl_arena_destroy() below frees the whole region. Skip
+    // these individual cudaFrees to avoid double-free on arena memory.
+    if (!g_fraqtl.arena_active) {
+        if (g_fraqtl.d_packed)    cudaFree(g_fraqtl.d_packed);
+        if (g_fraqtl.d_scale)     cudaFree(g_fraqtl.d_scale);
+        if (g_fraqtl.d_protected) cudaFree(g_fraqtl.d_protected);
+    }
+    //  — free the singleton Q' workspace. Safe on null.
+    //  when arena owns the workspace, skip the
+    // individual cudaFree (arena_destroy below frees the whole region).
+    if (g_fraqtl.qprime_workspace && !g_fraqtl.arena_active) cudaFree(g_fraqtl.qprime_workspace);
+    // free sink+residual buffers BEFORE zeroing the struct so
+    // the per-layer pointers are still readable. Idempotent (safe on null).
+    step59_free_buffers();
+    //  destroy the FraqtlArena (env-gated by
+    // FRAQTL_USE_ARENA=1 at create). Single cudaFree replaces 199 in
+    // . Safe on null.
+    if (g_fraqtl.arena) {
+        fraqtl_arena_destroy(g_fraqtl.arena);
+        g_fraqtl.arena = nullptr;
+    }
+    g_fraqtl = fraqtl_runtime_state{};
+}
+
+// config setter. Stores sink_n / residual_n in g_fraqtl so
+// register_layer_*_slabs () and the K_pack/V_pack hooks
+// () can read them. = field assignment + log only;
+// no buffers allocated yet.
+// Prints a single audit line so the harness can confirm the values that
+// reached the runtime, distinct from the values the user passed on the CLI
+// (catches plumbing bugs between common_params → llama_context_params →
+// llama_cparams → runtime).
+extern "C" void fraqtl_runtime_set_step59_config(int32_t sink_n, int32_t residual_n) {
+    g_fraqtl.sink_n     = (sink_n     < 0) ? 0 : sink_n;
+    g_fraqtl.residual_n = (residual_n < 0) ? 0 : residual_n;
+
+    // Free any previously-allocated buffers before re-deciding. Handles
+    // multi-context init in the same process and the "user changes flags
+    // mid-process" edge case (no-op when buffers were never allocated).
+    step59_free_buffers();
+
+    if (g_fraqtl.sink_n == 0 && g_fraqtl.residual_n == 0) {
+        fprintf(stderr,
+            "fraqtl: STEP59_CONFIG sink_n=0 residual_n=0 (DISABLED — "
+            "Step 5.8 path runs unmodified, no new behavior)\n");
+        fflush(stderr);
+        return;
+    }
+
+    // allocate per-layer fp16 buffers now that sink_n / residual_n
+    // are set AND fraqtl_runtime_setup has populated n_kv / hd / n_layers.
+    // If setup hasn't run yet (g_fraqtl.n_kv == 0 etc.), defer allocation
+    // fraqtl is fully off, no buffers needed. / 5.9.5
+    // also gate their behavior on the buffer pointers being non-null.
+    const bool setup_ran =
+        g_fraqtl.n_kv > 0 && g_fraqtl.hd > 0 && g_fraqtl.n_layers > 0
+        && g_fraqtl.n_layers <= FRAQTL_MAX_LAYERS;
+
+    if (!setup_ran) {
+        fprintf(stderr,
+            "fraqtl: STEP59_CONFIG sink_n=%d residual_n=%d "
+            "(ENABLED but fraqtl runtime not yet set up — buffers stay null; "
+            "n_kv=%d hd=%d n_layers=%d)\n",
+            g_fraqtl.sink_n, g_fraqtl.residual_n,
+            g_fraqtl.n_kv, g_fraqtl.hd, g_fraqtl.n_layers);
+        fflush(stderr);
+        return;
+    }
+
+    const int rc = step59_alloc_buffers();
+    if (rc != 0) {
+        // Allocation failure — clear flags so no downstream code thinks
+        // is active. The earlier STEP59_ALLOC_FAIL line tells the harness why.
+        g_fraqtl.sink_n     = 0;
+        g_fraqtl.residual_n = 0;
+        return;
+    }
+
+    fprintf(stderr,
+        "fraqtl: STEP59_CONFIG sink_n=%d residual_n=%d "
+        "(ENABLED — K+V fp16 wrapper buffers allocated)\n",
+        g_fraqtl.sink_n, g_fraqtl.residual_n);
+    // Per-buffer accounting line. Harness greps STEP59_BUFFERS_ALLOC for
+    // receipt fields. All five sizes are EXACT bytes (not MiB-rounded).
+    fprintf(stderr,
+        "fraqtl: STEP59_BUFFERS_ALLOC "
+        "sink_K_bytes_per_layer=%zu sink_V_bytes_per_layer=%zu "
+        "residual_K_bytes_per_layer=%zu residual_V_bytes_per_layer=%zu "
+        "n_layers=%d step59_total_bytes=%zu step59_total_MiB=%.3f\n",
+        g_fraqtl.sink_K_bytes_per_layer, g_fraqtl.sink_V_bytes_per_layer,
+        g_fraqtl.residual_K_bytes_per_layer, g_fraqtl.residual_V_bytes_per_layer,
+        g_fraqtl.n_layers, g_fraqtl.step59_total_bytes,
+        (double) g_fraqtl.step59_total_bytes / (1024.0 * 1024.0));
+    fflush(stderr);
+}
+
+extern "C" void fraqtl_runtime_get_step59_config(int32_t * sink_n_out, int32_t * residual_n_out) {
+    if (sink_n_out)     *sink_n_out     = g_fraqtl.sink_n;
+    if (residual_n_out) *residual_n_out = g_fraqtl.residual_n;
+}
+
+// non-regression log for 's collapsed descriptor footprint.
+// Sums sizeof(fraqtl_k_kvh_desc) * n_kv_heads across all active layers and
+// prints `STEP58_DESC_BYTES total=<T> per_layer=<P>`. Harness asserts T=6272
+// for Qwen 7B (4 KV heads × 28 layers × 56-byte desc post-alignment-fix).
+// Called at the end of fraqtl_runtime_setup() so the receipt has the value
+// at the same point in the lifecycle for every run.
+// emit STEP59_WRITE_STATS line summarising per-layer
+// double-write counters.
+// Idempotent across calls: g_fraqtl.step59_write_stats_logged guards repeat
+// emission within a single context lifetime, so calling from teardown AND
+// from a future engine probe never double-prints. Reset on next setup
+// (struct re-initialised in teardown).
+// The line carries:
+//   - sink_writes_K / sink_writes_V totals across layers
+//   - residual_writes_K / residual_writes_V totals (= cumulative tokens hooked)
+//   - overwrite_K / overwrite_V total residual writes that hit a
+//                                          modular index already used by a
+//                                          prior compressed slot (must equal
+//                                          max(0, residual_writes - residual_n)
+//                                          per layer, summed)
+//   - residual_n / sink_n the configured window sizes
+// "compressed slab writes still happen" is verifiable from the existing
+// per-layer set_rows_hook_calls counter (which the K/V hooks increment
+// AFTER calling the compress kernel — same as before ). We surface
+// the per-layer call counter sum as set_rows_hook_calls_total so the harness
+// can confirm both paths fired.
+extern "C" void fraqtl_runtime_log_step59_write_stats(void) {
+    if (g_fraqtl.step59_write_stats_logged) return;
+    g_fraqtl.step59_write_stats_logged = true;
+
+    int64_t sink_K = 0, sink_V = 0, res_K = 0, res_V = 0, ow_K = 0, ow_V = 0;
+    int64_t set_rows_calls_total = 0;
+    int     n_layers_with_writes = 0;
+    const int L_count = g_fraqtl.n_layers;
+    for (int L = 0; L < L_count; ++L) {
+        sink_K += g_fraqtl.step59_sink_writes_K[L];
+        sink_V += g_fraqtl.step59_sink_writes_V[L];
+        res_K  += g_fraqtl.step59_residual_writes_K[L];
+        res_V  += g_fraqtl.step59_residual_writes_V[L];
+        ow_K   += g_fraqtl.step59_overwrite_K[L];
+        ow_V   += g_fraqtl.step59_overwrite_V[L];
+        set_rows_calls_total += g_fraqtl.set_rows_hook_calls[L];
+        if (g_fraqtl.step59_residual_writes_K[L] > 0
+            || g_fraqtl.step59_residual_writes_V[L] > 0) {
+            n_layers_with_writes++;
+        }
+    }
+
+    fprintf(stderr,
+        "fraqtl: STEP59_WRITE_STATS "
+        "sink_n=%d residual_n=%d "
+        "sink_writes_K=%lld sink_writes_V=%lld "
+        "residual_writes_K=%lld residual_writes_V=%lld "
+        "overwrite_K=%lld overwrite_V=%lld "
+        "set_rows_hook_calls_total=%lld "
+        "n_layers_with_writes=%d/%d\n",
+        g_fraqtl.sink_n, g_fraqtl.residual_n,
+        (long long) sink_K, (long long) sink_V,
+        (long long) res_K,  (long long) res_V,
+        (long long) ow_K,   (long long) ow_V,
+        (long long) set_rows_calls_total,
+        n_layers_with_writes, L_count);
+    fflush(stderr);
+}
+
+// host-side accessor for the K read-side branch context.
+// Builds a 40-byte POD that the dispatcher passes by value through the
+// fattn-mma kernel template chain. Returns all-zero struct (sink_n=0,
+// residual_n=0, all pointers null) when is disabled — the kernel
+// branch checks these fields and falls through to the existing compressed
+// path with zero behavior change.
+// per_layer_kvh offset is computed inside the kernel as
+//   sink_K_layer + z_KV * sink_n * hd
+// (and similarly for residual_K_layer).
+extern "C" fraqtl_step59_k_args_t fraqtl_runtime_get_step59_k_args_for_layer(
+    int layer_idx, int current_kv, int n_heads)
+{
+    fraqtl_step59_k_args_t out = {};   // sink_K_layer = nullptr, ints = 0
+    if (g_fraqtl.sink_n <= 0 && g_fraqtl.residual_n <= 0) return out;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS)  return out;
+
+    out.sink_K_layer     = (g_fraqtl.sink_n > 0)
+                             ? g_fraqtl.sink_K_buf[layer_idx]     : nullptr;
+    out.residual_K_layer = (g_fraqtl.residual_n > 0)
+                             ? g_fraqtl.residual_K_buf[layer_idx] : nullptr;
+    // V pointers (symmetric to K). Same per-(layer, kvh) layout
+    // [(kvh, slot, d)] used by the double-write kernel.
+    out.sink_V_layer     = (g_fraqtl.sink_n > 0)
+                             ? g_fraqtl.sink_V_buf[layer_idx]     : nullptr;
+    out.residual_V_layer = (g_fraqtl.residual_n > 0)
+                             ? g_fraqtl.residual_V_buf[layer_idx] : nullptr;
+    out.sink_n           = g_fraqtl.sink_n;
+    out.residual_n       = g_fraqtl.residual_n;
+    out.hd               = g_fraqtl.hd;
+    out.n_kv             = g_fraqtl.n_kv;
+    out.n_heads          = n_heads;
+    out.current_kv       = current_kv;
+    return out;
+}
+
+// Cheap predicate: returns 1 if is currently active (either window
+// > 0). Used by the fattn.cu dispatcher's vec-path hard-fail check so we
+// don't silently fall through to a non-step59-aware vec kernel.
+extern "C" int fraqtl_runtime_step59_is_active(void) {
+    return (g_fraqtl.sink_n > 0 || g_fraqtl.residual_n > 0) ? 1 : 0;
+}
+
+extern "C" void fraqtl_runtime_log_step58_desc_bytes(void) {
+    if (g_fraqtl.n_kv <= 0 || g_fraqtl.n_layers <= 0) {
+        // fraqtl not (yet) configured with model dims — nothing to report.
+        return;
+    }
+    const size_t per_layer_bytes = sizeof(fraqtl_k_kvh_desc) * (size_t) g_fraqtl.n_kv;
+    const size_t total_bytes     = per_layer_bytes * (size_t) g_fraqtl.n_layers;
+    fprintf(stderr,
+        "fraqtl: STEP58_DESC_BYTES total=%zu per_layer=%zu "
+        "(sizeof(fraqtl_k_kvh_desc)=%zu n_kv=%d n_layers=%d)\n",
+        total_bytes, per_layer_bytes, sizeof(fraqtl_k_kvh_desc),
+        g_fraqtl.n_kv, g_fraqtl.n_layers);
+    fflush(stderr);
+}
+
+// descriptor-arena builder kernel. One thread per (h, k) entry.
+// Pure pointer arithmetic — slab pointers are stable for the lifetime of
+// the cache so this runs once at slab-register time and never again.
+// fix: also stamps U_head per row. Both kvh in the same
+// layer share the SAME U_head pointer offset within their layer's U block
+// (U is indexed by (layer, kvh) → HD×HD), so each row's U_head depends on
+// h.
+__global__ void fraqtl_kv_build_v_desc_kernel(
+    fraqtl_v_row_desc * __restrict__ descs,
+    const half *    __restrict__ prot_base,
+    const uint8_t * __restrict__ pack_base,
+    const float *   __restrict__ scale_base,
+    const half *    __restrict__ U_layer_base,   // pointer to layer's U block start (NKV*HD*HD halves)
+    int kv_size, int NKV, int K, int HD, int pack_stride)
+{
+    const int k = blockIdx.x * blockDim.x + threadIdx.x;
+    const int h = blockIdx.y;
+    if (k >= kv_size || h >= NKV) return;
+
+    const int row_idx = h * kv_size + k;
+    fraqtl_v_row_desc d;
+    d.prot_row    = prot_base  + (size_t) row_idx * (size_t) K;
+    d.pack_row    = pack_base
+        ? pack_base + (size_t) row_idx * (size_t) pack_stride
+        : nullptr;
+    d.scale_row   = scale_base + (size_t) row_idx;
+    // U_head[layer, h]: layer's block + h*HD*HD halves
+    d.U_head      = U_layer_base + (size_t) h * (size_t) HD * (size_t) HD;
+    d.k_prot      = K;
+    d.hd          = HD;
+    d.pack_stride = pack_stride;
+    d._pad        = 0;
+    descs[row_idx] = d;
+}
+
+//  COMPACT V descriptor build. One thread per kv-head,
+// writes ONE fraqtl_v_kvh_desc per (layer, kvh) instead of kv_size per head.
+// Per-slot row pointers are NOT pre-computed here — the consumer derives them
+// arithmetically (prot_base + slot*K, etc.). This is the producer half of the
+// per-token-descriptor-table elimination. Gated by FRAQTL_V_DESC_COMPACT.
+__global__ void fraqtl_kv_build_v_kvh_desc_kernel(
+    fraqtl_v_kvh_desc * __restrict__ descs,
+    const half *    __restrict__ prot_base,
+    const uint8_t * __restrict__ pack_base,
+    const float *   __restrict__ scale_base,
+    const half *    __restrict__ U_layer_base,   // layer's U block start (NKV*HD*HD halves)
+    int kv_size, int NKV, int K, int HD, int pack_stride)
+{
+    const int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (h >= NKV) return;
+
+    fraqtl_v_kvh_desc d;
+    // Head base = the old per-token formula (h*kv_size + k)*stride with k=0.
+    d.prot_base   = prot_base  + (size_t) h * (size_t) kv_size * (size_t) K;
+    d.pack_base   = pack_base
+        ? pack_base + (size_t) h * (size_t) kv_size * (size_t) pack_stride
+        : nullptr;
+    d.scale_base  = scale_base + (size_t) h * (size_t) kv_size;
+    d.U_head      = U_layer_base + (size_t) h * (size_t) HD * (size_t) HD;
+    d.k_prot      = K;
+    d.hd          = HD;
+    d.pack_stride = pack_stride;
+    d.kv_size     = kv_size;
+    descs[h] = d;
+}
+
+// cache registers each layer's slabs + resets cursors.
+// Called from llama_kv_cache constructor (per layer) and destructor (clear).
+// also allocates and populates the per-layer V row
+// descriptor arena used by the fattn-vec fraqtl_v=true path. Arena lives
+// for the cache's lifetime (slab pointers are stable; descriptors are
+// pure metadata). Freed in fraqtl_runtime_clear_layer_slabs.
+extern "C" void fraqtl_runtime_register_layer_slabs(
+    int32_t layer_idx,
+    void *  v_protected, void * v_packed, void * v_scale,
+    int32_t kv_size
+) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    g_fraqtl.layer_v_protected[layer_idx] = v_protected;
+    g_fraqtl.layer_v_packed   [layer_idx] = v_packed;
+    g_fraqtl.layer_v_scale    [layer_idx] = v_scale;
+    g_fraqtl.layer_kv_size    [layer_idx] = kv_size;
+    g_fraqtl.packed_until     [layer_idx] = 0;
+    g_fraqtl.v_lifetime_state [layer_idx] = fraqtl_runtime_state::V_FP16_ACTIVE;
+    g_fraqtl.v_pack_ok_logged [layer_idx] = 0;
+    g_fraqtl.v_marker_logged  [layer_idx] = 0;
+    g_fraqtl.v_route_logged   [layer_idx] = 0;
+
+    const int HD_state = g_fraqtl.hd;
+    const int NKV_state = g_fraqtl.n_kv;
+    const int K_state = g_fraqtl.k_protect;
+    const int sac_dims_state = HD_state - K_state;
+    const int padded_groups_state = (sac_dims_state + 7) / 8;
+    const int packed_bytes_row_state = padded_groups_state * 3;
+    g_fraqtl.v_logical_bytes[layer_idx] =
+        (kv_size > 0 && NKV_state > 0 && HD_state > 0)
+            ? (size_t) kv_size * (size_t) NKV_state * (size_t) HD_state * sizeof(half)
+            : 0;
+    g_fraqtl.v_compressed_bytes[layer_idx] =
+        (kv_size > 0 && NKV_state > 0 && HD_state > 0 && K_state >= 0)
+            ? (size_t) kv_size * (size_t) NKV_state *
+              ((size_t) K_state * sizeof(half) + (size_t) packed_bytes_row_state + sizeof(float))
+            : 0;
+
+    // allocate + populate descriptor arena. Requires g_fraqtl.hd /
+    // n_kv / k_protect to be already set (fraqtl_runtime_setup runs before
+    // this — the cache's constructor walks layers after llama_context init).
+    //  when arena owns the V_desc region, NEVER
+    // cudaFree it (would corrupt arena memory). Just clear the pointer; the
+    // arena accessor below re-binds it to the same arena slot.
+    if (g_fraqtl.layer_v_descs[layer_idx]) {
+        if (!g_fraqtl.arena_active) cudaFree(g_fraqtl.layer_v_descs[layer_idx]);
+        g_fraqtl.layer_v_descs[layer_idx] = nullptr;
+    }
+    if (kv_size <= 0 || g_fraqtl.n_kv <= 0 || g_fraqtl.hd <= 0) {
+        // Cannot build descriptors yet — leave nullptr; dispatcher's
+        // gate_supported() will fall back to .
+        return;
+    }
+    if ((g_fraqtl.k_protect & 7) != 0) {
+        // path requires K to be a multiple of 8 so dequantize_V_fraqtl
+        // never sees a mixed prot/sac range. Qwen2.5/0.5B uses K=16 (✓).
+        // Larger K values must also satisfy K%8==0.
+        fprintf(stderr,
+            "fraqtl: register_layer_slabs L%d skipping desc arena — "
+            "k_protect=%d not a multiple of 8 (Day 12.5 alignment requirement)\n",
+            layer_idx, g_fraqtl.k_protect);
+        fflush(stderr);
+        return;
+    }
+
+    const int sac_dims      = g_fraqtl.hd - g_fraqtl.k_protect;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int pack_stride   = padded_groups * 3;
+
+    //  compact V descriptor table. When FRAQTL_V_DESC_COMPACT
+    // is set, one descriptor per (layer, kv_head); otherwise one per
+    // (layer, kv_head, slot). Both descriptor structs are 48 B (static_assert
+    // in fraqtl-kv.cuh), so the per-element byte math is identical — only the
+    // element count changes.
+    const bool   v_desc_compact = fraqtl_v_desc_compact_enabled();
+    const size_t n_descs    = v_desc_compact
+        ? (size_t) g_fraqtl.n_kv
+        : (size_t) kv_size * (size_t) g_fraqtl.n_kv;
+    const size_t arena_sz   = n_descs * sizeof(fraqtl_v_row_desc);
+
+    //  when arena is active, route this layer's
+    // V_desc through arena instead of cudaMalloc. Math + kernel inputs unchanged.
+    fraqtl_v_row_desc * d_arena = nullptr;
+    cudaError_t e;
+    if (g_fraqtl.arena_active) {
+        d_arena = (fraqtl_v_row_desc *) fraqtl_arena_v_desc(g_fraqtl.arena, layer_idx);
+        if (!d_arena) {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE4_BIND_FAIL kind=v_desc L=%d (arena accessor returned null)\n",
+                layer_idx);
+            fflush(stderr);
+            return;
+        }
+        e = cudaSuccess;
+        g_fraqtl.stage4_v_desc_routed++;
+    } else {
+        e = cudaMalloc(&d_arena, arena_sz);
+        if (e != cudaSuccess) {
+            fprintf(stderr,
+                "fraqtl: register_layer_slabs L%d desc arena cudaMalloc failed (%zu B): %s\n",
+                layer_idx, arena_sz, cudaGetErrorString(e));
+            fflush(stderr);
+            return;
+        }
+    }
+
+    // diagnostic: print K used for THIS layer's descriptor build, on
+    // layer 0 only (one line per process). If g_fraqtl.k_protect drifts from
+    // the runtime_setup value somehow, this catches it before the hot path.
+    if (layer_idx == 0) {
+        fprintf(stderr,
+            "fraqtl: build_v_desc L0 — K=%d (g_fraqtl.k_protect), HD=%d, "
+            "pack_stride=%d, kv_size=%d, compact=%d, n_descs=%zu, "
+            "v_desc_bytes=%zu\n",
+            g_fraqtl.k_protect, g_fraqtl.hd, pack_stride, kv_size,
+            v_desc_compact ? 1 : 0, n_descs, arena_sz);
+        fflush(stderr);
+    }
+
+    // fix: pass U_layer_base so descriptors can carry
+    // U_head per (layer, kvh). U layout: [n_layers, NKV, HD, HD] halves.
+    // Layer block start = d_U + layer_idx * NKV * HD * HD halves.
+    const half * U_layer_base = nullptr;
+    if (g_fraqtl.d_U) {
+        U_layer_base = ((const half *) g_fraqtl.d_U)
+                      + (size_t) layer_idx
+                      * (size_t) g_fraqtl.n_kv
+                      * (size_t) g_fraqtl.hd
+                      * (size_t) g_fraqtl.hd;
+    }
+
+    if (v_desc_compact) {
+        // Compact path: one thread per kv-head, n_kv descriptors total.
+        const dim3 block_c(256, 1, 1);
+        const dim3 grid_c((g_fraqtl.n_kv + 255) / 256, 1, 1);
+        fraqtl_kv_build_v_kvh_desc_kernel<<<grid_c, block_c, 0, 0>>>(
+            (fraqtl_v_kvh_desc *) d_arena,
+            (const half *)    v_protected,
+            (const uint8_t *) v_packed,
+            (const float *)   v_scale,
+            U_layer_base,
+            kv_size, g_fraqtl.n_kv,
+            g_fraqtl.k_protect, g_fraqtl.hd, pack_stride);
+    } else {
+        const dim3 block(256, 1, 1);
+        const dim3 grid((kv_size + 255) / 256, g_fraqtl.n_kv, 1);
+        fraqtl_kv_build_v_desc_kernel<<<grid, block, 0, 0>>>(
+            d_arena,
+            (const half *)    v_protected,
+            (const uint8_t *) v_packed,
+            (const float *)   v_scale,
+            U_layer_base,
+            kv_size, g_fraqtl.n_kv,
+            g_fraqtl.k_protect, g_fraqtl.hd, pack_stride);
+    }
+    e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: register_layer_slabs L%d build_v_desc_kernel launch err: %s\n",
+            layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        cudaFree(d_arena);
+        return;
+    }
+    // Synchronous build — runs once per layer at cache init, microseconds.
+    e = cudaDeviceSynchronize();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: register_layer_slabs L%d build_v_desc_kernel sync err: %s\n",
+            layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        cudaFree(d_arena);
+        return;
+    }
+    g_fraqtl.layer_v_descs[layer_idx] = d_arena;
+}
+
+// ============================================================================
+// K-side infra
+// ============================================================================
+
+// () — per-(layer, kvh) descriptor builder.
+// Builds n_kv descriptors per layer (was kv_size * n_kv pre-Step-5.8).
+// Per-slot row pointers are no longer materialized; they're derived in
+// the kernel via base + slot * stride.
+// Slab layout convention is unchanged: prot_slab_k is laid out as
+// [n_kv, kv_size, max_rank] halves, so the per-kvh "base" pointer is
+// prot_base_k + h * (kv_size * max_rank). Pack and scale follow the
+// same per-kvh slicing.
+__global__ void fraqtl_kv_build_k_desc_kernel(
+    fraqtl_k_kvh_desc * __restrict__ descs,
+    const half *    __restrict__ prot_base_k,
+    const uint8_t * __restrict__ pack_base_k,    // may be null if all heads in layer have rank==HD
+    const float *   __restrict__ scale_base_k,
+    const half *    __restrict__ U_K_layer_base, // pointer to layer's U_K block start (NKV*HD*HD halves)
+    const int *     __restrict__ ranks,          // device array of NKV per-head ranks
+    int kv_size, int NKV, int HD,
+    int max_rank,                                // max R across heads in this layer
+    int max_pack_stride,                         // max pack_stride across heads (in bytes)
+    int tail_bits                                //  S2: 4 = legacy INT4, 3 = exp16 INT3
+) {
+    const int h = blockIdx.x * blockDim.x + threadIdx.x;
+    if (h >= NKV) return;
+
+    const int rank_h        = ranks[h];
+    const int sac_dims_h    = HD - rank_h;
+    //  S2 — pack_stride formula depends on tail_bits:
+    //   INT4: 2 idx/byte → ceil(sac/2) bytes
+    //   INT3: 8 idx per 3 bytes → ceil(sac/8) * 3 bytes
+    const int pack_stride_h = (tail_bits == 3)
+        ? ((sac_dims_h + 7) / 8) * 3
+        : ((sac_dims_h + 1) / 2);
+
+    fraqtl_k_kvh_desc d;
+    // Per-kvh slice base. The slot's row pointer is derived as
+    // base + slot * SLAB_stride (rectangular layout — per-layer max).
+    d.prot_base   = prot_base_k + (size_t) h * (size_t) kv_size * (size_t) max_rank;
+    d.pack_base   = (pack_base_k && pack_stride_h > 0)
+        ? pack_base_k + (size_t) h * (size_t) kv_size * (size_t) max_pack_stride
+        : nullptr;
+    d.scale_base  = scale_base_k + (size_t) h * (size_t) kv_size;
+    d.U_K_head    = U_K_layer_base + (size_t) h * (size_t) HD * (size_t) HD;
+    d.rank        = rank_h;
+    d.hd          = HD;
+    d.pack_stride = pack_stride_h;
+    d.slab_row_stride_halves = max_rank;
+    d.slab_pack_stride_bytes = max_pack_stride;
+    d.tail_bits   = tail_bits;
+    d._pad        = 0;
+    descs[h] = d;
+}
+
+extern "C" void fraqtl_runtime_register_layer_k_slabs(
+    int32_t layer_idx,
+    void *  prot_slab_k,
+    void *  pack_slab_k,
+    void *  scale_slab_k,
+    const int32_t * k_ranks_in_layer,
+    int32_t kv_size
+) {
+    // ----------------------------------------------------------------------
+    // Diagnostic counters (follow-up, ).
+    // internal review: distinguish "duplicate registration" (corruption
+    // risk — same layer_idx wired twice) from "duplicate log line"
+    // (harmless — fprintf called twice but only one register actually
+    // landed). Counters are local statics, valid across ONE process; an
+    // uninstantiated llama_kv_cache_clear path would reset them via
+    // clear_layer_slabs but THIS function intentionally does NOT clear
+    // them — they must accumulate across the whole session.
+    // ----------------------------------------------------------------------
+    static int   call_idx_static       = 0;
+    static int   layer_call_count[FRAQTL_MAX_LAYERS] = {0};
+    static int   first_seen_call_idx[FRAQTL_MAX_LAYERS];
+    static bool  layer_seen_initialized = false;
+    if (!layer_seen_initialized) {
+        for (int i = 0; i < FRAQTL_MAX_LAYERS; ++i) first_seen_call_idx[i] = -1;
+        layer_seen_initialized = true;
+    }
+    const int this_call_idx = call_idx_static++;
+
+    // Compute a small ranks summary so the diagnostic log carries the
+    // shape without spamming all 4 ranks per call (we already log them
+    // at higher level via K_REGISTER_LAYER).
+    int rmin = 1 << 30, rmax = 0;
+    long sum_r = 0;
+    int  n_kv_now = (g_fraqtl.n_kv > 0) ? g_fraqtl.n_kv : 0;
+    if (n_kv_now > 0 && k_ranks_in_layer != nullptr) {
+        for (int h = 0; h < n_kv_now; ++h) {
+            const int r = k_ranks_in_layer[h];
+            if (r < rmin) rmin = r;
+            if (r > rmax) rmax = r;
+            sum_r += r;
+        }
+    } else {
+        rmin = -1; rmax = -1;
+    }
+
+    bool duplicate = false;
+    int prev_call = -1;
+    if (layer_idx >= 0 && layer_idx < FRAQTL_MAX_LAYERS) {
+        layer_call_count[layer_idx]++;
+        if (first_seen_call_idx[layer_idx] >= 0) {
+            duplicate = true;
+            prev_call = first_seen_call_idx[layer_idx];
+        } else {
+            first_seen_call_idx[layer_idx] = this_call_idx;
+        }
+    }
+
+    fprintf(stderr,
+        "fraqtl: K_REGISTER_CALL call_idx=%d layer=%d n_kv=%d "
+        "ranks=[min=%d,max=%d,sum=%ld] "
+        "prot=%p pack=%p scale=%p kv_size=%d "
+        "duplicate=%d prev_call_idx=%d call_count_for_layer=%d\n",
+        this_call_idx, (int) layer_idx, n_kv_now,
+        rmin, rmax, sum_r,
+        prot_slab_k, pack_slab_k, scale_slab_k, (int) kv_size,
+        (int) duplicate, prev_call,
+        (layer_idx >= 0 && layer_idx < FRAQTL_MAX_LAYERS)
+            ? layer_call_count[layer_idx]
+            : -1);
+    fflush(stderr);
+
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    if (g_fraqtl.n_kv <= 0 || g_fraqtl.hd <= 0) return;
+    if (g_fraqtl.n_kv > FRAQTL_MAX_KV_HEADS) return;
+
+    g_fraqtl.layer_k_protected[layer_idx] = prot_slab_k;
+    g_fraqtl.layer_k_packed   [layer_idx] = pack_slab_k;
+    g_fraqtl.layer_k_scale    [layer_idx] = scale_slab_k;
+
+    int max_rank = 0;
+    for (int h = 0; h < g_fraqtl.n_kv; ++h) {
+        const int r = k_ranks_in_layer[h];
+        g_fraqtl.layer_k_ranks[layer_idx][h] = r;
+        if (r > max_rank) max_rank = r;
+    }
+    const int max_sac_dims    = g_fraqtl.hd - 0;       // worst case across heads is r=0 → all sac
+    // But actually max_pack_stride should be sized for MIN rank (max sac dims).
+    // We already iterated above for max_rank; do another pass for min_rank.
+    int min_rank = g_fraqtl.hd;
+    for (int h = 0; h < g_fraqtl.n_kv; ++h) {
+        if (g_fraqtl.layer_k_ranks[layer_idx][h] < min_rank) {
+            min_rank = g_fraqtl.layer_k_ranks[layer_idx][h];
+        }
+    }
+    //  S2 port: env var FRAQTL_K_TAIL_BITS selects K tail format.
+    //   "3" = exp16 INT3 path (target for K16 INT3 + V_PROT INT3 recipe, 3.46×).
+    //   default 4 = legacy INT4 nibble path (backward compat).
+    int k_tail_bits = 4;
+    {
+        const char * env_tb = std::getenv("FRAQTL_K_TAIL_BITS");
+        if (env_tb && env_tb[0] == '3') k_tail_bits = 3;
+    }
+    const int max_sac = g_fraqtl.hd - min_rank;
+    const int max_pack_stride = (k_tail_bits == 3)
+        ? ((max_sac + 7) / 8) * 3
+        : ((max_sac + 1) / 2);
+
+    //  gate the re-register cudaFree.
+    if (g_fraqtl.layer_k_descs[layer_idx]) {
+        if (!g_fraqtl.arena_active) cudaFree(g_fraqtl.layer_k_descs[layer_idx]);
+        g_fraqtl.layer_k_descs[layer_idx] = nullptr;
+    }
+    if (kv_size <= 0) {
+        return;
+    }
+
+    // (): per-(layer, kvh) descriptor — n_kv elements per
+    // layer (was kv_size * n_kv pre-Step-5.8). Slot row pointers are now
+    // derived in the kernel via base + slot * slab_stride. Memory savings
+    // for Qwen 7B at 16K = 84 MiB; at 64K = 336 MiB.
+    const size_t n_descs  = (size_t) g_fraqtl.n_kv;
+    const size_t arena_sz = n_descs * sizeof(fraqtl_k_kvh_desc);
+    //  route K_desc + K_ranks through arena when
+    // active. K_ranks is a transient device array used by build_k_desc_kernel
+    // and freed at end of function in the non-arena path; under arena it's
+    // backed by arena memory and never individually freed.
+    fraqtl_k_kvh_desc * d_arena = nullptr;
+    cudaError_t e;
+    if (g_fraqtl.arena_active) {
+        d_arena = (fraqtl_k_kvh_desc *) fraqtl_arena_k_desc(g_fraqtl.arena, layer_idx);
+        if (!d_arena) {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE4_BIND_FAIL kind=k_desc L=%d\n", layer_idx);
+            fflush(stderr);
+            return;
+        }
+        e = cudaSuccess;
+        g_fraqtl.stage4_k_desc_routed++;
+    } else {
+        e = cudaMalloc(&d_arena, arena_sz);
+        if (e != cudaSuccess) {
+            fprintf(stderr,
+                "fraqtl: register_layer_k_slabs L%d desc arena cudaMalloc failed (%zu B): %s\n",
+                layer_idx, arena_sz, cudaGetErrorString(e));
+            fflush(stderr);
+            return;
+        }
+    }
+
+    // Copy ranks to device (small array — n_kv ints).
+    int * d_ranks = nullptr;
+    if (g_fraqtl.arena_active) {
+        d_ranks = (int *) fraqtl_arena_k_ranks(g_fraqtl.arena, layer_idx);
+        if (!d_ranks) {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE4_BIND_FAIL kind=k_ranks L=%d\n", layer_idx);
+            fflush(stderr);
+            return;
+        }
+        e = cudaSuccess;
+        g_fraqtl.stage4_k_ranks_routed++;
+    } else {
+        e = cudaMalloc(&d_ranks, g_fraqtl.n_kv * sizeof(int));
+        if (e != cudaSuccess) {
+            fprintf(stderr, "fraqtl: register_layer_k_slabs L%d ranks cudaMalloc failed: %s\n",
+                    layer_idx, cudaGetErrorString(e));
+            fflush(stderr);
+            cudaFree(d_arena);
+            return;
+        }
+    }
+    e = cudaMemcpy(d_ranks, k_ranks_in_layer, g_fraqtl.n_kv * sizeof(int),
+                   cudaMemcpyHostToDevice);
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: register_layer_k_slabs L%d ranks cudaMemcpy failed: %s\n",
+                layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        if (!g_fraqtl.arena_active) { cudaFree(d_ranks); cudaFree(d_arena); }
+        return;
+    }
+
+    if (layer_idx == 0) {
+        fprintf(stderr,
+            "fraqtl: build_k_desc L0 — HD=%d, NKV=%d, kv_size=%d, ranks=[",
+            g_fraqtl.hd, g_fraqtl.n_kv, kv_size);
+        for (int h = 0; h < g_fraqtl.n_kv; ++h) {
+            fprintf(stderr, "%s%d", h == 0 ? "" : ",", k_ranks_in_layer[h]);
+        }
+        fprintf(stderr, "], max_rank=%d, max_pack_stride=%d\n",
+                max_rank, max_pack_stride);
+        fflush(stderr);
+    }
+
+    const half * U_K_layer_base = nullptr;
+    if (g_fraqtl.d_U_K) {
+        U_K_layer_base = ((const half *) g_fraqtl.d_U_K)
+                        + (size_t) layer_idx
+                        * (size_t) g_fraqtl.n_kv
+                        * (size_t) g_fraqtl.hd
+                        * (size_t) g_fraqtl.hd;
+    } else {
+        fprintf(stderr,
+            "fraqtl: register_layer_k_slabs L%d WARN d_U_K not set yet — "
+            "U_K_head pointers will be null in descriptor arena\n",
+            layer_idx);
+        fflush(stderr);
+    }
+
+    // launch n_kv threads (was kv_size × n_kv).
+    const dim3 block((unsigned) g_fraqtl.n_kv, 1, 1);
+    const dim3 grid(1, 1, 1);
+    fraqtl_kv_build_k_desc_kernel<<<grid, block, 0, 0>>>(
+        d_arena,
+        (const half *)    prot_slab_k,
+        (const uint8_t *) pack_slab_k,
+        (const float *)   scale_slab_k,
+        U_K_layer_base,
+        d_ranks,
+        kv_size, g_fraqtl.n_kv, g_fraqtl.hd,
+        max_rank, max_pack_stride, k_tail_bits);
+    if (k_tail_bits == 3) {
+        fprintf(stderr,
+            "fraqtl: K_TAIL_BITS_INT3 active layer=%d "
+            "max_pack_stride=%d (S2 exp16 path)\n",
+            layer_idx, max_pack_stride);
+        fflush(stderr);
+    }
+    e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: register_layer_k_slabs L%d build_k_desc_kernel launch err: %s\n",
+            layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        if (!g_fraqtl.arena_active) { cudaFree(d_ranks); cudaFree(d_arena); }
+        return;
+    }
+    e = cudaDeviceSynchronize();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: register_layer_k_slabs L%d build_k_desc_kernel sync err: %s\n",
+            layer_idx, cudaGetErrorString(e));
+        fflush(stderr);
+        if (!g_fraqtl.arena_active) { cudaFree(d_ranks); cudaFree(d_arena); }
+        return;
+    }
+    //  gate the transient ranks free. Under arena
+    // ownership the ranks pointer points INTO arena memory (per-layer slot)
+    // and is never individually freed; the single arena_destroy at teardown
+    // releases it along with all other arena regions.
+    if (!g_fraqtl.arena_active) {
+        cudaFree(d_ranks);  // ranks copied into descriptors; transient device array no longer needed
+    }
+    g_fraqtl.layer_k_descs[layer_idx] = d_arena;
+
+    //  emit aggregate ARENA_STAGE4_SWAP log line
+    // ONCE when both V and K register loops have routed all n_layers. K
+    // register typically fires after V register so this branch is reached
+    // after the last layer's K register, but the maybe-emit logic below is
+    // robust to either order.
+    if (g_fraqtl.arena_active && !g_fraqtl.stage4_log_emitted &&
+        g_fraqtl.stage4_v_desc_routed  >= g_fraqtl.n_layers &&
+        g_fraqtl.stage4_k_desc_routed  >= g_fraqtl.n_layers &&
+        g_fraqtl.stage4_k_ranks_routed >= g_fraqtl.n_layers)
+    {
+        const size_t v_desc_per_layer  = (size_t) kv_size * (size_t) g_fraqtl.n_kv * 48;
+        const size_t k_desc_per_layer  = (size_t) g_fraqtl.n_kv * 64;
+        const size_t k_ranks_per_layer = (size_t) g_fraqtl.n_kv * sizeof(int);
+        const int total_eliminated = 3 * g_fraqtl.n_layers;
+        fprintf(stderr,
+            "fraqtl: ARENA_STAGE4_SWAP cudaMallocs_eliminated=%d "
+            "v_desc=%zu k_desc=%zu k_ranks=%zu\n",
+            total_eliminated, v_desc_per_layer, k_desc_per_layer, k_ranks_per_layer);
+        fflush(stderr);
+        g_fraqtl.stage4_log_emitted = true;
+    }
+}
+
+extern "C" void fraqtl_runtime_set_uk_arena(const half * U_K_arena) {
+    g_fraqtl.d_U_K = (void *) U_K_arena;
+}
+
+// void* shim for non-CUDA callers (llama-context.cpp). Same
+// ABI as fraqtl_runtime_set_uk_arena above; takes `const void *` so the
+// caller doesn't need to include cuda_fp16.h to construct the right type.
+extern "C" void fraqtl_runtime_set_uk_arena_void(const void * U_K_arena) {
+    g_fraqtl.d_U_K = (void *) U_K_arena;
+}
+
+extern "C" const half * fraqtl_runtime_get_uk_head(int32_t layer_idx, int32_t kvh) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    if (kvh < 0 || kvh >= g_fraqtl.n_kv) return nullptr;
+    if (g_fraqtl.d_U_K == nullptr) return nullptr;
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    return ((const half *) g_fraqtl.d_U_K)
+         + ((size_t) layer_idx * NKV + (size_t) kvh) * (size_t) HD * (size_t) HD;
+}
+
+extern "C" const fraqtl_k_kvh_desc * fraqtl_runtime_get_layer_k_descriptors(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    return g_fraqtl.layer_k_descs[layer_idx];
+}
+
+extern "C" int32_t fraqtl_runtime_get_k_desc_stride(void) {
+    return (int32_t) sizeof(fraqtl_k_kvh_desc);
+}
+
+extern "C" int32_t fraqtl_runtime_get_k_rank(int32_t layer_idx, int32_t kvh) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return -1;
+    if (kvh < 0 || kvh >= g_fraqtl.n_kv) return -1;
+    return g_fraqtl.layer_k_ranks[layer_idx][kvh];
+}
+
+extern "C" void fraqtl_runtime_clear_layer_slabs(void) {
+    //  under arena ownership the V_desc and
+    // K_desc per-layer pointers point INTO arena memory. Skip the individual
+    // cudaFrees; the single fraqtl_arena_destroy at teardown frees the whole
+    // region. Pointers still reset to nullptr for state hygiene.
+    const bool arena_owns = g_fraqtl.arena_active;
+    for (int i = 0; i < FRAQTL_MAX_LAYERS; ++i) {
+        g_fraqtl.layer_v_protected[i] = nullptr;
+        g_fraqtl.layer_v_packed   [i] = nullptr;
+        g_fraqtl.layer_v_scale    [i] = nullptr;
+        g_fraqtl.layer_kv_size    [i] = 0;
+        g_fraqtl.packed_until     [i] = 0;
+        if (g_fraqtl.layer_v_descs[i]) {
+            if (!arena_owns) cudaFree(g_fraqtl.layer_v_descs[i]);
+            g_fraqtl.layer_v_descs[i] = nullptr;
+        }
+        // clear K-side state in parallel
+        g_fraqtl.layer_k_protected[i] = nullptr;
+        g_fraqtl.layer_k_packed   [i] = nullptr;
+        g_fraqtl.layer_k_scale    [i] = nullptr;
+        for (int h = 0; h < FRAQTL_MAX_KV_HEADS; ++h) {
+            g_fraqtl.layer_k_ranks[i][h] = 0;
+        }
+        if (g_fraqtl.layer_k_descs[i]) {
+            if (!arena_owns) cudaFree(g_fraqtl.layer_k_descs[i]);
+            g_fraqtl.layer_k_descs[i] = nullptr;
+        }
+        // reset K hook call counter so a second context in the
+        // same process doesn't inherit stale values.
+        g_fraqtl.k_set_rows_hook_calls[i] = 0;
+    }
+    // U_K arena is owned by the engine (loaded from sidecar); we just hold
+    // the pointer until teardown. clear_layer_slabs does NOT free it.
+}
+
+// ============================================================================
+// Q pre-projection kernel: Q' = Q @ U_K
+// Math identity (matches design doc section 4):
+//   score = Q @ K.T = Q @ (C_K @ U_K.T).T = (Q @ U_K) @ C_K.T = Q' @ C_K.T
+// where Q' is computed once per (q_token, kv_head) by this kernel. The
+// fattn-mma iter () consumes Q' instead of Q in its KQ matmul.
+// U_K layout (matches calibration `_top_eig` in colab_tinyllama_poly_k_bridge.py):
+//   U_K[(layer, kvh, d, c)] — d is input axis (eigenvector component),
+//                              c is output axis (eigenvalue index, sorted desc)
+//   So Q'[c] = sum_d Q[d] * U_K[d, c], i.e. U_K is read column-major from a thread.
+// Q tensor layout (matches dst convention from V's post-process kernel and
+// fattn-common.cuh:991): physical memory is [HD, n_heads, n_q, n_seqs]
+// head BEFORE q in stride order. The ggml tensor's logical ne is
+// [HD, n_q, n_heads, n_seqs] but its strides are permuted; we use the
+// permuted physical-memory offset formula here (same as
+// fraqtl_apply_U_T_to_O_kernel).
+// One block per (q_idx, head_idx, seq_idx); HD threads per block; each
+// thread emits one Q'[c] for c in [0, HD). Stage Q in shared memory so all
+// threads can read all HD components without reloading from global.
+// ============================================================================
+template <int HD>
+__global__ void fraqtl_apply_U_K_to_Q_kernel(
+        const float * __restrict__ Q_src,         // [HD, n_heads, n_q, n_seqs] f32 permuted
+        float       * __restrict__ Q_proj_dst,    // same shape — written
+        const half  * __restrict__ U_K_layer,     // [n_kv_heads, HD, HD] half (one layer slice)
+        const int n_q,
+        const int n_heads,
+        const int gqa_ratio)
+{
+    const int q_idx    = blockIdx.x;   // 0..n_q
+    const int head_idx = blockIdx.y;   // 0..n_heads
+    const int seq_idx  = blockIdx.z;   // 0..n_seqs
+    const int c        = threadIdx.x;  // 0..HD
+
+    if (c >= HD) return;
+
+    const int kvh = head_idx / gqa_ratio;
+    const half * U_K_head = U_K_layer + (size_t) kvh * HD * HD;
+
+    // Match fraqtl_apply_U_T_to_O_kernel offset formula exactly.
+    const size_t q_base = (size_t) seq_idx * n_q * n_heads * HD
+                        + (size_t) q_idx   * n_heads * HD
+                        + (size_t) head_idx * HD;
+
+    // Stage Q row in shared memory so every thread can dot against it.
+    __shared__ float stage_Q[HD];
+    stage_Q[c] = Q_src[q_base + c];
+    __syncthreads();
+
+    // Q'[c] = sum_d Q[d] * U_K_head[d, c]
+    float acc = 0.0f;
+    #pragma unroll
+    for (int d = 0; d < HD; ++d) {
+        acc += stage_Q[d] * __half2float(U_K_head[(size_t) d * HD + c]);
+    }
+
+    Q_proj_dst[q_base + c] = acc;
+}
+
+extern "C" int fraqtl_runtime_apply_U_K_to_Q(
+        const float * Q_src,
+        float *       Q_proj_dst,
+        int32_t       n_q,
+        int32_t       n_heads,
+        int32_t       n_seqs,
+        int32_t       layer_idx,
+        cudaStream_t  stream)
+{
+    if (!g_fraqtl.active)              return 1;
+    if (g_fraqtl.d_U_K == nullptr)     return 2;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 3;
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    if (NKV <= 0 || n_heads % NKV != 0) return 4;
+    const int gqa_ratio = n_heads / NKV;
+
+    // v0 scope: HD must be 128 (matches the locked Qwen 7B target).
+    if (HD != 128) return 5;
+
+    const half * U_K_layer = ((const half *) g_fraqtl.d_U_K)
+                           + (size_t) layer_idx * NKV * HD * HD;
+
+    dim3 grid((unsigned) n_q, (unsigned) n_heads, (unsigned) n_seqs);
+    dim3 block((unsigned) HD);
+    fraqtl_apply_U_K_to_Q_kernel<128><<<grid, block, 0, stream>>>(
+        Q_src, Q_proj_dst, U_K_layer, n_q, n_heads, gqa_ratio);
+
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: apply_U_K_to_Q kernel CUDA error: %s\n",
+            cudaGetErrorString(e));
+        fflush(stderr);
+        return 6;
+    }
+    return 0;
+}
+
+// ============================================================================
+// Q pre-projection SELF-TEST
+// Synthetic test: HD=8 small example, single layer, single head, single
+// sequence, n_q=4. Builds a known Q + a pseudo-orthonormal U_K (constructed
+// via a fixed rotation pattern, NOT random — so we can predict the result).
+// Computes expected Q' = Q @ U_K on host, runs the kernel, compares.
+// IMPORTANT: this test allocates its own device buffers (Q, Q_proj, U_K) and
+// does NOT touch the global g_fraqtl arenas. The runtime entry point above
+// is HD=128-only; we launch the kernel template directly at HD=8 here, which
+// the compiler instantiates implicitly from the launch site.
+// ============================================================================
+
+extern "C" int fraqtl_runtime_k_qproj_selftest(void) {
+    constexpr int HD     = 8;
+    constexpr int N_Q    = 4;
+    constexpr int HEADS  = 1;
+    constexpr int SEQS   = 1;
+
+    // Build host inputs.
+    float Q_h[N_Q * HEADS * SEQS * HD];
+    for (int i = 0; i < (int) (sizeof(Q_h) / sizeof(float)); ++i) {
+        Q_h[i] = 0.1f * (float) (i % 17) - 0.5f;  // deterministic pseudo-random
+    }
+
+    // Build a pseudo-orthonormal U_K: simple permutation + sign flip, so
+    // U_K @ U_K.T == I and we can verify Q' is just a known reordering.
+    // U_K[d, c] = 1 if c == perm[d] (with sign), 0 otherwise.
+    // perm = [3, 1, 7, 0, 5, 2, 6, 4]; signs = [+1, -1, +1, +1, -1, +1, +1, -1]
+    int perm[HD]  = {3, 1, 7, 0, 5, 2, 6, 4};
+    int signs[HD] = {+1, -1, +1, +1, -1, +1, +1, -1};
+    half U_K_h[HEADS * HD * HD];
+    for (int kvh = 0; kvh < HEADS; ++kvh) {
+        for (int d = 0; d < HD; ++d) {
+            for (int c = 0; c < HD; ++c) {
+                const float v = (perm[d] == c) ? (float) signs[d] : 0.0f;
+                U_K_h[((kvh * HD) + d) * HD + c] = __float2half(v);
+            }
+        }
+    }
+
+    // Host expected: Q'[seq, q, head, c] = sum_d Q[seq, q, head, d] * U_K[head/gqa, d, c]
+    // gqa_ratio = HEADS / HEADS = 1 here.
+    float expected[N_Q * HEADS * SEQS * HD];
+    for (int s = 0; s < SEQS; ++s) {
+        for (int q = 0; q < N_Q; ++q) {
+            for (int h = 0; h < HEADS; ++h) {
+                const int kvh = h;  // gqa=1
+                for (int c = 0; c < HD; ++c) {
+                    float acc = 0.0f;
+                    for (int d = 0; d < HD; ++d) {
+                        const float qv = Q_h[((s * N_Q + q) * HEADS + h) * HD + d];
+                        const float uv = __half2float(U_K_h[((kvh * HD) + d) * HD + c]);
+                        acc += qv * uv;
+                    }
+                    expected[((s * N_Q + q) * HEADS + h) * HD + c] = acc;
+                }
+            }
+        }
+    }
+
+    // Allocate device buffers.
+    float * d_Q       = nullptr;
+    float * d_Q_proj  = nullptr;
+    half  * d_U_K     = nullptr;
+    cudaError_t e;
+    e = cudaMalloc(&d_Q,      sizeof(Q_h));        if (e) goto fail;
+    e = cudaMalloc(&d_Q_proj, sizeof(Q_h));        if (e) goto fail;
+    e = cudaMalloc(&d_U_K,    sizeof(U_K_h));      if (e) goto fail;
+    e = cudaMemcpy(d_Q,    Q_h,    sizeof(Q_h),   cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_U_K,  U_K_h,  sizeof(U_K_h), cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemset(d_Q_proj, 0,    sizeof(Q_h));   if (e) goto fail;
+
+    {
+        // Launch the HD=8 kernel directly (does NOT go through the runtime
+        // entry point above, which is HD=128-only). gqa_ratio = 1.
+        dim3 grid(N_Q, HEADS, SEQS);
+        dim3 block(HD);
+        fraqtl_apply_U_K_to_Q_kernel<HD><<<grid, block>>>(
+            d_Q, d_Q_proj, d_U_K, N_Q, HEADS, /*gqa_ratio=*/1);
+        e = cudaGetLastError();
+        if (e) goto fail;
+        e = cudaDeviceSynchronize();
+        if (e) goto fail;
+    }
+
+    {
+        float out_h[N_Q * HEADS * SEQS * HD];
+        e = cudaMemcpy(out_h, d_Q_proj, sizeof(Q_h), cudaMemcpyDeviceToHost);
+        if (e) goto fail;
+
+        int n_mismatch = 0;
+        float max_abs_diff = 0.0f;
+        for (int i = 0; i < (int) (sizeof(out_h) / sizeof(float)); ++i) {
+            const float diff = fabsf(out_h[i] - expected[i]);
+            if (diff > max_abs_diff) max_abs_diff = diff;
+            // fp16 round-off + accumulation noise: 1e-3 tolerance is generous.
+            if (diff > 1e-3f) {
+                if (n_mismatch < 5) {
+                    fprintf(stderr,
+                        "fraqtl: Q_PROJ_SELFTEST mismatch i=%d expected=%.6f got=%.6f diff=%.6e\n",
+                        i, expected[i], out_h[i], diff);
+                    fflush(stderr);
+                }
+                n_mismatch++;
+            }
+        }
+        cudaFree(d_Q); cudaFree(d_Q_proj); cudaFree(d_U_K);
+
+        if (n_mismatch > 0) {
+            fprintf(stderr,
+                "fraqtl: Q_PROJ_SELFTEST_FAIL n_mismatch=%d max_abs_diff=%.6e HD=%d N_Q=%d HEADS=%d\n",
+                n_mismatch, max_abs_diff, HD, N_Q, HEADS);
+            fflush(stderr);
+            return 1;
+        }
+        fprintf(stderr,
+            "fraqtl: Q_PROJ_SELFTEST_PASS HD=%d N_Q=%d HEADS=%d max_abs_diff=%.6e\n",
+            HD, N_Q, HEADS, max_abs_diff);
+        fflush(stderr);
+        return 0;
+    }
+
+fail:
+    fprintf(stderr,
+        "fraqtl: Q_PROJ_SELFTEST_CUDA_ERROR err=%d (%s)\n",
+        (int) e, cudaGetErrorString(e));
+    fflush(stderr);
+    if (d_Q)      cudaFree(d_Q);
+    if (d_Q_proj) cudaFree(d_Q_proj);
+    if (d_U_K)    cudaFree(d_U_K);
+    return 2;
+}
+
+// ============================================================================
+// Per-K-cell dequant SELF-TEST
+// Validates the device-side fraqtl_k_get_coeff against a host-computed
+// reference. Builds one synthetic K row (HD=8 small example), packs it via
+// the same math the runtime set_rows hook will use (), then runs
+// fraqtl_k_get_coeff for every coefficient on the device and compares to
+// the original quantized values.
+// This is a one-shot smoke test, gated on env var FRAQTL_K_DEQUANT_SELFTEST=1
+// from CLI. Useful BEFORE wiring the kernel into fattn () so we
+// know the dequant math is correct in isolation.
+// Returns 0 on bit-equivalence (within fp16 round-off), non-zero on mismatch.
+// ============================================================================
+
+namespace {  // anonymous: device-side test helpers
+
+constexpr int FRAQTL_K_SELFTEST_HD   = 8;   // small example
+constexpr int FRAQTL_K_SELFTEST_RANK = 3;   // 3 protected fp16, 5 INT4 tail
+constexpr int FRAQTL_K_SELFTEST_PACK_BYTES = (FRAQTL_K_SELFTEST_HD - FRAQTL_K_SELFTEST_RANK + 1) / 2;  // 3 bytes for 5 idx
+
+__global__ void fraqtl_k_selftest_kernel(
+    const fraqtl_k_kvh_desc * __restrict__ desc,  // single descriptor (1 kvh, slot=0)
+    float * __restrict__ out)                     // [HD] output
+{
+    const int c = threadIdx.x;
+    if (c >= FRAQTL_K_SELFTEST_HD) return;
+    // pass slot=0 (single-row selftest).
+    out[c] = fraqtl_k_get_coeff(*desc, /*slot=*/0, c);
+}
+
+}  // anonymous namespace
+
+extern "C" int fraqtl_runtime_k_dequant_selftest(void) {
+    constexpr int HD   = FRAQTL_K_SELFTEST_HD;
+    constexpr int RANK = FRAQTL_K_SELFTEST_RANK;
+    constexpr int PACK_BYTES = FRAQTL_K_SELFTEST_PACK_BYTES;
+
+    // Host: build a synthetic C_K row with known values.
+    // Protected (c=0..RANK-1): explicit fp16 values.
+    // Tail (c=RANK..HD-1): explicit signed q values in [-8, 7], then quant via scale.
+    half  prot_h[RANK]    = { __float2half(0.5f), __float2half(-1.25f), __float2half(0.0f) };
+    int   tail_q[HD-RANK] = { 7, -8, 0, 3, -4 };  // signed q
+    float scale = 0.125f;
+
+    // Pack tail per canonical convention: HIGH nibble = first coefficient
+    // (lower index = c=RANK+0), LOW = second (c=RANK+1), etc.
+    // For odd tail length (5), last byte's low nibble pads with q=0 (uint4=8).
+    uint8_t pack_h[PACK_BYTES] = {0};
+    for (int g = 0; g < PACK_BYTES; ++g) {
+        const int c0 = 2*g;
+        const int c1 = 2*g + 1;
+        const int q0 = (c0 < HD-RANK) ? tail_q[c0] : 0;
+        const int q1 = (c1 < HD-RANK) ? tail_q[c1] : 0;
+        const uint8_t u0 = (uint8_t) (q0 + 8);
+        const uint8_t u1 = (uint8_t) (q1 + 8);
+        pack_h[g] = (uint8_t) ((u0 << 4) | (u1 & 0x0F));
+    }
+
+    // Host expected output: protected fp16 + dequant tail (q * scale).
+    float expected[HD];
+    for (int c = 0; c < RANK; ++c) {
+        expected[c] = __half2float(prot_h[c]);
+    }
+    for (int c = RANK; c < HD; ++c) {
+        expected[c] = (float) tail_q[c - RANK] * scale;
+    }
+
+    // Allocate device buffers + copy in.
+    half *    d_prot  = nullptr;
+    uint8_t * d_pack  = nullptr;
+    float *   d_scale = nullptr;
+    fraqtl_k_kvh_desc * d_desc = nullptr;
+    float *   d_out   = nullptr;
+
+    cudaError_t e;
+    e = cudaMalloc(&d_prot,  RANK * sizeof(half));               if (e) goto fail;
+    e = cudaMalloc(&d_pack,  PACK_BYTES * sizeof(uint8_t));      if (e) goto fail;
+    e = cudaMalloc(&d_scale, sizeof(float));                     if (e) goto fail;
+    e = cudaMalloc(&d_desc,  sizeof(fraqtl_k_kvh_desc));         if (e) goto fail;
+    e = cudaMalloc(&d_out,   HD * sizeof(float));                if (e) goto fail;
+    e = cudaMemcpy(d_prot,  prot_h, RANK * sizeof(half), cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_pack,  pack_h, PACK_BYTES,           cudaMemcpyHostToDevice); if (e) goto fail;
+    e = cudaMemcpy(d_scale, &scale, sizeof(float),        cudaMemcpyHostToDevice); if (e) goto fail;
+
+    {
+        // Build descriptor on host then copy to device. per-(layer, kvh)
+        // semantics with slab strides for slot-pointer derivation. For this
+        // selftest the slab is single-row, so slab strides equal the row sizes.
+        fraqtl_k_kvh_desc desc_h;
+        desc_h.prot_base   = d_prot;
+        desc_h.pack_base   = d_pack;
+        desc_h.scale_base  = d_scale;
+        desc_h.U_K_head    = nullptr;  // not needed for dequant test
+        desc_h.rank        = RANK;
+        desc_h.hd          = HD;
+        desc_h.pack_stride = PACK_BYTES;
+        desc_h.slab_row_stride_halves = RANK;        // single row, stride = rank
+        desc_h.slab_pack_stride_bytes = PACK_BYTES;  // single row, stride = pack_bytes
+        desc_h.tail_bits   = 4;                      // legacy INT4 selftest path
+        desc_h._pad        = 0;
+        e = cudaMemcpy(d_desc, &desc_h, sizeof(fraqtl_k_kvh_desc), cudaMemcpyHostToDevice);
+        if (e) goto fail;
+    }
+
+    // Launch test kernel.
+    fraqtl_k_selftest_kernel<<<1, HD>>>(d_desc, d_out);
+    e = cudaGetLastError();
+    if (e) goto fail;
+    e = cudaDeviceSynchronize();
+    if (e) goto fail;
+
+    // Read back + compare.
+    {
+        float out_h[HD];
+        e = cudaMemcpy(out_h, d_out, HD * sizeof(float), cudaMemcpyDeviceToHost);
+        if (e) goto fail;
+
+        int n_mismatch = 0;
+        float max_abs_diff = 0.0f;
+        for (int c = 0; c < HD; ++c) {
+            const float diff = fabsf(out_h[c] - expected[c]);
+            if (diff > max_abs_diff) max_abs_diff = diff;
+            // fp16 round-off + scale*7 ≈ 0.875 max; tolerate 1e-3 absolute.
+            if (diff > 1e-3f) {
+                fprintf(stderr,
+                    "fraqtl: K_DEQUANT_SELFTEST mismatch c=%d expected=%.6f got=%.6f diff=%.6e\n",
+                    c, expected[c], out_h[c], diff);
+                fflush(stderr);
+                n_mismatch++;
+            }
+        }
+        cudaFree(d_prot);  cudaFree(d_pack);  cudaFree(d_scale);
+        cudaFree(d_desc);  cudaFree(d_out);
+
+        if (n_mismatch > 0) {
+            fprintf(stderr,
+                "fraqtl: K_DEQUANT_SELFTEST_FAIL n_mismatch=%d max_abs_diff=%.6e HD=%d RANK=%d\n",
+                n_mismatch, max_abs_diff, HD, RANK);
+            fflush(stderr);
+            return 1;
+        }
+        fprintf(stderr,
+            "fraqtl: K_DEQUANT_SELFTEST_PASS HD=%d RANK=%d max_abs_diff=%.6e\n",
+            HD, RANK, max_abs_diff);
+        fflush(stderr);
+        return 0;
+    }
+
+fail:
+    fprintf(stderr,
+        "fraqtl: K_DEQUANT_SELFTEST_CUDA_ERROR err=%d (%s)\n",
+        (int) e, cudaGetErrorString(e));
+    fflush(stderr);
+    if (d_prot)  cudaFree(d_prot);
+    if (d_pack)  cudaFree(d_pack);
+    if (d_scale) cudaFree(d_scale);
+    if (d_desc)  cudaFree(d_desc);
+    if (d_out)   cudaFree(d_out);
+    return 2;
+}
+
+// Reset only the per-layer pack cursors (does NOT unregister slab
+// pointers). Called from llama_kv_cache mutation paths whenever the
+// row semantics underlying the slab become invalid: cache clear (buffer
+// zeroed or cells reset), seq_rm/seq_keep/seq_cp (cell metadata changed),
+// pos shifts (seq_add/seq_div, build_graph_shift), or apply_ubatch slot
+// reuse. After , packed_until is a high-water-mark for cpy_hook
+// coverage; resetting it just means "treat all slots as not-yet-covered
+// for diagnostic purposes." The slab pointers themselves remain valid
+// until the cache is destroyed (~llama_kv_cache →
+// fraqtl_runtime_clear_layer_slabs).
+extern "C" void fraqtl_runtime_reset_layer_cursors(void) {
+    for (int i = 0; i < FRAQTL_MAX_LAYERS; ++i) {
+        g_fraqtl.packed_until[i] = 0;
+    }
+}
+
+// ===========================================================================
+// write-time pack hook.
+// Called from ggml_cuda_cpy when the destination is a cache_v_l<L> tensor.
+// Packs only the rows just written (n_rows starting at dst_row_start) into
+// the per-layer slab. Replaces the per-fattn-call O(S) repack with an
+// O(rows-just-written) pack — typically O(1) per decode step, O(n_prompt)
+// per prefill cpy.
+// V cache layout (allocated in llama_kv_cache::llama_kv_cache):
+//   ggml_new_tensor_3d(ctx, type_v, n_embd_v_gqa, kv_size, n_stream)
+//   ne = [n_embd_v_gqa, kv_size, n_stream]
+//   nb = [sizeof(half), n_embd_v_gqa*sizeof(half), n_embd_v_gqa*kv_size*sizeof(half)]
+// where n_embd_v_gqa = n_kv_heads * head_dim. So one cache row contains
+// NKV heads × HD halves laid out contiguously: [head0_dim0..head0_dimHD-1,
+// head1_dim0..head1_dimHD-1, ...].
+// We reuse fraqtl_kv_pack_v_strided by synthesizing per-kvh sub-launches
+// with [HD, n_rows, 1, 1] virtual shape and strides:
+//   nb[0] = sizeof(half), nb[1] = v_cache_nb[1] (= NKV*HD*sizeof(half),
+//   the cache row stride), nb[2] = HD*sizeof(half) (one head's worth of
+//   halves — the "kvh stride" within a row), nb[3] = unused.
+// The kernel's per-kvh sub-launch already pre-offsets pointers in host
+// code, so we just need the right per-kvh starting V pointer.
+// ===========================================================================
+// Mark a layer as needing a Phase-1 fallback pack on the next fattn call.
+// Called from cpy.cu when the pre-call shape/stride/alignment gates fail
+// for a recognized cache_v_l<L> destination, AND from inside cpy_hook on
+// any internal validation failure. After removed the unconditional
+// fattn-side pack, the slab is the only V representation downstream — if
+// the cpy hook could not populate it for a slot range that just got new
+// data, we MUST regenerate the slab from V at fattn time before unpacking,
+// or attention will read stale/zero values for valid (non-empty) cells.
+extern "C" void fraqtl_runtime_mark_layer_fallback(int32_t layer_idx, int32_t reason) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    g_fraqtl.needs_fallback_pack[layer_idx] = 1;
+    if (reason == 1) {
+        g_fraqtl.hook_skips_shape[layer_idx]++;
+    } else {
+        g_fraqtl.hook_errors[layer_idx]++;
+    }
+}
+
+extern "C" int fraqtl_runtime_pack_v_cpy_hook(
+    const void *    v_cache_data,
+    const int64_t * v_cache_ne,
+    const size_t  * v_cache_nb,
+    int32_t         dst_row_start,
+    int32_t         n_rows,
+    int32_t         layer_idx,
+    void *          stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (n_rows <= 0)      return 0;
+
+    // Layer index gate. Loud + sticky for any caller that thinks it found
+    // a cache_v_l<L> name but L is out of range.
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS ||
+        (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers))
+    {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer_idx=%d out of range (n_layers=%d, max=%d) "
+            "— ABORT pack, fallback NOT settable (no valid layer slot)\n",
+            layer_idx, g_fraqtl.n_layers, FRAQTL_MAX_LAYERS);
+        fflush(stderr);
+        return 13;
+    }
+
+    void * lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void * lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void * lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    int    kv_size   = g_fraqtl.layer_kv_size    [layer_idx];
+    if (!lay_prot || !lay_scale || kv_size <= 0) {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer %d slabs not registered "
+            "(lay_prot=%p lay_scale=%p kv_size=%d) — fallback enabled\n",
+            layer_idx, lay_prot, lay_scale, kv_size);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 14;
+    }
+
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    const int K   = g_fraqtl.k_protect;
+    const int sac_dims          = HD - K;
+    const int padded_groups     = (sac_dims + 7) / 8;
+    const int packed_bytes_per_row = padded_groups * 3;
+
+    // Validate the cache shape matches the registered model.
+    if (v_cache_ne[0] != (int64_t) NKV * (int64_t) HD) {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer %d: cache ne[0]=%lld != NKV(%d)*HD(%d)=%d "
+            "— fallback enabled\n",
+            layer_idx, (long long) v_cache_ne[0], NKV, HD, NKV * HD);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 11;
+    }
+    if (v_cache_nb[1] != (size_t) NKV * (size_t) HD * sizeof(half)) {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer %d: cache nb[1]=%zu != NKV*HD*sizeof(half)=%zu "
+            "— fallback enabled\n",
+            layer_idx, v_cache_nb[1],
+            (size_t) NKV * (size_t) HD * sizeof(half));
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 18;
+    }
+
+    if (dst_row_start < 0 || dst_row_start + n_rows > kv_size) {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer %d: dst_row_start=%d + n_rows=%d > kv_size=%d "
+            "— fallback enabled\n",
+            layer_idx, dst_row_start, n_rows, kv_size);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 17;
+    }
+
+    // First-call-per-layer cpy_hook diagnostic (one line per layer per process).
+    static unsigned char hook_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!hook_logged[layer_idx]) {
+        fprintf(stderr,
+            "fraqtl: cpy_hook layer %d FIRST CALL — "
+            "dst_row_start=%d n_rows=%d kv_size=%d K=%d NKV=%d HD=%d "
+            "v_cache_nb=[%zu,%zu,%zu,%zu]\n",
+            layer_idx, dst_row_start, n_rows, kv_size, K, NKV, HD,
+            v_cache_nb[0], v_cache_nb[1], v_cache_nb[2], v_cache_nb[3]);
+        fflush(stderr);
+        hook_logged[layer_idx] = 1;
+    }
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+
+    // Synthetic strides for the strided pack kernel: pretend the cache row
+    // is laid out as [HD, S=n_rows, NKV, 1] with NKV interleaved INSIDE the
+    // S stride (one cache row = NKV heads contiguous → kvh stride = HD halves).
+    const size_t synth_nb0 = sizeof(half);
+    const size_t synth_nb1 = v_cache_nb[1];                  // cache row stride
+    const size_t synth_nb2 = (size_t) HD * sizeof(half);     // one kv head's halves
+    const size_t synth_nb3 = synth_nb1 * (size_t) n_rows;    // unused (B=1)
+
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        // V input ptr: cache_data + dst_row_start rows + kvh's head offset.
+        const char * v_off = (const char *) v_cache_data
+                           + (size_t) dst_row_start * synth_nb1
+                           + (size_t) kvh           * synth_nb2;
+
+        // Slab destination (kvh-major × full kv_size layout, same as
+        // decode_v_incremental's unpack reads from).
+        char * prot_off  = (char *) lay_prot
+            + ((size_t) kvh * (size_t) kv_size + (size_t) dst_row_start)
+              * (size_t) K * sizeof(half);
+        char * pack_off  = lay_pack
+            ? (char *) lay_pack
+              + ((size_t) kvh * (size_t) kv_size + (size_t) dst_row_start)
+                * (size_t) packed_bytes_per_row
+            : nullptr;
+        char * scale_off = (char *) lay_scale
+            + ((size_t) kvh * (size_t) kv_size + (size_t) dst_row_start)
+              * sizeof(float);
+
+        const half * U_kvh = ((half *) g_fraqtl.d_U)
+            + (size_t) layer_idx * NKV * HD * HD
+            + (size_t) kvh        * HD * HD;
+
+        fraqtl_kv_pack_v_strided(
+            v_off,
+            (half *)    prot_off,
+            (uint8_t *) pack_off,
+            (float *)   scale_off,
+            U_kvh,
+            /*B=*/1, /*NKV=*/1, /*S=*/n_rows, HD, K,
+            synth_nb0, synth_nb1, synth_nb2, synth_nb3,
+            cu_stream
+        );
+    }
+
+    // Advance high-water mark (informational; not used for control flow).
+    const int hwm_after = dst_row_start + n_rows;
+    if (hwm_after > g_fraqtl.packed_until[layer_idx]) {
+        g_fraqtl.packed_until[layer_idx] = hwm_after;
+    }
+    g_fraqtl.cpy_hook_calls[layer_idx]++;
+    return 0;
+}
+
+// ===========================================================================
+// (A1): set_rows-side write-time pack hook.
+// Called from ggml_cuda_op_set_rows when the destination tensor (or its
+// view_src) is named cache_v_l<L>. Reads the cache rows POST-set_rows
+// (same-stream FIFO ordering ensures set_rows kernel completed before
+// our pack queues), gathered by v_idxs[t] for each token t in
+// [0, n_tokens). v_idxs is a device pointer of int64 or int32; the
+// kernel reads it on-device, no host sync required.
+// Per-kvh sub-launch shape mirrors fraqtl_runtime_pack_v_cpy_hook so
+// the slab layout (kvh-major × kv_size) is identical between the two
+// pack paths. decode_v_incremental's unpack reads the same
+// layout.
+// Return codes mirror cpy_hook (0 ok, 11/13/14/17/18 various validation
+// failures). Any non-zero return marks the layer for Phase-1 fallback
+// at the next fattn entry — slabs MUST NOT be unpacked while in an
+// inconsistent state.
+// ===========================================================================
+extern "C" int fraqtl_runtime_pack_v_set_rows_hook(
+    const void *    v_cache_data,
+    const int64_t * v_cache_ne,
+    const size_t  * v_cache_nb,
+    const void *    v_idxs_data,    // device pointer
+    int32_t         v_idxs_dtype,   // 0 = i64, 1 = i32
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (n_tokens <= 0)    return 0;
+
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS ||
+        (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers))
+    {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer_idx=%d out of range "
+            "(n_layers=%d, max=%d) — ABORT pack, fallback NOT settable\n",
+            layer_idx, g_fraqtl.n_layers, FRAQTL_MAX_LAYERS);
+        fflush(stderr);
+        return 13;
+    }
+
+    // ===========================================================
+    // V_MEM_PROBE (internal ).
+    // V-only 64K PPL showed +294 MiB regression. Per analysis
+    // this is "irreducible without K compression" attributed to slabs
+    // + descriptor + steady scratch. internal review:
+    // instrument first, patch second.
+    // Sample free/total memory at well-defined points so we can
+    // localize when the +294 MiB grows during PPL. Gated to layers
+    // {0, 14, 27} and call_counts {0, 8, 16, 24, 32}.
+    {
+        const int call_idx = g_fraqtl.set_rows_hook_calls[layer_idx];
+        const bool layer_in_sample = (layer_idx == 0 || layer_idx == 14 || layer_idx == 27);
+        const bool call_in_sample  = (call_idx == 0 || call_idx == 8 ||
+                                      call_idx == 16 || call_idx == 24 ||
+                                      call_idx == 32);
+        if (layer_in_sample && call_in_sample) {
+            size_t mem_free = 0, mem_total = 0;
+            cudaMemGetInfo(&mem_free, &mem_total);
+            const size_t mem_used = mem_total - mem_free;
+            fprintf(stderr,
+                "fraqtl: V_MEM_PROBE layer=%d call=%d "
+                "free_mib=%zu total_mib=%zu used_mib=%zu n_tokens=%d\n",
+                layer_idx, call_idx,
+                mem_free  / (1024 * 1024),
+                mem_total / (1024 * 1024),
+                mem_used  / (1024 * 1024),
+                n_tokens);
+            fflush(stderr);
+        }
+    }
+
+    void * lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void * lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void * lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    int    kv_size   = g_fraqtl.layer_kv_size    [layer_idx];
+    if (!lay_prot || !lay_scale || kv_size <= 0) {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer %d slabs not registered "
+            "(lay_prot=%p lay_scale=%p kv_size=%d) — fallback enabled\n",
+            layer_idx, lay_prot, lay_scale, kv_size);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 14;
+    }
+
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    const int K   = g_fraqtl.k_protect;
+    const int sac_dims          = HD - K;
+    const int padded_groups     = (sac_dims + 7) / 8;
+    const int packed_bytes_per_row = padded_groups * 3;
+
+    // Validate cache shape: ne[0] must be NKV*HD; row stride matches.
+    if (v_cache_ne[0] != (int64_t) NKV * (int64_t) HD) {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer %d: cache ne[0]=%lld != "
+            "NKV(%d)*HD(%d)=%d — fallback enabled\n",
+            layer_idx, (long long) v_cache_ne[0], NKV, HD, NKV * HD);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 11;
+    }
+    if (v_cache_nb[1] != (size_t) NKV * (size_t) HD * sizeof(half)) {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer %d: cache nb[1]=%zu != "
+            "NKV*HD*sizeof(half)=%zu — fallback enabled\n",
+            layer_idx, v_cache_nb[1],
+            (size_t) NKV * (size_t) HD * sizeof(half));
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 18;
+    }
+
+    if (n_tokens > kv_size) {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer %d: n_tokens=%d > kv_size=%d "
+            "— fallback enabled\n",
+            layer_idx, n_tokens, kv_size);
+        fflush(stderr);
+        fraqtl_runtime_mark_layer_fallback(layer_idx, /*reason=internal*/0);
+        return 17;
+    }
+
+    // First-call-per-layer diagnostic.
+    static unsigned char sr_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!sr_logged[layer_idx]) {
+        fprintf(stderr,
+            "fraqtl: set_rows_hook layer %d FIRST CALL — "
+            "n_tokens=%d kv_size=%d K=%d NKV=%d HD=%d v_idxs_dtype=%d "
+            "v_cache_nb=[%zu,%zu,%zu,%zu]\n",
+            layer_idx, n_tokens, kv_size, K, NKV, HD, v_idxs_dtype,
+            v_cache_nb[0], v_cache_nb[1], v_cache_nb[2], v_cache_nb[3]);
+        fflush(stderr);
+        sr_logged[layer_idx] = 1;
+    }
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+    const size_t cache_row_stride_bytes = v_cache_nb[1];
+
+    // Per-kvh sub-launch (mirrors decode_v_incremental's loop pattern).
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        half *    prot_kvh  = (half *) ((char *) lay_prot
+            + (size_t) kvh * (size_t) kv_size * (size_t) K * sizeof(half));
+        uint8_t * pack_kvh  = lay_pack
+            ? (uint8_t *) ((char *) lay_pack
+              + (size_t) kvh * (size_t) kv_size * (size_t) packed_bytes_per_row)
+            : nullptr;
+        float *   scale_kvh = (float *) ((char *) lay_scale
+            + (size_t) kvh * (size_t) kv_size * sizeof(float));
+        const half * U_kvh = ((half *) g_fraqtl.d_U)
+            + (size_t) layer_idx * NKV * HD * HD
+            + (size_t) kvh        * HD * HD;
+
+        if (v_idxs_dtype == 0) {
+            fraqtl_kv_pack_v_set_rows_i64(
+                (const half *)    v_cache_data,
+                (const int64_t *) v_idxs_data,
+                prot_kvh, pack_kvh, scale_kvh, U_kvh,
+                n_tokens, kvh, kv_size, HD, K,
+                cache_row_stride_bytes, cu_stream);
+        } else {
+            fraqtl_kv_pack_v_set_rows_i32(
+                (const half *)    v_cache_data,
+                (const int32_t *) v_idxs_data,
+                prot_kvh, pack_kvh, scale_kvh, U_kvh,
+                n_tokens, kvh, kv_size, HD, K,
+                cache_row_stride_bytes, cu_stream);
+        }
+    }
+
+    {
+        const int sync_rc = fraqtl_sync_if_not_capturing(cu_stream, "set_rows_hook", layer_idx);
+        if (sync_rc != 0) return sync_rc;
+    }
+    fraqtl_runtime_note_v_pack_ok(layer_idx);
+    g_fraqtl.set_rows_hook_calls[layer_idx]++;
+
+    // ---- row audit (layer 0, kvh 0, slot 0, first call only) ------
+    // Confirms the pack hook is writing sensible data into the prot slab.
+    // For k=64 (no SAC), prot slab should equal V_in @ U exactly. Reconstruct
+    // V_recon = prot @ U.T and compare to V_in. rel_l2 should be ~ fp16 noise.
+    static bool row_audit_done = false;
+    if (!row_audit_done && layer_idx == 0) {
+        cudaStreamSynchronize(cu_stream);   // ensure pack kernels completed
+
+        // Read slot 0's live V cache row (kvh=0). Cache layout
+        // [n_embd_v_gqa, kv_size, n_stream]: first HD halves are slot 0, kvh 0.
+        std::vector<half> live_v_h(HD);
+        cudaMemcpy(live_v_h.data(), v_cache_data, HD * sizeof(half),
+                   cudaMemcpyDeviceToHost);
+
+        // Read first K halves of prot slab[kvh=0, slot=0]. kvh-major layout.
+        std::vector<half> prot_row_h(K);
+        cudaMemcpy(prot_row_h.data(), lay_prot, K * sizeof(half),
+                   cudaMemcpyDeviceToHost);
+
+        // Read U[layer=0, kvh=0] (HD x HD fp16).
+        std::vector<half> U_h(HD * HD);
+        cudaMemcpy(U_h.data(), (const half *) g_fraqtl.d_U,
+                   HD * HD * sizeof(half), cudaMemcpyDeviceToHost);
+
+        // Reconstruct C[0:HD]: prot[0:K] for protected dims, INT3-dequant for SAC.
+        std::vector<float> C(HD, 0.0f);
+        for (int i = 0; i < K; ++i) C[i] = __half2float(prot_row_h[i]);
+
+        if (K < HD) {
+            float scale_h_val = 0.0f;
+            cudaMemcpy(&scale_h_val, lay_scale, sizeof(float), cudaMemcpyDeviceToHost);
+            const int sac_dims    = HD - K;
+            const int n_groups    = (sac_dims + 7) / 8;
+            const int packed_bytes_local = n_groups * 3;
+            std::vector<uint8_t> pack_bytes(packed_bytes_local, 0);
+            if (lay_pack) {
+                cudaMemcpy(pack_bytes.data(), lay_pack,
+                           packed_bytes_local, cudaMemcpyDeviceToHost);
+            }
+            // MSB-first INT3 unpack matching pack kernel + dequantize_V_fraqtl.
+            for (int g = 0; g < n_groups; ++g) {
+                const uint32_t b0 = pack_bytes[g*3 + 0];
+                const uint32_t b1 = pack_bytes[g*3 + 1];
+                const uint32_t b2 = pack_bytes[g*3 + 2];
+                int idx[8];
+                idx[0] = ((b0 >> 5) & 7) - 4;
+                idx[1] = ((b0 >> 2) & 7) - 4;
+                idx[2] = (((b0 & 0x3) << 1) | ((b1 >> 7) & 1)) - 4;
+                idx[3] = ((b1 >> 4) & 7) - 4;
+                idx[4] = ((b1 >> 1) & 7) - 4;
+                idx[5] = (((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3)) - 4;
+                idx[6] = ((b2 >> 3) & 7) - 4;
+                idx[7] = ( b2       & 7) - 4;
+                for (int e = 0; e < 8; ++e) {
+                    const int hd_dim_idx = K + g*8 + e;
+                    if (hd_dim_idx < HD) {
+                        C[hd_dim_idx] = (float) idx[e] * scale_h_val;
+                    }
+                }
+            }
+        }
+
+        // V_recon[d] = sum_i C[i] * U[d, i] (matches unpack convention)
+        std::vector<float> V_recon(HD, 0.0f);
+        for (int d = 0; d < HD; ++d) {
+            float acc = 0.0f;
+            for (int i = 0; i < HD; ++i) {
+                acc += C[i] * __half2float(U_h[d * HD + i]);
+            }
+            V_recon[d] = acc;
+        }
+
+        double err_sq = 0.0, sig_sq = 0.0;
+        for (int d = 0; d < HD; ++d) {
+            const float v_orig = __half2float(live_v_h[d]);
+            const float v_rec  = V_recon[d];
+            err_sq += (v_orig - v_rec) * (v_orig - v_rec);
+            sig_sq += v_orig * v_orig;
+        }
+        const double rel_l2 = std::sqrt(err_sq / (sig_sq + 1e-12));
+
+        const int prot_print = (K < 8) ? K : 8;
+        fprintf(stderr, "fraqtl: ROW_AUDIT layer=0 kvh=0 slot=0 K=%d HD=%d\n", K, HD);
+        fprintf(stderr, "  live_v[0:8]   : ");
+        for (int i = 0; i < 8; ++i) fprintf(stderr, "%+.4f ", __half2float(live_v_h[i]));
+        fprintf(stderr, "\n  prot[0:%d]    : ", prot_print);
+        for (int i = 0; i < prot_print; ++i) fprintf(stderr, "%+.4f ", __half2float(prot_row_h[i]));
+        fprintf(stderr, "\n  V_recon[0:8]  : ");
+        for (int i = 0; i < 8; ++i) fprintf(stderr, "%+.4f ", V_recon[i]);
+        fprintf(stderr, "\n  rel_l2(live_v vs V_recon over HD dims) = %.6f"
+                        "  (expected ~0.001 at K=HD; higher at K<HD due to INT3 SAC)\n", rel_l2);
+        fflush(stderr);
+
+        row_audit_done = true;
+    }
+
+    return 0;
+}
+
+// ===========================================================================
+// ONLINE-mode set_rows pack hook that consumes src0
+// directly, bypassing the standard set_rows kernel write to cache_v_l<L>.
+// Same per-row work as fraqtl_runtime_pack_v_set_rows_hook (per-kvh
+// V@U + prot + INT3 SAC pack), but reads source halves from src0[t]
+// instead of cache_v_l<L>[v_idxs[t]]. Used by set-rows.cu in ONLINE
+// mode to skip the fp16 V cache write entirely on the decode hot path.
+// Return codes mirror the from-cache hook:
+//   0 success
+//   13 cache shape mismatch (NKV*HD)
+//   14 slabs/v_cache not registered
+//   17 n_tokens > kv_size
+//   18 cache row stride mismatch (kept for compat with existing parser)
+// ===========================================================================
+extern "C" int fraqtl_runtime_pack_v_set_rows_from_src_hook(
+    const void *    src0_data,        // ptr to set_rows src0 device memory
+    const int64_t * src0_ne,          // src0 ne[0..3]
+    const size_t  * src0_nb,          // src0 nb[0..3]
+    const void *    v_idxs_data,      // device pointer
+    int32_t         v_idxs_dtype,     // 0 = i64, 1 = i32
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+) {
+    if (!g_fraqtl.active) return 0;
+    if (n_tokens <= 0)    return 0;
+    if (g_fraqtl.mode != fraqtl_runtime_state::MODE_ONLINE) return 0;  // only fires in ONLINE mode
+
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS ||
+        (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers))
+    {
+        fprintf(stderr,
+            "fraqtl: set_rows_from_src_hook layer_idx=%d out of range — ABORT\n",
+            layer_idx);
+        fflush(stderr);
+        return 13;
+    }
+
+    void * lay_prot  = g_fraqtl.layer_v_protected[layer_idx];
+    void * lay_pack  = g_fraqtl.layer_v_packed   [layer_idx];
+    void * lay_scale = g_fraqtl.layer_v_scale    [layer_idx];
+    int    kv_size   = g_fraqtl.layer_kv_size    [layer_idx];
+    if (!lay_prot || !lay_scale || kv_size <= 0) {
+        fprintf(stderr,
+            "fraqtl: set_rows_from_src_hook layer %d slabs not registered\n",
+            layer_idx);
+        fflush(stderr);
+        return 14;
+    }
+
+    // V_MEM_PROBE — corrected attribution (internal review ).
+    // Fire on ALL layers, call 0 only (first batch). The +686 MiB jump
+    // happens somewhere across the 28-layer interval — need to localize
+    // by layer, not by call.
+    {
+        const int call_idx = g_fraqtl.set_rows_hook_calls[layer_idx];
+        static unsigned char vpack_logged[FRAQTL_MAX_LAYERS] = {0};
+        if (call_idx == 0 && !vpack_logged[layer_idx]) {
+            cudaDeviceSynchronize();
+            size_t mem_free = 0, mem_total = 0;
+            cudaMemGetInfo(&mem_free, &mem_total);
+            const size_t mem_used = mem_total - mem_free;
+            fprintf(stderr,
+                "fraqtl: V_MEM_PROBE site=vpack_pre layer=%d call=0 "
+                "free_mib=%zu used_mib=%zu n_tokens=%d\n",
+                layer_idx,
+                mem_free / (1024 * 1024),
+                mem_used / (1024 * 1024),
+                n_tokens);
+            fflush(stderr);
+            vpack_logged[layer_idx] = 1;
+        }
+    }
+
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    const int K   = g_fraqtl.k_protect;
+    const int sac_dims          = HD - K;
+    const int padded_groups     = (sac_dims + 7) / 8;
+    const int packed_bytes_row  = padded_groups * 3;
+
+    // src0 layout sanity: ne[0] should be NKV*HD F32 floats, nb[1] is
+    // the row stride bytes. set_rows callers in llama.cpp produce src0
+    // with this shape (the just-computed V row from the graph).
+    // ggml_cuda_op_set_rows asserts src0->type == GGML_TYPE_F32, so each
+    // element is 4 bytes and the per-row size is NKV*HD*sizeof(float).
+    if (src0_ne[0] != (int64_t) NKV * (int64_t) HD) {
+        fprintf(stderr,
+            "fraqtl: set_rows_from_src_hook layer %d: src0 ne[0]=%lld != NKV*HD=%d\n",
+            layer_idx, (long long) src0_ne[0], NKV * HD);
+        fflush(stderr);
+        return 13;
+    }
+    if (n_tokens > kv_size) {
+        fprintf(stderr,
+            "fraqtl: set_rows_from_src_hook layer %d: n_tokens=%d > kv_size=%d\n",
+            layer_idx, n_tokens, kv_size);
+        fflush(stderr);
+        return 17;
+    }
+
+    // First-call-per-layer diagnostic.
+    static unsigned char fr_logged[FRAQTL_MAX_LAYERS] = {0};
+    if (!fr_logged[layer_idx]) {
+        fprintf(stderr,
+            "fraqtl: set_rows_from_src_hook layer %d FIRST CALL — n_tokens=%d "
+            "kv_size=%d K=%d NKV=%d HD=%d v_idxs_dtype=%d "
+            "src0_ne=[%lld,%lld,%lld,%lld] src0_nb=[%zu,%zu,%zu,%zu]\n",
+            layer_idx, n_tokens, kv_size, K, NKV, HD, v_idxs_dtype,
+            (long long) src0_ne[0], (long long) src0_ne[1],
+            (long long) src0_ne[2], (long long) src0_ne[3],
+            src0_nb[0], src0_nb[1], src0_nb[2], src0_nb[3]);
+        fflush(stderr);
+        fr_logged[layer_idx] = 1;
+    }
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+    const size_t src0_row_stride_bytes = src0_nb[1];
+
+    for (int kvh = 0; kvh < NKV; ++kvh) {
+        half *    prot_kvh  = (half *) ((char *) lay_prot
+            + (size_t) kvh * (size_t) kv_size * (size_t) K * sizeof(half));
+        uint8_t * pack_kvh  = lay_pack
+            ? (uint8_t *) ((char *) lay_pack
+              + (size_t) kvh * (size_t) kv_size * (size_t) packed_bytes_row)
+            : nullptr;
+        float *   scale_kvh = (float *) ((char *) lay_scale
+            + (size_t) kvh * (size_t) kv_size * sizeof(float));
+        const half * U_kvh = ((half *) g_fraqtl.d_U)
+            + (size_t) layer_idx * NKV * HD * HD
+            + (size_t) kvh        * HD * HD;
+
+        if (v_idxs_dtype == 0) {
+            fraqtl_kv_pack_v_set_rows_from_src_i64(
+                (const float *)   src0_data,
+                (const int64_t *) v_idxs_data,
+                prot_kvh, pack_kvh, scale_kvh, U_kvh,
+                n_tokens, kvh, kv_size, HD, K,
+                src0_row_stride_bytes, cu_stream);
+        } else {
+            fraqtl_kv_pack_v_set_rows_from_src_i32(
+                (const float *)   src0_data,
+                (const int32_t *) v_idxs_data,
+                prot_kvh, pack_kvh, scale_kvh, U_kvh,
+                n_tokens, kvh, kv_size, HD, K,
+                src0_row_stride_bytes, cu_stream);
+        }
+    }
+
+    {
+        const int sync_rc = fraqtl_sync_if_not_capturing(cu_stream, "set_rows_from_src_hook", layer_idx);
+        if (sync_rc != 0) return sync_rc;
+    }
+    fraqtl_runtime_note_v_pack_ok(layer_idx);
+
+    // V-side double-write into fp16 sink + residual buffers.
+    // Fires AFTER the per-kvh pack loop so the compressed slab is written
+    // first; same stream guarantees ordering for the "no overwrite-before-
+    // compress" invariant when residual modular indexing wraps. No-op when
+    // is disabled (sink_n=0 + residual_n=0) or when buffers are
+    // null for this layer (defensive).
+    {
+        const bool step59_active =
+            (g_fraqtl.sink_n > 0 || g_fraqtl.residual_n > 0)
+            && (g_fraqtl.sink_V_buf[layer_idx] != nullptr
+                || g_fraqtl.residual_V_buf[layer_idx] != nullptr);
+        if (step59_active) {
+            if (v_idxs_dtype == 0) {
+                fraqtl_step59_double_write_dispatch_i64(
+                    (const float *)   src0_data,
+                    (const int64_t *) v_idxs_data,
+                    g_fraqtl.sink_V_buf[layer_idx],
+                    g_fraqtl.residual_V_buf[layer_idx],
+                    n_tokens, NKV, HD,
+                    g_fraqtl.sink_n, g_fraqtl.residual_n,
+                    src0_row_stride_bytes, cu_stream);
+            } else {
+                fraqtl_step59_double_write_dispatch_i32(
+                    (const float *)   src0_data,
+                    (const int32_t *) v_idxs_data,
+                    g_fraqtl.sink_V_buf[layer_idx],
+                    g_fraqtl.residual_V_buf[layer_idx],
+                    n_tokens, NKV, HD,
+                    g_fraqtl.sink_n, g_fraqtl.residual_n,
+                    src0_row_stride_bytes, cu_stream);
+            }
+            // Counter math under monotonic-slot assumption (true for v0:
+            // prefill batches write contiguous slots, decode writes one new
+            // slot at a time, no eviction within ctx ≤ 64K-YaRN). If a
+            // future cache-eviction model breaks monotonicity, promote
+            // slot tracking to atomicMax on a device counter.
+            const int64_t cum = g_fraqtl.step59_residual_writes_V[layer_idx];
+            if (g_fraqtl.sink_n > 0 && g_fraqtl.sink_V_buf[layer_idx]) {
+                const int64_t sink_room = (int64_t) g_fraqtl.sink_n - cum;
+                const int64_t sink_inc  = (sink_room > 0)
+                    ? (int64_t) (n_tokens < (int) sink_room ? n_tokens : (int) sink_room)
+                    : 0;
+                g_fraqtl.step59_sink_writes_V[layer_idx] += sink_inc;
+            }
+            if (g_fraqtl.residual_n > 0 && g_fraqtl.residual_V_buf[layer_idx]) {
+                g_fraqtl.step59_residual_writes_V[layer_idx] += n_tokens;
+                const int64_t res_n    = g_fraqtl.residual_n;
+                const int64_t pre_room = (cum < res_n) ? (res_n - cum) : 0;
+                const int64_t ow_inc   = (pre_room >= n_tokens) ? 0 : ((int64_t) n_tokens - pre_room);
+                g_fraqtl.step59_overwrite_V[layer_idx] += ow_inc;
+            }
+        }
+    }
+
+    g_fraqtl.set_rows_hook_calls[layer_idx]++;
+
+    // Path A: as soon as ALL layers have packed at least once,
+    // fire the engine-registered release callback to free the fp16 V buffer
+    // mid-prefill (much earlier than the decode-end trigger). One-shot per
+    // process. The callback is no-op if not registered. release_ready
+    // checks both set_rows_hook_calls > 0 AND ROW_AUDIT pass for every
+    // layer; in ONLINE_FROM_START + bypass mode the audit's rel_l2
+    // computation degenerates to 0 (live cache_v_l is all zeros, never
+    // written) so audit passes trivially.
+    if (g_fraqtl.release_callback != nullptr && !g_fraqtl.release_callback_fired) {
+        if (fraqtl_runtime_release_ready(g_fraqtl.n_layers) == 1) {
+            g_fraqtl.release_callback_fired = true;
+            // Path A proof line: emitted BEFORE the callback runs so
+            // even if the engine-side release crashes, the receipt can prove
+            // the callback was reached. Harness greps this regex.
+            int set_rows_total = 0;
+            for (int L = 0; L < g_fraqtl.n_layers; ++L) {
+                set_rows_total += g_fraqtl.set_rows_hook_calls[L];
+            }
+            fprintf(stderr,
+                "fraqtl: EARLY_RELEASE_TRIGGERED trigger_layer=%d "
+                "n_layers=%d set_rows_hook_calls_total=%d\n",
+                layer_idx, g_fraqtl.n_layers, set_rows_total);
+            fflush(stderr);
+            g_fraqtl.release_callback(g_fraqtl.release_callback_user);
+        }
+    }
+    return 0;
+}
+
+// Path A: register an engine-side callback that's fired exactly
+// once per process, the first time release_ready returns 1 from inside
+// fraqtl_runtime_pack_v_set_rows_from_src_hook. The engine's callback
+// implementation should call llama_kv_cache::release_fraqtl_v_fp16_buffers().
+// Pass cb=nullptr to disable (default state on setup). Idempotent: repeated
+// registrations overwrite the prior callback (last-write-wins).
+extern "C" void fraqtl_runtime_register_release_callback(
+        void (*cb)(void * user_data),
+        void *  user_data)
+{
+    g_fraqtl.release_callback       = cb;
+    g_fraqtl.release_callback_user  = user_data;
+    g_fraqtl.release_callback_fired = false;
+}
+
+// Path A proof helpers: thin wrappers around cudaGetLastError +
+// cudaDeviceSynchronize so non-CUDA TUs (llama-kv-cache.cpp) can capture
+// the cuda result of the buf.reset() chain. Returns int cast of cudaError_t.
+extern "C" int fraqtl_runtime_get_cuda_last_err(void) {
+    return (int) cudaGetLastError();
+}
+
+extern "C" int fraqtl_runtime_sync_and_get_err(void) {
+    return (int) cudaDeviceSynchronize();
+}
+
+// ===========================================================================
+// fused-attention dispatcher support API.
+// Three pieces:
+//   - fraqtl_attn_v_fused_supported : called from fattn.cu before the
+//                                            standard kernel dispatch to decide
+//                                            whether to take the fused path.
+//   - fraqtl_runtime_mark_fused_call : called from the fused kernel host
+//                                            launcher AFTER cudaGetLastError
+//                                            confirms a clean launch — just
+//                                            increments the per-layer counter.
+//                                            (No cross-call flag — fattn.cu's
+//                                            local `fused_handled` boolean is
+//                                            the single source of truth within
+//                                            ONE fattn entry.)
+//   - fraqtl_runtime_get_fused_attn_calls : read accessor for the FIRST
+//                                            CALL diagnostic.
+// Supported tuple (first patch): HD == 64, K_PROT in {16, 64},
+// NKV == 2. Anything else → unsupported, dispatcher falls back to
+// path (standard fattn + decode_v_incremental unpack).
+// ===========================================================================
+// Accessors used by the fused-attention launcher (fattn-fraqtl.cu).
+// Direct reads of g_fraqtl singleton state — kept in this TU because
+// g_fraqtl lives in this file's anonymous namespace.
+extern "C" const half * fraqtl_runtime_get_layer_prot_slab(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    return (const half *) g_fraqtl.layer_v_protected[layer_idx];
+}
+
+extern "C" const uint8_t * fraqtl_runtime_get_layer_pack_slab(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    return (const uint8_t *) g_fraqtl.layer_v_packed[layer_idx];
+}
+
+extern "C" const float * fraqtl_runtime_get_layer_scale_slab(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    return (const float *) g_fraqtl.layer_v_scale[layer_idx];
+}
+
+extern "C" int32_t fraqtl_runtime_get_layer_kv_size(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 0;
+    return g_fraqtl.layer_kv_size[layer_idx];
+}
+
+extern "C" const half * fraqtl_runtime_get_layer_U(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    if (g_fraqtl.d_U == nullptr) return nullptr;
+    const int NKV = g_fraqtl.n_kv;
+    const int HD  = g_fraqtl.hd;
+    return ((const half *) g_fraqtl.d_U) + (size_t) layer_idx * NKV * HD * HD;
+}
+
+extern "C" int32_t fraqtl_runtime_get_n_kv_heads(void) { return g_fraqtl.n_kv; }
+extern "C" int32_t fraqtl_runtime_get_head_dim  (void) { return g_fraqtl.hd; }
+extern "C" int32_t fraqtl_runtime_get_k_protect (void) { return g_fraqtl.k_protect; }
+extern "C" int32_t fraqtl_runtime_get_n_layers  (void) { return g_fraqtl.n_layers; }
+
+//  — clean predicate to gate K-shadow-free (and any other
+// invariant that requires fraqtl_runtime_setup to have run). Same triple
+// check that step59_alloc_buffers uses internally. Returns 1 iff
+// runtime singleton has valid shape state.
+extern "C" int32_t fraqtl_runtime_is_setup_complete(void) {
+    return (g_fraqtl.n_kv > 0 && g_fraqtl.hd > 0 && g_fraqtl.n_layers > 0
+            && g_fraqtl.n_layers <= FRAQTL_MAX_LAYERS) ? 1 : 0;
+}
+
+//  — singleton Q' workspace accessor (internal memory P0).
+// Called from fattn.cu's K-route dispatcher (replacing ggml_cuda_pool_alloc).
+// Returns a device pointer sized to at least `needed_bytes`. Grow-as-needed
+// pattern: alloc on first call; subsequent calls reuse if the existing
+// buffer is large enough, reallocate only if a larger request arrives.
+// Acceptance: g_fraqtl.qprime_alloc_count == 1 at teardown after warmup
+// (first max-ubatch prefill chunk fires the only grow event).
+extern "C" float * fraqtl_runtime_get_qprime_workspace(size_t needed_bytes) {
+    g_fraqtl.qprime_get_calls++;
+    if (needed_bytes > g_fraqtl.qprime_workspace_peak_bytes) {
+        g_fraqtl.qprime_workspace_peak_bytes = needed_bytes;
+    }
+    //  when arena is active, route Q' workspace
+    // from arena's pre-reserved qprime_scratch region (sized 28 MiB for
+    // Qwen 7B / MAX_UB=2048). Arena pointer is fixed for the lifetime of
+    // the context so the grow path never fires. Oversize requests fail
+    // loudly rather than silently corrupting arena memory.
+    if (g_fraqtl.arena_active) {
+        if (needed_bytes > g_fraqtl.arena_qprime_capacity_bytes) {
+            fprintf(stderr,
+                "fraqtl: ARENA_STAGE5_OVERFLOW needed=%zu arena_capacity=%zu "
+                "(qprime workspace exceeds arena reservation; non-default "
+                "MAX_UB or n_heads_q is unsupported in v0)\n",
+                needed_bytes, g_fraqtl.arena_qprime_capacity_bytes);
+            fflush(stderr);
+            return nullptr;
+        }
+        if (g_fraqtl.qprime_workspace == nullptr) {
+            g_fraqtl.qprime_workspace       = (float *) fraqtl_arena_qprime(g_fraqtl.arena);
+            g_fraqtl.qprime_workspace_bytes = g_fraqtl.arena_qprime_capacity_bytes;
+            g_fraqtl.qprime_alloc_count++;
+            if (!g_fraqtl.stage5_log_emitted) {
+                fprintf(stderr,
+                    "fraqtl: ARENA_STAGE5_SWAP cudaMallocs_eliminated=1 "
+                    "qprime_capacity=%zu needed=%zu\n",
+                    g_fraqtl.arena_qprime_capacity_bytes, needed_bytes);
+                fflush(stderr);
+                g_fraqtl.stage5_log_emitted = true;
+            }
+        }
+        return g_fraqtl.qprime_workspace;
+    }
+    if (g_fraqtl.qprime_workspace_bytes >= needed_bytes &&
+        g_fraqtl.qprime_workspace != nullptr) {
+        // Hot path: reuse existing buffer.
+        return g_fraqtl.qprime_workspace;
+    }
+    // Cold path: grow. Free old buffer if present, alloc new at peak size.
+    if (g_fraqtl.qprime_workspace != nullptr) {
+        cudaFree(g_fraqtl.qprime_workspace);
+        g_fraqtl.qprime_workspace = nullptr;
+        g_fraqtl.qprime_workspace_bytes = 0;
+    }
+    cudaError_t e = cudaMalloc((void **) &g_fraqtl.qprime_workspace, needed_bytes);
+    if (e != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: QPRIME_WORKSPACE_ALLOC_FAIL cuda=%s needed_bytes=%zu "
+            "prev_bytes=%zu alloc_count=%lld\n",
+            cudaGetErrorString(e), needed_bytes,
+            g_fraqtl.qprime_workspace_bytes,
+            (long long) g_fraqtl.qprime_alloc_count);
+        fflush(stderr);
+        return nullptr;
+    }
+    g_fraqtl.qprime_workspace_bytes = needed_bytes;
+    g_fraqtl.qprime_alloc_count++;
+    fprintf(stderr,
+        "fraqtl: QPRIME_WORKSPACE_GROW alloc_count=%lld bytes=%zu peak_bytes=%zu "
+        "get_calls=%lld\n",
+        (long long) g_fraqtl.qprime_alloc_count, needed_bytes,
+        g_fraqtl.qprime_workspace_peak_bytes,
+        (long long) g_fraqtl.qprime_get_calls);
+    fflush(stderr);
+    return g_fraqtl.qprime_workspace;
+}
+
+// Accessors for receipt/diagnostic harnesses.
+extern "C" size_t  fraqtl_runtime_get_qprime_workspace_bytes(void)      { return g_fraqtl.qprime_workspace_bytes; }
+extern "C" size_t  fraqtl_runtime_get_qprime_workspace_peak_bytes(void) { return g_fraqtl.qprime_workspace_peak_bytes; }
+extern "C" int64_t fraqtl_runtime_get_qprime_alloc_count(void)          { return g_fraqtl.qprime_alloc_count; }
+extern "C" int64_t fraqtl_runtime_get_qprime_get_calls(void)            { return g_fraqtl.qprime_get_calls; }
+//  (internal review roadmap) — pool trim audit hook.
+// After the first warmup forward, llama.cpp's compute scratch buffer has
+// grown from sched_reserve's 1688 MiB to runtime's 2340 MiB (the regrow tax)
+// and CUDA's caching allocator has retained ~1.5 GiB of intermediate
+// allocations. cudaMemPoolTrimTo(pool, 0) releases the unused-but-reserved
+// half of that back to the OS so nvidia-smi reflects the truth.
+// Gating: env var FRAQTL_MEMORY_AUDIT=1. NOT in hot decode path. The hook
+// fires ONCE after the K dispatcher has seen one full pass of all layers
+// (i.e. the first prefill ubatch is complete on every layer) and then
+// disables itself via g_fraqtl.audit_trim_done.
+// internal API: cudaMemPoolTrimTo (NOT cudaMemPoolTrim).
+extern "C" void fraqtl_runtime_memory_audit_trim(const char * label) {
+    int device_id = 0;
+    cudaGetDevice(&device_id);
+    cudaMemPool_t pool;
+    cudaError_t e = cudaDeviceGetDefaultMemPool(&pool, device_id);
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: MEMORY_AUDIT_FAIL cudaDeviceGetDefaultMemPool=%s\n",
+                cudaGetErrorString(e));
+        fflush(stderr);
+        return;
+    }
+
+    cudaDeviceSynchronize();
+
+    unsigned long long reserved_before = 0, used_before = 0,
+                       reserved_after  = 0, used_after  = 0;
+    cudaMemPoolGetAttribute(pool, cudaMemPoolAttrReservedMemCurrent, &reserved_before);
+    cudaMemPoolGetAttribute(pool, cudaMemPoolAttrUsedMemCurrent,     &used_before);
+
+    size_t free_before = 0, total_before = 0,
+           free_after  = 0, total_after  = 0;
+    cudaMemGetInfo(&free_before, &total_before);
+
+    cudaMemPoolTrimTo(pool, 0);
+    cudaDeviceSynchronize();
+
+    cudaMemPoolGetAttribute(pool, cudaMemPoolAttrReservedMemCurrent, &reserved_after);
+    cudaMemPoolGetAttribute(pool, cudaMemPoolAttrUsedMemCurrent,     &used_after);
+    cudaMemGetInfo(&free_after, &total_after);
+
+    const double MIB = 1024.0 * 1024.0;
+    fprintf(stderr,
+        "fraqtl: MEMORY_AUDIT_TRIM label=%s "
+        "pool_reserved_before_mib=%.1f pool_reserved_after_mib=%.1f "
+        "pool_used_before_mib=%.1f pool_used_after_mib=%.1f "
+        "pool_freed_mib=%.1f "
+        "cudaMemGetInfo_free_before_mib=%.1f cudaMemGetInfo_free_after_mib=%.1f "
+        "cudaMemGetInfo_freed_mib=%.1f total_mib=%.1f\n",
+        label,
+        (double) reserved_before / MIB, (double) reserved_after / MIB,
+        (double) used_before     / MIB, (double) used_after     / MIB,
+        ((double) reserved_before - (double) reserved_after) / MIB,
+        (double) free_before / MIB, (double) free_after / MIB,
+        ((double) free_after - (double) free_before) / MIB,
+        (double) total_before / MIB);
+    fflush(stderr);
+}
+
+// Audit trim trigger: called from the K dispatcher's post-K_DISPATCH path.
+// Two responsibilities:
+//   1. (FRAQTL_POOL_THRESHOLD_ZERO=1) On the FIRST K dispatch: set
+//      cudaMemPoolAttrReleaseThreshold = 0 so retention never accumulates
+//      in the first place. This is the lever that actually moves smi_peak
+//      because trim alone fires AFTER the peak is recorded by polling.
+//   2. (FRAQTL_MEMORY_AUDIT=1) After n_layers dispatches (first full
+//      forward done): fire cudaMemPoolTrimTo + before/after pool stats
+//      logging. Belt-and-suspenders for residual retention.
+// Both env vars are independent. Either / both / neither active is fine.
+// Safe to call from any K dispatch event — guarded by one-shot flags.
+extern "C" void fraqtl_runtime_memory_audit_maybe_trim_post_warmup(void) {
+    static int threshold_zero_done = 0;
+    static int audit_active        = -1;
+    static int threshold_zero_env  = -1;
+
+    // First-dispatch threshold-zero lever (BEFORE any retention forms).
+    if (!threshold_zero_done) {
+        if (threshold_zero_env < 0) {
+            const char * e = std::getenv("FRAQTL_POOL_THRESHOLD_ZERO");
+            threshold_zero_env = (e && e[0] == '1') ? 1 : 0;
+        }
+        if (threshold_zero_env) {
+            int device_id = 0;
+            cudaGetDevice(&device_id);
+            cudaMemPool_t pool;
+            cudaError_t e = cudaDeviceGetDefaultMemPool(&pool, device_id);
+            if (e == cudaSuccess) {
+                unsigned long long zero = 0;
+                cudaError_t se = cudaMemPoolSetAttribute(
+                    pool, cudaMemPoolAttrReleaseThreshold, &zero);
+                fprintf(stderr,
+                    "fraqtl: POOL_THRESHOLD_ZERO_SET rc=%d (cuda=%s) — "
+                    "default pool will release async-freed memory immediately. "
+                    "Prevents pool retention before smi_peak forms.\n",
+                    (int) se, cudaGetErrorString(se));
+                fflush(stderr);
+            } else {
+                fprintf(stderr,
+                    "fraqtl: POOL_THRESHOLD_ZERO_FAIL "
+                    "cudaDeviceGetDefaultMemPool=%s\n",
+                    cudaGetErrorString(e));
+                fflush(stderr);
+            }
+        }
+        threshold_zero_done = 1;
+    }
+
+    // Trim-after-first-pass lever.
+    if (g_fraqtl.audit_trim_done) return;
+    if (audit_active < 0) {
+        const char * env = std::getenv("FRAQTL_MEMORY_AUDIT");
+        audit_active = (env && env[0] == '1') ? 1 : 0;
+        if (audit_active) {
+            fprintf(stderr,
+                "fraqtl: MEMORY_AUDIT_ENABLED — will trim CUDA pool after "
+                "first full forward pass (one trim total).\n");
+            fflush(stderr);
+        }
+    }
+    if (!audit_active) return;
+    g_fraqtl.audit_dispatches_seen++;
+    if (g_fraqtl.audit_dispatches_seen >= g_fraqtl.n_layers) {
+        fraqtl_runtime_memory_audit_trim("post_first_full_pass");
+        g_fraqtl.audit_trim_done = true;
+    }
+}
+
+// descriptor arena accessors. Used by fattn.cu dispatcher to
+// substitute V tensor data + nb[1..3] with descriptor base + sizeof(desc).
+extern "C" const fraqtl_v_row_desc * fraqtl_runtime_get_layer_v_descriptors(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return nullptr;
+    return g_fraqtl.layer_v_descs[layer_idx];
+}
