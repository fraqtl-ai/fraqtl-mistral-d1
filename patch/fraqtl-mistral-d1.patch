index 000000000..f22eb39ed
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-fraqtl.cuh
@@ -0,0 +1,45 @@
+// fused attention for fraQtl V cache.
+// Replaces the per-fattn-call unpack -> V tensor materialization round
+// trip () with a single kernel that reads the per-layer slabs
+// (prot / packed / scale) directly inside the V-multiply phase. The
+// un-rotation by U.T happens once per query-step on the accumulated
+// V vector instead of once per (kv_row, query) pair.
+// First-patch scope (, internal review direction):
+//   - HD = 64, K_PROT in {16, 64}, NKV = 2
+//   - F1: fp16 V cache stays allocated (ggml-managed); we just don't
+//     read from it. F2 (drop the cache) is .
+//   - Dispatcher in fattn.cu falls back to the path for any
+//     unsupported shape (different HD / K / NKV / batch / SWA / MLA).
+// See docs/fraqtl-kv-day12-fused-attention-design.md for the full
+// design and gating criteria.
+#pragma once
+
+// ggml types are in <ggml.h>; the rest of ggml-cuda includes that
+// transitively. We avoid pulling common.cuh into this header so it
+// can be referenced from fattn.cu without re-touching CUDA includes
+// already pulled in there.
+struct ggml_tensor;
+
+extern "C" {
+
+// Launch the fused attention kernel for one fattn call. Reads slabs
+// for the given layer, writes O (= dst->data) directly. Caller has
+// already validated supported shape (HD=64, K in {16, 64}, NKV=2)
+// via fraqtl_attn_v_fused_supported() and fraqtl runtime active.
+// op_params (scale, max_bias, logit_softcap) are read from O->op_params
+// host-side and applied internally. Mask handling: only the standard 2D
+// causal mask (mask->ne = [n_kv, n_tokens, *, *]) is supported; if mask
+// is non-null and shape doesn't match, returns non-zero and the caller
+// should fall back to the standard fattn path.
+// Returns 0 on success; non-zero on internal validation failure.
+int fraqtl_attn_v_fused_launch(
+    const struct ggml_tensor * Q,        // src[0]
+    const struct ggml_tensor * K,        // src[1]
+    const struct ggml_tensor * V,        // src[2] (used for shape only)
+    const struct ggml_tensor * mask,     // src[3], may be null
+    struct ggml_tensor *       O,        // dst
+    int                        layer_idx,
+    void *                     stream    // cudaStream_t passed as void*
+);
+
+}  // extern "C"
