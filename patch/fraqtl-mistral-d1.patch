+extern "C" void fraqtl_kv_unpack_v(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const float*   v_scale,
+    const half*    eigenbasis,
+    half*          v_out,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+) {
+    const int total = B * NKV * S; if (total <= 0) return;
+    const size_t shmem = (size_t) HD * sizeof(float);
