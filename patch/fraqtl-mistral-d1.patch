+// FraQtl Runtime v0 — public API.
+// Standalone of llama.cpp. internal review-committed .
+
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+#include <cuda_fp16.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// =============================================================================
+// FraqtlArena — one persistent cudaMalloc, sub-allocated regions.
+// =============================================================================
+
+typedef struct fraqtl_arena_s fraqtl_arena_t;
+
+// Configuration for arena layout. All sizes in bytes.
+typedef struct {
+    int32_t n_layers;
+    int32_t n_kv_heads;
+    int32_t n_heads_q;          // total Q-side head count (28 for Qwen 7B)
+                                // — REQUIRED for correct qprime sizing
+    int32_t head_dim;
+    int32_t kv_size;            // context length (e.g. 65536)
+    int32_t max_n_tokens;       // max ubatch (e.g. 2048)
+    int32_t k_protect;          // fp16 protected K dims (e.g. 32)
+    int32_t v_protect;
+    int32_t k_rank_max;         // largest per-(layer,kvh) K rank
+    int32_t v_rank_max;
+    int32_t sink_n;             // first N positions fp16 (e.g. 8)
+    int32_t residual_n;         // last N positions fp16 (e.g. 2048)
+} fraqtl_arena_config_t;
+
+// Per-region byte counts after sizing. Useful for accounting + receipt.
+typedef struct {
+    size_t total_bytes;
+    size_t compressed_k_bytes;
+    size_t compressed_v_bytes;
+    size_t protected_k_bytes;
+    size_t protected_v_bytes;
+    size_t uk_arena_bytes;
+    size_t uv_arena_bytes;
+    size_t scales_k_bytes;
+    size_t scales_v_bytes;
+    size_t ranks_bytes;
+    size_t offsets_bytes;
+    size_t sink_k_bytes;
+    size_t sink_v_bytes;
+    size_t residual_k_bytes;
+    size_t residual_v_bytes;
+    size_t qprime_scratch_bytes;
+    size_t tile_scratch_bytes;
+    //  global staging buffers for K compression.
+    // Previously 3 separate cudaMallocs in fraqtl_runtime_setup (d_packed,
+    // d_scale, d_protected). Sized off kv_size * n_kv_heads (== scratch_rows).
+    size_t staging_packed_bytes;     // kv_size*n_kv * ((HD-K_PROTECT+7)/8)*3
+    size_t staging_scale_bytes;      // kv_size*n_kv * sizeof(float)
+    size_t staging_protected_bytes;  // kv_size*n_kv * K_PROTECT * sizeof(half)
+    //  vLLM CUDA ABI the K/V descriptor regions are
+    // already summed into total_bytes but were not exposed as named
+    // fields, leaving the accounting ledger short by k_desc + v_desc.
+    // Now first-class (purely additive — no change to total_bytes).
+    size_t k_desc_bytes;             // n_layers * n_kv * 64 (per-(layer,kvh))
+    size_t v_desc_bytes;             // n_layers * kv_size * n_kv * 48 (per-slot)
+} fraqtl_arena_layout_t;
+
+// Compute arena layout from config (does NOT allocate). Pure function.
+int fraqtl_arena_compute_layout(
+    const fraqtl_arena_config_t * cfg,
+    fraqtl_arena_layout_t       * layout
+);
+
+// Allocate the arena with one cudaMalloc. Sub-regions populated via offsets.
+// Returns 0 on success, non-zero cuda error code on failure.
+int fraqtl_arena_create(
+    const fraqtl_arena_config_t * cfg,
+    fraqtl_arena_t             ** out_arena
+);
+
+//  production opts to skip ggml-owned regions.
+typedef struct {
+    int32_t skip_compressed_kv;  // 1 = arena does not reserve compressed K/V
+                                 //     (ggml's KV cache owns them in production
+                                 //     via set_rows hooks; arena reservation
+                                 //     was double-counting at smi peak).
+                                 // 0 = full layout (standalone tests).
+} fraqtl_arena_opts_t;
+
+// Same as fraqtl_arena_create but with explicit opts. The base function is a
+// thin wrapper that calls this with opts={0,...}.
+int fraqtl_arena_create_with_opts(
+    const fraqtl_arena_config_t * cfg,
+    const fraqtl_arena_opts_t   * opts,
+    fraqtl_arena_t             ** out_arena
+);
+
+// Get pointers to each region (device pointers, lifetime = arena).
+void * fraqtl_arena_compressed_k(fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_compressed_v(fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_residual_k  (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_residual_v  (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_sink_k      (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_sink_v      (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_v_desc      (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_k_desc      (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_k_ranks     (fraqtl_arena_t * arena, int32_t layer);
+void * fraqtl_arena_uk          (fraqtl_arena_t * arena, int32_t layer, int32_t kvh);
+void * fraqtl_arena_uv          (fraqtl_arena_t * arena, int32_t layer, int32_t kvh);
+void * fraqtl_arena_qprime      (fraqtl_arena_t * arena);  // shared singleton
+
+//  global staging-buffer accessors. Singletons
+// (no per-layer / per-kvh indexing). Used by fraqtl_runtime_setup to replace
+// the d_packed / d_scale / d_protected cudaMallocs when FRAQTL_USE_ARENA=1.
+void * fraqtl_arena_staging_packed   (fraqtl_arena_t * arena);
+void * fraqtl_arena_staging_scale    (fraqtl_arena_t * arena);
+void * fraqtl_arena_staging_protected(fraqtl_arena_t * arena);
+
+// Get full layout for audit/receipt.
+void fraqtl_arena_get_layout(const fraqtl_arena_t * arena,
+                              fraqtl_arena_layout_t * out);
+
+// Tear down. Frees the single cudaMalloc and the arena struct.
+void fraqtl_arena_destroy(fraqtl_arena_t * arena);
+
+// =============================================================================
+// FraqtlAttention — custom kernel that consumes compressed K/V tile-by-tile.
+// =============================================================================
+
+// Run one attention call:
+//   Q[n_q, n_heads, head_dim] (fp32)
+// + compressed K/V slabs (in arena)
+// + residual K/V rings (last `residual_n` positions, fp16)
+// + protected mask (which old tokens are kept fp16 — optional, can be null)
+// → output O[n_q, n_heads, head_dim] (fp32)
+// this is a STUB that calls fraqtl_reference_attention (fp16
+// reconstruction in fp16 scratch, then standard attention).
+// replaces this with the real per-tile compressed-decode kernel.
+// Returns 0 on success.
+int fraqtl_attention_v0(
+    fraqtl_arena_t * arena,
+    int32_t          layer_idx,
+    const float    * Q,         // device pointer
+    int32_t          n_q,
+    int32_t          n_heads,
+    int32_t          n_seqs,
+    int32_t          kv_used,   // current K/V cache fill (≤ kv_size)
+    float          * O,         // device pointer, output
+    void           * stream     // cudaStream_t
+);
+
+// =============================================================================
+// FraqtlPagedAttention — vLLM CUDA ABI .
+// =============================================================================
+// =============================================================================
+// Reference fp16 attention (for parity checks).
+// =============================================================================
+
+int fraqtl_reference_attention_fp16(
+    const __half * K_full,      // [kv_size, n_heads, head_dim] fp16
+    const __half * V_full,      // [kv_size, n_heads, head_dim] fp16
+    const float  * Q,           // [n_q, n_heads, head_dim] fp32
+    int32_t        n_q,
+    int32_t        n_heads,
+    int32_t        head_dim,
+    int32_t        kv_used,
+    float        * O,           // [n_q, n_heads, head_dim] fp32
+    void         * stream
+);
+
+#ifdef __cplusplus
+}
+#endif
