+// fraQtl V cache compression — CUDA kernels.
+// Production: uniform-symmetric INT3 (matches fraqtl/packing.py and runtime
+// PackedKVCache). Locked after the math agent confirmed Lloyd-Max
+// is the weight-compression recipe and uniform is the V-cache runtime recipe
+// (LM drifts ~7× worse without future-token error feedback).
+// Legacy: Lloyd-Max + 1-bit sign correction kernels retained as debug fallback,
+// suffix `_lloyd_max_sign_legacy`. Same shared-memory layout, different math.
+
+#include "fraqtl-kv.cuh"
+#include "fraqtl_runtime_v0.h"   //  FraqtlArena integration
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cmath>
+#include <vector>
