+extern "C" int32_t fraqtl_runtime_get_v_desc_stride(void) {
+    return (int32_t) sizeof(fraqtl_v_row_desc);
+}
+
+// =============================================================================
+// post-process kernel that applies U.T to dst.
+// The MMA kernel (with fraqtl_v=true) writes the C-space attention output
+//     O_c[q, head, c] = sum_k P[q, head, k] * C[k, c]
+// to dst (f32). To get back to original V-space we apply
+//     O[q, head, hd] = sum_c O_c[q, head, c] * U_head[kvh, hd, c]
+// where kvh = head / gqa_ratio.
+// Math identity used: V = C @ U.T, so
+//     O = P @ V = P @ (C @ U.T) = (P @ C) @ U.T = O_c @ U.T
+// One block per (q_idx, head_idx). HD threads per block; each thread emits
+// one output dim hd_out. Stage O_c[q, head, *] (HD floats = 512 B at HD=128)
+// in shared memory so reads finish before writes. U_head is global, served
+// by L2 (one (kvh, head_in_kvh) pair per block, all blocks with same kvh
+// hit the same 32 KiB U_head — fits L2 trivially).
+// First-hack: separate kernel launched after `_case<...,true>` returns.
+// If 64K perf is acceptable, this can later be fused into the MMA write-out.
+// =============================================================================
+template <int HD>
+__global__ void fraqtl_apply_U_T_to_O_kernel(
+        float * __restrict__ O,        // [HD, n_q, n_heads, n_seqs] f32 contiguous
+        const half * __restrict__ U_layer,  // [n_kv_heads, HD, HD] half
+        const int n_q,
+        const int n_heads,
+        const int gqa_ratio)
+{
+    const int q_idx    = blockIdx.x;   // 0..n_q
+    const int head_idx = blockIdx.y;   // 0..n_heads
+    const int seq_idx  = blockIdx.z;   // 0..n_seqs (typically 1)
+    const int hd_out   = threadIdx.x;  // 0..HD
+
+    if (hd_out >= HD) return;
+
+    const int kvh = head_idx / gqa_ratio;
+    const half * U_head = U_layer + (size_t) kvh * HD * HD;
+
+    // dst MEMORY layout (per fattn-common.cuh:991 combine kernel write):
+    //     j_dst_unrolled = (sequence*n_q + q_idx)*n_heads + head_idx
+    //     dst += j_dst_unrolled * HD
+    // i.e. memory order is [HD, n_heads, n_q, n_seqs] — head BEFORE q.
+    // The ggml tensor is reported as ne=[HD, n_q, n_heads, n_seqs] but
+    // its strides are permuted so the physical memory matches the kernel
+    // write pattern. We must match that pattern here, otherwise we read
+    // O_c at one (q, head) and write O at a DIFFERENT (q, head), which
+    // scrambles the output (v0 bug, fixed here).
+    const size_t out_base = (size_t) seq_idx * n_q * n_heads * HD
+                          + (size_t) q_idx * n_heads * HD
+                          + (size_t) head_idx * HD;
+
+    // Stage O_c[q, head, *] in shared memory. Block reads then thread-writes.
+    __shared__ float stage[HD];
+    stage[hd_out] = O[out_base + hd_out];
+    __syncthreads();
+
+    // O[hd_out] = sum_c stage[c] * U_head[hd_out * HD + c]
+    // U_head is half; convert per FMA. HD=128 → 128 FMAs per thread.
+    float acc = 0.0f;
+    #pragma unroll
+    for (int c = 0; c < HD; ++c) {
+        acc += stage[c] * __half2float(U_head[(size_t) hd_out * HD + c]);
+    }
+
+    __syncthreads();  // ensure all stage reads done before overwriting O
+    O[out_base + hd_out] = acc;
+}
+
+extern "C" int fraqtl_runtime_apply_U_T_to_O(
+        float *      O_dst,
+        int32_t      n_q,
+        int32_t      n_heads,
+        int32_t      n_seqs,
+        int32_t      layer_idx,
+        cudaStream_t stream)
+{
+    if (!g_fraqtl.active) return 1;
+    if (g_fraqtl.d_U == nullptr) return 2;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 3;
+    const int HD  = g_fraqtl.hd;
+    const int NKV = g_fraqtl.n_kv;
+    if (NKV <= 0 || n_heads % NKV != 0) return 4;
+    const int gqa_ratio = n_heads / NKV;
+    const half * U_layer = ((const half *) g_fraqtl.d_U)
+                         + (size_t) layer_idx * NKV * HD * HD;
+
+    // Locked v0 scope: HD must be 128. Other HDs need separate template
+    // instantiation. fattn.cu's eligibility check already gates on HD=128.
+    if (HD != 128) return 5;
+
+    // : one-shot memory probe around postprocess U_T kernel.
+    // The 5+ GiB transient mystery at fraqtl K+V attention forward might
+    // be in here OR in the K dispatch kernel. Probe the free/used delta
+    // around this kernel launch on the first invocation per layer to find
+    // which step actually allocates GPU memory.
+    static unsigned char ut_mem_probe_logged[96] = {0};
+    if (layer_idx >= 0 && layer_idx < 96 && !ut_mem_probe_logged[layer_idx]) {
+        size_t free_before = 0, total = 0;
+        cudaMemGetInfo(&free_before, &total);
+        // Synchronize so we measure post-attention but pre-U_T state cleanly.
+        cudaStreamSynchronize(stream);
+        size_t free_pre_ut = 0;
+        cudaMemGetInfo(&free_pre_ut, &total);
+
+        dim3 grid((unsigned) n_q, (unsigned) n_heads, (unsigned) n_seqs);
+        dim3 block((unsigned) HD);
+        fraqtl_apply_U_T_to_O_kernel<128><<<grid, block, 0, stream>>>(
+            O_dst, U_layer, n_q, n_heads, gqa_ratio);
+        cudaStreamSynchronize(stream);
+        size_t free_post_ut = 0;
+        cudaMemGetInfo(&free_post_ut, &total);
+
+        fprintf(stderr,
+            "fraqtl: U_T_MEM_PROBE layer=%d n_q=%d n_heads=%d n_seqs=%d "
+            "free_before=%zu MiB free_pre_ut=%zu MiB free_post_ut=%zu MiB "
+            "attn_used_delta=%zd MiB ut_used_delta=%zd MiB total_used_now=%zu MiB\n",
+            layer_idx, n_q, n_heads, n_seqs,
+            free_before  / (1024*1024),
+            free_pre_ut  / (1024*1024),
+            free_post_ut / (1024*1024),
+            (ssize_t)(free_before  - free_pre_ut)  / (1024*1024),
+            (ssize_t)(free_pre_ut  - free_post_ut) / (1024*1024),
+            (total - free_post_ut) / (1024*1024));
+        fflush(stderr);
+        ut_mem_probe_logged[layer_idx] = 1;
+    } else {
+        dim3 grid((unsigned) n_q, (unsigned) n_heads, (unsigned) n_seqs);
+        dim3 block((unsigned) HD);
+        fraqtl_apply_U_T_to_O_kernel<128><<<grid, block, 0, stream>>>(
+            O_dst, U_layer, n_q, n_heads, gqa_ratio);
+    }
+
+    cudaError_t e = cudaGetLastError();
+    if (e != cudaSuccess) {
+        fprintf(stderr, "fraqtl: apply_U_T_to_O kernel CUDA error: %s\n",
+                cudaGetErrorString(e));
+        return 6;
+    }
+    return 0;
+}
+
+extern "C" int fraqtl_attn_v_fused_supported(int32_t layer_idx, int32_t HD, int32_t NKV) {
+    if (!g_fraqtl.active) return 0;
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 0;
+    if (g_fraqtl.n_layers > 0 && layer_idx >= g_fraqtl.n_layers) return 0;
+    // All required slab pointers must be registered. Note: layer_v_packed
+    // is allowed to be null only when K_PROT == HD (no sacrifice dims =>
+    // no packed bytes allocated per llama-kv-cache.cpp:325).
+    if (g_fraqtl.layer_v_protected[layer_idx] == nullptr) return 0;
+    if (g_fraqtl.layer_v_scale    [layer_idx] == nullptr) return 0;
+    if (g_fraqtl.layer_kv_size    [layer_idx] <= 0)       return 0;
+    // HD ∈ {64, 128, 256} are the existing fattn-vec template
+    // instantiations (see fattn-vec.cuh DECL_FATTN_VEC_CASE_FRAQTL). Any
+    // NKV is allowed as long as it matches the bundle the runtime was set
+    // up with — descriptor arena layout is (kvh*kv_size + slot)*sizeof(desc)
+    // regardless of NKV count.
+    if (HD  != g_fraqtl.hd)                              return 0;
+    if (HD  != 64 && HD != 128 && HD != 256)             return 0;
+    if (NKV != g_fraqtl.n_kv)                            return 0;
+    const int K = g_fraqtl.k_protect;
+    // gate relaxation: allow any K%8==0 in [0, HD]. The original
+    // hard-coded K ∈ {16, 64} was tuned to the standalone kernel's
+    // tested cells; the descriptor adapter (dequantize_V_fraqtl in
+    // fattn-common.cuh) only requires K%8==0 alignment so the warp-uniform
+    // prot/sac branch boundary lines up with the dequantizer's fixed
+    // ne∈{2,4,8} request size. sweep at 16K hit a U-curve because
+    // k=32/48 fell back to the path under the old gate; this fix
+    // enables them to ride the descriptor adapter.
+    if (K < 0 || K > HD || (K % 8) != 0) return 0;
+    if (K < HD && g_fraqtl.layer_v_packed[layer_idx] == nullptr) return 0;
+    return 1;
+}
