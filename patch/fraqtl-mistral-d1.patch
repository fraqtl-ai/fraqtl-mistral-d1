+// =============================================================================
+// Runtime singleton (lite).
+// Set once at llama_context init via fraqtl_runtime_setup; cleared at
+// llama_free via teardown. The fattn dispatcher checks is_active and calls
+// roundtrip_v() on the V tensor in place before computing attention.
+// Lossy in-place roundtrip — exercises pack/unpack on the actual V. With
+// identity-U + k_protect = head_dim the roundtrip is a no-op (Variant A
+// plumbing gate); with k_protect < head_dim quantization noise is introduced
+// (Variant B kernel-exercise gate).
+// + replaces this with proper graph injection / real V cache compression.
+// =============================================================================
+
+// Returns 0 on success; non-zero on cudaMalloc failure (1=packed, 2=scale, 3=prot).
+//  dynamic-harness extension:
+//   - Added n_heads_q (Q-side total attention heads, e.g. 28 Qwen 7B / 32 Mistral 7B).
+//   - Added max_n_tokens (physical batch / ubatch, e.g. 2048).
+// Both values were previously hardcoded inside fraqtl_runtime_setup. They are
+// now passed from llama-context.cpp via model.hparams.n_head / cparams.n_ubatch
+// so the same runtime serves any GGUF model (Mistral, Llama, Qwen 14B, etc.)
+// without per-model code changes.
+int  fraqtl_runtime_setup(
+    void * d_eigenbasis,
+    int32_t n_layers, int32_t n_kv, int32_t head_dim, int32_t k_protect,
+    int32_t scratch_n_ctx,
+    int32_t n_heads_q, int32_t max_n_tokens
+);
+
+void fraqtl_runtime_teardown(void);
+int  fraqtl_runtime_is_active(void);
+
+// sink + recent-residual fp16 wrapper configuration.
+// Configures the literature-validated insurance pattern (KIVI, KVQuant,
+// StreamingLLM): the FIRST `sink_n` cache positions and the LAST `residual_n`
+// cache positions stay fp16; positions in between go through the existing
+// compressed path (eigenbasis prot + INT4 tail).
+// Defaults: 0 / 0 (DISABLED). When both are 0, no new code paths activate
+// and behavior is byte-identical to .
+// Must be called once after fraqtl_runtime_setup() and BEFORE the cache
+// constructor calls fraqtl_runtime_register_layer_*_slabs (will
+// trigger sink/residual buffer allocation in those register functions).
+// See internal spec.
+void fraqtl_runtime_set_step59_config(int32_t sink_n, int32_t residual_n);
+
+// Read back current config (for receipt logging from harness).
+void fraqtl_runtime_get_step59_config(int32_t * sink_n_out, int32_t * residual_n_out);
+
+// STEP58_DESC_BYTES non-regression log. Prints once at end of
+// fraqtl_runtime_setup() the per-layer + total descriptor byte count so
+// the harness can assert 's footprint (Qwen 7B = 7168 bytes after
+// the alignment fix) is preserved.
+void fraqtl_runtime_log_step58_desc_bytes(void);
+
+// STEP59_WRITE_STATS one-shot log. Emits cumulative sink and
+// residual write counters per modality plus the existing set_rows_hook_calls
+// total so the harness can confirm:
+//   - sink/residual fp16 writes happened (sink_writes_K / sink_writes_V > 0
+//     and residual_writes_K / residual_writes_V == cumulative tokens hooked)
+//   - compressed slab writes still happened (set_rows_hook_calls_total > 0)
+//   - "no overwrite-before-compress" invariant holds (overwrite counts equal
+//     max(0, residual_writes - residual_n) per layer, summed)
+// Auto-fires from fraqtl_runtime_teardown so the receipt always captures it
+// at end of context lifetime; idempotent (one-shot guard in g_fraqtl).
+void fraqtl_runtime_log_step59_write_stats(void);
+
+// fattn-mma K read-side branch context.
+// Small POD (40 bytes) passed by value from the fattn.cu dispatcher through
+// the kernel template chain (case → launch_fattn → kernel → process_tile →
+// iter) to the K read loop. Built once per (layer, attention call) on the
+// host. Per-kvh offset is computed inside the kernel from z_KV.
+// All fields zero / null when is disabled; kernel branch checks
+// sink_n/residual_n > 0 AND ptr != nullptr before reading, so disabled
+// state is a no-op (compiles into the existing fraqtl_k path).
+// Why pass-by-value rather than __constant__: the build does NOT use
+// separable compilation (no -rdc=true), so cross-TU __constant__/__device__
+// symbols would each get a per-TU copy and a single cudaMemcpyToSymbol
+// would only update the calling TU's instance. Kernel-arg pass-by-value is
+// the portable, correct path.
+struct fraqtl_step59_k_args_t {
+    const half * sink_K_layer;       // per-layer base pointer (nullptr if disabled)
+    const half * residual_K_layer;   // per-layer base pointer (nullptr if disabled)
+    const half * sink_V_layer;       // V sink base (nullptr if disabled)
+    const half * residual_V_layer;   // V residual base (nullptr if disabled)
+    int sink_n;                      // 0 if sink disabled
+    int residual_n;                  // 0 if residual disabled
+    int hd;                          // head dim (= 128 for v0 Qwen 7B)
+    int n_kv;                        // n_kv_heads from model (= 4 for Qwen 7B)
+    int n_heads;                     // n_attention_heads (= 28 for Qwen 7B); used for GQA divisibility check
+    int current_kv;                  // K cache extent at attention call time
+};
+
+// Host-side accessor — builds the struct from g_fraqtl for `layer_idx` and
+// `current_kv`. Returns all-zero struct when is disabled, fraqtl
+// is disabled, or layer_idx is out of range. Caller passes the struct
+// directly as a kernel argument (kernel-arg path; no
+// __constant__ memory game).
+// `n_heads` is the model's attention head count; the dispatcher passes it
+// in so the kernel can hard-fail on GQA divisibility violations
+// (n_heads % n_kv != 0).
+fraqtl_step59_k_args_t fraqtl_runtime_get_step59_k_args_for_layer(
+    int layer_idx, int current_kv, int n_heads);
+
+// query whether is currently active (sink_n > 0 OR
+// residual_n > 0). Used by the dispatcher's vec-path hard-fail check.
+int  fraqtl_runtime_step59_is_active(void);
+
+// (deferred-pack):
+// is_active() now returns (initialized && mode == ONLINE). The
+// initialized-only check is exposed separately so callers that need to
+// know "did setup ever succeed" without caring about the mode flag can
+// ask. mode flips DEFERRED → ONLINE via fraqtl_runtime_set_mode_online,
+// typically called from llama_fraqtl_compress_cache(ctx) after a
+// bulk-pack of all layers completes.
+int  fraqtl_runtime_is_initialized(void);
+int  fraqtl_runtime_get_mode(void);                // 0 = DEFERRED, 1 = ONLINE
+void fraqtl_runtime_set_mode_online(void);
+void fraqtl_runtime_set_mode_deferred(void);
+
+// register a layer's fp16 V cache pointer + layout so
+// fraqtl_runtime_compress_layer can read source data at end-of-prefill.
+// Called by the cache constructor after backend buffer allocation,
+// alongside fraqtl_runtime_register_layer_slabs.
+void fraqtl_runtime_register_layer_v_cache(
+    int32_t      layer_idx,
+    const void * v_cache_data,
+    int64_t      v_cache_ne0,    // = NKV*HD
+    size_t       v_cache_nb1);   // row stride bytes
+
+// bulk-pack rows [0, n_rows) of layer's fp16 V cache into the
+// descriptor slabs. Idempotent — re-call with a larger n_rows to pack
+// only the delta. Caller flips mode to ONLINE after all layers done.
+// Returns 0 on success; 10/11/12/13/14/15/30 — see fraqtl-kv.cu for
+// the exact code → cause table.
+int  fraqtl_runtime_compress_layer(int32_t layer_idx, int32_t n_rows, void * stream);
+int  fraqtl_runtime_compress_sync(void * stream);   // 0 ok, 1 cuda error
+
+// ROW_AUDIT for compress_cache. Reads alive cache_v_l<layer>
+// at slot 0 / kvh 0 + slabs at the same address, computes V_recon, and
+// prints rel_l2 vs the live cache row. One-shot per process per
+// layer_idx. Must be invoked BEFORE the v_fp16 backend buffer is freed.
+// re-land (): return type changed void→int so callers
+// can use audit pass/fail as a release-ready guard.
+//   1 = audit passed (V_recon ≈ V within tolerance)
+//   0 = audit skipped (slabs/v_cache not registered) or failed
+int  fraqtl_runtime_audit_compressed_layer(int32_t layer_idx);
+
+// re-land (): engine-side release-ready guard.
+// Returns 1 iff every layer in [0, n_layers):
+//   (a) has packed at least one real row via the bypass hook
+//       (set_rows_hook_calls[L] > 0)
+//   (b) passes ROW_AUDIT (V_recon ≈ V at slot 0 / kvh 0)
+// Returns 0 otherwise. Idempotent + cheap to call (audit itself is one-shot
+// per process per layer; subsequent calls hit the audit_done memoization).
+// Used by llama_context::decode() to gate the live VRAM release.
+int  fraqtl_runtime_release_ready(int32_t n_layers);
+// pack V tensor into externally-owned slabs (not the runtime's
+// internal scratch). Used by llama_kv_cache::fraqtl_pack_v_cache_after_decode
+// to populate per-layer slabs after each forward pass.
+// Returns 0 on success, non-zero on shape mismatch / CUDA error.
+int fraqtl_runtime_pack_v_to_slabs(
+    void *      v_data,             // input fp16 V tensor (CUDA, possibly strided)
+    void *      v_protected,        // output fp16 [k * NKV, S, B]
+    void *      v_packed,           // output uint8 [packed * NKV, S, B]
+    void *      v_scale,             // output fp32 [NKV, S, B]
+    int32_t     B, int32_t NKV, int32_t S, int32_t HD,
+    const int64_t * v_ne,            // V tensor shape
+    const size_t  * v_nb,            // V tensor byte strides
+    int32_t     layer_idx,
+    void *      stream
+);
+
+// unpack from per-layer slabs into a contiguous fp16 scratch
+// tensor (used by fattn read path). Slabs are contiguous (we own them);
+// scratch is contiguous (we allocate it). No stride parameters needed.
+int fraqtl_runtime_unpack_slabs_to_scratch(
+    const void * v_protected,
+    const void * v_packed,
+    const void * v_scale,
+    void *       scratch_v,           // output fp16 [B, NKV, S, HD] contiguous
+    int32_t      B, int32_t NKV, int32_t S, int32_t HD,
+    int32_t      layer_idx,
+    void *       stream
+);
+
+// In-place lossy roundtrip on V tensor. Verifies layout via ne[] + nb[]
+// (contiguous, ne[0]=HD matching sidecar, ne[2]=NKV matching sidecar).
+// On layout mismatch returns non-zero and is a no-op (V untouched). All
+// kernel launches happen on the supplied stream; CUDA_CHECK after each.
+// Return codes:
+//   0 success
+//   10 NKV mismatch with sidecar
+//   11 head_dim mismatch with sidecar
+//   12 row capacity exceeded (B*NKV*S > scratch_rows)
+//   13 layer_idx out of range
+//   20 non-contiguous V tensor (byte strides don't match packed layout)
+//   30 CUDA error during pack
+//   31 CUDA error during unpack
+int  fraqtl_runtime_roundtrip_v(
+    void *      v_data,
+    const int64_t * ne,    // [4]: HD, S, NKV, B (ggml convention)
+    const size_t  * nb,    // [4]: byte strides
+    int32_t     layer_idx,
+    void *      stream     // cudaStream_t passed as void* to keep header CUDA-free
+);
+
+// Sentinel-layout probe — fills a [B, NKV, S, HD] tensor with coordinate-
+// encoded values, runs pack/unpack with identity-U + k_protect=HD (no-op
+// roundtrip), and verifies bit-exact preservation. Catches axis swaps that
+// the real-model roundtrip might hide. Returns 0 on PASS; non-zero on FAIL
+// (and writes failure info via stderr).
+int  fraqtl_runtime_sentinel_test(int B, int NKV, int S, int HD);
+
+// write-time pack hook. Called from ggml_cuda_cpy when the cpy
+// destination is a `cache_v_l<N>` tensor. Packs only the rows that were
+// just written (`n_rows` rows starting at `dst_row_start` slot index into
+// the cache_v_l<L> tensor) into the per-layer slabs registered via
+// fraqtl_runtime_register_layer_slabs. v_cache_ne / v_cache_nb describe
+// the cache tensor's full layout ([n_embd_v_gqa, kv_size, n_stream, 1]
+// with row stride v_cache_nb[1] = n_embd_v_gqa * sizeof(half)).
+// Replaces the per-fattn-call O(S) repack with an O(rows-just-written)
+// pack, typically O(1) per decode step. fattn-side decode_v_incremental
+// no longer packs; it only unpacks slab → V's active slice.
+// Return codes mirror the existing runtime entry points:
+//   0 success (or no-op when fraqtl_runtime_is_active() is false)
+//   10 NKV mismatch with sidecar
+//   11 head_dim mismatch with sidecar
+//   13 layer_idx out of range
+//   14 layer slabs not registered
+//   17 dst_row_start + n_rows > kv_size (refused, slab OOB)
+//   18 cache row stride mismatch (v_cache_nb[1] != n_kv * head_dim * sizeof(half))
+int  fraqtl_runtime_pack_v_cpy_hook(
+    const void *    v_cache_data,
+    const int64_t * v_cache_ne,
+    const size_t  * v_cache_nb,
+    int32_t         dst_row_start,
+    int32_t         n_rows,
+    int32_t         layer_idx,
+    void *          stream
+);
+
+// mark a layer as needing a Phase-1 fallback pack on the next
+// fattn-side decode_v_incremental call. Called from cpy.cu when the
+// pre-call shape/stride/alignment gate fails for a recognized
+// cache_v_l<L> destination, OR from inside fraqtl_runtime_pack_v_cpy_hook
+// or fraqtl_runtime_pack_v_set_rows_hook on any internal validation
+// error. The fattn-side decode then regenerates the slab from live V
+// before unpacking, preserving correctness at the cost of one
+// Phase-3c-lite-shaped pack for that layer/call.
+// reason: 1 = shape/stride/alignment gate failed; 0 = internal validation
+// failed (slabs not registered, NKV/HD mismatch, OOB row range, etc.).
+// Used only for the per-layer hook_skips_shape vs hook_errors counters.
+void fraqtl_runtime_mark_layer_fallback(int32_t layer_idx, int32_t reason);
+
+// (A1): write-time pack hook for ggml_cuda_op_set_rows. This is
+// the primary V-cache write path in modern llama.cpp; the cpy hook above
+// is a harmless safety net that fires only if/when llama.cpp routes a
+// cache_v_l<L> write through ggml_cuda_cpy (rare).
+// v_cache_data / v_cache_ne / v_cache_nb describe the destination cache
+// tensor (cache_v_l<L> or its view_src). v_idxs_data points to the
+// device-side row-indices tensor of length n_tokens; the kernel reads
+// it on-device so no host sync is needed (graph-capture safe).
+// v_idxs_dtype: 0 = int64 (default per llama-kv-cache.cpp:1502),
+//               1 = int32 (some quantized paths).
+// Same return-code conventions as fraqtl_runtime_pack_v_cpy_hook.
+int  fraqtl_runtime_pack_v_set_rows_hook(
+    const void *    v_cache_data,
+    const int64_t * v_cache_ne,
+    const size_t  * v_cache_nb,
+    const void *    v_idxs_data,
+    int32_t         v_idxs_dtype,
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+);
+
+// ONLINE-mode set_rows pack from src0 directly.
+// Caller invokes this INSTEAD of the standard set_rows kernel + the
+// from-cache hook when the runtime is in MODE_ONLINE and the dst is
+// a fraqtl-managed cache_v_l<L>. Returns 0 (no-op) when not in ONLINE
+// mode, so the caller can safely fall through to the standard path.
+int  fraqtl_runtime_pack_v_set_rows_from_src_hook(
+    const void *    src0_data,
+    const int64_t * src0_ne,
+    const size_t  * src0_nb,
+    const void *    v_idxs_data,
+    int32_t         v_idxs_dtype,
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+);
+
+// K-side from-src bypass hook. Mirrors V's
+// fraqtl_runtime_pack_v_set_rows_from_src_hook signature; called from
+// set-rows.cu when dst is a fraqtl-managed cache_k_l<L>.
+// Per-row work: project K[h, :] through U_K[layer, h] into C_K[HD], split
+// into top-rank_h fp16 protected slab + (HD - rank_h) INT4 tail (canonical
+// Gate 0b packing) + per-row absmax/7 scale. Per-(layer, kvh) variable
+// rank from descriptor arena; R == HD heads write protected only and a
+// scale placeholder of 1.0.
+// Return codes:
+//   0 handled — set-rows.cu should skip the standard kernel write
+//   13 shape / layer index out of range
+//   14 K slabs (descriptors) not registered for this layer
+//   15 d_U_K not yet set — descriptors carry null U_K_head
+//   17 n_tokens > kv_size
+//   99 kernel launch CUDA error
+int  fraqtl_runtime_pack_k_set_rows_from_src_hook(
+    const void *    src0_data,
+    const int64_t * src0_ne,
+    const size_t  * src0_nb,
+    const void *    k_idxs_data,
+    int32_t         k_idxs_dtype,
+    int32_t         n_tokens,
+    int32_t         layer_idx,
+    void *          stream
+);
+
+// K-pack self-test. Synthetic case (HD=8, NKV=2, kv_size=4,
+// n_tokens=2, ranks=[3, 8]) covering BOTH the compressible head (R<HD,
+// protected + INT4 tail) and the uncompressible head (R==HD, protected
+// only, scale placeholder 1.0). Identity U_K so C_K = K_src; expected
+// values are computed on host then compared against device output after
+// dequant. Tolerance: scale * 0.55 + 1e-5 absolute (INT4 quant noise).
+// Output line:
+//   fraqtl: K_PACK_SELFTEST_PASS HD=8 NKV=2 ranks=[3,8] ...
+// or _FAIL / _CUDA_ERROR variants.
+// Returns 0 on PASS, 1 on FAIL, 2 on CUDA error. Allocates its own
+// buffers; does NOT touch g_fraqtl state.
+int  fraqtl_runtime_k_pack_selftest(void);
+
+// Score-parity micro-harness (internal K math debug, ).
+// Drives the full +5.3+5.4 pipeline on a tiny synthetic case
+// (HD=8, NKV=2, n_q=2, n_tokens=4, ranks=[3, 8]) covering BOTH the
+// compressible head (R<HD with INT4 tail) AND the R==HD branch
+// naturally. Compares fraqtl score = Q' · C_K.T against reference
+// score_ref = Q · K.T element-by-element. Dumps the full score matrix
+// to stderr regardless of pass/fail. Returns 0 on PASS, 1 on FAIL,
+// 2 on CUDA error.
+// Output:
+//   fraqtl: K_SCORE_PARITY_DUMP HD=N NKV=N ... ranks=[a,b] gqa_ratio=N
+//     q=Q h=H kvh=K R=R k=K ref=X.XXXXXX got=X.XXXXXX diff=X.XXXe-NN
+//     ... (one line per (q, h, k))
+//   fraqtl: K_SCORE_PARITY_PASS HD=N NKV=N ranks=[a,b] max_abs_diff=X.XXXe-NN
+// or
+//   fraqtl: K_SCORE_PARITY_FAIL n_mismatch=N max_abs_diff=X.XXXe-NN
+//     first_fail q=Q h=H k=K ref=X.XXX got=X.XXX diff=X.XXXe-NN
+int  fraqtl_runtime_k_score_parity_selftest(void);
+
+// dispatcher support API. Called from fattn.cu before the
+// standard kernel selection to decide whether to take the fused path.
+// Returns 1 only when fraqtl is active, slabs are registered for this
+// layer, and the (HD, NKV) tuple matches a fused kernel template
+// instantiation. K_PROT is read from g_fraqtl.k_protect internally.
+int     fraqtl_attn_v_fused_supported(int32_t layer_idx, int32_t HD, int32_t NKV);
+
+// Per-launch counter increment. fattn.cu's local `fused_handled` boolean
+// already gates the decode_v_incremental skip and the standard-fattn
+// short-circuit within ONE fattn entry, so no cross-function flag is
+// needed (and a cross-function flag would be stale on the next fattn
+// call that falls back to the path).
+void    fraqtl_runtime_mark_fused_call      (int32_t layer_idx);
+int32_t fraqtl_runtime_get_fused_attn_calls (int32_t layer_idx);
+
+// =============================================================================
+// per-V-row descriptor for the fattn-vec embed path.
+// fattn-vec's hot loop reads V via `vx = V + k*nb21` and then calls
+// dequantize_V(vx, dst, i0). The signature is fixed: vx + i0 → ne values.
+// To make fraqtl's three-pointer slab layout fit that signature without
+// adding any branch in the hot loop, we publish a per-row descriptor
+// array. dispatch sets V to the descriptor base + nb21 = sizeof(desc)
+// so vx lands on the right descriptor for row k. dequantize_V_fraqtl
+// reads {prot_row, pack_row, scale_row, k_prot} from the descriptor and
+// produces the dequantized values for column index i0.
+// Arena lifetime: allocated once in fraqtl_runtime_register_layer_slabs
+// (slab pointers are stable for the cache's lifetime; descriptors are
+// pure metadata and never need updating). Freed in
+// fraqtl_runtime_clear_layer_slabs / teardown.
+// =============================================================================
+struct fraqtl_v_row_desc {
+    const half *    prot_row;     // → prot_slab + (h*kv_size + k)*k_prot halfs
+    const uint8_t * pack_row;     // → pack_slab + (h*kv_size + k)*pack_stride bytes
+    const float *   scale_row;    // → scale_slab + (h*kv_size + k) floats
+    const half *    U_head;       // → eigenbasis row block U[layer, h] = HD×HD halves.
+                                  //   dequantize_V_fraqtl uses U_head to apply the
+                                  //   inverse rotation V[d] = sum_r C[r] * U[d, r]
+                                  //   without it, the descriptor adapter returns
+                                  //   rotated coordinates C instead of original V,
+                                  //   which fattn-vec then misinterprets as V (the
+                                  //   bisect root cause).
+    int             k_prot;       // copy of g_fraqtl.k_protect (warp-uniform)
+    int             hd;           // copy of g_fraqtl.hd
+    int             pack_stride;  // bytes per packed row (padded_groups*3)
+    int             _pad;         // → 48-byte total (4 ptrs × 8 + 4 ints × 4)
+};
+static_assert(sizeof(fraqtl_v_row_desc) == 48,
+              "fraqtl_v_row_desc layout drift");
+
+//  (memory roadmap) — COMPACT V descriptor.
+// One descriptor per (layer, kv_head) instead of one per (kv_head, slot).
+// Mirrors the K side (fraqtl_k_kvh_desc). The per-slot row pointers the old
+// fraqtl_v_row_desc pre-computed are derived arithmetically at read time:
+//     prot_row = prot_base + slot * k_prot
+//     pack_row = pack_base + slot * pack_stride
+//     scale_row = scale_base + slot
+// This eliminates the kv_size * n_kv descriptor table (~168 MiB at 32K on
+// Qwen-7B) that scaled linearly with context. Gated behind the runtime flag
+// FRAQTL_V_DESC_COMPACT until the consumer side (dequantize_V_fraqtl +
+// fattn-vec V addressing) is wired — producer side is inert without it.
+struct fraqtl_v_kvh_desc {
+    const half *    prot_base;    // → prot_slab + h*kv_size*k_prot (head base)
+    const uint8_t * pack_base;    // → pack_slab + h*kv_size*pack_stride (null if k_prot==HD)
+    const float *   scale_base;   // → scale_slab + h*kv_size
+    const half *    U_head;       // → U[layer, h] = HD×HD halves (per-head, slot-invariant)
+    int             k_prot;       // copy of g_fraqtl.k_protect
+    int             hd;           // copy of g_fraqtl.hd
+    int             pack_stride;  // bytes per packed row (padded_groups*3)
+    int             kv_size;      // slab storage capacity — bounds the slot index
+};  // 48 bytes (4 ptrs × 8 + 4 ints × 4) — 16-byte multiple, alignment-safe
+static_assert(sizeof(fraqtl_v_kvh_desc) == 48,
+              "fraqtl_v_kvh_desc layout drift");
+
+// Returns the device descriptor arena base for this layer. nullptr if not
+// registered. Layout: desc[h*kv_size + k] for h in [0, NKV), k in [0, kv_size).
+const fraqtl_v_row_desc * fraqtl_runtime_get_layer_v_descriptors(int32_t layer_idx);
+
+// Stride (bytes) between adjacent row descriptors. Used as nb21 by fattn-vec.
+int32_t                   fraqtl_runtime_get_v_desc_stride(void);
+
+// Per-layer kv_size accessor (used by dispatcher to compute nb22 = stride*kv_size).
+int32_t                   fraqtl_runtime_get_layer_kv_size(int32_t layer_idx);
+
+// Per-process accessors used by fattn.cu dispatcher.
+int32_t                   fraqtl_runtime_get_n_kv_heads(void);
+int32_t                   fraqtl_runtime_get_head_dim(void);
+int32_t                   fraqtl_runtime_get_k_protect(void);
+int32_t                   fraqtl_runtime_get_n_layers(void);
+
+//  — clean predicate for the K-shadow-free hard-assert in
+// llama-kv-cache.cpp. Returns 1 iff fraqtl_runtime_setup() has populated
+// the global state (n_kv > 0 AND n_layers > 0 AND head_dim > 0). The
+// internal review after the 5.10 K-only crash: never skip fp16 K
+// alloc unless this predicate returns 1 — otherwise the marker buffer
+// path produces invalid attention reads (CUDA illegal access via
+// GET_ROWS reading from the 128-byte marker).
+int32_t                   fraqtl_runtime_is_setup_complete(void);
+
+//  — singleton Q' workspace (internal memory P0).
+// Called from fattn.cu's K-route dispatcher in place of ggml_cuda_pool_alloc.
+// Returns a device pointer sized to at least `needed_bytes`. Grow-as-needed:
+// alloc on first call, reuse if existing buffer is large enough, reallocate
+// only on a larger request (typically exactly once at first max-ubatch
+// prefill chunk). After warmup, alloc_count stays at 1.
+float *                   fraqtl_runtime_get_qprime_workspace(size_t needed_bytes);
+
+// Receipt fields for the memory ledger. Read after warmup / before teardown.
+size_t                    fraqtl_runtime_get_qprime_workspace_bytes(void);
+size_t                    fraqtl_runtime_get_qprime_workspace_peak_bytes(void);
+int64_t                   fraqtl_runtime_get_qprime_alloc_count(void);
+int64_t                   fraqtl_runtime_get_qprime_get_calls(void);
+
+//  memory audit pool trim. Gated by env FRAQTL_MEMORY_AUDIT=1.
+// trim() does the cudaMemPoolTrimTo + before/after logging unconditionally.
+// maybe_trim_post_warmup() is the dispatcher hook: increments a per-pass
+// counter and fires trim ONCE after one full forward pass (n_layers K
+// dispatches). internal API: cudaMemPoolTrimTo (NOT cudaMemPoolTrim).
+void                      fraqtl_runtime_memory_audit_trim(const char * label);
+void                      fraqtl_runtime_memory_audit_maybe_trim_post_warmup(void);
+// post-process kernel that applies U.T to dst
+// after the MMA kernel writes the C-space attention output O_c.
+// O[q, head, hd] = sum_c O_c[q, head, c] * U_head[head/gqa_ratio, hd, c]
+// Returns 0 on success, non-zero error code on guard failure.
+// Locked v0 scope: HD=128 only (other HDs need their own kernel instance).
+int                       fraqtl_runtime_apply_U_T_to_O(
+                              float *      O_dst,
+                              int32_t      n_q,
+                              int32_t      n_heads,
+                              int32_t      n_seqs,
+                              int32_t      layer_idx,
+                              cudaStream_t stream);
+
+// Path A: register a callback fired once per process the first time
+// release_ready returns 1 from inside the set_rows hook (i.e. mid-prefill,
+// after all layers have packed at least one slab). The callback should call
+// llama_kv_cache::release_fraqtl_v_fp16_buffers() — the engine-side release
+// path. Pass cb=nullptr to disable.
+void                      fraqtl_runtime_register_release_callback(
+                              void (*cb)(void * user_data),
+                              void *  user_data);
+
+// =============================================================================
+// K-cache compression (parallel to V)
+// K-side mirrors the V infrastructure but with three key differences:
+//   1. Per-(layer, kv_head) variable rank R (not a fixed K_PROTECT). v0 uses
+//      per-head fixed R; per-cell adaptive R is deferred to v1.
+//   2. INT4 tail (signed -8..+7, 2 idx per byte, high-nibble-first per the
+//      canonical convention in docs/k-int4-packing-convention.md). V uses INT3.
+//   3. The INT4 tail can be EMPTY when R == HD (uncompressible head). Kernel
+//      inner loop skips dequant in that case via warp-uniform branch.
+// Math (parallels V's deferred-U.T identity, but applied BEFORE attention):
+//   score = Q @ K.T = Q @ (C_K @ U_K.T).T = (Q @ U_K) @ C_K.T = Q' @ C_K.T
+// where Q' is computed once per (q_token, kv_head) by fraqtl_apply_U_K_to_Q.
+// Per-K-cell inner loop (in the iter):
+//   score[k] = sum_{c<R} Q'[c] * prot_row_k[c] (fp16 dot)
+//            + sum_{c≥R} Q'[c] * (uint4_unpack(pack_row_k, c-R) - 8) * scale_k
+// =============================================================================
+// () — per-(layer, kvh) descriptor.
+// Replaces the per-(layer, slot, kvh) `fraqtl_k_row_desc` from
+// (which scaled descriptor arena bytes linearly with kv_size).
+// Memory savings vs
+//   16K context, Qwen 7B (28 layers, 4 kvh): 84 MiB → 5.4 KiB
+//   64K context: 336 MiB → 5.4 KiB
+// Per-slot row pointers are derived in the kernel:
+//   prot_row [slot] = prot_base + slot * rank
+//   pack_row [slot] = pack_base + slot * pack_stride (when rank < HD)
+//   scale_row[slot] = scale_base + slot
+// rank, pack_stride, hd, U_K_head are constant across all slots within
+// a (layer, kvh) — they're per-(layer, kvh) parameters, never per-slot.
+struct fraqtl_k_kvh_desc {
+    const half *    prot_base;       // → prot_slab_k base for this (layer, kvh).
+                                     //   slot row = prot_base + slot * slab_row_stride_halves
+                                     //   (slab is rectangular [n_kv, kv_size, max_rank];
+                                     //   per-Step-5.8-scope-lock no per-head packed layout yet).
+    const uint8_t * pack_base;       // → pack_slab_k base for this (layer, kvh).
+                                     //   slot row = pack_base + slot * slab_pack_stride_bytes
+                                     //   (null when rank == HD; entire row is prot).
+    const float *   scale_base;      // → scale_slab_k base for this (layer, kvh).
+                                     //   slot scale = scale_base[slot]
+                                     //   (placeholder 1.0 when rank == HD).
+    const half *    U_K_head;        // → U_K arena: (layer, h) HD×HD halves.
+    int             rank;            // per-(layer, kvh) protected rank R, 24 ≤ R ≤ HD.
+    int             hd;              // copy of g_fraqtl.hd (kept for the K-pack kernel
+                                     // which doesn't carry HD as a template constant).
+    int             pack_stride;     // bytes per packed row for THIS kvh's tail
+                                     //   = ceil((HD - rank) / 2). 0 when rank == HD.
+                                     //   (Used by the K-pack kernel to write the tail.)
+    int             slab_row_stride_halves;  // per-LAYER prot slab row stride (= max_rank).
+                                     //   Used by the kernel to derive slot row pointers
+                                     //   from prot_base. Differs from `rank` when other
+                                     //   kvh in the same layer have higher rank.
+    int             slab_pack_stride_bytes;  // per-LAYER pack slab row stride (= max_pack_stride).
+                                     //   Used by the kernel to derive slot row pointers
+                                     //   from pack_base. Differs from `pack_stride` when
+                                     //   other kvh in the same layer have lower rank.
+    int             tail_bits;       //  S2 port: bits per K tail dim.
+                                     //   4 = legacy INT4 (default, backward compat).
+                                     //   3 = exp16 INT3 path (target for S2_exp16_k16
+                                     //   recipe, 3.46-3.58x KV compression).
+                                     //   Per-kvh because per-head rank policy may
+                                     //   differ; pack/dequant code dispatches on this.
+                                     //   Packing: INT4 = 2 nibbles/byte; INT3 = 8 groups/3 bytes.
+    int             _pad;            // → 64-byte total: 4 ptrs × 8 (offsets 0..31)
+                                     //   + 7 ints × 4 (offsets 32..59) + 1 int × 4 (offsets 60..63).
+                                     // CRITICAL: must be 16-byte multiple so that the
+                                     // dispatcher's K->nb[2] = sizeof(desc) keeps every
+                                     // per-kvh K_h2 = base + kvh*nb[2] 16-byte aligned.
+                                     // cp_async issues uint4 (16-byte) loads that fault
+                                     // on misaligned addresses (root-cause
+                                     // discovered : 56-byte struct produced
+                                     // K_h2[kvh=1] at offset 56 → not 16-aligned →
+                                     // CUDA "misaligned address" surfacing at next op).
+};
+static_assert(sizeof(fraqtl_k_kvh_desc) == 64,
+              "fraqtl_k_kvh_desc layout drift; MUST be 16-byte multiple "
+              "for cp_async per-kvh alignment");
+static_assert(sizeof(fraqtl_k_kvh_desc) % 16 == 0,
+              "fraqtl_k_kvh_desc must be 16-byte aligned for cp_async");
+
+// Returns the device descriptor arena base for this layer. nullptr if not
+// registered. Layout (): desc[h] for h in [0, NKV) — n_kv elements
+// per layer (was kv_size * n_kv pre-Step-5.8).
+const fraqtl_k_kvh_desc * fraqtl_runtime_get_layer_k_descriptors(int32_t layer_idx);
+
+// Stride (bytes) between adjacent kvh descriptors. Equals sizeof(fraqtl_k_kvh_desc).
+int32_t                   fraqtl_runtime_get_k_desc_stride(void);
+
+// Per-(layer, kv_head) K rank from the calibration sidecar. Returns -1 if
+// the layer is not registered or kvh is out of range.
+int32_t                   fraqtl_runtime_get_k_rank(int32_t layer_idx, int32_t kvh);
+
+// K-side slab registration. Called from llama-kv-cache.cpp during
+// session setup, after K slabs are allocated by the engine and the U_K
+// arena has been loaded from the recalibration sidecar. The K_ranks array
+// is per-(layer, kv_head) — must be n_kv * sizeof(int32_t) bytes per layer.
+// prot_slab_k: device ptr; layout [n_kv, kv_size, max_rank] halves (slab is
+//               sized for max_rank across heads in this layer; per-head row
+//               only writes its rank halves)
+// pack_slab_k: device ptr; layout [n_kv, kv_size, max_pack_stride] bytes
+//               (or nullptr if all heads in layer have rank==HD)
+// scale_slab_k: device ptr; layout [n_kv, kv_size] floats
+// k_ranks_in_layer: host ptr to int32[n_kv]; per-head rank values
+// kv_size: slot count for this layer's K cache
+void                      fraqtl_runtime_register_layer_k_slabs(
+                              int32_t        layer_idx,
+                              void *         prot_slab_k,
+                              void *         pack_slab_k,
+                              void *         scale_slab_k,
+                              const int32_t* k_ranks_in_layer,
+                              int32_t        kv_size);
+
+// Set the U_K arena pointer (HD×HD halves per (layer, kvh)).
+// Layout in memory: U_K[layer][kvh][i][j] = U_K_arena[((layer*NKV + kvh)*HD + i)*HD + j].
+// Lifetime: caller owns; runtime stores the pointer until teardown.
+void                      fraqtl_runtime_set_uk_arena(const half * U_K_arena);
+
+// Returns the U_K head pointer for the (layer, kvh) pair. nullptr if not set.
+const half *              fraqtl_runtime_get_uk_head(int32_t layer_idx, int32_t kvh);
+
+// Q pre-projection kernel.
+// Q' = Q @ U_K_head (per (q_token, kv_head)).
+// Reads Q from the engine's f32 Q tensor; writes Q' to a transient fp32
+// workspace allocated by the caller.
+// Q layout: [HD, n_q, n_heads, n_seqs] f32 with the same permuted-stride
+// pattern as dst (see fattn-mma-f16.cuh). The caller must use the SAME
+// stride formula as the existing V-side post-process kernel:
+//   linear_offset = seq*n_q*n_heads*HD + q*n_heads*HD + head*HD + hd
+// gqa_ratio = n_heads / n_kv_heads.
+// Returns 0 on success, non-zero on guard failure (no U_K, bad shapes, etc.)
+int                       fraqtl_runtime_apply_U_K_to_Q(
+                              const float *  Q_src,
+                              float *        Q_proj_dst,
+                              int32_t        n_q,
+                              int32_t        n_heads,
+                              int32_t        n_seqs,
+                              int32_t        layer_idx,
+                              cudaStream_t   stream);
+
+// Per-coefficient C_K accessor.
+// Returns the C-space coefficient at eigenbasis index `c` for one K row,
+// reading from the descriptor's protected fp16 slab (when c < rank) or
+// dequantizing from the INT4 tail slab (when c >= rank) per the canonical
+// packing convention (docs/k-int4-packing-convention.md).
+// When desc.rank == HD, the entire row is in protected fp16 (uncompressible
+// head — Gate 0c finding); the INT4 tail branch is unreachable.
+// Caller is responsible for the warp-uniform `if (R < HD)` branch elsewhere
+// (e.g. when batching multiple coefficients per thread); this helper itself
+// always returns the correct value.
+// caller passes `slot` (the K cache row index). Per-slot row
+// pointers are derived from base + slot * stride; `slot` ∈ [0, kv_size).
+// Bit layout (matches docs/k-int4-packing-convention.md):
+//   pack_base[slot * pack_stride + g] = (uint4_at_R+2g << 4) | (uint4_at_R+2g+1 & 0x0F)
+//   uint4 = signed_q + 8 (range [0, 15] for q in [-8, 7])
+//   dequant: c_val = (uint4 - 8) * scale_base[slot]
+#ifdef __CUDACC__
+static __device__ __forceinline__ float fraqtl_k_get_coeff(
+        const fraqtl_k_kvh_desc & desc, int slot, int c)
+{
+    if (c < desc.rank) {
+        // slab_row_stride_halves is the per-LAYER max_rank used to lay out
+        // the prot slab rectangularly. We only USE the first `rank` entries
+        // of each row; the rest are unused padding.
+        return __half2float(desc.prot_base[(size_t) slot * desc.slab_row_stride_halves + c]);
+    }
+    // Tail dispatch: tail_bits == 3 → exp16 INT3 group-extract path (S2 target);
+    //                tail_bits == 4 → legacy INT4 nibble path (default for old sidecars).
+    // The caller (iter) must guard with `if (rank < HD)` before the
+    // tail loop; this function does not re-check pack_base for null.
+    const int rel = c - desc.rank;
+    const float scale = desc.scale_base[slot];
+
+    if (desc.tail_bits == 3) {
+        //  S2 exp16 INT3 path — mirror of V's INT3 layout
+        // (fattn-mma-f16.cuh:980-998). 8 indices per 3 bytes, MSB-first.
+        // q ∈ [-4, 3] stored as u = q + 4 ∈ [0, 7].
+        const int g = rel / 8;
+        const int e = rel & 7;
+        // slab_pack_stride_bytes is per-LAYER (== max packed bytes across kvh).
+        const uint8_t * pack = desc.pack_base
+                             + (size_t) slot * desc.slab_pack_stride_bytes
+                             + g * 3;
+        const uint32_t b0 = pack[0];
+        const uint32_t b1 = pack[1];
+        const uint32_t b2 = pack[2];
+        int idx;
+        switch (e) {
+            case 0: idx = (int)((b0 >> 5) & 7) - 4; break;
+            case 1: idx = (int)((b0 >> 2) & 7) - 4; break;
+            case 2: idx = (int)((((b0 & 0x3) << 1) | ((b1 >> 7) & 1)) & 7) - 4; break;
+            case 3: idx = (int)((b1 >> 4) & 7) - 4; break;
+            case 4: idx = (int)((b1 >> 1) & 7) - 4; break;
+            case 5: idx = (int)((((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3)) & 7) - 4; break;
+            case 6: idx = (int)((b2 >> 3) & 7) - 4; break;
+            default: idx = (int)( b2       & 7) - 4; break;
+        }
+        return (float) idx * scale;
+    }
+
+    // tail_bits == 4 (or any non-3 value): legacy INT4 nibble path.
+    const int g   = rel >> 1;        // / 2
+    const int e   = rel & 1;         // % 2
+    const uint8_t b = desc.pack_base[(size_t) slot * desc.slab_pack_stride_bytes + g];
+    // HIGH NIBBLE = first coefficient (lower index, e == 0)
+    // LOW NIBBLE = second coefficient (higher index, e == 1)
+    const uint8_t u = (e == 0) ? ((b >> 4) & 0x0F) : (b & 0x0F);
+    const int     q = (int) u - 8;       // unsigned [0, 15] → signed [-8, 7]
+    return (float) q * scale;
+}
+
+// Convenience: pack two consecutive C_K coefficients (indices hd0 and hd0+1)
+// into a half2. Mirrors V's per-(k_row, col2) pattern in fattn-mma-f16.cuh.
+static __device__ __forceinline__ half2 fraqtl_k_get_coeff_pair_h2(
+        const fraqtl_k_kvh_desc & desc, int slot, int hd0)
+{
+    const float c_val0 = fraqtl_k_get_coeff(desc, slot, hd0);
+    const float c_val1 = fraqtl_k_get_coeff(desc, slot, hd0 + 1);
+    return __floats2half2_rn(c_val0, c_val1);
+}
+#endif  // __CUDACC__
+
+// Self-test launcher.
+// Round-trips a known-input fp16 row through quantize-then-dequant
+// (host-side calibration math) and compares against the device-side
+// dequant via fraqtl_k_get_coeff. Returns 0 on bit-equivalence (within
+// fp16 round-off), non-zero on mismatch.
+// Useful as a one-shot smoke test before wiring the kernel into fattn.
+// Called once at startup if env var FRAQTL_K_DEQUANT_SELFTEST=1.
+int                       fraqtl_runtime_k_dequant_selftest(void);
+
+// Q pre-projection self-test.
+// Builds a small synthetic (Q, U_K) pair on host (HD=8, n_q=4, single head,
+// pseudo-orthonormal U_K), runs fraqtl_runtime_apply_U_K_to_Q on a temporary
+// U_K arena, and compares the device output against a host CPU matmul
+// reference (Q @ U_K). Tolerance: 1e-3 absolute (fp16 → fp32 round-off
+// + matmul accumulation).
+// Output line:
+//   fraqtl: Q_PROJ_SELFTEST_PASS HD=N max_abs_diff=X
+// or _FAIL / _CUDA_ERROR variants.
+// Returns 0 on PASS, 1 on FAIL, 2 on CUDA error. Does NOT touch any
+// runtime state (uses its own d_U_K arena allocation, frees on exit).
+int                       fraqtl_runtime_k_qproj_selftest(void);
+
+// =============================================================================
+// + stub — fused unpack-then-attention V product.
+// =============================================================================
+
+void fraqtl_attn_v_fused(
+    const half*    attn_weights,
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const float*   v_scale,
+    const half*    eigenbasis,
+    half*          output,
+    int B, int NKV, int q_len, int k_len, int HD, int K,
+    cudaStream_t stream
+);
+
+}  // extern "C"
