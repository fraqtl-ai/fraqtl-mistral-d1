+// fraQtl V row dequantizer for the descriptor fast path.
+// IMPORTANT: this returns rotated coordinates C, not original-coordinate V.
+// The attention sum is linear:
+//   sum_i alpha_i V_i = sum_i alpha_i (C_i @ U.T)
+//                    = (sum_i alpha_i C_i) @ U.T
+// so fattn-vec accumulates in C-space and applies the inverse rotation once
+// at the final output write. Doing C @ U.T here is correct but too slow: it
+// repeats a dense HD-dot for every V load in the hot loop.
+template <typename T, int ne, int D>
+static __device__ __forceinline__ void dequantize_V_fraqtl(const void * __restrict__ vx, void * __restrict__ dst, const int64_t i0) {
+    const fraqtl_v_row_desc * d = (const fraqtl_v_row_desc *) vx;
+    const int K = d->k_prot;
+
+    if (i0 + ne <= K) {
+#ifdef FP16_AVAILABLE
+        if constexpr (std::is_same_v<T, half>) {
+            ggml_cuda_memcpy_1<ne*sizeof(half)>(dst, d->prot_row + i0);
+        } else
+#endif // FP16_AVAILABLE
+        if constexpr (std::is_same_v<T, float>) {
+            float * dst_f = (float *) dst;
+#pragma unroll
+            for (int l = 0; l < ne; ++l) {
+                dst_f[l] = __half2float(d->prot_row[i0 + l]);
+            }
+        } else {
+            static_assert(std::is_same_v<T, void>, "unsupported T for dequantize_V_fraqtl");
+        }
+        return;
+    }
+
+    if (i0 >= K) {
+        const float scale = d->scale_row[0];
+        const int g0 = ((int) i0 - K) / 8;
+        const int g1 = ((int) i0 + ne - 1 - K) / 8;
+
+#ifdef FP16_AVAILABLE
+        half * dst_h = nullptr;
+        if constexpr (std::is_same_v<T, half>) {
+            dst_h = (half *) dst;
+        }
+#endif // FP16_AVAILABLE
+        float * dst_f = nullptr;
+        if constexpr (std::is_same_v<T, float>) {
+            dst_f = (float *) dst;
+        }
+
+        for (int g = g0; g <= g1; ++g) {
+            const uint8_t * pack = d->pack_row + g*3;
+            const uint32_t b0 = pack[0];
+            const uint32_t b1 = pack[1];
+            const uint32_t b2 = pack[2];
+            int idx[8];
+            idx[0] = ((b0 >> 5) & 7) - 4;
+            idx[1] = ((b0 >> 2) & 7) - 4;
+            idx[2] = (((b0 & 0x3) << 1) | ((b1 >> 7) & 1)) - 4;
+            idx[3] = ((b1 >> 4) & 7) - 4;
+            idx[4] = ((b1 >> 1) & 7) - 4;
+            idx[5] = (((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3)) - 4;
+            idx[6] = ((b2 >> 3) & 7) - 4;
+            idx[7] = ( b2       & 7) - 4;
+#pragma unroll
+            for (int e = 0; e < 8; ++e) {
+                const int hd_dim_idx = K + g*8 + e;
+                if (hd_dim_idx >= i0 && hd_dim_idx < i0 + ne && hd_dim_idx < D) {
+                    const int l = hd_dim_idx - (int) i0;
+                    const float val = (float) idx[e] * scale;
+#ifdef FP16_AVAILABLE
+                    if constexpr (std::is_same_v<T, half>) {
+                        dst_h[l] = __float2half(val);
+                    } else
+#endif // FP16_AVAILABLE
+                    if constexpr (std::is_same_v<T, float>) {
+                        dst_f[l] = val;
+                    } else {
+                        static_assert(std::is_same_v<T, void>, "unsupported T for dequantize_V_fraqtl");
+                    }
+                }
+            }
+        }
+        return;
+    }
+
+    // Mixed prot/SAC requests are not expected for the K%8 descriptor fast
+    // path, but handle them defensively.
+#ifdef FP16_AVAILABLE
+    if constexpr (std::is_same_v<T, half>) {
+        half * dst_h = (half *) dst;
+        for (int l = 0; l < ne; ++l) {
+            float tmp;
+            dequantize_V_fraqtl<float, 1, D>(vx, &tmp, i0 + l);
+            dst_h[l] = __float2half(tmp);
+        }
+    } else
+#endif // FP16_AVAILABLE
+    if constexpr (std::is_same_v<T, float>) {
+        float * dst_f = (float *) dst;
+        for (int l = 0; l < ne; ++l) {
+            dequantize_V_fraqtl<float, 1, D>(vx, dst_f + l, i0 + l);
+        }
+    } else {
+        static_assert(std::is_same_v<T, void>, "unsupported T for dequantize_V_fraqtl");
+    }
+}
+
+//  materialize a legacy per-slot fraqtl_v_row_desc from a
+// compact per-kvh fraqtl_v_kvh_desc + absolute slot index. Lets the MMA
+// kernel's existing per-slot descriptor consumer (which reads d.prot_row /
+// d.pack_row / d.scale_row / d.U_head) run unchanged on the compact layout.
+static __device__ __forceinline__ fraqtl_v_row_desc
+fraqtl_v_row_desc_from_kvh(const fraqtl_v_kvh_desc * __restrict__ desc, int slot) {
+    fraqtl_v_row_desc d;
+    d.prot_row    = desc->prot_base + (size_t) slot * (size_t) desc->k_prot;
+    d.pack_row    = desc->pack_base
+        ? desc->pack_base + (size_t) slot * (size_t) desc->pack_stride
+        : nullptr;
+    d.scale_row   = desc->scale_base + (size_t) slot;
+    d.U_head      = desc->U_head;
+    d.k_prot      = desc->k_prot;
+    d.hd          = desc->hd;
+    d.pack_stride = desc->pack_stride;
+    d._pad        = 0;
+    return d;
+}
+
+//  COMPACT V row dequantizer. Same dequant math as
+// dequantize_V_fraqtl, but takes ONE per-(layer, kv_head) descriptor plus an
+// absolute slot index. The per-slot row pointers the legacy
+// fraqtl_v_row_desc pre-computed are derived here:
+//     prot_row = prot_base + slot * k_prot
+//     pack_row = pack_base + slot * pack_stride
+//     scale_row = scale_base + slot
+// The derived row pointers are stuffed into a stack-local fraqtl_v_row_desc
+// and the existing dequantize_V_fraqtl logic is reused verbatim — so the
+// produced V dimensions are bit-identical to the legacy path.
+template <typename T, int ne, int D>
+static __device__ __forceinline__ void dequantize_V_fraqtl_compact(
+        const fraqtl_v_kvh_desc * __restrict__ desc, int slot,
+        void * __restrict__ dst, const int64_t i0) {
+    const fraqtl_v_row_desc d = fraqtl_v_row_desc_from_kvh(desc, slot);
+    dequantize_V_fraqtl<T, ne, D>((const void *) &d, dst, i0);
+}
