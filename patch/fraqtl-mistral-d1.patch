+    out.n_kv_heads          = hdr.n_kv_heads;
+    out.head_dim            = hdr.head_dim;
+    out.ranks_per_layer_kvh = std::move(ranks);
+    out.uk_arena_bytes      = uk_bytes;
+    out.loaded              = true;
