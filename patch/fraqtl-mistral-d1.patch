+// fused attention for fraQtl V cache — first patch.
+// One kernel template, one block per (token, query-head, batch).
+// HD = 64, K_PROT in {16, 64}, NKV = 2. Block dim: 64 threads.
+// Numerical path (A1 — preserves recipe):
+//   acc[i] = (sum_s P[q, s] * C_rot[s, i]) / l for i in [0, HD)
+//   O[q, d] = sum_i acc[i] * U[kvh, i, d] for d in [0, HD)
+// where C_rot[s, i] is reconstructed on the fly:
+//   i < K_PROT : prot_slab[(kvh*kv_size + s)*K_PROT + i] (fp16)
+//   i >= K_PROT: ((unsigned_idx[s, i-K_PROT] - 4) * scale[s])
+//                with unsigned_idx packed 8-into-3 bytes per row.
+// First patch is intentionally non-tile-optimized: correctness first.
+// fattn-tile-f16 / mma-f16 borrow comes in +.
+
+#include "common.cuh"
+#include "fraqtl-kv.cuh"
+#include "fattn-fraqtl.cuh"
+
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstring>
+#include <cmath>
+
+// Forward decls of accessors implemented in fraqtl-kv.cu. Same C-ABI as
+// the existing runtime entries (extern "C" at file scope per
+// internal loga).
+extern "C" int          fraqtl_runtime_is_active(void);
+extern "C" const half *    fraqtl_runtime_get_layer_prot_slab (int32_t layer_idx);
+extern "C" const uint8_t * fraqtl_runtime_get_layer_pack_slab (int32_t layer_idx);
+extern "C" const float *   fraqtl_runtime_get_layer_scale_slab(int32_t layer_idx);
+extern "C" int32_t         fraqtl_runtime_get_layer_kv_size   (int32_t layer_idx);
+extern "C" const half *    fraqtl_runtime_get_layer_U         (int32_t layer_idx);
+extern "C" int32_t         fraqtl_runtime_get_n_kv_heads      (void);
+extern "C" int32_t         fraqtl_runtime_get_head_dim        (void);
+extern "C" int32_t         fraqtl_runtime_get_k_protect       (void);
+extern "C" void            fraqtl_runtime_mark_fused_call     (int32_t layer_idx);
+
+namespace {
+
+constexpr int BLOCK_S            = 64;       // K/V rows per online-softmax tile
+constexpr int FATTN_FRAQTL_HD    = 64;
+constexpr int FATTN_FRAQTL_MAX_L = 96;
+
+// Device helper: dequant one INT3 sacrifice value at sac_dim e for the
+// row whose packed bytes start at pack_row.
+__device__ inline float dequant_sac_value(
+    const uint8_t * __restrict__ pack_row,
+    int e,
+    float scale_s
+) {
+    const int g = e >> 3;          // group index
+    const int j = e & 7;           // position within the 8-int group
+    const uint8_t b0 = pack_row[g*3 + 0];
+    const uint8_t b1 = pack_row[g*3 + 1];
+    const uint8_t b2 = pack_row[g*3 + 2];
+    int u;
+    switch (j) {
+        case 0: u = (b0 >> 5) & 7;                            break;
+        case 1: u = (b0 >> 2) & 7;                            break;
+        case 2: u = ((b0 & 0x3) << 1) | ((b1 >> 7) & 1);      break;
+        case 3: u = (b1 >> 4) & 7;                            break;
+        case 4: u = (b1 >> 1) & 7;                            break;
+        case 5: u = ((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3);    break;
+        case 6: u = (b2 >> 3) & 7;                            break;
+        case 7: u =  b2        & 7;                           break;
+        default: u = 0;                                       break;
+    }
+    return ((float)u - 4.0f) * scale_s;
