+        "%s: loaded fraQtl K eigenbasis sidecar — "
+        "n_layers=%d n_kv_heads=%d head_dim=%d "
+        "ranks=[min=%d max=%d avg=%.2f] U_K=%.2f MiB on GPU\n",
+        __func__, hdr.n_layers, hdr.n_kv_heads, hdr.head_dim,
+        rmin, rmax, ravg, static_cast<double>(uk_bytes) / (1024.0 * 1024.0));
+}
+
+void free_k_bundle(k_bundle & bundle) {
+    if (!bundle.loaded || bundle.d_uk_arena == nullptr) {
+        return;
+    }
+#ifdef GGML_USE_CUDA
+    cudaFree(bundle.d_uk_arena);
+#endif
+    bundle.d_uk_arena    = nullptr;
+    bundle.uk_arena_bytes = 0;
+    bundle.loaded        = false;
+    bundle.ranks_per_layer_kvh.clear();
+}
