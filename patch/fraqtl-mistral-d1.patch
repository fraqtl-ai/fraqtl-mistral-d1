+// ===========================================================================
+// sink + residual fp16 double-write.
+// Fired from K_pack and V_pack set_rows hooks AFTER the existing compress
+// kernel completes (same stream, so kernel ordering is preserved). For each
+// (token, kvh, dim) tuple:
+//   - Convert src0[t][kvh*HD + d] from float to half.
+//   - If slot = idxs[t] < sink_n AND sink_buf != nullptr: write to
+//     sink_buf[(kvh * sink_n + slot) * HD + d].
+//   - If residual_buf != nullptr AND residual_n > 0: write to
+//     residual_buf[(kvh * residual_n + (slot % residual_n)) * HD + d].
+// Layout convention is locked by the contract (Section A.1) and must match
+// read-side dispatch when that lands.
+// Block / grid: blockIdx.x = token, blockIdx.y = kvh, threadIdx.x = dim.
+// Assumes HD <= 1024 so a head fits in one block (true for HD=128 Qwen).
+// "No overwrite-before-compress" invariant is structural: this kernel runs
+// AFTER the pack kernel on the same stream, so by the time slot S writes to
+// residual_buf[S % residual_n], slot (S - residual_n) — which used that same
+// modular index — was compressed in a prior pack call (call N - residual_n).
+// CUDA stream-ordered dispatch guarantees this without explicit barriers.
+// ===========================================================================
+template<typename idx_t>
+__global__ void fraqtl_kv_step59_double_write_kernel(
+    const float * __restrict__ src0,
+    const idx_t * __restrict__ idxs,
+    half *  sink_buf,         // may be nullptr
+    half *  residual_buf,     // may be nullptr
+    int n_tokens, int NKV, int HD,
+    int sink_n, int residual_n,
+    size_t src0_row_stride_bytes)
+{
+    const int t = blockIdx.x;
+    const int h = blockIdx.y;
+    const int d = threadIdx.x;
+    if (t >= n_tokens || h >= NKV || d >= HD) return;
+
+    // src0[t][:] starts at byte offset t * src0_row_stride_bytes.
+    const float * row_ptr = (const float *)
+        ((const char *) src0 + (size_t) t * src0_row_stride_bytes);
+    const float src_val = row_ptr[h * HD + d];
+    const half  hval     = __float2half(src_val);
+
+    const long long slot_ll = (long long) idxs[t];
+    if (slot_ll < 0) return;                   // defensive: invalid slot
+    const int slot = (int) slot_ll;
+
+    if (sink_buf != nullptr && sink_n > 0 && slot < sink_n) {
+        const size_t sink_off = (size_t)((h * sink_n + slot) * HD + d);
+        sink_buf[sink_off] = hval;
+    }
+    if (residual_buf != nullptr && residual_n > 0) {
+        // narrow patch (internal ) — winner
+        // filter for the residual write race. When n_tokens > residual_n,
+        // multiple tokens in the same ubatch map to the same modular
+        // residual index. WITHOUT this filter, the final residual_buf
+        // contents are non-deterministic across hardware schedules.
+        // Rule: write residual ONLY if this token is in the LAST residual_n
+        // positions of the ubatch. Under monotonic prefill idxs (slots
+        // increase with t), this is equivalent to "slot belongs to the
+        // newest residual_n unique modular indices of this batch", so the
+        // newest absolute slot wins per residual index.
+        // Decode (n_tokens=1): t=0, n_tokens-residual_n is negative, gate
+        // trivially passes — decode token always writes.
+        // Small prefill (n_tokens <= residual_n): every token is in the
+        // last residual_n positions; everyone writes (no race because the
+        // batch can't have two tokens with the same modular index).
+        const bool is_residual_winner =
+            (n_tokens <= residual_n) || (t + residual_n >= n_tokens);
+        if (is_residual_winner) {
+            const int    ridx    = slot % residual_n;
+            const size_t res_off = (size_t)((h * residual_n + ridx) * HD + d);
+            residual_buf[res_off] = hval;
+        }
+    }
+}
+
+// Host wrappers (called from the K/V hooks; idx_t dispatched on the
+// k_idxs_dtype / v_idxs_dtype field — same convention as the existing
+// pack-kernel dispatchers above). Caller is responsible for passing the
+// CORRECT sink_buf / residual_buf for the modality (K vs V).
+static void fraqtl_step59_double_write_dispatch_i64(
+    const float *   src0,
+    const int64_t * idxs,
+    half *          sink_buf,
+    half *          residual_buf,
+    int n_tokens, int NKV, int HD,
+    int sink_n, int residual_n,
+    size_t src0_row_stride_bytes,
+    cudaStream_t stream)
+{
+    if (n_tokens <= 0 || NKV <= 0 || HD <= 0) return;
+    if (sink_buf == nullptr && residual_buf == nullptr) return;
+    dim3 grid((unsigned) n_tokens, (unsigned) NKV);
+    dim3 block((unsigned) HD);
+    fraqtl_kv_step59_double_write_kernel<int64_t>
+        <<<grid, block, 0, stream>>>(
+            src0, idxs, sink_buf, residual_buf,
+            n_tokens, NKV, HD, sink_n, residual_n,
+            src0_row_stride_bytes);
+}
