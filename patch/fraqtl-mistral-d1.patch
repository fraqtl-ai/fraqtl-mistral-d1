+// ===========================================================================
+// stride-aware pack/unpack kernels.
+// The contiguous-layout pack/unpack above assume V is in row-major
+// [B, NKV, S, HD] order. ggml's KV cache stores V with NKV and S strides
+// SWAPPED (memory layout [B, S, NKV, HD] — see internal log). The
+// strided variants use byte offsets via nb[] so they work on any layout.
+// Slabs (prot, packed, scale, U) stay contiguous — we own their layout.
+// Only V_in (pack) and V_out (unpack) are strided.
+// ===========================================================================
+
+namespace {
+
+template <typename TOut>
+__global__ void fraqtl_kv_unpack_kernel_strided(
+    const half*    __restrict__ v_protected,
+    const uint8_t* __restrict__ v_packed,
+    const float*   __restrict__ v_scale,
+    const half*    __restrict__ U,
+    void*          __restrict__ v_out_base,    // strided output
+    int B, int NKV, int S, int HD, int K,
+    size_t nb0, size_t nb1, size_t nb2, size_t nb3
+) {
+    extern __shared__ float C_shared[];
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+
+    // Slabs use contiguous packed-row indexing.
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+    const int tid = threadIdx.x;
+
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        C_shared[i] = __half2float(v_protected[prot_row_base + i]);
+    }
+
+    const uint8_t* packed_row = v_packed + row * packed_bytes;
+    const float    scale      = v_scale[row];
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        const uint8_t b0 = packed_row[g * 3 + 0];
+        const uint8_t b1 = packed_row[g * 3 + 1];
+        const uint8_t b2 = packed_row[g * 3 + 2];
+        int v[8];
+        v[0] = (b0 >> 5) & 7;
+        v[1] = (b0 >> 2) & 7;
+        v[2] = ((b0 & 0x3) << 1) | ((b1 >> 7) & 1);
+        v[3] = (b1 >> 4) & 7;
+        v[4] = (b1 >> 1) & 7;
+        v[5] = ((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3);
+        v[6] = (b2 >> 3) & 7;
+        v[7] =  b2       & 7;
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                C_shared[K + e] = ((float) v[j] - 4.0f) * scale;
+            }
+        }
+    }
+    __syncthreads();
+
+    // V_out uses byte strides. Tensor dim order: ne[0]=HD, ne[1]=S, ne[2]=NKV, ne[3]=B.
+    const half* U_head = U + kvh * HD * HD;
+    char* row_base = (char *) v_out_base + b * nb3 + s * nb1 + kvh * nb2;
+
+    for (int d = tid; d < HD; d += blockDim.x) {
+        const half* U_row = U_head + d * HD;
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += C_shared[i] * __half2float(U_row[i]);
+        }
+        // Strided write: each d-element is at row_base + d*nb0
+        half * dst = (half *) (row_base + d * nb0);
+        *dst = fp32_to_out<TOut>(acc);
+    }
+}
+
+__global__ void fraqtl_kv_pack_kernel_strided(
+    const void*    __restrict__ v_in_base,    // strided input
+    half*          __restrict__ v_protected,
+    uint8_t*       __restrict__ v_packed,
+    float*         __restrict__ v_scale,
+    const half*    __restrict__ U,
+    int B, int NKV, int S, int HD, int K,
+    size_t nb0, size_t nb1, size_t nb2, size_t nb3
+) {
+    extern __shared__ float smem[];
+    float* C_shared    = smem;
+    float* scale_bcast = smem + HD;
+    float* reduce_buf  = smem + HD + 1;
+
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+    const int tid = threadIdx.x;
+
+    // V_in uses byte strides. ne[0]=HD, ne[1]=S, ne[2]=NKV, ne[3]=B.
+    const char* row_base = (const char *) v_in_base + b * nb3 + s * nb1 + kvh * nb2;
+    const half* U_head   = U + kvh * HD * HD;
+
+    // V_rot[d] = sum_i V_in[i] * U[i, d]
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            const half * v_ptr = (const half *) (row_base + i * nb0);
+            acc += __half2float(*v_ptr) * __half2float(U_head[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    // Slabs are contiguous as before.
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[prot_row_base + i] = __float2half(C_shared[i]);
+    }
+
+    // per-row max-abs reduce → scale = max/3.
+    float local_max = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float a = fabsf(C_shared[d]);
+        if (a > local_max) local_max = a;
+    }
+    reduce_buf[tid] = local_max;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            const float other = reduce_buf[tid + stride];
+            if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        float scale = reduce_buf[0] / 3.0f;
+        if (scale < 1e-10f) scale = 1e-10f;
+        scale_bcast[0] = scale;
+        v_scale[row]   = scale;
+    }
+    __syncthreads();
+    const float scale = scale_bcast[0];
+
+    // quantize sacrifice + pack 8-into-3.
+    uint8_t* packed_row = v_packed + row * packed_bytes;
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        int idx[8] = {0};
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                int q = (int) rintf(C_shared[K + e] / scale);
+                if (q < -4) q = -4;
+                if (q >  3) q =  3;
+                idx[j] = q + 4;
+            }
+        }
+        const uint8_t b0 = (idx[0] << 5) | (idx[1] << 2) | (idx[2] >> 1);
+        const uint8_t b1 = ((idx[2] & 1) << 7) | (idx[3] << 4) |
+                           (idx[4] << 1) | (idx[5] >> 2);
+        const uint8_t b2 = ((idx[5] & 0x3) << 6) | (idx[6] << 3) | idx[7];
+        packed_row[g * 3 + 0] = b0;
+        packed_row[g * 3 + 1] = b1;
+        packed_row[g * 3 + 2] = b2;
+    }
+}
+
+// ===========================================================================
+// pack-from-cache kernel for the ggml_cuda_op_set_rows hook.
+// Mirrors fraqtl_kv_pack_kernel_strided but reads from the V cache tensor
+// (post-set_rows write, same-stream-FIFO with the set_rows kernel queued
+// before us) and writes into the slab at slot index v_idxs[t] for each
+// token t in [0, n_tokens). Pre-offset slab pointers per-kvh in host code
+// so the kernel only sees one head's section.
+// Numerical path matches the strided kernel exactly: reads halves from
+// the cache (same as /cpy that read halves at fattn entry),
+// rotates by U[layer, kvh, :, :], writes prot/pack/scale at row idx.
+// No F32 short-circuit (per internal review direction A1, not A2).
+// ===========================================================================
+template <typename TIdx>
+__global__ void fraqtl_kv_pack_kernel_set_rows(
+    const half *  __restrict__ v_cache,        // base of cache_v_l<L>'s data
+    const TIdx *  __restrict__ v_idxs,         // device tensor [n_tokens]
+    half *        __restrict__ v_protected,    // pre-offset to kvh's section base
+    uint8_t *     __restrict__ v_packed,       // pre-offset to kvh's section base, may be null
+    float *       __restrict__ v_scale,        // pre-offset to kvh's section base
+    const half *  __restrict__ U,              // per-(layer, kvh) slice [HD, HD]
+    int n_tokens, int kvh_idx, int kv_size, int HD, int K,
+    size_t cache_row_stride_bytes              // = NKV * HD * sizeof(half)
+) {
+    extern __shared__ float smem[];
+    float * C_shared    = smem;
+    float * scale_bcast = smem + HD;
+    float * reduce_buf  = smem + HD + 1;
+
+    const int t = blockIdx.x;
+    if (t >= n_tokens) return;
+    const int tid = threadIdx.x;
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+
+    // Read slot index for this token (device-side; no host sync needed).
+    const TIdx idx_val = v_idxs[t];
+    const int  idx     = (int) idx_val;
+    if (idx < 0 || idx >= kv_size) return;
+
+    // Cache row at (slot=idx, head=kvh_idx). The cache layout is
+    // [n_embd_v_gqa=NKV*HD, kv_size, n_stream] with row stride
+    // cache_row_stride_bytes = NKV*HD*sizeof(half). Heads sit
+    // contiguously within a row; head kvh starts at offset
+    // kvh_idx * HD * sizeof(half) from the row base.
+    const char * cache_row = (const char *) v_cache
+                           + (size_t) idx * cache_row_stride_bytes
+                           + (size_t) kvh_idx * HD * sizeof(half);
+    const half * cache_kvh = (const half *) cache_row;
+
+    // V_rot[d] = sum_i cache_kvh[i] * U[i, d]
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += __half2float(cache_kvh[i]) * __half2float(U[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    // write protected slab at row idx.
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[(size_t) idx * K + i] = __float2half(C_shared[i]);
+    }
+
+    // per-row max-abs reduce -> scale = max/3.
+    float local_max = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float a = fabsf(C_shared[d]);
+        if (a > local_max) local_max = a;
+    }
+    reduce_buf[tid] = local_max;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            const float other = reduce_buf[tid + stride];
+            if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        float scale = reduce_buf[0] / 3.0f;
+        if (scale < 1e-10f) scale = 1e-10f;
+        scale_bcast[0]   = scale;
+        v_scale[idx]     = scale;
+    }
+    __syncthreads();
+    const float scale = scale_bcast[0];
+
+    // quantize sacrifice + pack 8-into-3.
+    if (v_packed != nullptr) {
+        uint8_t * packed_row = v_packed + (size_t) idx * packed_bytes;
+        for (int g = tid; g < padded_groups; g += blockDim.x) {
+            int idx8[8] = {0};
+            #pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const int e = g * 8 + j;
+                if (e < sac_dims) {
+                    int q = (int) rintf(C_shared[K + e] / scale);
+                    if (q < -4) q = -4;
+                    if (q >  3) q =  3;
+                    idx8[j] = q + 4;
+                }
+            }
+            const uint8_t b0 = (idx8[0] << 5) | (idx8[1] << 2) | (idx8[2] >> 1);
+            const uint8_t b1 = ((idx8[2] & 1) << 7) | (idx8[3] << 4) |
+                               (idx8[4] << 1) | (idx8[5] >> 2);
+            const uint8_t b2 = ((idx8[5] & 0x3) << 6) | (idx8[6] << 3) | idx8[7];
+            packed_row[g * 3 + 0] = b0;
+            packed_row[g * 3 + 1] = b1;
+            packed_row[g * 3 + 2] = b2;
+        }
+    }
+}
+
+// pack-from-src variant of the set_rows kernel.
+// Reads source V row directly from set_rows.src0 (the just-computed V
+// from the graph), bypassing the standard set_rows kernel's write to
+// cache_v_l<L>. Lets ONLINE mode skip the fp16 cache_v_l<L> dependency
+// entirely on the decode hot path.
+// Layout: src0 holds n_tokens rows of n_embd_v_gqa = NKV*HD halves
+// each. Row stride is src0->nb[1] (passed as src0_row_stride_bytes).
+// Within a row, kvh's HD halves start at kvh_idx * HD * sizeof(half).
+// Block: blockIdx.x = t (token index in batch). idx = v_idxs[t]. Same
+// per-row body as fraqtl_kv_pack_kernel_set_rows: V@U rotation, prot
+// write at row idx, max-abs reduce, INT3 SAC pack.
+template <typename TIdx>
+__global__ void fraqtl_kv_pack_kernel_set_rows_from_src(
+    const float * __restrict__ src0,           // base of set_rows src0 (F32 per ggml_cuda_op_set_rows)
+    const TIdx *  __restrict__ v_idxs,         // device tensor [n_tokens]
+    half *        __restrict__ v_protected,    // pre-offset to kvh's section base
+    uint8_t *     __restrict__ v_packed,       // pre-offset to kvh's section base, may be null
+    float *       __restrict__ v_scale,        // pre-offset to kvh's section base
+    const half *  __restrict__ U,              // per-(layer, kvh) slice [HD, HD]
+    int n_tokens, int kvh_idx, int kv_size, int HD, int K,
+    size_t src0_row_stride_bytes              // = src0->nb[1]
+) {
+    extern __shared__ float smem[];
+    float * C_shared    = smem;
+    float * scale_bcast = smem + HD;
+    float * reduce_buf  = smem + HD + 1;
+
+    const int t = blockIdx.x;
+    if (t >= n_tokens) return;
+    const int tid = threadIdx.x;
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+
+    const TIdx idx_val = v_idxs[t];
+    const int  idx     = (int) idx_val;
+    if (idx < 0 || idx >= kv_size) return;
+
+    // Source row: src0[t, kvh*HD : (kvh+1)*HD] — HD F32 floats of V.
+    // ggml_cuda_op_set_rows asserts src0->type == GGML_TYPE_F32, so we
+    // read floats directly. The standard kernel would then F32→F16 cast
+    // into cache_v_l<L>; we skip that since slabs absorb the dynamic
+    // range via scale + INT3 SAC.
+    const char *  src_row = (const char *) src0 + (size_t) t * src0_row_stride_bytes;
+    const float * src_kvh = (const float *)(src_row + (size_t) kvh_idx * HD * sizeof(float));
+
+    // V_rot[d] = sum_i src_kvh[i] * U[i, d]
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += src_kvh[i] * __half2float(U[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    // protected slab.
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[(size_t) idx * K + i] = __float2half(C_shared[i]);
+    }
+
+    // per-row max-abs reduce.
+    float local_max = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float a = fabsf(C_shared[d]);
+        if (a > local_max) local_max = a;
+    }
+    reduce_buf[tid] = local_max;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            const float other = reduce_buf[tid + stride];
+            if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        float scale = reduce_buf[0] / 3.0f;
+        if (scale < 1e-10f) scale = 1e-10f;
+        scale_bcast[0]   = scale;
+        v_scale[idx]     = scale;
+    }
+    __syncthreads();
+    const float scale = scale_bcast[0];
+
+    // INT3 SAC pack (8-into-3, MSB-first).
+    if (v_packed != nullptr) {
+        uint8_t * packed_row = v_packed + (size_t) idx * packed_bytes;
+        for (int g = tid; g < padded_groups; g += blockDim.x) {
+            int idx8[8] = {0};
+            #pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const int e = g * 8 + j;
+                if (e < sac_dims) {
+                    int q = (int) rintf(C_shared[K + e] / scale);
+                    if (q < -4) q = -4;
+                    if (q >  3) q =  3;
+                    idx8[j] = q + 4;
+                }
+            }
+            const uint8_t b0 = (idx8[0] << 5) | (idx8[1] << 2) | (idx8[2] >> 1);
+            const uint8_t b1 = ((idx8[2] & 1) << 7) | (idx8[3] << 4) |
+                               (idx8[4] << 1) | (idx8[5] >> 2);
+            const uint8_t b2 = ((idx8[5] & 0x3) << 6) | (idx8[6] << 3) | idx8[7];
+            packed_row[g * 3 + 0] = b0;
+            packed_row[g * 3 + 1] = b1;
+            packed_row[g * 3 + 2] = b2;
+        }
+    }
+}
+
+// (deferred-pack): bulk full-range pack kernel.
+// Same per-row work as fraqtl_kv_pack_kernel_set_rows (V@U rotation, prot
+// write, max-abs reduction, INT3 SAC pack), but processes a contiguous
+// row range [row_start, row_start + n_rows) without an indirection table.
+// One block per row; n_rows blocks per launch. Caller offsets prot/pack/
+// scale slabs to the kvh's section base, same convention as the per-row
+// hook launcher.
+__global__ void fraqtl_kv_pack_kernel_bulk(
+    const half *  __restrict__ v_cache,        // base of cache_v_l<L>'s data
+    half *        __restrict__ v_protected,    // pre-offset to kvh's section base
+    uint8_t *     __restrict__ v_packed,       // pre-offset to kvh's section base, may be null
+    float *       __restrict__ v_scale,        // pre-offset to kvh's section base
+    const half *  __restrict__ U,              // per-(layer, kvh) slice [HD, HD]
+    int row_start, int n_rows, int kvh_idx, int kv_size, int HD, int K,
+    size_t cache_row_stride_bytes              // = NKV * HD * sizeof(half)
+) {
+    extern __shared__ float smem[];
+    float * C_shared    = smem;
+    float * scale_bcast = smem + HD;
+    float * reduce_buf  = smem + HD + 1;
+
+    const int t = blockIdx.x;
+    if (t >= n_rows) return;
+    const int idx = row_start + t;
+    if (idx < 0 || idx >= kv_size) return;
+    const int tid = threadIdx.x;
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+
+    const char * cache_row = (const char *) v_cache
+                           + (size_t) idx * cache_row_stride_bytes
+                           + (size_t) kvh_idx * HD * sizeof(half);
+    const half * cache_kvh = (const half *) cache_row;
+
+    // V_rot[d] = sum_i cache_kvh[i] * U[i, d]
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += __half2float(cache_kvh[i]) * __half2float(U[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    // protected slab.
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[(size_t) idx * K + i] = __float2half(C_shared[i]);
+    }
+
+    // per-row max-abs reduce.
+    float local_max = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float a = fabsf(C_shared[d]);
+        if (a > local_max) local_max = a;
+    }
+    reduce_buf[tid] = local_max;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            const float other = reduce_buf[tid + stride];
+            if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        float scale = reduce_buf[0] / 3.0f;
+        if (scale < 1e-10f) scale = 1e-10f;
+        scale_bcast[0]   = scale;
+        v_scale[idx]     = scale;
+    }
+    __syncthreads();
+    const float scale = scale_bcast[0];
+
+    // INT3 SAC pack (8-into-3, MSB-first — must match dequantize_V_fraqtl).
+    if (v_packed != nullptr) {
+        uint8_t * packed_row = v_packed + (size_t) idx * packed_bytes;
+        for (int g = tid; g < padded_groups; g += blockDim.x) {
+            int idx8[8] = {0};
+            #pragma unroll
+            for (int j = 0; j < 8; ++j) {
+                const int e = g * 8 + j;
+                if (e < sac_dims) {
+                    int q = (int) rintf(C_shared[K + e] / scale);
+                    if (q < -4) q = -4;
+                    if (q >  3) q =  3;
+                    idx8[j] = q + 4;
+                }
+            }
+            const uint8_t b0 = (idx8[0] << 5) | (idx8[1] << 2) | (idx8[2] >> 1);
+            const uint8_t b1 = ((idx8[2] & 1) << 7) | (idx8[3] << 4) |
+                               (idx8[4] << 1) | (idx8[5] >> 2);
+            const uint8_t b2 = ((idx8[5] & 0x3) << 6) | (idx8[6] << 3) | idx8[7];
+            packed_row[g * 3 + 0] = b0;
+            packed_row[g * 3 + 1] = b1;
+            packed_row[g * 3 + 2] = b2;
+        }
+    }
+}
