+// explicit template instantiations for fraqtl_k=true variants.
+// Hand-written (NOT autogenerated by generate_cu_files.py) — the fraqtl_k
+// scope is intentionally locked to a single product configuration:
+//   - Qwen 7B only
+//   - HD = 128 (DKQ = DV = 128)
+//   - NKV = 4 (runtime check in fattn.cu eligibility)
+//   - per-(layer, kvh) variable rank R, R range [24, 128] including R=HD
+//   - gqa_ratio = 7 → ncols2 = 8 (dispatcher selects this in fattn.cu)
+// Two routes × two shapes = 4 instantiations:
+//   K-only debug (k=T, v=F):
+//     prefill (n_tokens >= 8): _case<128,128,8,8,false,true> ncols=64
+//     decode (n_tokens == 1): _case<128,128,1,8,false,true> ncols=8
+//   Combined K+V product (k=T, v=T):
+//     prefill: _case<128,128,8,8,true,true> ncols=64
+//     decode: _case<128,128,1,8,true,true> ncols=8
+// Anything outside this scope MUST go through the existing fp16 path
+// (DECL_FATTN_MMA_F16_CASE without _FRAQTL_K / _FRAQTL_KV). See the
+// static_asserts inside flash_attn_ext_f16_iter for the compile-time guard.
+// will wire the fattn.cu dispatcher to route to these.
+// will land the cache_k_l<L> first-class storage that makes K_h2 carry
+// descriptor bytes instead of raw fp16 K — without 5.7, these kernels
+// will read garbage from K_h2 and produce wrong scores. The
+// dispatcher MUST gate on the K storage being wired before routing here.
+
+#include "../fattn-mma-f16.cuh"
+
+// K read-side context now flows via kernel arguments
+// (see fraqtl_step59_k_args_t in fraqtl-kv.cuh). No __constant__/__device__
+// symbols defined here. The dispatcher in fattn.cu builds the struct via
+// fraqtl_runtime_get_step59_k_args_for_layer() and passes it to
+// ggml_cuda_flash_attn_ext_mma_f16_case which forwards through launch_fattn.
+
+DECL_FATTN_MMA_F16_CASE_FRAQTL_K (128, 128, 8, 8);
+DECL_FATTN_MMA_F16_CASE_FRAQTL_K (128, 128, 1, 8);
+DECL_FATTN_MMA_F16_CASE_FRAQTL_KV(128, 128, 8, 8);
+DECL_FATTN_MMA_F16_CASE_FRAQTL_KV(128, 128, 1, 8);
