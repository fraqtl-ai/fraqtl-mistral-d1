+            } else {
+                if (pack_kvh != nullptr) {
+                    const int e = d - K_PROT;
+                    const float scale_s = scale_kvh[s];
+                    const uint8_t * pack_row = pack_kvh + (size_t) s * packed_bytes_per_row;
+                    c_rot_d = dequant_sac_value(pack_row, e, scale_s);
+                } else {
+                    c_rot_d = 0.0f;
+                }
+            }
+            v_contrib += p_s * c_rot_d;
+        }
+        acc_d = alpha * acc_d + v_contrib;
+
+        l = alpha * l + tile_sum;
+        m = m_new;
+
+        __syncthreads();
+    }
+
+    if (l > 0.0f) {
+        acc_d = acc_d / l;
+    }
+
+    // Apply U.T un-rotation: O[d] = sum_i acc[i] * U[kvh, i, d].
+    red_buf[d] = acc_d;
+    __syncthreads();
+
+    {
+        float o = 0.0f;
+        #pragma unroll
+        for (int i = 0; i < HD; ++i) {
+            o += red_buf[i] * __half2float(U_kvh[(size_t) i * HD + d]);
+        }
+        // O (KQV) is F32 in ggml CUDA flash_attn_ext, with shape
+        //   [HD, n_head, n_tokens, B] (ggml.c: int64_t ne[4] = {
+        //                                  v->ne[0], q->ne[2], q->ne[1],
+        //                                  q->ne[3] }; "permute(0, 2, 1, 3)")
+        // i.e. nb[1] is the HEAD-axis stride, nb[2] is the TOKEN-axis
+        // stride. This is the OPPOSITE of Q's [HD, n_tokens, n_head, B]
+        // — Q uses nb[1] for token and nb[2] for head. first
+        // patch had this wrong (used Q's pattern for O), producing
+        // bytes at the wrong (head, token) offsets and garbage
+        // generation. Now matches the standard fattn writeback order.
+        float * O_row = (float *) (O_base
+                      + (size_t) batch * O_nb3
+                      + (size_t) token * O_nb2
+                      + (size_t) head  * O_nb1);
+        O_row[d] = o;
+    }
+}
+
+}  // anonymous namespace
+
+extern "C" int fraqtl_attn_v_fused_launch(
+    const struct ggml_tensor * Q,
+    const struct ggml_tensor * K,
+    const struct ggml_tensor * V,
+    const struct ggml_tensor * mask,
+    struct ggml_tensor *       O,
+    int                        layer_idx,
+    void *                     stream
+) {
+    if (!fraqtl_runtime_is_active()) return 1;
+    (void) V;   // shape only — slabs already validated upstream
+
+    const int HD       = (int) Q->ne[0];
+    const int n_tokens = (int) Q->ne[1];
+    const int n_head   = (int) Q->ne[2];
+    const int B        = (int) Q->ne[3];
+    const int n_kv     = (int) K->ne[1];
+    const int NKV      = (int) K->ne[2];
+
+    if (HD != FATTN_FRAQTL_HD) return 11;
+    if (n_head % NKV != 0)     return 12;
+    const int q_per_kvh = n_head / NKV;
+
+    // Type gates. ggml CUDA flash_attn_ext takes Q in F32 and writes
+    // KQV (= O = dst) in F32. K and mask stay in F16 (the cache K is
+    // f16, the mask is f16). Sticking to the same type contract so the
+    // fused kernel is a drop-in replacement for the standard fattn
+    // dispatch path.
+    if (Q->type != GGML_TYPE_F32) return 18;
+    if (K->type != GGML_TYPE_F16) return 19;
+    if (O->type != GGML_TYPE_F32) return 20;
+    // first patch: mask is REQUIRED and must be fp16 (the
+    // dispatcher in fattn.cu enforces this too; we re-check defensively
+    // because a different caller might call this entry directly).
+    if (mask == nullptr)               return 26;
+    if (mask->type != GGML_TYPE_F16)   return 21;
+
+    // Stride sanity: nb[0] must match the per-tensor element size.
+    if (Q->nb[0]    != sizeof(float)) return 22;
+    if (K->nb[0]    != sizeof(half))  return 23;
+    if (O->nb[0]    != sizeof(float)) return 24;
+    if (mask->nb[0] != sizeof(half))  return 25;
+
+    // Mask shape gates. The kernel reads mask[token, s] for s in [0, n_kv)
+    // and token in [0, n_tokens). mask->ne[0] is the s-axis (n_kv); ne[1]
+    // is the token-axis (n_tokens). Higher dims must be 1 (no batch / head
+    // broadcasting in first patch — those go through the path).
+    if (mask->ne[0] < n_kv)       return 27;
+    if (mask->ne[1] < n_tokens)   return 28;
+    if (mask->ne[2] != 1)         return 29;
+    if (mask->ne[3] != 1)         return 30;
+
+    const half *    prot_slab  = fraqtl_runtime_get_layer_prot_slab (layer_idx);
+    const uint8_t * pack_slab  = fraqtl_runtime_get_layer_pack_slab (layer_idx);
+    const float *   scale_slab = fraqtl_runtime_get_layer_scale_slab(layer_idx);
+    const int       kv_size    = fraqtl_runtime_get_layer_kv_size   (layer_idx);
+    const half *    U_layer    = fraqtl_runtime_get_layer_U         (layer_idx);
+    const int       K_PROT     = fraqtl_runtime_get_k_protect       ();
+    if (!prot_slab || !scale_slab || !U_layer || kv_size <= 0) return 14;
+
+    const int sac_dims             = HD - K_PROT;
+    const int padded_groups        = (sac_dims + 7) / 8;
+    const int packed_bytes_per_row = padded_groups * 3;
+
+    // When K_PROT < HD, the kernel reads quantized sacrifice values from
+    // pack_slab. A null pack_slab in that case would silently zero the
+    // sac contribution and return success — wrong math, hard to detect
+    // downstream. K_PROT == HD is the no-sac case where pack_slab is
+    // legitimately null (no allocation per llama-kv-cache.cpp:325).
+    if (K_PROT < HD && pack_slab == nullptr) return 32;
+
+    // Capacity gate: K view length must fit in registered slab capacity.
+    if (n_kv > kv_size) return 33;
+
+    // Batched cache out of scope for first patch.
+    if (B != 1) return 34;
+
+    float scale         = 1.0f;
+    float max_bias      = 0.0f;
+    float logit_softcap = 0.0f;
+    memcpy(&scale,         (const float *) O->op_params + 0, sizeof(float));
+    memcpy(&max_bias,      (const float *) O->op_params + 1, sizeof(float));
+    memcpy(&logit_softcap, (const float *) O->op_params + 2, sizeof(float));
+    if (logit_softcap != 0.0f) return 15;
+    if (max_bias      != 0.0f) return 16;       // ALiBi out of scope for first patch
+
+    cudaStream_t cu_stream = (cudaStream_t) stream;
+
+    // First-launch-per-layer diagnostic.
+    static unsigned char fused_logged[FATTN_FRAQTL_MAX_L] = {0};
+    if (layer_idx >= 0 && layer_idx < FATTN_FRAQTL_MAX_L && !fused_logged[layer_idx]) {
+        fprintf(stdout,
+            "fraqtl: fused_attn layer %d FIRST CALL — "
+            "n_tokens=%d n_head=%d NKV=%d q_per_kvh=%d HD=%d K_PROT=%d "
+            "n_kv=%d kv_size=%d B=%d scale=%.4f packed_bytes_per_row=%d "
+            "Q_nb=[%lld,%lld,%lld] O_nb=[%lld,%lld,%lld]\n",
+            layer_idx, n_tokens, n_head, NKV, q_per_kvh, HD, K_PROT,
+            n_kv, kv_size, B, scale, packed_bytes_per_row,
+            (long long) Q->nb[1], (long long) Q->nb[2], (long long) Q->nb[3],
+            (long long) O->nb[1], (long long) O->nb[2], (long long) O->nb[3]);
+        fflush(stdout);
+        fused_logged[layer_idx] = 1;
+    }
+
+    const char * mask_base         = mask ? (const char *) mask->data : nullptr;
+    const int    mask_token_stride = mask ? (int) mask->nb[1] : 0;
+    const int    mask_n_tokens     = mask ? (int) mask->ne[1] : 0;
+
+    const dim3 grid((unsigned) n_tokens, (unsigned) n_head, (unsigned) B);
+    const dim3 block((unsigned) HD, 1, 1);
+    const size_t smem_bytes = ((size_t) HD * 2 + 2 * BLOCK_S) * sizeof(float);
+
+    if (K_PROT == 16) {
+        fattn_fraqtl_kernel<16><<<grid, block, smem_bytes, cu_stream>>>(
+            (const char *) Q->data, (int) Q->nb[1], (int) Q->nb[2], (int) Q->nb[3],
+            (const char *) K->data, (int) K->nb[1], (int) K->nb[2], (int) K->nb[3],
+            n_kv, q_per_kvh,
+            mask_base, mask_token_stride, mask_n_tokens,
+            prot_slab, pack_slab, scale_slab,
+            kv_size, packed_bytes_per_row,
+            U_layer,
+            (char *) O->data, (int) O->nb[1], (int) O->nb[2], (int) O->nb[3],
+            scale);
+    } else if (K_PROT == 64) {
+        fattn_fraqtl_kernel<64><<<grid, block, smem_bytes, cu_stream>>>(
+            (const char *) Q->data, (int) Q->nb[1], (int) Q->nb[2], (int) Q->nb[3],
+            (const char *) K->data, (int) K->nb[1], (int) K->nb[2], (int) K->nb[3],
+            n_kv, q_per_kvh,
+            mask_base, mask_token_stride, mask_n_tokens,
+            prot_slab, pack_slab, scale_slab,
+            kv_size, packed_bytes_per_row,
+            U_layer,
+            (char *) O->data, (int) O->nb[1], (int) O->nb[2], (int) O->nb[3],
+            scale);
+    } else {
+        return 17;
+    }
+
+    // Catch launch-time errors (bad shared mem size, occupancy fail, etc.).
+    // We DO NOT cudaStreamSynchronize here — that would break graph capture
+    // (internal logd). cudaGetLastError() reads the per-thread
+    // error flag set by the launch itself; it does not synchronize.
+    const cudaError_t launch_err = cudaGetLastError();
+    if (launch_err != cudaSuccess) {
+        fprintf(stdout,
+            "fraqtl: fused_attn layer %d KERNEL LAUNCH ERROR — %s "
+            "(K_PROT=%d n_tokens=%d n_head=%d n_kv=%d) — fallback enabled\n",
+            layer_idx, cudaGetErrorString(launch_err),
+            K_PROT, n_tokens, n_head, n_kv);
+        fflush(stdout);
+        return 31;
+    }
+
+    fraqtl_runtime_mark_fused_call(layer_idx);
+    return 0;
+}
