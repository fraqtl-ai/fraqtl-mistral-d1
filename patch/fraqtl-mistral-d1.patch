+// ===========================================================================
+// Runtime singleton (lite).
+// Holds the loaded eigenbasis + scratch slabs. Set once at llama_context init,
+// cleared at llama_free. The fattn dispatcher checks `is_active()` and calls
+// `roundtrip_v()` on the V tensor in place before the standard kernels run.
+// This is an in-place lossy roundtrip — exercises the pack/unpack kernels on
+// the actual V tensor inside the attention path. With identity U + k_protect
+// = head_dim, the roundtrip is mathematically a no-op (Variant A plumbing
+// gate). With k_protect < head_dim, INT3 quantization noise is introduced
+// (Variant B kernel-exercise gate).
+// + replaces this with proper graph injection (real V cache compression
+// = packed slabs ARE the cache, unpack on demand into a per-batch scratch).
+// ===========================================================================
+
+namespace {
+constexpr int FRAQTL_MAX_LAYERS = 96;
+// per-layer K rank table size. Qwen 7B has 4 KV heads; common models
+// range 4-32; 64 is a safe upper bound that fits common architectures.
+constexpr int FRAQTL_MAX_KV_HEADS = 64;
+
+struct fraqtl_runtime_state {
+    bool     active       = false;
+
+    // deferred-pack: prefill writes fp16 V to standard
+    // cache_v_l<L>; per-row pack hook + descriptor adapter are gated
+    // OFF until llama_fraqtl_compress_cache(ctx) bulk-packs the cache
+    // and flips mode to ONLINE. is_active() checks (active && mode==ONLINE)
+    // so set-rows.cu and fattn.cu both see "fraqtl off" during prefill,
+    // and "fraqtl on" during decode. No call-site changes required.
+    enum mode_t { MODE_DEFERRED = 0, MODE_ONLINE = 1 };
+    mode_t   mode         = MODE_DEFERRED;
+    int32_t  last_compressed_rows[FRAQTL_MAX_LAYERS] = {0};   // set after first compress
+
+    void *   d_U          = nullptr;     // fp16 [n_layers, n_kv, hd, hd]
+    int32_t  n_layers     = 0;
+    int32_t  n_kv         = 0;
+    int32_t  hd           = 0;
+    int32_t  k_protect    = 0;
+    // Scratch slabs (sized for max n_ctx). Reused across forward passes.
+    void *   d_packed     = nullptr;     // uint8 [n_ctx * n_kv, ceil(sac/8)*3]
+    void *   d_scale      = nullptr;     // fp32 [n_ctx * n_kv]
+    void *   d_protected  = nullptr;     // fp16 [n_ctx * n_kv, k_protect]
+    int32_t  scratch_rows = 0;           // n_ctx * n_kv (the row capacity)
+
+    // Per-layer persistent slabs + incremental pack cursor.
+    // Cache (llama_kv_cache ctor) allocates ggml-managed slab tensors in
+    // the same backend buffer as K/V, then registers each layer's slab
+    // pointers here post-buffer-alloc via fraqtl_runtime_register_layer_slabs.
+    // packed_until[i] tracks how many V rows have been packed into layer
+    // i's slab; fattn entry packs only [packed_until, current_S) per call.
+    // Cursors reset on cache mutation via fraqtl_runtime_reset_layer_cursors.
+    void *   layer_v_protected[FRAQTL_MAX_LAYERS] = {nullptr};
+    void *   layer_v_packed   [FRAQTL_MAX_LAYERS] = {nullptr};
+    void *   layer_v_scale    [FRAQTL_MAX_LAYERS] = {nullptr};
+    int32_t  packed_until     [FRAQTL_MAX_LAYERS] = {0};
+    int32_t  layer_kv_size    [FRAQTL_MAX_LAYERS] = {0};
+
+    // per-layer fp16 V cache pointer + layout, registered
+    // alongside slabs by the cache constructor (llama-kv-cache.cpp). Used
+    // by fraqtl_runtime_compress_layer to read source V at end of prefill.
+    // We do NOT own the storage; the kv-cache buffer owns it.
+    const void * layer_v_cache_data[FRAQTL_MAX_LAYERS] = {nullptr};
+    int64_t  layer_v_cache_ne0[FRAQTL_MAX_LAYERS] = {0};   // = NKV*HD
+    size_t   layer_v_cache_nb1[FRAQTL_MAX_LAYERS] = {0};   // row stride bytes
+
+    // per-layer write-time hook counters + fallback flag.
+    // cpy_hook_calls — incremented by fraqtl_runtime_pack_v_cpy_hook
+    //                     when called from ggml_cuda_cpy on a recognized
+    //                     cache_v_l<L> destination (legacy path; modern
+    //                     llama.cpp routes V writes through ggml_set_rows
+    //                     so this counter is typically 0 in production).
+    // set_rows_hook_calls — incremented by fraqtl_runtime_pack_v_set_rows_hook
+    //                     when called from ggml_cuda_op_set_rows. THIS
+    //                     is the load-bearing counter for the smoke
+    //                     receipt; > 0 proves the right hook fired.
+    // hook_skips_shape — pre-call shape/stride/alignment gate failures
+    //                     across both hooks (cpy.cu and set-rows.cu).
+    // hook_errors — internal validation failures inside either
+    //                     fraqtl_runtime_pack_v_*_hook function body.
+    // needs_fallback_pack — set when EITHER hook missed for ANY reason.
+    //                     decode_v_incremental at fattn entry checks
+    //                     this AND a "no hook ever fired" condition
+    //                     (cpy_hook_calls + set_rows_hook_calls == 0)
+    //                     and runs a Phase-1 full repack from live V
+    //                     before unpacking. Mandatory safety net per
+    //                     internal review direction: never silently unpack a
+    //                     stale or zero slab into V.
+    int32_t  cpy_hook_calls       [FRAQTL_MAX_LAYERS] = {0};
+    int32_t  set_rows_hook_calls  [FRAQTL_MAX_LAYERS] = {0};
+    int32_t  hook_skips_shape     [FRAQTL_MAX_LAYERS] = {0};
+    int32_t  hook_errors          [FRAQTL_MAX_LAYERS] = {0};
+    int32_t  needs_fallback_pack  [FRAQTL_MAX_LAYERS] = {0};
+
+    // Path A: engine-registered callback fired by the set_rows
+    // hook the FIRST TIME release_ready returns 1 (i.e. as soon as all layers
+    // have packed their first slab during chunk-1 prefill). Lets the existing
+    // release_fraqtl_v_fp16_buffers() fire mid-prefill, much earlier than the
+    // decode-end trigger. Empirical question whether nvidia-smi peak actually
+    // drops — depends on whether cudaFree on a 1.7 GB block returns memory
+    // to OS or to CUDA pool.
+    void (*release_callback)(void *) = nullptr;
+    void *  release_callback_user    = nullptr;
+    bool    release_callback_fired   = false;
+
+    // per-layer device descriptor arena for the fattn-vec embed
+    // path. Allocated in fraqtl_runtime_register_layer_slabs once slab
+    // pointers + kv_size are known; freed in fraqtl_runtime_clear_layer_slabs
+    // / teardown. Layout: layer_v_descs[h*kv_size + k] = fraqtl_v_row_desc{
+    //   prot_row, pack_row, scale_row, k_prot, hd, pack_stride }.
+    // Pure metadata — set once at register time, never updated by set_rows.
+    fraqtl_v_row_desc * layer_v_descs[FRAQTL_MAX_LAYERS] = {nullptr};
+
+    // per-layer counter for successful fused-attention launches.
+    // Surfaced in the FIRST CALL diagnostic so the receipt can prove
+    // fused_path_used vs the fallback path. There is NO per-call
+    // "handled" flag — the dispatcher in fattn.cu uses a local boolean
+    // (`fused_handled`) within one fattn entry to decide whether to run
+    // decode_v_incremental and whether to fall through to the standard
+    // fattn dispatch. A cross-function flag would be stale across calls
+    // when the dispatcher takes the fused path one call and the
+    // path the next.
+    int32_t  fused_attn_calls [FRAQTL_MAX_LAYERS] = {0};
+
+    // re-land (): per-layer ROW_AUDIT verdict cache.
+    // 0 = not yet run, 1 = passed (rel_l2 ≤ tolerance), 2 = skipped/failed.
+    // Reset in fraqtl_runtime_setup() so a second context in the same process
+    // does not inherit stale verdicts by layer index. (The previous version
+    // used a function-static array, which was only safe for single-shot CLI.)
+    unsigned char audit_done [FRAQTL_MAX_LAYERS] = {0};
+
+    // Strict V lifetime state. This is intentionally orthogonal to the
+    // compression math: it only records whether the fp16 V backing is still
+    // allowed to exist/read/write after compressed V has been built.
+    enum v_lifetime_state_t {
+        V_FP16_ACTIVE      = 0,
+        V_COMPRESSED_BUILT = 1,
+        V_MARKER_ONLY      = 2,
+        V_ILLEGAL_READ     = 3,
+    };
+    unsigned char v_lifetime_state[FRAQTL_MAX_LAYERS] = {0};
+    unsigned char v_pack_ok_logged  [FRAQTL_MAX_LAYERS] = {0};
+    unsigned char v_marker_logged   [FRAQTL_MAX_LAYERS] = {0};
+    unsigned char v_route_logged    [FRAQTL_MAX_LAYERS] = {0};
+    size_t        v_logical_bytes   [FRAQTL_MAX_LAYERS] = {0};
+    size_t        v_compressed_bytes[FRAQTL_MAX_LAYERS] = {0};
+    unsigned char k_marker_logged   [FRAQTL_MAX_LAYERS] = {0};
+    unsigned char k_route_logged    [FRAQTL_MAX_LAYERS] = {0};
+    unsigned char k_marker_only     [FRAQTL_MAX_LAYERS] = {0};
+    size_t        k_logical_bytes   [FRAQTL_MAX_LAYERS] = {0};
+
+    // ========================================================================
+    // K-cache compression state (parallel to V state above).
+    // d_U_K is the K-side eigenbasis arena, separately calibrated from the
+    // V-side d_U. Both arenas live for the duration of the runtime.
+    // K slabs are per-layer device pointers (analogous to layer_v_protected
+    // etc.). pack_slab_k may be nullptr for a layer if every kvh in that
+    // layer has rank == HD (uncompressible).
+    // layer_k_ranks holds the per-(layer, kvh) protected rank R from the
+    // calibration sidecar. Range: 24 ≤ R ≤ HD (Gate 0c showed Qwen 7B has
+    // some heads at R = HD = 128 — runtime kernel must support this).
+    // ========================================================================
+    void *   d_U_K        = nullptr;     // fp16 [n_layers, n_kv, hd, hd]
+
+    void *   layer_k_protected[FRAQTL_MAX_LAYERS] = {nullptr};
+    void *   layer_k_packed   [FRAQTL_MAX_LAYERS] = {nullptr};   // may be null per-layer
+    void *   layer_k_scale    [FRAQTL_MAX_LAYERS] = {nullptr};
+    int32_t  layer_k_ranks    [FRAQTL_MAX_LAYERS][FRAQTL_MAX_KV_HEADS] = {{0}};
+
+    // K-side per-layer descriptor arena. Layout (): desc[h] for
+    // h in [0, NKV) — n_kv elements per layer (was kv_size * n_kv).
+    // Per-slot row pointers are derived in the kernel via
+    // base + slot * slab_stride. Allocated in
+    // fraqtl_runtime_register_layer_k_slabs once slab pointers + kv_size +
+    // ranks are known; freed in clear_layer_slabs / teardown.
+    fraqtl_k_kvh_desc * layer_k_descs[FRAQTL_MAX_LAYERS] = {nullptr};
+
+    // K-side write-time pack hook call counter, parallel to V's
+    // set_rows_hook_calls. Incremented in fraqtl_runtime_pack_k_set_rows_from_src_hook.
+    int32_t  k_set_rows_hook_calls[FRAQTL_MAX_LAYERS] = {0};
+
+    // ========================================================================
+    // sink + recent-residual fp16 wrapper (KIVI/KVQuant insurance).
+    // Default 0/0 = disabled; allocator + read/write paths stay dormant and
+    // path runs unmodified.
+    // When sink_n > 0 OR residual_n > 0:
+    //   - (this phase): per-layer fp16 buffers are allocated in
+    //     fraqtl_runtime_set_step59_config. No reads/writes yet.
+    //   - K_pack / V_pack hooks DOUBLE-WRITE into these buffers.
+    //   - fattn read paths PREFER these buffers when
+    //     slot is in sink range (s < sink_n) or residual range
+    //     (s >= current_kv - residual_n).
+    // Per-layer shape: [HD, sink_n, n_kv_heads] (sink) and
+    //                  [HD, residual_n, n_kv_heads] (residual), fp16.
+    // Indexing convention (locked for ):
+    //   sink_K_buf[L][(kvh * sink_n + s) * HD + d] for s in [0, sink_n)
+    //   residual_K_buf[L][(kvh * residual_n + (s % residual_n)) * HD + d]
+    // Lifecycle: allocated in fraqtl_runtime_set_step59_config (after
+    // fraqtl_runtime_setup populates n_kv / hd / n_layers), freed in
+    // fraqtl_runtime_teardown.
+    // See internal spec
+    // ========================================================================
+    int32_t  sink_n     = 0;   // first N cache positions kept fp16
+    int32_t  residual_n = 0;   // last N cache positions kept fp16 (rolling)
+
+    // Per-layer fp16 buffer pointers. nullptr when sink_n == 0 / residual_n == 0
+    // OR when allocation has not yet happened (e.g. before set_step59_config).
+    half *   sink_K_buf    [FRAQTL_MAX_LAYERS] = {nullptr};
+    half *   sink_V_buf    [FRAQTL_MAX_LAYERS] = {nullptr};
+    half *   residual_K_buf[FRAQTL_MAX_LAYERS] = {nullptr};
+    half *   residual_V_buf[FRAQTL_MAX_LAYERS] = {nullptr};
+
+    // Per-buffer byte counts cached at allocation time so the receipt
+    // can report retained-fp16 accounting without recomputing from
+    // sink_n / residual_n / hd / n_kv. Zeroed when buffers are absent.
+    size_t   sink_K_bytes_per_layer     = 0;
+    size_t   sink_V_bytes_per_layer     = 0;
+    size_t   residual_K_bytes_per_layer = 0;
+    size_t   residual_V_bytes_per_layer = 0;
+    size_t   step59_total_bytes         = 0;   // sum across all layers + all 4 buffers
+
+    // per-layer write counters for the double-write path.
+    // step59_sink_writes_K[L] — cumulative tokens written to sink_K_buf[L]
+    //                             (caps at sink_n in practice; first-time slots only).
+    // step59_residual_writes_K — cumulative tokens written to residual_K_buf[L]
+    //                             (every K cell that arrives via the K hook).
+    // step59_overwrite_K — count of residual writes where slot >= residual_n
+    //                             (i.e., the modular write displaces a prior entry).
+    //                             Invariant: equals max(0, residual_writes - residual_n).
+    //                             A mismatch flags an out-of-order pack call.
+    // V counterparts are symmetric (same semantics, V hook).
+    // step59_write_stats_logged one-shot guard so STEP59_WRITE_STATS is emitted
+    //                            at most once per teardown.
+    int64_t  step59_sink_writes_K     [FRAQTL_MAX_LAYERS] = {0};
+    int64_t  step59_sink_writes_V     [FRAQTL_MAX_LAYERS] = {0};
+    int64_t  step59_residual_writes_K [FRAQTL_MAX_LAYERS] = {0};
+    int64_t  step59_residual_writes_V [FRAQTL_MAX_LAYERS] = {0};
+    int64_t  step59_overwrite_K       [FRAQTL_MAX_LAYERS] = {0};
+    int64_t  step59_overwrite_V       [FRAQTL_MAX_LAYERS] = {0};
+    bool     step59_write_stats_logged = false;
+
+    // ========================================================================
+    //  — singleton Q' workspace (internal memory P0).
+    // Previously fattn.cu:764-766 allocated Q' via ggml_cuda_pool_alloc per
+    // attention call per layer. Receipt at 64K K+V showed +652 MiB compute
+    // scratch growth vs fp16 (1688 → 2340) eating the visible smi savings
+    // from the 1547 MiB KV reduction. Pool retains shape-varying allocs
+    // (prefill n_q=2048 vs decode n_q=1) instead of reusing.
+    // Fix: one shared singleton, grow-as-needed pattern. First Q' call
+    // sizes the buffer to its request; subsequent calls reuse if the
+    // singleton is already large enough, reallocate only if a larger
+    // request arrives (rare — happens once when first max-ubatch prefill
+    // chunk fires).
+    // Acceptance: qprime_alloc_count == 1 at teardown (after warmup).
+    // Thread/stream safety: process-global single-context only in v0.
+    // Multi-context concurrent inference would need a per-context arena;
+    // out of scope for the product config.
+    float *  qprime_workspace             = nullptr;
+    size_t   qprime_workspace_bytes       = 0;
+    size_t   qprime_workspace_peak_bytes  = 0;   // largest size ever requested
+    int64_t  qprime_alloc_count           = 0;   // grow events; want = 1 at teardown
+    int64_t  qprime_get_calls             = 0;   // total fattn.cu hits
+
+    //  memory audit trim state. Counts K dispatches per
+    // process; trims CUDA pool once after the first full forward pass.
+    // Gated by env FRAQTL_MEMORY_AUDIT=1. See
+    // fraqtl_runtime_memory_audit_maybe_trim_post_warmup.
+    int64_t  audit_dispatches_seen        = 0;
+    bool     audit_trim_done              = false;
+
+    //  FraqtlArena integration.
+    // Single owned cudaMalloc that sub-allocates the regions previously
+    // taken by 199 separate cudaMallocs (d_packed/scale/protected, sink+
+    // residual K+V × 28 layers, V+K descriptor arenas × 28 layers, ranks
+    // × 28, qprime singleton). Created in fraqtl_runtime_setup; destroyed
+    // in fraqtl_runtime_teardown. Sub-region pointers below shadow the
+    // existing fields so call sites are unchanged.
+    // Gated by env FRAQTL_USE_ARENA=1. When inactive, original cudaMalloc
+    // path runs (safe rollback). When active, the legacy cudaMallocs are
+    // skipped and arena pointers populate the corresponding fields.
+    fraqtl_arena_t * arena                = nullptr;
+    bool             arena_active         = false;
+    int32_t          arena_n_heads_q_hint = 0;   // populated externally if arena active
+    //  register-call counters so we can emit
+    // the aggregate ARENA_STAGE4_SWAP log once both V and K register loops
+    // finish (V_register and K_register are separate per-layer call paths).
+    int32_t          stage4_v_desc_routed  = 0;
+    int32_t          stage4_k_desc_routed  = 0;
+    int32_t          stage4_k_ranks_routed = 0;
+    bool             stage4_log_emitted    = false;
+    //  Q' workspace singleton swap.
+    // Arena reserved qprime_scratch_bytes at create time; cache the capacity
+    // so get_qprime_workspace can reject oversize requests without crashing.
+    size_t           arena_qprime_capacity_bytes = 0;
+    bool             stage5_log_emitted    = false;
+};
+fraqtl_runtime_state g_fraqtl;
+}  // anonymous namespace
+
+static inline bool fraqtl_strict_v_evict_sync_enabled() {
+    const char * e = std::getenv("FRAQTL_STRICT_V_EVICT");
+    return e && e[0] != '\0' && e[0] != '0';
+}
+
+//  (memory roadmap) — COMPACT V descriptor flag.
+// When enabled, register_layer_slabs builds ONE fraqtl_v_kvh_desc per
+// (layer, kv_head) instead of one fraqtl_v_row_desc per (layer, kv_head,
+// slot). The consumer (fattn-vec / dequantize_V_fraqtl_compact) derives the
+// per-slot row pointers arithmetically. Read once per process. Flag OFF =
+// the legacy per-token descriptor table, byte-for-byte unchanged.
+static inline bool fraqtl_v_desc_compact_enabled() {
+    static const int cached = []() {
+        const char * e = std::getenv("FRAQTL_V_DESC_COMPACT");
+        return (e && e[0] != '\0' && e[0] != '0') ? 1 : 0;
+    }();
+    return cached != 0;
+}
+
+//  (memory roadmap) — COMPACT staging buffers flag.
+// When enabled, the d_packed/d_scale/d_protected staging slabs are sized for
+// one ubatch (max_n_tokens * n_kv rows) instead of the full context
+// (n_ctx * n_kv rows). The per-ubatch pack hook only ever stages one ubatch;
+// full-context staging existed for the Day-11 decode_v_incremental roundtrip,
+// which is dead in ONLINE/product mode. Flag OFF = full-context staging,
+// byte-for-byte unchanged.
+static inline bool fraqtl_staging_compact_enabled() {
+    static const int cached = []() {
+        const char * e = std::getenv("FRAQTL_STAGING_COMPACT");
+        return (e && e[0] != '\0' && e[0] != '0') ? 1 : 0;
+    }();
+    return cached != 0;
+}
+
+static inline int fraqtl_sync_if_not_capturing(cudaStream_t stream, const char * caller, int32_t layer_idx) {
+    if (!fraqtl_strict_v_evict_sync_enabled()) {
+        return 0;
+    }
+
+    cudaStreamCaptureStatus capture_status = cudaStreamCaptureStatusNone;
+    cudaError_t capture_err = cudaStreamIsCapturing(stream, &capture_status);
+    if (capture_err == cudaSuccess && capture_status != cudaStreamCaptureStatusNone) {
+        static unsigned char logged_capture_skip[FRAQTL_MAX_LAYERS] = {0};
+        if (layer_idx >= 0 && layer_idx < FRAQTL_MAX_LAYERS && !logged_capture_skip[layer_idx]) {
+            logged_capture_skip[layer_idx] = 1;
+            fprintf(stderr,
+                "fraqtl: STRICT_V_SYNC_SKIPPED layer=%d caller=%s reason=cuda_graph_capture\n",
+                layer_idx, caller ? caller : "(unknown)");
+            fflush(stderr);
+        }
+        return 0;
+    }
+    if (capture_err != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: %s layer %d cudaStreamIsCapturing failed: %s\n",
+            caller ? caller : "strict_v_sync", layer_idx, cudaGetErrorString(capture_err));
+        fflush(stderr);
+        return 30;
+    }
+
+    cudaError_t sync_err = cudaStreamSynchronize(stream);
+    if (sync_err != cudaSuccess) {
+        fprintf(stderr,
+            "fraqtl: %s layer %d strict sync failed: %s\n",
+            caller ? caller : "strict_v_sync", layer_idx, cudaGetErrorString(sync_err));
+        fflush(stderr);
+        return 30;
+    }
+    return 0;
+}
+
+static inline void fraqtl_runtime_note_v_pack_ok(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    if (g_fraqtl.v_lifetime_state[layer_idx] <
+            (unsigned char) fraqtl_runtime_state::V_COMPRESSED_BUILT) {
+        g_fraqtl.v_lifetime_state[layer_idx] =
+            (unsigned char) fraqtl_runtime_state::V_COMPRESSED_BUILT;
+    }
+    if (!g_fraqtl.v_pack_ok_logged[layer_idx]) {
+        g_fraqtl.v_pack_ok_logged[layer_idx] = 1;
+        fprintf(stderr,
+            "FRAQTL_KV_PACK_OK layer=%d kind=V src_bytes=%zu compressed_bytes=%zu\n",
+            layer_idx,
+            g_fraqtl.v_logical_bytes[layer_idx],
+            g_fraqtl.v_compressed_bytes[layer_idx]);
+        fflush(stderr);
+    }
+}
+
+extern "C" void fraqtl_runtime_mark_v_marker_only(
+    int32_t layer_idx,
+    size_t  marker_bytes,
+    size_t  freed_bytes,
+    size_t  logical_bytes
+) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    if (logical_bytes > 0) {
+        g_fraqtl.v_logical_bytes[layer_idx] = logical_bytes;
+    }
+    g_fraqtl.v_lifetime_state[layer_idx] =
+        (unsigned char) fraqtl_runtime_state::V_MARKER_ONLY;
+    fprintf(stderr,
+        "FRAQTL_KV_EVICT layer=%d kind=V freed_bytes=%zu\n",
+        layer_idx, freed_bytes);
+    if (!g_fraqtl.v_marker_logged[layer_idx]) {
+        g_fraqtl.v_marker_logged[layer_idx] = 1;
+        fprintf(stderr,
+            "FRAQTL_KV_MARKER layer=%d kind=V marker_bytes=%zu logical_bytes=%zu\n",
+            layer_idx, marker_bytes, g_fraqtl.v_logical_bytes[layer_idx]);
+    }
+    fflush(stderr);
+}
+
+extern "C" int fraqtl_runtime_v_is_marker_only(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return 0;
+    return g_fraqtl.v_lifetime_state[layer_idx] >=
+        (unsigned char) fraqtl_runtime_state::V_MARKER_ONLY ? 1 : 0;
+}
+
+extern "C" void fraqtl_runtime_v_note_compressed_route(int32_t layer_idx) {
+    if (layer_idx < 0 || layer_idx >= FRAQTL_MAX_LAYERS) return;
+    if (!g_fraqtl.v_route_logged[layer_idx]) {
+        g_fraqtl.v_route_logged[layer_idx] = 1;
+        fprintf(stderr,
+            "FRAQTL_KV_COMPRESSED_ROUTE layer=%d kind=V\n",
+            layer_idx);
+        fflush(stderr);
+    }
+}
+
+extern "C" void fraqtl_runtime_v_illegal_read_abort(int32_t layer_idx, const char * caller) {
