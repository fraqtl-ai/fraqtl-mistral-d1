+    return __half2float(hf);
+#else
+    // IEEE 754 fp16 → fp32 fallback (no CUDA toolchain).
+    uint32_t sign = (uint32_t)(h & 0x8000) << 16;
+    uint32_t exp  = (h & 0x7C00) >> 10;
+    uint32_t mant = (h & 0x03FF);
+    uint32_t f;
+    if (exp == 0) {
+        f = mant ? sign | (((mant + 0x80) >> 7) << 16) : sign;
+    } else if (exp == 31) {
+        f = sign | 0x7F800000 | (mant << 13);
+    } else {
+        f = sign | ((exp + 112) << 23) | (mant << 13);
+    }
+    float result;
+    std::memcpy(&result, &f, sizeof(float));
+    return result;
+#endif
+}
+
+namespace fraqtl {
+
+namespace {
+
+constexpr int32_t kMagicFRAQ   = 0x46524151;   // 'F' 'R' 'A' 'Q' little-endian
+constexpr int32_t kSupportedVersion = 1;
+
+struct sidecar_header {
+    int32_t magic;
+    int32_t version;
+    int32_t n_layers;
+    int32_t n_kv_heads;
+    int32_t head_dim;
+    int32_t k_protect;
+    int32_t reserved[2];
+};
+static_assert(sizeof(sidecar_header) == 32, "sidecar_header must be exactly 32 bytes");
+
+inline std::string format_err(const std::string & path, const std::string & msg) {
+    return std::string("fraqtl_kv: failed to load sidecar '") + path + "': " + msg;
+}
+
+}  // anonymous namespace
+
+void load_eigenbasis_sidecar(
+    const std::string & path,
+    const llama_model * model,
+    int32_t             requested_k_protect,
+    kv_bundle &         out
+) {
+    // ---- File open + header read ------------------------------------------
+    std::ifstream f(path, std::ios::binary);
+    if (!f) {
+        throw std::runtime_error(format_err(path, std::strerror(errno)));
+    }
+
+    sidecar_header hdr{};
+    f.read(reinterpret_cast<char *>(&hdr), sizeof(hdr));
+    if (!f || f.gcount() != static_cast<std::streamsize>(sizeof(hdr))) {
+        throw std::runtime_error(format_err(path, "short read on header"));
+    }
+
+    if (hdr.magic != kMagicFRAQ) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "bad magic 0x%08x (expected 0x%08x = 'FRAQ')",
+            hdr.magic, kMagicFRAQ);
+        throw std::runtime_error(format_err(path, buf));
+    }
+    if (hdr.version != kSupportedVersion) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "unsupported version %d (this build supports v%d)",
+            hdr.version, kSupportedVersion);
+        throw std::runtime_error(format_err(path, buf));
+    }
+    if (hdr.n_layers <= 0 || hdr.n_kv_heads <= 0 || hdr.head_dim <= 0 || hdr.k_protect < 0) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "invalid dims: n_layers=%d n_kv_heads=%d head_dim=%d k_protect=%d",
+            hdr.n_layers, hdr.n_kv_heads, hdr.head_dim, hdr.k_protect);
+        throw std::runtime_error(format_err(path, buf));
+    }
+    if (hdr.k_protect > hdr.head_dim) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "k_protect=%d exceeds head_dim=%d",
+            hdr.k_protect, hdr.head_dim);
+        throw std::runtime_error(format_err(path, buf));
+    }
+
+    // ---- Validate against model hparams -----------------------------------
+    if (model) {
+        const auto & hp = model->hparams;
+
+        // For GQA models, sidecar is per-KV-head (locked recipe). Use layer 0
+        // as the canonical reference; fail if any layer disagrees with the
+        // sidecar's n_kv_heads.
+        const int model_n_kv_heads = static_cast<int>(hp.n_head_kv(0));
+        const int model_head_dim   = static_cast<int>(hp.n_embd_head_v(0));
+        const int model_n_layers   = static_cast<int>(hp.n_layer);
+
+        if (hdr.n_kv_heads != model_n_kv_heads) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "n_kv_heads mismatch: sidecar=%d model=%d "
+                "(sidecar must be calibrated per-KV-head, NOT per-Q-head — "
+                "Qwen 3.6 = 8, NOT 128)",
+                hdr.n_kv_heads, model_n_kv_heads);
+            throw std::runtime_error(format_err(path, buf));
+        }
+        if (hdr.head_dim != model_head_dim) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "head_dim mismatch: sidecar=%d model=%d",
+                hdr.head_dim, model_head_dim);
+            throw std::runtime_error(format_err(path, buf));
+        }
+        if (hdr.n_layers != model_n_layers) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "n_layers mismatch: sidecar=%d model=%d",
+                hdr.n_layers, model_n_layers);
+            throw std::runtime_error(format_err(path, buf));
+        }
+    } else {
+        LLAMA_LOG_WARN("%s: model is null — skipping hparams validation\n", __func__);
+    }
+
+    // Resolve effective K: CLI/cparams `requested_k_protect` is authoritative
+    // for runtime. Sidecar's hdr.k_protect is INFORMATIONAL/compat metadata.
+    // The eigenbasis U is K-independent (a full HD×HD orthonormal rotation),
+    // so any K satisfying (K > 0, K <= head_dim, K % 8 == 0) is mathematically
+    // valid regardless of what K the sidecar was calibrated at.
+    // Prior behavior (silently overwriting requested_k with hdr.k_protect)
+    // hid the CLI flag from the runtime path and made every --fraqtl-kv-protect
+    // value collapse to the sidecar header's K (root cause).
+    int32_t effective_k = (requested_k_protect > 0) ? requested_k_protect : hdr.k_protect;
+    if (effective_k <= 0 || effective_k > hdr.head_dim || (effective_k % 8) != 0) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "invalid effective k_protect=%d (must satisfy 0 < K <= head_dim=%d "
+            "AND K %% 8 == 0 for the descriptor path); "
+            "requested=%d, sidecar_header_k=%d",
+            effective_k, hdr.head_dim, requested_k_protect, hdr.k_protect);
+        throw std::runtime_error(format_err(path, buf));
+    }
+    if (requested_k_protect > 0 && requested_k_protect != hdr.k_protect) {
+        LLAMA_LOG_INFO(
+            "%s: requested k_protect=%d differs from sidecar header k_protect=%d; "
+            "using requested=%d (eigenbasis is K-independent so this is valid).\n",
+            __func__, requested_k_protect, hdr.k_protect, effective_k
+        );
+    }
+
+    // ---- Read U data into host buffer -------------------------------------
+    const size_t n_elements = static_cast<size_t>(hdr.n_layers)
+                            * static_cast<size_t>(hdr.n_kv_heads)
+                            * static_cast<size_t>(hdr.head_dim)
+                            * static_cast<size_t>(hdr.head_dim);
+    const size_t bytes = n_elements * sizeof(uint16_t);   // fp16 = uint16_t
+
+    std::vector<uint16_t> host_buf(n_elements);
+    f.read(reinterpret_cast<char *>(host_buf.data()), static_cast<std::streamsize>(bytes));
+    if (!f || static_cast<size_t>(f.gcount()) != bytes) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "short read on U data: expected %zu bytes, got %zu",
+            bytes, static_cast<size_t>(f.gcount()));
+        throw std::runtime_error(format_err(path, buf));
+    }
+
+    // Reject trailing data — silent corruption guard.
+    f.peek();
+    if (!f.eof()) {
+        throw std::runtime_error(format_err(path, "trailing data after U block"));
+    }
+
+    // ---- cudaMalloc + memcpy (CUDA-only path; CPU build no-ops below) -----
+#ifdef GGML_USE_CUDA
+    void * d_ptr = nullptr;
+    cudaError_t e = cudaMalloc(&d_ptr, bytes);
+    if (e != cudaSuccess) {
+        throw std::runtime_error(
+            format_err(path, std::string("cudaMalloc failed: ") + cudaGetErrorString(e))
+        );
+    }
+    e = cudaMemcpy(d_ptr, host_buf.data(), bytes, cudaMemcpyHostToDevice);
+    if (e != cudaSuccess) {
+        cudaFree(d_ptr);
+        throw std::runtime_error(
+            format_err(path, std::string("cudaMemcpy failed: ") + cudaGetErrorString(e))
+        );
+    }
+    out.d_eigenbasis = d_ptr;
+#else
+    // CPU build: there is no kernel without CUDA. Surface the constraint
+    // clearly rather than silently dropping the sidecar.
+    throw std::runtime_error(format_err(path,
+        "fraqtl_kv requires a CUDA build (GGML_USE_CUDA=ON)"));
+#endif
+
+    out.n_layers   = hdr.n_layers;
+    out.n_kv_heads = hdr.n_kv_heads;
+    out.head_dim   = hdr.head_dim;
+    out.k_protect  = effective_k;        // was hdr.k_protect (silent override bug)
+    out.bytes      = bytes;
+    out.loaded     = true;
+
+    LLAMA_LOG_INFO(
+        "%s: loaded fraQtl eigenbasis sidecar (n_layers=%d, n_kv_heads=%d, "
+        "head_dim=%d, sidecar_header_k=%d, requested_k=%d, effective_runtime_k=%d, "
+        "%.2f MiB on GPU)\n",
+        __func__, hdr.n_layers, hdr.n_kv_heads, hdr.head_dim,
+        hdr.k_protect, requested_k_protect, effective_k,
+        static_cast<double>(bytes) / (1024.0 * 1024.0)
+    );
+}
+
+void free_kv_bundle(kv_bundle & bundle) {
+    if (!bundle.loaded || bundle.d_eigenbasis == nullptr) {
+        return;
+    }
+#ifdef GGML_USE_CUDA
+    cudaFree(bundle.d_eigenbasis);
+#endif
+    bundle.d_eigenbasis = nullptr;
+    bundle.bytes        = 0;
+    bundle.loaded       = false;
+}
+
+// ============================================================================
+// K sidecar loader.
+// Wire format spec at docs/fraqtl-kv-step5-7b-scope.md. Header invariants:
+//   magic == 0x4B514152 ('RAQK' little-endian)
+//   version == 1
+//   header size == 32 bytes
+// Hard-fails on every malformed condition (internal review lock — fail-closed). The
+// caller (llama-context.cpp) catches and disables K runtime; V-only path
+// continues unchanged.
+// ============================================================================
+namespace {
+
+constexpr int32_t kKMagicRAQK       = 0x4B514152;
+constexpr int32_t kKSupportedVersion = 1;
+
+struct k_sidecar_header {
+    int32_t magic;
+    int32_t version;
+    int32_t n_layers;
+    int32_t n_kv_heads;
+    int32_t head_dim;
+    int32_t reserved[3];
+};
+static_assert(sizeof(k_sidecar_header) == 32,
+              "k_sidecar_header must be exactly 32 bytes");
+
+inline std::string format_k_err(const std::string & path, const std::string & msg) {
+    return std::string("fraqtl_k: failed to load K sidecar '") + path + "': " + msg;
+}
+
+}  // anonymous namespace
+
+void load_k_eigenbasis_sidecar(
+    const std::string & path,
+    const llama_model * model,
+    k_bundle &          out
+) {
+    // ---- File open + header read -------------------------------------------
+    std::ifstream f(path, std::ios::binary);
+    if (!f) {
+        throw std::runtime_error(format_k_err(path, std::strerror(errno)));
+    }
+
+    k_sidecar_header hdr{};
+    f.read(reinterpret_cast<char *>(&hdr), sizeof(hdr));
+    if (!f || f.gcount() != static_cast<std::streamsize>(sizeof(hdr))) {
+        throw std::runtime_error(format_k_err(path, "short read on header"));
+    }
+
+    if (hdr.magic != kKMagicRAQK) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "bad magic 0x%08x (expected 0x%08x = 'RAQK')",
+            hdr.magic, kKMagicRAQK);
+        throw std::runtime_error(format_k_err(path, buf));
+    }
+    if (hdr.version != kKSupportedVersion) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "unsupported K sidecar version %d (this build supports v%d)",
+            hdr.version, kKSupportedVersion);
+        throw std::runtime_error(format_k_err(path, buf));
+    }
+    if (hdr.n_layers <= 0 || hdr.n_kv_heads <= 0 || hdr.head_dim <= 0) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "invalid dims: n_layers=%d n_kv_heads=%d head_dim=%d",
+            hdr.n_layers, hdr.n_kv_heads, hdr.head_dim);
+        throw std::runtime_error(format_k_err(path, buf));
+    }
+
+    // ---- Validate against model hparams -----------------------------------
+    if (model) {
+        const auto & hp = model->hparams;
+        const int model_n_kv_heads = static_cast<int>(hp.n_head_kv(0));
+        const int model_head_dim_k = static_cast<int>(hp.n_embd_head_k(0));
+        const int model_n_layers   = static_cast<int>(hp.n_layer);
+
+        if (hdr.n_kv_heads != model_n_kv_heads) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "n_kv_heads mismatch: K sidecar=%d model=%d",
+                hdr.n_kv_heads, model_n_kv_heads);
+            throw std::runtime_error(format_k_err(path, buf));
+        }
+        if (hdr.head_dim != model_head_dim_k) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "head_dim mismatch: K sidecar=%d model_n_embd_head_k=%d",
+                hdr.head_dim, model_head_dim_k);
+            throw std::runtime_error(format_k_err(path, buf));
+        }
+        if (hdr.n_layers != model_n_layers) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "n_layers mismatch: K sidecar=%d model=%d",
+                hdr.n_layers, model_n_layers);
+            throw std::runtime_error(format_k_err(path, buf));
+        }
+    } else {
+        LLAMA_LOG_WARN("%s: model is null — skipping hparams validation\n", __func__);
+    }
+
+    // ---- Read ranks (int32 array, n_layers * n_kv_heads) ------------------
+    const size_t n_ranks       = static_cast<size_t>(hdr.n_layers)
+                               * static_cast<size_t>(hdr.n_kv_heads);
+    const size_t ranks_bytes   = n_ranks * sizeof(int32_t);
+    std::vector<int32_t> ranks(n_ranks);
+    f.read(reinterpret_cast<char *>(ranks.data()),
+           static_cast<std::streamsize>(ranks_bytes));
+    if (!f || static_cast<size_t>(f.gcount()) != ranks_bytes) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "short read on ranks: expected %zu bytes, got %zu",
+            ranks_bytes, static_cast<size_t>(f.gcount()));
+        throw std::runtime_error(format_k_err(path, buf));
+    }
+
+    // Per-(layer, kv_head) rank validation — internal review-locked range.
+    //  — lowered the rank floor from 24 to 8 to allow the S2 exp16
+    // recipe (K rank=16 + INT3 tail, 3.46x compression). The 24 floor was a
+    // QA gate inherited from the development period when only INT4
+    // tail was supported and < 24 caused noticeable PPL drift. With the K
+    // INT3 dispatch landed (commit 214f205bc) and the internal's K rank=16
+    // sidecar receipt (SHA fd5a3eaf, +0.024 PPL on Mistral 7B exp16), R=16
+    // is the production target. Floor at 8 keeps a safety net against
+    // degenerate sidecars (R<8 would have <50% protected variance).
+    int rmin = hdr.head_dim, rmax = 0;
+    long sum_r = 0;
+    for (size_t i = 0; i < n_ranks; ++i) {
+        const int r = ranks[i];
+        if (r < 8 || r > hdr.head_dim) {
+            char buf[256];
+            std::snprintf(buf, sizeof(buf),
+                "rank out of range at index %zu (layer %zu, kvh %zu): "
+                "rank=%d not in [8, head_dim=%d]",
+                i, i / static_cast<size_t>(hdr.n_kv_heads),
+                   i % static_cast<size_t>(hdr.n_kv_heads),
+                r, hdr.head_dim);
+            throw std::runtime_error(format_k_err(path, buf));
+        }
+        if (r < rmin) rmin = r;
+        if (r > rmax) rmax = r;
+        sum_r += r;
+    }
+    const double ravg = (n_ranks > 0) ? (double) sum_r / (double) n_ranks : 0.0;
+
+    // ---- Read U_K arena (fp16) --------------------------------------------
+    const size_t n_uk_elements = static_cast<size_t>(hdr.n_layers)
+                               * static_cast<size_t>(hdr.n_kv_heads)
+                               * static_cast<size_t>(hdr.head_dim)
+                               * static_cast<size_t>(hdr.head_dim);
+    const size_t uk_bytes      = n_uk_elements * sizeof(uint16_t);  // fp16 = uint16_t
+
+    std::vector<uint16_t> uk_host(n_uk_elements);
+    f.read(reinterpret_cast<char *>(uk_host.data()),
+           static_cast<std::streamsize>(uk_bytes));
+    if (!f || static_cast<size_t>(f.gcount()) != uk_bytes) {
+        char buf[256];
+        std::snprintf(buf, sizeof(buf),
+            "short read on U_K: expected %zu bytes, got %zu",
+            uk_bytes, static_cast<size_t>(f.gcount()));
+        throw std::runtime_error(format_k_err(path, buf));
+    }
+
+    // Trailing-data rejection — silent corruption guard.
+    f.peek();
+    if (!f.eof()) {
+        throw std::runtime_error(format_k_err(path, "trailing data after U_K block"));
+    }
+
+    // ============================================================================
+    // Diagnostic A (internal, ).
+    // Sanity-check U_K orthonormality post-load. The fattn diagnostic
+    // showed C_K coefficients of magnitude ~466 (Layer 0 row 0 col 0) which
+    // is 8× higher than what an orthonormal U_K projection of a typical Qwen
+    // K vector should produce. Either:
+    //   (1) U_K is not orthonormal (sidecar / converter bug)
+    //   (2) The K source tensor magnitude is wrong (Diagnostic C)
+    // This block reads U_K from the host buffer (uk_host, fp16-as-uint16_t)
+    // for 4 sample (layer, kvh) pairs and computes:
+    //   - per-column L2 norm: should be 1.0 ± 1e-3 for orthonormal
+    //   - max off-diagonal of U_K.T @ U_K: should be < 1e-2 for orthonormal
+    // Sample points: (0, 0), (0, n_kv-1), (n_layers/2, 0), (n_layers-1, 0).
+    // Logged as one line per sample so the harness can grep them.
+    // ============================================================================
+    {
+        const int sample_kvh_max     = (hdr.n_kv_heads > 1) ? hdr.n_kv_heads - 1 : 0;
+        const int sample_layer_mid   = hdr.n_layers / 2;
+        const int sample_layer_last  = hdr.n_layers - 1;
+        const int sample_pairs[][2] = {
+            {0,                 0},
+            {0,                 sample_kvh_max},
+            {sample_layer_mid,  0},
+            {sample_layer_last, 0},
+        };
+        const int n_samples = sizeof(sample_pairs) / sizeof(sample_pairs[0]);
+
+        for (int s = 0; s < n_samples; ++s) {
+            const int L  = sample_pairs[s][0];
+            const int H  = sample_pairs[s][1];
+            const size_t base =
+                (((size_t) L * hdr.n_kv_heads) + (size_t) H)
+                * (size_t) hdr.head_dim * (size_t) hdr.head_dim;
+
+            // Per-column L2 norm: sum_d U_K[d, c]^2 then sqrt. Column c uses
+            // index base + d * head_dim + c per row-major [d, c] layout.
+            float col_norm_min = 1e30f;
+            float col_norm_max = -1.0f;
+            float col_norm_sum = 0.0f;
+            for (int c = 0; c < hdr.head_dim; ++c) {
+                float n2 = 0.0f;
+                for (int d = 0; d < hdr.head_dim; ++d) {
+                    const float v = fraqtl_fp16_to_fp32_host(
+                        uk_host[base + (size_t) d * hdr.head_dim + c]);
+                    n2 += v * v;
+                }
+                const float n = sqrtf(n2);
+                if (n < col_norm_min) col_norm_min = n;
+                if (n > col_norm_max) col_norm_max = n;
+                col_norm_sum += n;
+            }
+            const float col_norm_mean = col_norm_sum / (float) hdr.head_dim;
+
+            // Max off-diagonal of U_K.T @ U_K, taking the worst absolute
+            // value over c1 < c2 pairs. (UK.T @ UK)[c1, c2] = sum_d
+            // U_K[d, c1] * U_K[d, c2]. For orthonormal U_K this is δ_{c1,c2}.
+            float off_diag_max = 0.0f;
+            const int hd = hdr.head_dim;
+            for (int c1 = 0; c1 < hd; ++c1) {
+                for (int c2 = c1 + 1; c2 < hd; ++c2) {
+                    float dot = 0.0f;
+                    for (int d = 0; d < hd; ++d) {
+                        const float v1 = fraqtl_fp16_to_fp32_host(
+                            uk_host[base + (size_t) d * hd + c1]);
+                        const float v2 = fraqtl_fp16_to_fp32_host(
+                            uk_host[base + (size_t) d * hd + c2]);
+                        dot += v1 * v2;
+                    }
+                    if (fabsf(dot) > off_diag_max) off_diag_max = fabsf(dot);
+                }
+            }
+
+            const bool norms_ok    = (col_norm_min >= 0.99f && col_norm_max <= 1.01f);
+            const bool offdiag_ok  = (off_diag_max <= 1e-2f);
+            const char * verdict   = (norms_ok && offdiag_ok) ? "OK" : "WARN";
+
+            fprintf(stderr,
+                "fraqtl: U_K_SANITY layer=%d kvh=%d "
+                "col_norm_min=%.6f col_norm_max=%.6f col_norm_mean=%.6f "
+                "off_diag_max=%.6e verdict=%s\n",
+                L, H,
+                col_norm_min, col_norm_max, col_norm_mean,
+                off_diag_max, verdict);
+            fflush(stderr);
+        }
+    }
+
+    // ============================================================================
+    // Diagnostic A++ : full U_K finite sweep.
+    // internal (). per-kvh K_SCORE_PARITY found
+    // layer 27 kvh=1 produces score_prot = NaN on the host-side standalone
+    // dot. Sampled U_K_SANITY only covered (0,0), (0,n_kv-1), (mid,0),
+    // (last,0) — kvh=1 of layer 27 was NOT one of them.
+    // Sweep every (layer, kvh): count NaN, count Inf, compute max_abs.
+    // First-bad-index dumped only for non-finite pairs.
+    // Decision matrix:
+    //   any NaN/Inf in U_K → sidecar/calibration bug (do not touch runtime)
+    //   all finite → bug is in K_src, pack kernel, or harness
+    // ============================================================================
+    {
+        const int hd = hdr.head_dim;
+        const size_t per_head = (size_t) hd * (size_t) hd;
+        long long total_nan = 0, total_inf = 0;
+        int       bad_pairs = 0;
+        float     uk_global_max_abs = 0.0f;
+        for (int L = 0; L < (int) hdr.n_layers; ++L) {
+            for (int H = 0; H < (int) hdr.n_kv_heads; ++H) {
+                const size_t base =
+                    (((size_t) L * hdr.n_kv_heads) + (size_t) H) * per_head;
+                long long n_nan = 0, n_inf = 0;
+                float     max_abs = 0.0f;
