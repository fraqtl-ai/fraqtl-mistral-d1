+namespace {
+
+constexpr int BLOCK_THREADS = 128;
+
+template <typename T>
+__device__ inline T fp32_to_out(float x);
+template <> __device__ inline half  fp32_to_out<half> (float x) { return __float2half(x); }
+template <> __device__ inline float fp32_to_out<float>(float x) { return x; }
+
+// ---------------------------------------------------------------------------
+// Production unpack: uniform-symmetric INT3.
+// Grid: one block per (b, kv_head, s). Block: BLOCK_THREADS threads.
+// Shared memory: HD floats — reconstructed eigenbasis vector C[i].
+// Per row:
+//   1. Load v_protected[..., 0:K] → C[0:K] (fp16 → fp32 promote)
+//   2. Unpack INT3 indices, dequant: C[K + e] = (idx[e] - 4) * scale
+//   3. v_out[..., d] = sum_i C[i] * U[kvh, d, i] (un-rotate via U^T)
+// ---------------------------------------------------------------------------
+
+template <typename TOut>
+__global__ void fraqtl_kv_unpack_kernel(
+    const half*    __restrict__ v_protected,
+    const uint8_t* __restrict__ v_packed,
+    const float*   __restrict__ v_scale,
+    const half*    __restrict__ U,
+    TOut*          __restrict__ v_out,
+    int B, int NKV, int S, int HD, int K
+) {
+    extern __shared__ float C_shared[];
+
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+
+    const int tid = threadIdx.x;
+
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        C_shared[i] = __half2float(v_protected[prot_row_base + i]);
+    }
+
+    const uint8_t* packed_row = v_packed + row * packed_bytes;
+    const float    scale      = v_scale[row];
+
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        const uint8_t b0 = packed_row[g * 3 + 0];
+        const uint8_t b1 = packed_row[g * 3 + 1];
+        const uint8_t b2 = packed_row[g * 3 + 2];
+
+        int v[8];
+        v[0] = (b0 >> 5) & 7;
+        v[1] = (b0 >> 2) & 7;
+        v[2] = ((b0 & 0x3) << 1) | ((b1 >> 7) & 1);
+        v[3] = (b1 >> 4) & 7;
+        v[4] = (b1 >> 1) & 7;
+        v[5] = ((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3);
+        v[6] = (b2 >> 3) & 7;
+        v[7] =  b2       & 7;
+
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                C_shared[K + e] = ((float) v[j] - 4.0f) * scale;
+            }
+        }
+    }
+    __syncthreads();
+
+    const int   out_row_base = ((b * NKV + kvh) * S + s) * HD;
+    const half* U_head       = U + kvh * HD * HD;
+
+    for (int d = tid; d < HD; d += blockDim.x) {
+        const half* U_row = U_head + d * HD;
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += C_shared[i] * __half2float(U_row[i]);
+        }
+        v_out[out_row_base + d] = fp32_to_out<TOut>(acc);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Production pack: V → V_rot → top-K fp16 + INT3 sacrifice.
+// Mirrors fraqtl/packing.py::quantize_and_pack_int3 byte-for-byte.
+// Shared memory layout:
+//   [0 .. HD-1 ] C_shared V_rot
+//   [HD ] scale_bcast broadcast scale after reduce
+//   [HD+1 .. HD+BT ] reduce_buf per-thread max-abs partials
+// ---------------------------------------------------------------------------
+
+__global__ void fraqtl_kv_pack_kernel(
+    const half*    __restrict__ v_in,
+    half*          __restrict__ v_protected,
+    uint8_t*       __restrict__ v_packed,
+    float*         __restrict__ v_scale,
+    const half*    __restrict__ U,
+    int B, int NKV, int S, int HD, int K
+) {
+    extern __shared__ float smem[];
+    float* C_shared    = smem;
+    float* scale_bcast = smem + HD;
+    float* reduce_buf  = smem + HD + 1;
+
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+
+    const int tid = threadIdx.x;
+
+    // ---- V_rot[d] = sum_i V_in[i] * U[i, d] ----------------------
+    // U[NKV, HD, HD]: U_head[i, d] at offset i*HD + d.
+    const int   in_row_base = ((b * NKV + kvh) * S + s) * HD;
+    const half* U_head      = U + kvh * HD * HD;
+
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += __half2float(v_in[in_row_base + i]) * __half2float(U_head[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    // ---- write protected[0:K] ------------------------------------
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[prot_row_base + i] = __float2half(C_shared[i]);
+    }
+
+    // ---- scale = max(|sac|) / 3 (block-wide max-abs reduce) ------
+    // Mirrors packing.py:48 (h=4, h-1=3).
+    float local_max = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float a = fabsf(C_shared[d]);
+        if (a > local_max) local_max = a;
+    }
+    reduce_buf[tid] = local_max;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            const float other = reduce_buf[tid + stride];
+            if (other > reduce_buf[tid]) reduce_buf[tid] = other;
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        float scale = reduce_buf[0] / 3.0f;
+        if (scale < 1e-10f) scale = 1e-10f;     // packing.py:49 clamp
+        scale_bcast[0] = scale;
+        v_scale[row]   = scale;
+    }
+    __syncthreads();
+    const float scale = scale_bcast[0];
+
+    // ---- quantize sacrifice + pack 8-into-3 ----------------------
+    uint8_t* packed_row = v_packed + row * packed_bytes;
+
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        int idx[8] = {0};   // pad zeros for unused slots (matches packing.py F.pad)
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                // packing.py:50: round, clamp(-4, 3), then +4 to unsigned 0..7.
+                int q = (int) rintf(C_shared[K + e] / scale);
+                if (q < -4) q = -4;
+                if (q >  3) q =  3;
+                idx[j] = q + 4;
+            }
+        }
+        // Pack 8 indices into 3 bytes (mirrors packing.py:70-72).
+        const uint8_t b0 = (idx[0] << 5) | (idx[1] << 2) | (idx[2] >> 1);
+        const uint8_t b1 = ((idx[2] & 1) << 7) | (idx[3] << 4) |
+                           (idx[4] << 1) | (idx[5] >> 2);
+        const uint8_t b2 = ((idx[5] & 0x3) << 6) | (idx[6] << 3) | idx[7];
+        packed_row[g * 3 + 0] = b0;
+        packed_row[g * 3 + 1] = b1;
+        packed_row[g * 3 + 2] = b2;
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Legacy: Lloyd-Max + 1-bit sign correction. Debug fallback.
+// Same shared-memory layout pattern as production but with centroid lookup,
+// std reduction, and sign bitmap.
+// ---------------------------------------------------------------------------
+
+__device__ inline void compute_cell_widths(const float* sorted_c, float* cell_w) {
+    float boundaries[7];
+    #pragma unroll
+    for (int i = 0; i < 7; ++i) {
+        boundaries[i] = (sorted_c[i] + sorted_c[i + 1]) * 0.5f;
+    }
+    cell_w[0] = 2.0f * fabsf(boundaries[0] - sorted_c[0]);
+    cell_w[7] = 2.0f * fabsf(sorted_c[7] - boundaries[6]);
+    #pragma unroll
+    for (int i = 1; i < 7; ++i) {
+        cell_w[i] = boundaries[i] - boundaries[i - 1];
+    }
+}
+
+template <typename TOut>
+__global__ void fraqtl_kv_unpack_kernel_lms(
+    const half*    __restrict__ v_protected,
+    const uint8_t* __restrict__ v_packed,
+    const uint8_t* __restrict__ v_sign_mask,
+    const float*   __restrict__ v_sigma,
+    const float*   __restrict__ centroids,
+    const half*    __restrict__ U,
+    TOut*          __restrict__ v_out,
+    int B, int NKV, int S, int HD, int K
+) {
+    extern __shared__ float smem[];
+    float* C_shared = smem;
+    float* sorted_c = smem + HD;
+    float* cell_w   = smem + HD + 8;
+
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+    const int sign_bytes    = padded_groups;
+
+    const int tid = threadIdx.x;
+    if (tid < 8) sorted_c[tid] = centroids[kvh * 8 + tid];
+    __syncthreads();
+    if (tid == 0) compute_cell_widths(sorted_c, cell_w);
+    __syncthreads();
+
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        C_shared[i] = __half2float(v_protected[prot_row_base + i]);
+    }
+
+    const uint8_t* packed_row = v_packed    + row * packed_bytes;
+    const uint8_t* sign_row   = v_sign_mask + row * sign_bytes;
+    const float    sigma      = v_sigma[row];
+
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        const uint8_t b0 = packed_row[g * 3 + 0];
+        const uint8_t b1 = packed_row[g * 3 + 1];
+        const uint8_t b2 = packed_row[g * 3 + 2];
+        const uint8_t sb = sign_row[g];
+
+        int idx[8];
+        idx[0] = (b0 >> 5) & 7;
+        idx[1] = (b0 >> 2) & 7;
+        idx[2] = ((b0 & 0x3) << 1) | ((b1 >> 7) & 1);
+        idx[3] = (b1 >> 4) & 7;
+        idx[4] = (b1 >> 1) & 7;
+        idx[5] = ((b1 & 0x1) << 2) | ((b2 >> 6) & 0x3);
+        idx[6] = (b2 >> 3) & 7;
+        idx[7] =  b2       & 7;
+
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                const int   sign_bit = (sb >> (7 - j)) & 1;
+                const float sign_pm1 = sign_bit ? +1.0f : -1.0f;
+                const float cv       = sorted_c[idx[j]];
+                const float cw       = cell_w[idx[j]];
+                C_shared[K + e] = (cv + sign_pm1 * cw * 0.25f) * sigma;
+            }
+        }
+    }
+    __syncthreads();
+
+    const int   out_row_base = ((b * NKV + kvh) * S + s) * HD;
+    const half* U_head       = U + kvh * HD * HD;
+    for (int d = tid; d < HD; d += blockDim.x) {
+        const half* U_row = U_head + d * HD;
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += C_shared[i] * __half2float(U_row[i]);
+        }
+        v_out[out_row_base + d] = fp32_to_out<TOut>(acc);
+    }
+}
+
+__global__ void fraqtl_kv_pack_kernel_lms(
+    const half*    __restrict__ v_in,
+    half*          __restrict__ v_protected,
+    uint8_t*       __restrict__ v_packed,
+    uint8_t*       __restrict__ v_sign_mask,
+    float*         __restrict__ v_sigma,
+    const float*   __restrict__ centroids,
+    const half*    __restrict__ U,
+    int B, int NKV, int S, int HD, int K
+) {
+    extern __shared__ float smem[];
+    float* C_shared    = smem;
+    float* sorted_c    = smem + HD;
+    float* sigma_bcast = smem + HD + 8;
+    float* reduce_buf  = smem + HD + 8 + 1;
+
+    const int row = blockIdx.x;
+    if (row >= B * NKV * S) return;
+    const int s   = row % S;
+    const int kvh = (row / S) % NKV;
+    const int b   = row / (S * NKV);
+
+    const int sac_dims      = HD - K;
+    const int padded_groups = (sac_dims + 7) / 8;
+    const int packed_bytes  = padded_groups * 3;
+    const int sign_bytes    = padded_groups;
+
+    const int tid = threadIdx.x;
+    if (tid < 8) sorted_c[tid] = centroids[kvh * 8 + tid];
+    __syncthreads();
+
+    const int   in_row_base = ((b * NKV + kvh) * S + s) * HD;
+    const half* U_head      = U + kvh * HD * HD;
+    for (int d = tid; d < HD; d += blockDim.x) {
+        float acc = 0.0f;
+        for (int i = 0; i < HD; ++i) {
+            acc += __half2float(v_in[in_row_base + i]) * __half2float(U_head[i * HD + d]);
+        }
+        C_shared[d] = acc;
+    }
+    __syncthreads();
+
+    const int prot_row_base = ((b * NKV + kvh) * S + s) * K;
+    for (int i = tid; i < K; i += blockDim.x) {
+        v_protected[prot_row_base + i] = __float2half(C_shared[i]);
+    }
+
+    float local_sum = 0.0f, local_sumsq = 0.0f;
+    for (int d = K + tid; d < HD; d += blockDim.x) {
+        const float v = C_shared[d];
+        local_sum   += v;
+        local_sumsq += v * v;
+    }
+    reduce_buf[tid]                 = local_sum;
+    reduce_buf[tid + BLOCK_THREADS] = local_sumsq;
+    __syncthreads();
+    for (int stride = BLOCK_THREADS / 2; stride > 0; stride >>= 1) {
+        if (tid < stride) {
+            reduce_buf[tid]                 += reduce_buf[tid + stride];
+            reduce_buf[tid + BLOCK_THREADS] += reduce_buf[tid + BLOCK_THREADS + stride];
+        }
+        __syncthreads();
+    }
+    if (tid == 0) {
+        const float total_sum   = reduce_buf[0];
+        const float total_sumsq = reduce_buf[BLOCK_THREADS];
+        const int   N           = sac_dims;
+        const float mean        = total_sum / (float) N;
+        float var = (total_sumsq - total_sum * mean) / (float)(N - 1);
+        if (var < 0.0f) var = 0.0f;
+        float sigma = sqrtf(var);
+        if (sigma < 1e-10f) sigma = 1e-10f;
+        sigma_bcast[0] = sigma;
+        v_sigma[row]   = sigma;
+    }
+    __syncthreads();
+    const float sigma = sigma_bcast[0];
+
+    uint8_t* packed_row = v_packed    + row * packed_bytes;
+    uint8_t* sign_row   = v_sign_mask + row * sign_bytes;
+
+    for (int g = tid; g < padded_groups; g += blockDim.x) {
+        int group_idx [8] = {0};
+        int group_sign[8] = {0};
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) {
+            const int e = g * 8 + j;
+            if (e < sac_dims) {
+                const float wn = C_shared[K + e] / sigma;
+                int idx_r = 8;
+                #pragma unroll
+                for (int c = 0; c < 8; ++c) {
+                    if (sorted_c[c] >= wn) { idx_r = c; break; }
+                }
+                if (idx_r < 1) idx_r = 1;
+                if (idx_r > 7) idx_r = 7;
+                const int   idx_l = idx_r - 1;
+                const float dl    = fabsf(wn - sorted_c[idx_l]);
+                const float dr    = fabsf(sorted_c[idx_r] - wn);
+                const int   assign = (dl < dr) ? idx_l : idx_r;
+                group_idx[j]  = assign;
+                group_sign[j] = ((wn - sorted_c[assign]) >= 0.0f) ? 1 : 0;
+            }
+        }
+        const uint8_t b0 = (group_idx[0] << 5) | (group_idx[1] << 2) | (group_idx[2] >> 1);
+        const uint8_t b1 = ((group_idx[2] & 1) << 7) | (group_idx[3] << 4) |
+                           (group_idx[4] << 1) | (group_idx[5] >> 2);
+        const uint8_t b2 = ((group_idx[5] & 0x3) << 6) | (group_idx[6] << 3) | group_idx[7];
+        packed_row[g * 3 + 0] = b0;
+        packed_row[g * 3 + 1] = b1;
+        packed_row[g * 3 + 2] = b2;
+
+        uint8_t sb = 0;
+        #pragma unroll
+        for (int j = 0; j < 8; ++j) sb |= (group_sign[j] & 1) << (7 - j);
+        sign_row[g] = sb;
+    }
+}
+
+}  // anonymous namespace
