index 000000000..6b3c83015
--- /dev/null
+++ b/ggml/src/ggml-cuda/fraqtl-kv.cuh
@@ -0,0 +1,881 @@
+// fraQtl V cache compression — CUDA kernel signatures.
+// Production format: uniform-symmetric INT3 (matches fraqtl/packing.py and
+// the runtime PackedKVCache). Per-row scale = max(|sac|) / 3; indices stored
+// unsigned 0..7 (= signed level + 4); dequant = (unsigned - 4) * scale.
+// Locked recipe — V cache compression at runtime uses uniform, NOT Lloyd-Max.
+// LM+sign is the WEIGHT-compression recipe (offline, with GPTQ-style error
+// feedback). On runtime V cache (no future-token feedback to compensate), LM
+// drifts ~7× worse than uniform per the locked memory rule. See
+// feedback_lloydmax_runtime_vs_weight.md.
+// Per-row math (one row = one (b, kv_head, s) tuple):
+//     scale = sac.abs().amax(-1).clamp(1e-10) / 3 // h-1 = 3
+//     idx_signed = round(sac / scale).clamp(-4, 3)
+//     idx_unsigned = idx_signed + 4 // 0..7
+//     <pack 8 idx_unsigned per 3 bytes via packing.py:64-75>
+//     <unpack via packing.py:97-105 + (unsigned - 4) * scale>
+// LM+sign kernels retained as `_lloyd_max_sign_legacy` for debug only — will
+// only be reactivated if a math-agent ablation shows offline-LM beats uniform
+// on V cache PPL/NIAH at matched bits.
+
+#pragma once
+
+#include <cuda_fp16.h>
+#include <cstdint>
+
+extern "C" {
+
+// =============================================================================
+// Production: uniform-symmetric INT3 (matches PackedKVCache).
+// =============================================================================
+
+//   v_protected [B, NKV, S, K] fp16 protected dims (eigenbasis coords)
+//   v_packed [B*NKV*S, ceil(sac/8)*3] uint8 INT3 indices (unsigned 0..7)
+//   v_scale [B*NKV*S] fp32 per-row max-abs / 3
+//   eigenbasis [NKV, HD, HD] fp16 U[h, d, i] row-major
+//   v_out [B, NKV, S, HD] fp16
+//   sac_dims = HD - K
+void fraqtl_kv_unpack_v(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const float*   v_scale,
+    const half*    eigenbasis,
+    half*          v_out,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+);
+
+// fp32 verification path — skips final fp16 cast for strict math comparison.
+void fraqtl_kv_unpack_v_fp32(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const float*   v_scale,
+    const half*    eigenbasis,
+    float*         v_out,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+);
+
+// Pack: V (head-space, fp16) → eigenbasis-rotated → top-K fp16 + INT3 sacrifice.
+// Mirrors fraqtl/packing.py::quantize_and_pack_int3 byte-for-byte.
+void fraqtl_kv_pack_v(
+    const half*    v_in,
+    half*          v_protected,
+    uint8_t*       v_packed,
+    float*         v_scale,
+    const half*    eigenbasis,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+);
+
+// stride-aware variants. V buffer is addressed via byte strides
+// nb[0..3] corresponding to ggml ne[0]=HD, ne[1]=S, ne[2]=NKV, ne[3]=B.
+// Slabs (prot, packed, scale, U) are still contiguous (we own their layout).
+// Use these when V comes from a real ggml KV cache (potentially non-contiguous).
+void fraqtl_kv_pack_v_strided(
+    const void*    v_in,
+    half*          v_protected,
+    uint8_t*       v_packed,
+    float*         v_scale,
+    const half*    eigenbasis,
+    int B, int NKV, int S, int HD, int K,
+    size_t nb0, size_t nb1, size_t nb2, size_t nb3,
+    cudaStream_t stream
+);
+void fraqtl_kv_unpack_v_strided(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const float*   v_scale,
+    const half*    eigenbasis,
+    void*          v_out,
+    int B, int NKV, int S, int HD, int K,
+    size_t nb0, size_t nb1, size_t nb2, size_t nb3,
+    cudaStream_t stream
+);
+
+// =============================================================================
+// Legacy: Lloyd-Max INT3 + 1-bit sign correction (weight-compression recipe).
+// Debug fallback only. Reactivate only if math agent proves LM+sign beats
+// uniform on V cache at matched bits.
+// =============================================================================
+
+void fraqtl_kv_unpack_v_lloyd_max_sign_legacy(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const uint8_t* v_sign_mask,
+    const float*   v_sigma,
+    const float*   centroids,
+    const half*    eigenbasis,
+    half*          v_out,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+);
+
+void fraqtl_kv_unpack_v_lloyd_max_sign_legacy_fp32(
+    const half*    v_protected,
+    const uint8_t* v_packed,
+    const uint8_t* v_sign_mask,
+    const float*   v_sigma,
+    const float*   centroids,
+    const half*    eigenbasis,
+    float*         v_out,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
+);
+
+void fraqtl_kv_pack_v_lloyd_max_sign_legacy(
+    const half*    v_in,
+    half*          v_protected,
+    uint8_t*       v_packed,
+    uint8_t*       v_sign_mask,
+    float*         v_sigma,
+    const float*   centroids,
+    const half*    eigenbasis,
+    int B, int NKV, int S, int HD, int K,
+    cudaStream_t stream
