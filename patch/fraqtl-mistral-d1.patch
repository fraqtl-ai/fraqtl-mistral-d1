+// time would OOB-read the marker. Empirically the K/V views only flow into
+// the fattn op, which is intercepted. Validated by 4K smoke + PPL gates.
+static inline void fraqtl_propagate_marker(ggml_tensor * view, const ggml_tensor * src) {
+    if (view && src && src->buffer && src->data &&
+            ggml_backend_buffer_get_size(src->buffer) < ggml_nbytes(src)) {
+        view->data   = src->data;
+        view->buffer = src->buffer;
+        if (getenv("FRAQTL_MARKER_PROP_TRACE")) {
+            static int log_count = 0;
+            if (log_count < 16) {
+                fprintf(stderr,
+                        "fraqtl: MARKER_PROPAGATE count=%d view_name=%s src_name=%s "
+                        "view_op=%s src_buffer_bytes=%zu src_nbytes=%zu view_nbytes=%zu "
+                        "view_offs=%zu\n",
+                        log_count,
+                        view->name[0] ? view->name : "(unnamed)",
+                        src->name[0] ? src->name : "(unnamed)",
+                        ggml_op_name(view->op),
+                        ggml_backend_buffer_get_size(src->buffer),
+                        ggml_nbytes(src),
+                        ggml_nbytes(view),
+                        view->view_offs);
+                fflush(stderr);
+                log_count++;
+            }
+        }
+    }
